// Counts the lines of a file that the host provides, using the files contract
// of std::wasm::files. Build it with
//
//   fe build --backend wasm examples/wasm/lines.fe
//
// and run it with `node examples/wasm/lines.mjs lines.wasm <file>`. The reply is
// the number of line feeds, plus one if the file does not end with one; an empty
// file has no lines.
use core::ptr::MemArray
use std::wasm::{HostText, Reply}
use std::wasm::files::{Files, close, open, read}

fn count(_ name: HostText) -> Reply uses (files: mut Files) {
    let handle = match open(name.copy()) {
        Result::Ok(handle) => handle
        Result::Err(error) => { return Reply::error(error.code()) }
    }
    var lines: u32 = 0
    var last: u8 = 10
    var failure: u32 = 0
    // The file is read a block at a time; a read of nothing is its end.
    var block: MemArray<u8> = MemArray::new_zeroed(4096)
    var offset: u32 = 0
    var reading = true
    while reading {
        match read(handle, offset, mut block.as_slice()) {
            Result::Ok(count) => {
                var index: usize = 0
                while index < count as usize {
                    let byte = block[index]
                    if byte == 10 {
                        lines += 1
                    }
                    last = byte
                    index += 1
                }
                offset += count
                reading = count > 0
            }
            Result::Err(error) => {
                failure = error.code()
                reading = false
            }
        }
    }
    close(handle)
    if failure != 0 {
        return Reply::error(failure)
    }
    // A last line without a line feed still counts.
    Reply::ok(if last == 10 { lines } else { lines + 1 })
}

// The files come from the root effect, `std::wasm::Host`.
#[unsafe(export)]
pub fn lines(name: HostText) -> Reply uses (files: mut Files) {
    count(name)
}
