struct Arr {
    ptr: *u256,
}

impl Copy for Arr {}

struct Writer {
    p: *u256,
}

// Each write through `w.p` may overwrite `w.p` itself if it points into the
// writer, and then later writes and reads may reach any memory.
fn copy_in_loop(_ q: Arr, w: mut Writer) {
    let mut i: u256 = 0
    while i < 2 {
        *w.p = *q.ptr
        i += 1
    }
}

// Accepted: a local writer cannot be the target of its own raw pointer.
fn local_writer(_ q: Arr, _ p: *u256) -> u256 {
    let mut local: u256 = 0
    let r = mut local
    let mut w = Writer { p }
    copy_in_loop(q, w: mut w)
    r = 1
    let again = mut w
    *again.p
}

// Rejected: the caller cannot establish separation of the borrowed writer
// in raw memory from the callee's raw read and write effects.
fn raw_writer(_ q: Arr, _ wp: *Writer) {
    let mut local: u256 = 0
    let r = mut local
    copy_in_loop(q, w: mut *wp)
    r = 1
}

// Rejected: lending the writer while another mutable borrow of it is live.
fn overlapping_writer_loans(_ q: Arr, _ p: *u256) {
    let mut w = Writer { p }
    let first = mut w
    copy_in_loop(q, w: mut w)
    first.p = p
}
