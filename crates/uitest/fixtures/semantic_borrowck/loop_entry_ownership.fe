// Loop headers partition joined states by incoming edge, so a move through an
// optional pointer stays correlated with clearing that pointer.

// Accepted: the moved pointer is cleared before the next iteration.
mod cleared_pointer {
    use core::{Option, ptr}
    struct Item { value: u64 }
    fn consume(_ value: own Item) {}
    fn inspect() {
        let pointer = ptr::alloc<Item>()
        *pointer = Item { value: 42 }
        let mut top = Option::Some(pointer)
        while true {
            let selected = match top {
                Option::Some(selected) => selected,
                Option::None => return,
            }
            consume(*selected)
            top = Option::None
        }
    }
}

// Rejected: the next iteration moves the same pointee again.
mod refilled_pointer {
    use core::{Option, ptr}
    struct Item { value: u64 }
    fn consume(_ value: own Item) {}
    fn inspect() {
        let pointer = ptr::alloc<Item>()
        *pointer = Item { value: 42 }
        let mut top = Option::Some(pointer)
        while true {
            let selected = match top {
                Option::Some(selected) => selected,
                Option::None => return,
            }
            consume(*selected)
            top = Option::Some(pointer)
        }
    }
}

// Accepted: each outer iteration reinitializes the pointee before the inner loop.
mod nested_reinitialization {
    use core::{Option, ptr}
    struct Item { value: u64 }
    fn consume(_ value: own Item) {}
    fn inspect(count: usize) {
        let pointer = ptr::alloc<Item>()
        *pointer = Item { value: 42 }
        for _ in 0..count {
            *pointer = Item { value: 42 }
            let mut top = Option::Some(pointer)
            while true {
                let selected = match top {
                    Option::Some(selected) => selected,
                    Option::None => break,
                }
                consume(*selected)
                top = Option::None
            }
        }
    }
}

// Rejected: the inner move survives into the next outer iteration.
mod nested_without_reinitialization {
    use core::{Option, ptr}
    struct Item { value: u64 }
    fn consume(_ value: own Item) {}
    fn inspect(count: usize) {
        let pointer = ptr::alloc<Item>()
        *pointer = Item { value: 42 }
        for _ in 0..count {
            let mut top = Option::Some(pointer)
            while true {
                let selected = match top {
                    Option::Some(selected) => selected,
                    Option::None => break,
                }
                consume(*selected)
                top = Option::None
            }
        }
    }
}

mod forwarded {
    use core::{Option, ptr}
    struct Item { value: u64 }
    fn consume(_ value: own Item) {}
    fn drain(_ pointer: *Item) {
        let mut top = Option::Some(pointer)
        while true {
            let selected = match top {
                Option::Some(selected) => selected,
                Option::None => break,
            }
            consume(*selected)
            top = Option::None
        }
    }

    // Accepted: the pointee is reinitialized between drains.
    fn reinitialized() {
        let pointer = ptr::alloc<Item>()
        *pointer = Item { value: 42 }
        drain(pointer)
        *pointer = Item { value: 43 }
        drain(pointer)
    }

    // Rejected: the drained pointee is moved again.
    fn consumed() {
        let pointer = ptr::alloc<Item>()
        *pointer = Item { value: 42 }
        drain(pointer)
        consume(*pointer)
    }

    // Rejected: the drained pointee is drained again.
    fn redrained() {
        let pointer = ptr::alloc<Item>()
        *pointer = Item { value: 42 }
        drain(pointer)
        drain(pointer)
    }
}

mod inline {
    use core::{Option, ptr}
    struct Item { value: u64 }
    fn consume(_ value: own Item) {}
    fn drain(_ pointer: *Item) {
        let mut top = Option::Some(pointer)
        while true {
            let selected = match top {
                Option::Some(selected) => selected,
                Option::None => break,
            }
            consume(*selected)
            top = Option::None
        }
    }

    // Accepted: the pointee is reinitialized after the inline drain.
    fn reinitialized() {
        let pointer = ptr::alloc<Item>()
        *pointer = Item { value: 42 }
        let mut top = Option::Some(pointer)
        while true {
            let selected = match top {
                Option::Some(selected) => selected,
                Option::None => break,
            }
            consume(*selected)
            top = Option::None
        }
        *pointer = Item { value: 43 }
        drain(pointer)
    }

    // Rejected: the inline-drained pointee is moved again.
    fn consumed() {
        let pointer = ptr::alloc<Item>()
        *pointer = Item { value: 42 }
        let mut top = Option::Some(pointer)
        while true {
            let selected = match top {
                Option::Some(selected) => selected,
                Option::None => break,
            }
            consume(*selected)
            top = Option::None
        }
        consume(*pointer)
    }

    // Rejected: the inline-drained pointee is drained again.
    fn redrained() {
        let pointer = ptr::alloc<Item>()
        *pointer = Item { value: 42 }
        let mut top = Option::Some(pointer)
        while true {
            let selected = match top {
                Option::Some(selected) => selected,
                Option::None => break,
            }
            consume(*selected)
            top = Option::None
        }
        drain(pointer)
    }
}
