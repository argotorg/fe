use core::functional::Fn
use std::evm::TStorPtr

fn capture_target() uses (target: mut u256) {
    let handle = mut target
    let f = |_ unit: own ()| -> () {
        let captured = handle
        captured = 7
    }
    f.call(())
}

pub fn closure_transient_handle_capture() {
    let ptr: TStorPtr<u256> = TStorPtr::from_raw(0)
    with (ptr) {
        capture_target()
    }
}
