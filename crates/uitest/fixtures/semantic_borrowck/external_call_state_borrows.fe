use core::ptr::{MemBuffer, MemSpan}
use std::evm::{Address, Call}

// Rejected: an unrestricted call crosses a live mutable storage loan.
pub contract CallBorrow {
    mut value: u256,
    init() uses (mut value, call: mut Call) {
        value = 0
        let held = mut value
        let mut output = MemBuffer::empty()
        let outcome = call.raw_call(
            addr: Address { inner: 1 }, gas: 100000, value: Wei::zero(),
            args: MemSpan::empty(), ret: mut output,
        )
        held = 1
    }
}

// Rejected: an unrestricted call can also write through a shared loan.
pub contract CallRefBorrow {
    mut value: u256,
    init() uses (mut value, call: mut Call) {
        value = 0
        let held = ref value
        let mut output = MemBuffer::empty()
        let outcome = call.raw_call(
            addr: Address { inner: 1 }, gas: 100000, value: Wei::zero(),
            args: MemSpan::empty(), ret: mut output,
        )
        let observed: u256 = held
    }
}

// Accepted: the native storage loan starts after the call.
pub contract CallReborrow {
    mut value: u256,
    init() uses (mut value, call: mut Call) {
        value = 0
        let mut output = MemBuffer::empty()
        let outcome = call.raw_call(
            addr: Address { inner: 1 }, gas: 100000, value: Wei::zero(),
            args: MemSpan::empty(), ret: mut output,
        )
        let held = mut value
        held = 1
    }
}

// Rejected: even a static call can read through an exclusive storage loan.
pub contract StaticMutBorrow {
    mut value: u256,
    init() uses (mut value, call: mut Call) {
        value = 0
        let held = mut value
        let mut output = MemBuffer::empty()
        let outcome = call.raw_staticcall(
            addr: Address { inner: 1 }, gas: 100000,
            args: MemSpan::empty(), ret: mut output,
        )
        held = 1
    }
}

// Accepted: a static call and a shared storage loan can both read.
pub contract StaticRefBorrow {
    mut value: u256,
    init() uses (mut value, call: mut Call) {
        value = 0
        let held = ref value
        let mut output = MemBuffer::empty()
        let outcome = call.raw_staticcall(
            addr: Address { inner: 1 }, gas: 100000,
            args: MemSpan::empty(), ret: mut output,
        )
        let observed: u256 = held
    }
}

// Accepted: a precompile cannot call back into the contract, so it may run
// while an exclusive storage loan is live.
pub contract PrecompileMutBorrow {
    mut value: u256,
    init() uses (mut value) {
        value = 0
        let held = mut value
        let digest = std::evm::crypto::sha256(MemSpan::empty())
        held = 1
    }
}
