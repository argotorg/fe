use core::{Option, ptr}

struct Node { value: u256, next: *Node, other: *Node }

// A helper returning a recursive field must preserve its exact stored address.
fn next_1(_ node: *Node) -> *Node { node.next }
fn forwarded_1(_ node: *Node) -> *Node { next_1(node) }

fn next_4(_ node: *Node) -> *Node { node.next.next.next.next }
fn forwarded_4(_ node: *Node) -> *Node { next_4(node) }

fn next_16(_ node: *Node) -> *Node { node.next.next.next.next.next.next.next.next.next.next.next.next.next.next.next.next }
fn forwarded_16(_ node: *Node) -> *Node { next_16(node) }

// Accepted: the selected tail is distinct from the borrowed head.
fn tail_after_1_links() {
    let head = ptr::alloc<Node>()
    let tail = ptr::alloc<Node>()
    *tail = Node { value: 0, next: tail, other: head }
    *head = Node { value: 1, next: tail, other: head }
    let selected = forwarded_1(head)
    let borrowed = mut head.value
    selected.value = 2
    borrowed = 3
}

// Rejected: the selected head aliases the mutable borrow.
fn head_after_1_links() {
    let head = ptr::alloc<Node>()
    let tail = ptr::alloc<Node>()
    *tail = Node { value: 0, next: tail, other: head }
    *head = Node { value: 1, next: head, other: head }
    let selected = forwarded_1(head)
    let borrowed = mut head.value
    selected.value = 2
    borrowed = 3
}

// Accepted: the selected tail is distinct from the borrowed head.
fn tail_after_4_links() {
    let head = ptr::alloc<Node>()
    let tail = ptr::alloc<Node>()
    *tail = Node { value: 0, next: tail, other: head }
    *head = Node { value: 1, next: tail, other: head }
    let selected = forwarded_4(head)
    let borrowed = mut head.value
    selected.value = 2
    borrowed = 3
}

// Rejected: the selected head aliases the mutable borrow.
fn head_after_4_links() {
    let head = ptr::alloc<Node>()
    let tail = ptr::alloc<Node>()
    *tail = Node { value: 0, next: tail, other: head }
    *head = Node { value: 1, next: head, other: head }
    let selected = forwarded_4(head)
    let borrowed = mut head.value
    selected.value = 2
    borrowed = 3
}

// Accepted: the selected tail is distinct from the borrowed head.
fn tail_after_16_links() {
    let head = ptr::alloc<Node>()
    let tail = ptr::alloc<Node>()
    *tail = Node { value: 0, next: tail, other: head }
    *head = Node { value: 1, next: tail, other: head }
    let selected = forwarded_16(head)
    let borrowed = mut head.value
    selected.value = 2
    borrowed = 3
}

// Rejected: the selected head aliases the mutable borrow.
fn head_after_16_links() {
    let head = ptr::alloc<Node>()
    let tail = ptr::alloc<Node>()
    *tail = Node { value: 0, next: tail, other: head }
    *head = Node { value: 1, next: head, other: head }
    let selected = forwarded_16(head)
    let borrowed = mut head.value
    selected.value = 2
    borrowed = 3
}

struct OptionalNode { value: u256, next: Option<*OptionalNode> }

fn take(_ node: *OptionalNode) -> OptionalNode { *node }

// Accepted: consuming the head leaves the distinct tail available.
fn move_distinct_nodes() {
    let head = ptr::alloc<OptionalNode>()
    let tail = ptr::alloc<OptionalNode>()
    *tail = OptionalNode { value: 2, next: Option::None }
    *head = OptionalNode { value: 1, next: Option::Some(tail) }
    let first = take(head)
    let tail = match first.next { Option::Some(tail) => tail, Option::None => return }
    let second = take(tail)
    core::assert(second.value == 2)
}

// Rejected: the same head cannot be consumed twice.
fn move_same_node_twice() {
    let head = ptr::alloc<OptionalNode>()
    let tail = ptr::alloc<OptionalNode>()
    *tail = OptionalNode { value: 2, next: Option::None }
    *head = OptionalNode { value: 1, next: Option::Some(tail) }
    let first = take(head)
    let tail = match first.next { Option::Some(tail) => tail, Option::None => return }
    let second = take(head)
    core::assert(second.value == 2)
}

// Accepted: a recursive traversal's summary converges for each payload shape.
fn node_sum(_ node: *Node, _ n: u256) -> u256 {
    if n == 0 { 0 } else { node.value + node_sum(node.next, n - 1) }
}

fn even_sum(_ node: *Node, _ n: u256) -> u256 {
    if n == 0 { 0 } else { node.value + odd_sum(node.next, n - 1) }
}

fn odd_sum(_ node: *Node, _ n: u256) -> u256 {
    if n == 0 { 0 } else { even_sum(node.other, n - 1) }
}

enum Chain { End, Next(*ChainNode) }
struct ChainNode { value: u256, next: Chain }

fn chain_sum(_ chain: Chain) -> u256 {
    match chain {
        Chain::End => 0
        Chain::Next(node) => node.value + chain_sum(node.next)
    }
}

fn chain_sum_ref(_ chain: ref Chain) -> u256 {
    match chain {
        Chain::End => 0
        Chain::Next(node) => node.value + chain_sum_ref(ref node.next)
    }
}

fn optional_sum(_ node: ref Option<*OptionalNode>) -> u256 {
    if let Option::Some(node) = node { node.value + optional_sum(ref node.next) } else { 0 }
}

// Rejected: the recursive call may write the borrowed node through a cycle.
fn bump_all(_ node: *Node, _ n: u256) {
    if n == 0 { return }
    let borrowed = mut node.value
    bump_all(node.next, n - 1)
    borrowed += 1
}
