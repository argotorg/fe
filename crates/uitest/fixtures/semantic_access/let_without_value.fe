fn read() -> u8 {
    let x: u8
    x
}

fn read_in_branch(_ c: bool) -> u8 {
    let x: u8
    if c {
        return x
    }
    0
}

fn read_after_loop(_ n: u8) -> u8 {
    let x: u8
    var i: u8 = 0
    while i < n {
        i += 1
    }
    x
}

fn never_read() -> u8 {
    let x: u8
    0
}

fn diverge() -> ! {
    loop {}
}

fn read_after_diverging() -> u8 {
    let x: u8
    diverge()
    x
}

fn uninhabited_array() -> [!; 1] {
    loop {}
}

fn read_after_uninhabited_array() -> u8 {
    let x: u8
    let _n = uninhabited_array()
    x
}

fn read_after_uninhabited_statement() -> u8 {
    let x: u8
    uninhabited_array()
    x
}

enum Void {}

fn void() -> Void {
    loop {}
}

fn read_after_void() -> u8 {
    let x: u8
    let _v = void()
    x
}

fn read_after_breaking_loop() -> u8 {
    let x: u8
    loop {
        break
    }
    x
}

fn read_after_endless_loop() -> u8 {
    let x: u8
    loop {}
    x
}

fn read_after_loop_that_diverges() -> u8 {
    let x: u8
    loop {
        void()
        break
    }
    x
}

fn read_after_empty_match(_ v: Void) -> u8 {
    let x: u8
    match v {}
    x
}

fn take(_ x: u8) {}

fn read_as_argument() {
    let x: u8
    take(x)
}

fn read_through_borrow() {
    let x: u8
    let _r = ref x
}

struct Pair {
    a: u8,
    b: u8,
}

fn read_field() -> u8 {
    let p: Pair
    p.a
}

fn read_destructured() -> u8 {
    let (a, b): (u8, u8)
    a
}

fn read_in_capture() -> u8 {
    let x: u8
    let c = || x
    c()
}

fn read_in_closure() -> u8 {
    let c = || {
        let x: u8
        x
    }
    c()
}

fn read_shadowing() -> u8 {
    let x: u8 = 1
    let x: u8
    x
}

fn read_shadowed() -> u8 {
    let x: u8
    let x: u8 = 1
    x
}

struct Empty {}

fn read_empty() -> Empty {
    let x: Empty
    x
}

const fn read_in_const_fn() -> u8 {
    let x: u8
    x
}
