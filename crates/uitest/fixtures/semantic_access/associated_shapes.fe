// An associated shape forwarded whole is an access of the call, as the
// shape its impl gives is: a write to the base while a part is live, and two
// `mut` grants of one base, conflict.
trait Driver {
    shape Step

    fn at(mut? self) -> Self::Step
}

struct Pair {
    a: u256,
    b: u256,
}

impl Driver for Pair {
    shape Step = (mut? u256, mut? u256)

    fn at(mut? self) -> (mut? u256, mut? u256) {
        (mut? self.a, mut? self.b)
    }
}

fn first<D: mut? Driver>(_ d: mut? D) -> D::Step {
    d.at()
}

fn twice<D: mut? Driver>(_ d: mut? D) -> (D::Step, D::Step) {
    (d.at(), d.at())
}

fn write_while_live() {
    var p = Pair { a: 1, b: 2 }
    let (mut x, y) = first(mut p)
    p.a = 5
    x = 1
}

// Accepted: the parts are dead before the write.
fn write_after() {
    var p = Pair { a: 1, b: 2 }
    let (mut x, y) = first(mut p)
    x = 1
    p.a = 5
}

// Accepted: a forwarded shape grants its parts apart.
fn parts_apart() {
    var p = Pair { a: 1, b: 2 }
    let (mut x, mut y) = first(mut p)
    x = 1
    y = 2
}

// Accepted: a part beside a read of another.
fn part_beside_read() {
    var p = Pair { a: 1, b: 2 }
    let (mut x, y) = first(mut p)
    x = y
}

struct Counted {
    n: u256,
    v: u256,
}

impl Driver for Counted {
    shape Step = (own u256, mut? u256)

    fn at(mut? self) -> (own u256, mut? u256) {
        (self.n, mut? self.v)
    }
}

// Accepted: an `own` part holds no access once the rest is dead.
fn own_part_outlives_session() {
    var c = Counted { n: 1, v: 2 }
    let (n, mut v) = first(mut c)
    v = 3
    c.n = n + 1
}

fn write_under_part() {
    var c = Counted { n: 1, v: 2 }
    let (n, mut v) = first(mut c)
    c.v = n
    v = 3
}
