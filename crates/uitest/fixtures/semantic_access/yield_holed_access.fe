// A yielded grant gives the caller its whole referent, so no part of it may
// be moved out when the projection yields, under the grant's own access or
// one it derives from.
use core::option::Option
use core::ptr::MemArray

struct Holder {
    a: u256,
    b: MemArray<u256>,
}

struct Pair {
    x: MemArray<u256>,
    y: MemArray<u256>,
}

struct Outer {
    p: Pair,
}

impl Holder {
    // Rejected: the yielded access's referent was moved out.
    fn p1(mut self) -> mut MemArray<u256> {
        let g = mut self.b
        let v = g
        yield g
        self.a = v[0]
        g = v
    }

    // Rejected: a tuple component.
    fn p2(mut self) -> (u256, mut MemArray<u256>) {
        let g = mut self.b
        let v = g
        yield (1, g)
        g = v
    }

    // Rejected: a sum payload.
    fn p3(mut self) -> Option<mut MemArray<u256>> {
        let g = mut self.b
        let v = g
        yield Option::Some(g)
        g = v
    }
}

impl Outer {
    // Rejected: a child access of the whole holed parent.
    fn whole(mut self) -> mut Pair {
        let g = mut self.p
        let v = g.x
        let h = mut g
        yield h
        g.x = v
    }

    // Accepted: the child's referent holds no hole.
    fn other(mut self) -> mut MemArray<u256> {
        let g = mut self.p
        let v = g.x
        let h = mut g.y
        yield h
        g.x = v
    }
}

// A `mut` parameter's hole may be held across a yield that does not export
// it, and restored in the slide.
struct Halves {
    a: MemArray<u256>,
    b: MemArray<u256>,
}

impl Halves {
    // Accepted: the hole is disjoint from the grant and restored.
    fn disjoint(mut self) -> mut MemArray<u256> {
        let v = self.b
        yield mut self.a
        self.b = v
    }

    // Rejected: the grant is the hole.
    fn exported(mut self) -> mut MemArray<u256> {
        let v = self.b
        yield mut self.b
        self.b = v
    }

    // Rejected: the grant holds the hole.
    fn whole(mut self) -> mut Halves {
        let v = self.b
        yield self
        self.b = v
    }

    // Accepted.
    fn disjoint_ref(mut self) -> ref MemArray<u256> {
        let v = self.b
        yield ref self.a
        self.b = v
    }

    // Rejected: the slide never restores it.
    fn unrestored(mut self) -> mut MemArray<u256> {
        let v = self.b
        yield mut self.a
    }

    // Accepted: the empty variant restores before it returns.
    fn restored_on_each_path(mut self, _ c: bool) -> Option<mut MemArray<u256>> {
        let v = self.b
        if c {
            self.b = v
            return Option::None
        }
        yield Option::Some(mut self.a)
        self.b = v
    }
}

// Accepted: a free function's `mut` parameter.
fn disjoint_param(_ h: mut Halves) -> mut MemArray<u256> {
    let v = h.b
    yield mut h.a
    h.b = v
}
