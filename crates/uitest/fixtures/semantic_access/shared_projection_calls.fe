struct Buffer { value: u256 }

impl Buffer {
    fn read(self) -> u256 { self.value }
    fn absorb(mut self, _ other: Buffer) { self.value += other.value }
    fn consume(own self) -> u256 { self.value }
}

struct Frame { memory: Buffer }

fn consume(_ buffer: own Buffer) -> u256 { buffer.value }

fn inspect(_ buffer: Buffer, _ frame: mut Frame) -> u256 { buffer.read() }

fn own_receiver_moves_projection(frame: own Frame) -> u256 {
    frame.memory.consume() + frame.memory.read()
}

fn own_argument_moves_projection(frame: own Frame) -> u256 {
    consume(frame.memory) + frame.memory.read()
}

fn projection_view_conflicts_with_mut_argument(var frame: own Frame) -> u256 {
    inspect(frame.memory, mut frame)
}

fn projection_view_conflicts_with_mut_receiver(var frame: own Frame) {
    frame.memory.absorb(frame.memory)
}
