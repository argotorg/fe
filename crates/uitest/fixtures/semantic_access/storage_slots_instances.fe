use core::intrinsic::storage_slots

fn slots<T>() -> u256 {
    storage_slots<T>()
}

// Rejected: `slots<[[[u256; 2**32 - 1]; 2**32 - 1]; 2**32 - 1]>` asks for more storage slots than a layout can count.
fn too_many() -> u256 {
    slots<[[[u256; 0xffffffff]; 0xffffffff]; 0xffffffff]>()
}

// Accepted.
fn three() -> u256 {
    slots<[u256; 3]>()
}
