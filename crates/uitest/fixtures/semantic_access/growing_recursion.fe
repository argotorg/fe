// Rejected: a const argument that grows at every call makes a new instance
// at each, as a growing type does.
fn count_up<const N: usize>(_ x: u256) -> u256 {
    if x == 0 { N as u256 } else { count_up<{ N + 1 }>(x - 1) }
}

fn calls_count_up() -> u256 {
    count_up<0>(3)
}
