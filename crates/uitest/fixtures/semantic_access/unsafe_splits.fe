use core::ptr::{MemArray, MemBuffer, MemSpan}
use std::evm::{Address, Call, RawStorage, SolArray}

msg Msg {
    #[selector = 1]
    Run -> u256,
}

// Rejected: a split's grants keep all storage reserved, so a contract field
// cannot be written while either is open.
pub contract C {
    mut total: u256,

    recv Msg {
        Run -> u256 uses (mut total, storage: mut RawStorage) {
            let (mut a, mut b) = unsafe { (SolArray<u256>::at_mut(10), SolArray<u256>::at_mut(11)) }
            a.push(1)
            total = 5
            b.push(2)
            total
        }
    }
}

// Rejected: nor may an external call run.
fn external_call() uses (call: mut Call, storage: mut RawStorage) {
    let (mut a, mut b) = unsafe { (SolArray<u256>::at_mut(0), SolArray<u256>::at_mut(1)) }
    a.push(1)
    var output = MemBuffer::empty()
    let _ = call.raw_call(addr: Address { inner: 1 }, gas: 0, value: 0, args: MemSpan::empty(), ret: mut output)
    b.push(2)
}

// Rejected: raw roots from two `unsafe` blocks are two all-storage sessions.
fn two_blocks() uses (storage: mut RawStorage) {
    let a = unsafe { SolArray<u256>::at_mut(0) }
    let b = unsafe { SolArray<u256>::at_mut(1) }
    a.push(1)
    b.push(2)
}

// Rejected: one component of a split granted twice.
fn duplicated(_ xs: mut MemArray<u256>) -> (mut u256, mut u256) {
    let (mut a, mut b) = xs.pair_mut(0, 1)
    (a, a)
}
