// Accesses of a trait provider in a `const fn` follow the same rules as at
// runtime: a projection may yield a place in the domain its `uses` clause
// reserves, and a `with` source cannot be accessed mutably while it provides.
trait Lookup {
    const fn first(ref self) -> ref u256
}

struct Table { xs: [u256; 4] }

impl Lookup for Table {
    const fn first(ref self) -> ref u256 { ref self.xs[0] }
}

const fn leak() -> ref u256 uses (table: Lookup) {
    table.first()
}

const fn call_leak() -> u256 {
    with (Lookup = Table { xs: [1, 2, 3, 4] }) { leak() }
}

const fn overwrite(_ table: mut Table) -> u256 uses (provider: Lookup) {
    table.xs[0] = 9
    provider.first()
}

const fn alias() -> u256 {
    var table = Table { xs: [1, 2, 3, 4] }
    with (Lookup = table) { overwrite(mut table) }
}
