msg M {
    #[selector = 0]
    Touch -> u256,
}

contract ImmutableFallbackFieldMutUse {
    x: u256

    init() uses (mut x) {
        x = 1
    }

    recv M {
        Touch -> u256 uses (mut x) {
            x
        }
    }
}

contract ReadOnlyUses {
    x: u256

    init() uses (mut x) {
        x = 1
    }

    recv M {
        Touch -> u256 uses (x) {
            x
        }
    }
}
