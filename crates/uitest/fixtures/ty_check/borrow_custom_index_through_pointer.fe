use core::ops::Index

struct WordView { base: u256 }

impl Copy for WordView {}

impl Index<u256> for WordView {
    type Output = u256

    fn index(self, _ offset: u256) -> ref u256 {
        let word = self.base + offset
        ref word
    }
}

struct Holder {
    view: WordView,
    words: [u256; 2],
}

fn make_ptr() -> *Holder {
    core::ptr::alloc<Holder>()
}

fn borrow_custom_index_through_pointer() {
    // A built-in array element below a temporary pointer is a place.
    let _element = unsafe { ref make_ptr().words[0] }
    // A custom `Index` call's result is a place in its grant.
    let _value = unsafe { ref make_ptr().view[0] }
}
