use core::AsBytes

trait Foo {
    fn foo(self) -> u256
}

struct S {
    x: u256,
}

impl Foo for S {
    fn foo(self) -> u256 {
        self.x
    }
}

struct W<A> {
    a: A,
}

impl<A: Foo> Foo for W<A> {
    fn foo(self) -> u256 {
        self.a.foo()
    }
}

impl<A: Foo> Foo for (A,) {
    fn foo(self) -> u256 {
        self.0.foo()
    }
}

fn need<X: Foo>(_ x: X) -> u256 {
    x.foo()
}

// A non-Copy generic parameter declared without `own` is borrowed, so the
// tuple holds a borrowed `T`, which does not implement `AsBytes`.
fn tuple_of_generic<T: AsBytes>(_ dims: T) -> u256 {
    core::keccak(("abcdefghijklmnopqrstuvwxy", dims, "abcdef"))
}

fn struct_wrapper<T: Foo>(_ t: T) -> u256 {
    need(W { a: t })
}

fn concrete_non_copy(_ s: S) -> u256 {
    need((s,))
}

// These compile: the value is owned or copied.
fn owned_param<T: Foo>(_ t: own T) -> u256 {
    need(W { a: t })
}

fn copy_param<T: Foo + Copy>(_ t: T) -> u256 {
    need(W { a: t })
}

fn owned_concrete(_ s: own S) -> u256 {
    need((s,))
}

// The borrowed `T` comes from destructuring a borrowed tuple, so there is no
// `T` parameter to take as `own`. The error explains the borrow but suggests
// no edit.
fn destructured<T: Foo>(_ p: (T,)) -> u256 {
    let (t,) = p
    need(W { a: t })
}

// `W<T>: Foo` is assumed, so with `T` owned the bound holds by that
// assumption, although `T: Foo` is not known. The explanation claims only
// that, and names no `Foo` impl for `T`.
fn assumed_wrapper<T>(_ t: T) -> u256
where
    W<T>: Foo,
{
    need(W { a: t })
}
