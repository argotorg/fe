use std::abi::DynArray

// Not `Copy`, so fixed arrays of it have no ABI codec.
#[abi]
struct Key {
    a: u256,
}

#[abi]
struct Keys {
    keys: [Key; 2],
}

#[abi]
struct Nested {
    first: u256,
    nested: (u256, [[Key; 1]; 2]),
    list: DynArray<[Key; 2]>,
}

type KeyPair = [Key; 2]

#[event]
struct KeysEvent {
    keys: KeyPair,
}

#[error]
struct KeysError {
    keys: KeyPair,
}
