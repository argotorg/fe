// A trait reference's const argument is evaluated where the reference is
// written, so a fault or a non-const call in it is reported there instead of
// silently dropping the bound. A fault that a default or a named constant
// declares is reported once, at that declaration; one that only applying a
// default reveals is reported at the reference that applies it.
fn runtime() -> usize { 1 }

trait Has<const N: usize> {}

struct Plain<const N: usize> {}

fn inline_bound<T: Has<{ 1 / 0 }>>() {}

fn where_clause<T>() where T: Has<{ runtime() }> {}

struct Bounded<T: Has<{ 2 - 3 }>> {}

impl Has<{ runtime() }> for u8 {}

impl Has<{ 4 / 0 }> for Plain<1> {}

trait Defaulted<const N: usize = { 5 / 0 }> {}

fn applies_default<T: Defaulted>() {}

const FAULT: usize = 6 / 0

fn names_constant<T: Has<{ FAULT }>>() {}

fn valid<T: Has<{ 1 / 1 }>>() {}

fn caller() { valid<bool>() }

type Inverse<const N: usize> = [u8; { 7 / N }]

trait Shaped<const N: usize, T = Inverse<N>> {}

fn applies_faulting_default<T: Shaped<0>>() {}

fn applies_valid_default<T: Shaped<1>>() {}

trait Type { type Item }

struct Width<const N: usize> {}

impl<const N: usize> Type for Width<N> { type Item = [u8; { 8 / N }] }

trait Projected<T: Type, U = T::Item> {}

fn projects_faulting_default<X: Projected<Width<0>>>() {}

fn projects_valid_default<X: Projected<Width<1>>>() {}

trait Sized<const N: usize> { type Item }

fn qualified<T: Sized<1>>() -> <T as Sized<{ 9 / 0 }>>::Item { todo() }

// A qualified path's trait arguments fault wherever the path is written.
trait Valued<const N: usize> {
    type Item
    const C: u8
}

struct Rec { x: u8 }

impl Valued<1> for Rec {
    type Item = Rec
    const C: u8 = 1
}

fn qualified_value() -> u8 { <Rec as Valued<{ 10 / 0 }>>::C }

fn qualified_pattern(x: u8) {
    match x {
        <Rec as Valued<{ 11 / 0 }>>::C => {}
        _ => {}
    }
}

fn qualified_record() -> Rec { <Rec as Valued<{ 12 / 0 }>>::Item { x: 1 } }

fn qualified_record_pattern(r: Rec) {
    match r {
        <Rec as Valued<{ 13 / 0 }>>::Item { x } => {}
    }
}
