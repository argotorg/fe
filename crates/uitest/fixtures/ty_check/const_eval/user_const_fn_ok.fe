struct Agg {
    a: u8,
    b: u8,
}

const fn make_agg() -> Agg {
    Agg { a: 3, b: 2 }
}

const fn agg_len() -> usize {
    let agg = make_agg()
    agg.a as usize
}

const fn add(_ a: usize, _ b: usize) -> usize {
    a + b
}

const fn pick(_ flag: bool) -> usize {
    if flag {
        1
    } else {
        2
    }
}

type Arr = [u8; add(pick(true), pick(false))]
type AggArr = [u8; agg_len()]

fn takes_arr(_: Arr) {}
fn takes_agg(_: AggArr) {}

fn ok(a: Arr, d: AggArr) {
    takes_arr(a)
    takes_agg(d)
}
