// A loop's item pattern chooses its traversal: `mut` on the item takes `at`
// at `mut` and opens the base mutably, as a `mut` component opens a matched
// place, so the base needs no marker.

// S-70. Accepted: each element, and each item of a chain, is written in
// place.
fn written(_ xs: mut [u256; 4]) {
    for mut x in xs {
        x *= 2
    }
    for (i, mut x) in xs.enumerate().take(3) {
        x += i as u256
    }
}

// S-70. Rejected: a `mut` item over a view base.
fn view_base(_ xs: [u256; 2]) {
    for mut x in xs {
        x += 1
    }
}

// S-70. Rejected: `mut` on the owned index beside the item.
fn mut_extra(_ xs: mut [u256; 2]) {
    for (mut i, x) in xs.enumerate() {
        i += x.downcast_unchecked()
    }
}

struct Account { balance: u256 }

// S-70. Rejected: a step's non-`Copy` element is bound `ref`, and its owned
// index by value.
fn non_copy_step(_ accounts: [Account; 2]) {
    for (i, account) in accounts.enumerate() {
    }
}

// Rejected: a step bound whole, which the pattern must take apart, or which
// generic code only passes on; `ref` and `mut` on it add nothing more.
fn whole_step(_ xs: mut [u256; 2]) {
    for ref t in xs.enumerate() {
    }
    for mut t in xs.enumerate() {
    }
}

fn whole_opaque_step<D: Copy + core::iter::Driver<Base = [u256; 2]>>(_ xs: [u256; 2], _ d: D)
    uses D::E
{
    for ref x in xs.by(d) {
    }
}
