// A string literal longer than the inline `String` capacity whose type is only
// inferred (not passed directly to a compile-time byte consumer like
// `core::keccak`) used to reach constant evaluation with an invalid type and
// fail with a compiler invariant error.
use core::AsBytes

const fn hash<T: AsBytes>(_ x: T) -> u256 {
    core::keccak(x)
}

const FORWARDED: u256 = hash(("OrderComponents(address offerer,address zone)", "x"))

const fn bound_tuple() -> u256 {
    let parts = ("OrderComponents(address offerer,address zone)", "x")
    core::keccak(parts)
}
