enum Choice<const N: usize> where N > 0 { Empty, Tuple(u256), Record { value: u256 } }
const fn read<const M: usize>(_ item: Choice<M>) -> u256 where M > 0 { match item { Choice::Empty => 7, Choice::Tuple(value) => value, Choice::Record { value } => value + 1 } }
const fn answer() -> u256 { read(Choice<0>::Empty) }
