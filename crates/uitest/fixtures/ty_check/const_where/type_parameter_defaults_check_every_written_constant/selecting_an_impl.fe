// An anonymous constant in a type parameter's default that only selects an
// impl is checked against its parameter. Here `dec<0>()` wraps to
// `usize::MAX`, and `Bounded<0>::D` reaches an impl whose premise fails.
struct Bounded<const N: usize> where N > 0 { value: u256 }
struct Holder<const N: usize> {}
struct Plain {}
trait Mk { type Out }
trait Sel<const N: usize> { type Out }
#[arithmetic(unchecked)]
const fn dec<const N: usize>() -> usize where N > 0 { N - 1 }
const fn positive<const N: usize>() -> usize where N > 0 { 1 }
#[arithmetic(unchecked)]
const fn wrapped_max() -> usize { 0 - 1 }
const MAX: usize = wrapped_max()
impl Mk for Holder<MAX> { type Out = Plain }
impl<const N: usize> Sel<N> for Plain { type Out = Plain }
impl<const N: usize> Bounded<N> { const D: usize = dec<N>() }

struct S<T = Holder<{ dec<0>() }>::Out> { x: T }
struct Premise<T = Holder<{ Bounded<0>::D }>::Out> { x: T }
struct Qualified<T = <Plain as Sel<{ positive<0>() }>>::Out> { x: T }
fn g<T = Holder<{ dec<0>() }>::Out>() {}
struct Z {}
impl Z { fn method<T = Holder<{ dec<0>() }>::Out>() {} }
trait Tr { fn go<T = Holder<{ dec<0>() }>::Out>() {} }

fn take(_ s: S, _ p: Premise, _ q: Qualified) {
    g()
    Z::method()
}

struct Allowed<T = Holder<{ dec<1>() + MAX }>::Out> { x: T }
