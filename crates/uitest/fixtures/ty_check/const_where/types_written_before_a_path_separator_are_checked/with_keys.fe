// A `with` key is a written type, checked like any other, together with the
// anonymous constants written in it.
struct Bounded<const N: usize> where N > 0 { value: u256 }
struct Holder<const N: usize> {}
trait Mk { type Out }
#[arithmetic(unchecked)]
const fn dec<const N: usize>() -> usize where N > 0 { N - 1 }
const fn positive<const N: usize>() -> usize where N > 0 { 1 }
impl<const N: usize> Mk for Bounded<N> { type Out = Holder<{ dec<N>() }> }
impl<const N: usize> Bounded<N> { const D: usize = dec<N>() }
#[arithmetic(unchecked)]
const fn wrapped_max() -> usize { 0 - 1 }
const MAX: usize = wrapped_max()
fn wants_max() uses (h: Holder<MAX>) {}
fn wants_one() uses (h: Holder<1>) {}
fn wants_zero() uses (h: Holder<0>) {}

fn qualifier() { with (Bounded<0>::Out = Holder<MAX> {}) { wants_max() } }
fn argument() { with (Holder<Bounded<0>::D> = Holder<MAX> {}) { wants_max() } }
fn braced() { with (Holder<{ Bounded<0>::D }> = Holder<MAX> {}) { wants_max() } }
fn call() { with (Holder<{ positive<0>() }> = Holder<1> {}) { wants_one() } }

fn allowed() {
    with (Bounded<1>::Out = Holder<0> {}, Holder<{ positive<1>() }> = Holder<1> {}) {
        wants_zero()
        wants_one()
    }
}
