// An impl of a constrained type may rely on its header's condition, so every
// path that reaches the impl through a constrained type checks that type.
// Here `dec<0>()` would wrap to `usize::MAX` if `Bounded<0>::Out` were
// accepted.
struct Bounded<const N: usize> where N > 0 { value: u256 }
struct Holder<const N: usize> {}
trait Mk { type Out }
trait Get { const V: usize }
#[arithmetic(unchecked)]
const fn dec<const N: usize>() -> usize where N > 0 { N - 1 }
impl<const N: usize> Mk for Bounded<N> { type Out = Holder<{ dec<N>() }> }
impl<const N: usize> Get for Bounded<N> { const V: usize = dec<N>() }
impl<const N: usize> Bounded<N> { const D: usize = dec<N>() }
#[arithmetic(unchecked)]
const fn wrapped_max() -> usize { 0 - 1 }
const MAX: usize = wrapped_max()

fn param(_ x: Bounded<0>::Out) {}
fn use_param() { param(Holder<MAX> {}) }
fn local() { let _x: Bounded<0>::Out = Holder<MAX> {} }
fn trait_const(_ h: Holder<Bounded<0>::V>) {}
fn inherent_const(_ h: Holder<Bounded<0>::D>) {}
fn body_trait_const() -> usize { Bounded<0>::V }
// An alias cannot carry the header's condition to a use that skips it.
type Same<const N: usize> = Bounded<N>
fn through_alias(_ x: Same<0>::Out) {}
type Projected<const N: usize> = Bounded<N>::Out

fn allowed(_ x: Bounded<1>::Out, _ h: Holder<Bounded<1>::V>, _ y: Same<1>::Out) -> usize {
    let _y: Bounded<2>::Out = Holder<1> {}
    Bounded<1>::D
}
