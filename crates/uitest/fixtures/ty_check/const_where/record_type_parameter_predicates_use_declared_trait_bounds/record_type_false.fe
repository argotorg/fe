trait Flag { const ALLOWED: bool }
struct Yes {}
struct No {}
impl Flag for Yes { const ALLOWED: bool = true }
impl Flag for No { const ALLOWED: bool = false }
struct Bounded<T: Flag> where T::ALLOWED { value: u256 }
const fn make<U: Flag>() -> Bounded<U> where U::ALLOWED { Bounded { value: 42 } }
type Invalid = Bounded<No>
