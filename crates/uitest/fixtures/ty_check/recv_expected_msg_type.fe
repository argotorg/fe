// Test that recv blocks require a msg module, not a struct or enum

pub struct NotAMsg {
    value: u64,
}

pub enum NotAMsgEither {
    Foo,
    Bar(u64),
}

pub contract BadContract {
    mut data: u64,

    // Error: recv block expects a msg module, but struct is given
    recv NotAMsg {
        value -> u64 uses () {
            value
        }
    }
}

pub contract BadContract2 {
    mut data: u64,

    // Error: recv block expects a msg module, but enum is given
    recv NotAMsgEither {
        Foo -> u64 uses () {
            0
        }
    }
}
