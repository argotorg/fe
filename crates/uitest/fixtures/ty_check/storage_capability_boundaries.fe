use std::evm::{StorageMap, TSlot, storage_at, storage_at_mut}
use std::evm::effects::RawStorage

struct Store {
    balances: StorageMap<u256, u256>,
}

pub fn map_literal(_ store: mut Store) {
    store.balances = StorageMap {}
}

// A raw-slot constructor is `unsafe` and needs raw storage authority.
pub fn raw_map_without_unsafe() -> u256 uses (storage: mut RawStorage) {
    StorageMap<u256, u256>::at(0).get(1)
}

pub fn raw_map_without_effect() -> u256 {
    unsafe { StorageMap<u256, u256>::at(0).get(1) }
}

pub fn tslot_literal(_ slot: mut TSlot<u256>) {
    slot = TSlot {}
}

pub fn tslot_write_through_view(slot: TSlot<u256>) {
    slot.write(1)
}

pub fn readonly_store_set()
uses (store: Store)
{
    store.balances.set(key: 1, value: 2)
}

// The read form yields a place to read; the mutable form needs mutable raw
// storage authority.
pub fn raw_write_through_read_form() uses (storage: mut RawStorage) {
    unsafe { storage_at<u256>(0) = 1 }
}

pub fn raw_mut_form_with_read_authority() -> u256 uses (storage: RawStorage) {
    unsafe { storage_at_mut<u256>(0) }
}

// A collection's raw-slot constructors split the same way: `at` to read,
// `at_mut` to write.
pub fn raw_map_write_through_read_form() uses (storage: mut RawStorage) {
    unsafe { StorageMap<u256, u256>::at(0) }.set(key: 1, value: 2)
}

pub fn raw_map_mut_form_with_read_authority() -> u256 uses (storage: RawStorage) {
    unsafe { StorageMap<u256, u256>::at_mut(0).get(1) }
}
