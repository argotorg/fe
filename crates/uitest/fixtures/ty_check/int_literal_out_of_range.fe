fn annotated() -> u8 {
    let x: u8 = 300
    x
}

fn inferred(x: u16) -> u16 {
    x + 65536
}

fn pattern(x: u8) -> bool {
    match x {
        256 => true
        _ => false
    }
}

// `usize` and `isize` literals are checked against the compilation target
// (see `test_cli_check_usize_literals_fit_the_backend_target`).
fn in_range() -> (u8, i8, usize, isize) {
    (255, -128, 0xffffffff, -0x80000000)
}

// Literals in types, such as const arguments, are checked against the
// parameter's type.
struct Small<const N: u8> {}
struct Signed<const N: i8> {}

fn const_argument(_ s: Small<256>) {}

fn negated_const_argument(_ s: Signed<{ -129 }>) {}

fn types_in_range(_ a: [u8; 3], _ s: Small<255>, _ t: Signed<{ -128 }>) {}
