// With both traits in scope, `u8::SIZE` and `u8::Out` stay ambiguous.

mod one {
    pub trait One {
        const SIZE: usize
        type Out
    }

    impl One for u8 {
        const SIZE: usize = 1
        type Out = u16
    }
}

mod two {
    pub trait Two {
        const SIZE: usize
        type Out
    }

    impl Two for u8 {
        const SIZE: usize = 2
        type Out = u32
    }
}

use one::One
use two::Two

fn konst() -> usize {
    u8::SIZE
}

fn assoc_ty(_ x: u8::Out) {}

// A super-trait is in scope through its subtrait even when an associated type
// of the subtrait shadows its name, so `u8::N` stays ambiguous with `Rival`.
mod shadowed {
    pub trait Parent {
        const N: usize
    }

    impl Parent for u8 {
        const N: usize = 1
    }

    pub trait Child: Parent {
        type Parent
    }

    impl Child for u8 {
        type Parent = u8
    }

    pub trait WhereChild where Self: Parent {
        type Parent
    }

    impl WhereChild for u8 {
        type Parent = u8
    }
}

mod rival {
    pub trait Rival {
        const N: usize
    }

    impl Rival for u8 {
        const N: usize = 2
    }
}

mod uses_child {
    use super::shadowed::Child
    use super::rival::Rival

    fn n() -> usize { u8::N }
}

mod uses_where_child {
    use super::shadowed::WhereChild
    use super::rival::Rival

    fn n() -> usize { u8::N }
}
