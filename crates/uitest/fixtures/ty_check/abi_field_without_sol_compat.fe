use core::abi::{AbiDecoder, AbiFrame, AbiSize, AbiSpan, ByteInput, Decode, Encode}
use std::abi::Sol

// ABI-encodable, but without a Solidity type name.
pub struct Word {
    pub value: u256,
}

impl AbiSize for Word {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSpan<Sol> for Word {
    fn payload_end<I: ByteInput>(_ input: I, base: u256, pos: u256) -> u256 {
        pos + 32
    }
}

impl Decode<Sol> for Word {
    fn decode_payload<D: AbiDecoder<Sol>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
        Word { value: d.read_word(input) }
    }
}

impl Encode<Sol> for Word {
    fn encode(own self, _ out: AbiFrame) {
        out.store_word(at: 0, value: self.value)
    }
}

// Accepted: `Wrapper` has a codec, only no `SolCompat` impl.
#[abi]
pub struct Wrapper {
    pub word: Word,
}

// Event and error signatures need a Solidity type name for every field.
#[event]
struct Wrapped {
    wrapper: Wrapper,
}

#[event]
struct Direct {
    word: Word,
}

#[error]
struct Failed {
    wrapper: Wrapper,
}
