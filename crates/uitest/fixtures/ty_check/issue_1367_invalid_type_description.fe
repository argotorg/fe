trait Seq {
    type Item

    fn len(self) -> usize
    fn get(self, source: [u256; 8], i: usize) -> ref Self::Item
}

struct Slice {
    start: usize,
    len: usize,
}

impl Seq for Slice {
    type Item = u256

    fn len(self) -> usize {
        self.len
    }

    fn get(self, source: [u256; 8], i: usize) -> ref Item {
        source[self.start + I]
    }
}
