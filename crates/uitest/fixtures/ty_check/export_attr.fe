// A C caller calls an `#[unsafe(export)]` function by its name alone.
#[unsafe(export)]
pub fn exported(_ x: i64) -> i64 { x }

#[unsafe(export)]
fn private() {}

#[unsafe(export)]
pub fn generic<T>(_ x: own T) {}

#[unsafe(export)]
pub fn sized<const N: usize>() -> usize { N }

struct Counter { n: i64 }

#[unsafe(export)]
pub fn effects() -> i64 uses (counter: Counter) { counter.n }

#[unsafe(export(name))]
pub fn bad_form() {}

#[unsafe(export)]
#[unsafe(export)]
pub fn duplicate() {}

impl Counter {
    #[unsafe(export)]
    pub fn method(self) -> i64 { self.n }
}

trait Get {
    #[unsafe(export)]
    fn get(self) -> i64
}

extern {
    #[unsafe(export)]
    fn puts(_ s: *u8) -> i32
}

#[unsafe(export)]
struct Exported {}

#[unsafe(export)]
mod exported_mod {}

// Only exporting is unsafe, and exporting is always unsafe.
#[export]
pub fn not_marked_unsafe() {}

#[unsafe(inline)]
pub fn unsafe_inline() {}
