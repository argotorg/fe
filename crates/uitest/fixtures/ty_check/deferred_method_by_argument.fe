use core::MemSpan
use core::ops::Eq

struct Count {}

trait Get<T> {
    fn get(self, _ x: own T) -> u256
}

impl Get<u256> for Count {
    fn get(self, _ x: own u256) -> u256 {
        1
    }
}

impl Get<bool> for Count {
    fn get(self, _ x: own bool) -> u256 {
        2
    }
}

// The arguments leave one impl, so the call is typed where an operator
// needs it.
fn by_argument(_ c: Count) -> bool {
    c.get(true) == 2 && c.get(5) + 1 == 2
}

fn spans(_ s: MemSpan, _ t: MemSpan) -> bool {
    !s.eq(t)
}
