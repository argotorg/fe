pub trait Logger {
    fn log(self) -> u8
}

pub struct Console {}

impl Logger for Console {
    fn log(self) -> u8 {
        1
    }
}

pub struct Silent {}

pub fn needs_logger() -> u8
  uses (logger: Logger)
{
    logger.log()
}

pub fn missing_logger_impl() -> u8 {
    with (Logger = Silent {}) {
        needs_logger()
    }
}

// A key whose trait defaults a parameter to `Self` asks its provider for
// that parameter too.
pub trait Reads<T = Self> {
    fn read(self) -> u8
}

pub struct Other {}

impl Reads<u8> for Other {
    fn read(self) -> u8 {
        2
    }
}

pub fn needs_reader() -> u8
  uses (reader: Reads)
{
    reader.read()
}

pub fn reader_for_another_type() -> u8 {
    with (Reads = Other {}) {
        needs_reader()
    }
}
