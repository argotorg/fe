// A `let` whose pattern may not match needs an `else` block, and the block
// must diverge.
fn refutable(_ o: Option<u256>) -> u256 {
    let Option::Some(x) = o
    x
}

fn completes(_ o: Option<u256>) -> u256 {
    let Option::Some(x) = o else {}
    x
}

fn accepted(_ o: Option<u256>) -> u256 {
    let Option::Some(x) = o else {
        return 0
    }
    x
}

fn nested_scopes(_ o: Option<u256>) -> u256 {
    let Option::Some(x) = o else {
        if true { let y: u256 = 1 }
        while false {}
        for _ in 0..1 {}
        return 0
    }
    x
}
