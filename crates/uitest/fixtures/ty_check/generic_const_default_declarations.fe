fn ordinary() -> usize {
    return 1
}

const fn identity<const N: usize>() -> usize {
    return N
}

fn wrong_type<const N: usize = true>() {}

fn non_const<const N: usize = ordinary()>() {}

fn forward<const N: usize = M, const M: usize = 1>() {}

fn nested_forward<
    const N: usize = identity<M>(),
    const M: usize = 1,
>() {}

fn self_reference<const N: usize = N>() {}

fn nontrailing_fn<const N: usize = 1, const M: usize>() {}

struct NontrailingStruct<const N: usize = 1, const M: usize> {}

trait NontrailingTrait<const N: usize = 1, const M: usize> {}

struct ConstPair<const N: usize, const M: usize> {}

type NontrailingAlias<const N: usize = 1, const M: usize> = ConstPair<N, M>

const fn length<T>() -> usize { 2 }

trait Length {
    const LEN: usize
}

impl Length for u256 {
    const LEN: usize = 2
}

fn forward_type<const N: usize = length<T>(), T = u256>() {}

fn forward_associated<const N: usize = T::LEN, T: Length = u256>() {}

fn forward_qualified<const N: usize = <T as Length>::LEN, T: Length = u256>() {}

fn repeated_forward_type<const N: usize = { length<T>() + length<T>() }, T = u256>() {}

struct ForwardType<const N: usize = length<T>(), T = u256> {}

trait ForwardTypeTrait<const N: usize = length<T>(), T = u256> {}

type ForwardTypeAlias<const N: usize = length<T>(), T = u256> = [T; N]
