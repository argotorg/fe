use core::ptr
use std::evm::StorageKey
struct OldKey { value: u256 }

// Rejected: missing encoded_len and the obsolete write_key return type.
impl StorageKey for OldKey {
    unsafe fn write_key(ptr: *u8, self) -> u256 {
        unsafe { *ptr::cast<u8, u256>(ptr) = self.value }
        32
    }
}

struct SizedKey { value: u256 }

// Accepted: the encoded length is available before writing.
impl StorageKey for SizedKey {
    fn encoded_len(self) -> u256 { 32 }

    unsafe fn write_key(ptr: *u8, self) {
        unsafe { *ptr::cast<u8, u256>(ptr) = self.value }
    }
}
