use core::functional::{Fn, FnOnce}
use core::result::Result::{self, Ok}

struct Wrap {
    val: u256,
}

struct ToWrap {}
impl FnOnce<(u256,), Wrap> for ToWrap {
    fn call_once(self: own Self, _ args: own (u256,)) -> Wrap {
        self.call(args.0)
    }
}

impl Fn<(u256,), Wrap> for ToWrap {
    fn call(self, _ args: own (u256,)) -> Wrap {
        Wrap { val: args.0 }
    }
}

struct StillNeedsU256 {}
impl FnOnce<(u256,), u256> for StillNeedsU256 {
    fn call_once(self: own Self, _ args: own (u256,)) -> u256 {
        self.call(args.0)
    }
}

impl Fn<(u256,), u256> for StillNeedsU256 {
    fn call(self, _ args: own (u256,)) -> u256 {
        args.0
    }
}

fn pipeline() -> u256 {
    let r: Result<bool, u256> = Ok(42)
    r.map(ToWrap{}).map(StillNeedsU256{}).unwrap()
}
