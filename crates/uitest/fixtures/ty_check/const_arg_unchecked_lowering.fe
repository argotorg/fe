trait Need {}

struct NoImpl {}

struct Needy<T: Need> {}

impl<T: Need> Needy<T> {
    pub const N: usize = 4
}

struct Holder<const N: usize> {}

fn receiver_bound(_ h: Holder<{ Needy<NoImpl>::N }>) {}

const NARROW: u8 = 4

fn narrow_braced(_ h: Holder<{ NARROW }>) {}

fn narrow(_ h: Holder<NARROW>) {}

struct Bounded<const N: usize> where N > 0 {}

trait Wide {
    const K: u256
}

impl<const N: usize> Wide for Bounded<N> {
    const K: u256 = 4
}

fn where_clause(_ a: [u8; { Bounded<0>::K }]) {}

struct Cell { x: usize }

impl Cell {
    const fn get(mut self) -> mut usize { mut self.x }
}

fn copied_access(_ h: Holder<{
    var b = Cell { x: 1 }
    var y = b.get()
    y
}>) {}
