use core::abi::{Abi, AbiFrame, AbiSize, Encode}
use std::abi::SolCompat

fn runtime_name() -> String<3> {
    "bad"
}

struct Bad { word: u256 }

impl AbiSize for Bad {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl<A: Abi> Encode<A> for Bad {
    fn encode(own self, _ out: AbiFrame) {
        out.store_word(at: 0, value: self.word)
    }
}

impl SolCompat for Bad {
    type S = String<3>
    const SOL_TYPE: Self::S = runtime_name()
}

#[event]
struct Broken { value: Bad }
