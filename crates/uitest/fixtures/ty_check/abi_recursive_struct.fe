use std::abi::DynArray

// Finite runtime layout, but recursive ABI components: report once at the struct.
#[abi]
pub struct Node {
    pub children: DynArray<Node>,
}

struct Wrapped<T> { items: DynArray<T> }
#[abi]
struct Indirect { children: Wrapped<Indirect> }

#[abi]
struct Left { children: DynArray<Right> }
#[abi]
struct Right { children: DynArray<Left> }
