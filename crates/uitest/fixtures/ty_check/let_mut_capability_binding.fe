struct Foo {}

// Accepted: binding a view parameter copies a `Copy` value.
fn copy_ok(x: u256) {
    var y = x
    let _z = x
    y += 1
}

// Rejected: `var` binds an owned value, not an access.
fn mut_access_binding_bad(var x: own u256) {
    var h = mut x
    h = 1
}

// Accepted: binding an access binding copies its `Copy` referent.
fn copy_through_access_ok(var x: own u256) {
    let h = mut x
    var y = h
    y = 1
}

// Rejected: an access is not a tuple element.
fn nested_access_bad(var x: own u256) {
    let (h, _) = (mut x, 1)
}
