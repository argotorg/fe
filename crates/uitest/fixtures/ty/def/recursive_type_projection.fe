use core::{AddressSpace, EffectHandle, ptr}

pub trait Next {
    type Out
}

// Recursion through a projection grows if an impl wraps its input.
impl Next for u256 {
    type Out = Hidden<[u256; 1]>
}

impl<T> Next for [T; 1] {
    type Out = Hidden<[[T; 1]; 1]>
}

pub struct Hidden<T: Next> {
    value: T,
    next: *T::Out,
}

// Recursion through a projection may rebuild the impl's input.
pub struct Wrap<T> {
    value: T,
}

impl<T> Next for Wrap<T> {
    type Out = Same<Wrap<T>>
}

pub struct Same<T: Next> {
    next: *T::Out,
}

// A handle's target is a referent.
pub struct Link<T> {}

impl<T> EffectHandle for Link<T> {
    type Target = Node<[T; 1]>
    type Raw = *Node<[T; 1]>
    const SPACE: AddressSpace = AddressSpace::Memory

    fn raw(self) -> *Node<[T; 1]> {
        ptr::alloc<Node<[T; 1]>>()
    }
}

pub struct Node<T> {
    value: T,
    next: Link<T>,
}

// An impl can close a growing cycle through types it does not define.
pub struct Chain<T> {}

impl<T> EffectHandle for Chain<T> {
    type Target = Option<Chain<[T; 1]>>
    type Raw = *Option<Chain<[T; 1]>>
    const SPACE: AddressSpace = AddressSpace::Memory

    fn raw(self) -> *Option<Chain<[T; 1]>> {
        ptr::alloc<Option<Chain<[T; 1]>>>()
    }
}

// An impl may undo the growth of the cycle that reaches it.
pub trait Unwrap {
    type Out
}

impl<T> Unwrap for [T; 1] {
    type Out = Wrapped<T>
}

pub struct Unwrapping<U: Unwrap> {
    next: *U::Out,
}

pub struct Wrapped<T> {
    value: T,
    next: *Unwrapping<[T; 1]>,
}

// A projection may resolve to part of its input.
pub trait Second {
    type Out
}

impl<T> Second for (u8, T) {
    type Out = T
}

impl<S, T> Second for ([S; 1], T) {
    type Out = T
}

pub struct Carried<T>
where
    (T, Carried<[T; 1]>): Second,
{
    value: T,
    next: *<(T, Carried<[T; 1]>) as Second>::Out,
}
