pub enum Wrapper<T> {
    Value(T),
}

impl Wrapper {
    fn bad_ref<T>(ref self: Self<T>) {}

    fn bad_own<T>(own self: Self<T>) {}

    fn bad_mut_plain<T>(mut self: Self<T>) {}

    fn bad_var_own_bare(var self: own Self) {}

    fn bad_var_view<T>(var self: Self<T>) {}

    fn ok_var_own_self_generic<T>(var self: own Self<T>) {}

    fn ok_var_own_named<T>(var self: own Wrapper<T>) {}
}
