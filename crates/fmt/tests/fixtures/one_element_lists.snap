// A one-element tuple keeps its comma; a variant's one field takes none.
enum Wrapped {
    One(u256),
    Pair((u256,)),
}

fn singles(_ w: Wrapped, _ t: (u256,)) -> (u256,) {
    let (a,) = t
    match w {
        Wrapped::One(v) => (v,),
        Wrapped::Pair((v,)) => (a + v,),
    }
}
