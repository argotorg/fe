trait Collection {
    uses E
    fn at(self, _ c: u256) -> ref u256 uses E
}

impl Collection for Words {
    uses E = (storage: mut Self)
    fn at(self, _ c: u256) -> (u256, ref u256) uses E {
        self.get(c)
    }
}
