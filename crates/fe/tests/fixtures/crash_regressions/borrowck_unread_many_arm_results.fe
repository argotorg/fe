    let unused16 = identity(Many::V16.ordinal())
    let unused17 = identity(Many::V17.ordinal())
    let unused18 = identity(Many::V18.ordinal())
    let unused19 = identity(Many::V19.ordinal())
}

fn unread_cell() {
    var sink: usize = 0
    sink = Many::V0.ordinal()
    sink = Many::V1.ordinal()
    sink = Many::V2.ordinal()
    sink = Many::V3.ordinal()
    sink = Many::V4.ordinal()
    sink = Many::V5.ordinal()
