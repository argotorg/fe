    var sum: usize = 0
    if constant_boolean_branch(Many::V0.ordinal()) { sum += 1 }
    if constant_boolean_branch(Many::V1.ordinal()) { sum += 1 }
    if constant_boolean_branch(Many::V2.ordinal()) { sum += 1 }
