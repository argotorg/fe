    sink = Many::V16.ordinal()
    sink = Many::V17.ordinal()
    sink = Many::V18.ordinal()
    sink = Many::V19.ordinal()
}

fn narrowed_selectors(_ arr: [u64; 256]) -> u64 {
    var total: u64 = 0
    let s0: u8 = Many::V0.ordinal().downcast_truncate()
    total += arr[s0 as usize]
    let s1: u8 = Many::V1.ordinal().downcast_truncate()
    total += arr[s1 as usize]
    let s2: u8 = Many::V2.ordinal().downcast_truncate()
    total += arr[s2 as usize]
    let s3: u8 = Many::V3.ordinal().downcast_truncate()
    total += arr[s3 as usize]
    let s4: u8 = Many::V4.ordinal().downcast_truncate()
    total += arr[s4 as usize]
    let s5: u8 = Many::V5.ordinal().downcast_truncate()
    total += arr[s5 as usize]
    let s6: u8 = Many::V6.ordinal().downcast_truncate()
    total += arr[s6 as usize]
    let s7: u8 = Many::V7.ordinal().downcast_truncate()
    total += arr[s7 as usize]
    let s8: u8 = Many::V8.ordinal().downcast_truncate()
    total += arr[s8 as usize]
    let s9: u8 = Many::V9.ordinal().downcast_truncate()
    total += arr[s9 as usize]
    let s10: u8 = Many::V10.ordinal().downcast_truncate()
    total += arr[s10 as usize]
    let s11: u8 = Many::V11.ordinal().downcast_truncate()
    total += arr[s11 as usize]
    let s12: u8 = Many::V12.ordinal().downcast_truncate()
    total += arr[s12 as usize]
    let s13: u8 = Many::V13.ordinal().downcast_truncate()
    total += arr[s13 as usize]
    let s14: u8 = Many::V14.ordinal().downcast_truncate()
    total += arr[s14 as usize]
    let s15: u8 = Many::V15.ordinal().downcast_truncate()
    total += arr[s15 as usize]
    let s16: u8 = Many::V16.ordinal().downcast_truncate()
    total += arr[s16 as usize]
    let s17: u8 = Many::V17.ordinal().downcast_truncate()
    total += arr[s17 as usize]
    let s18: u8 = Many::V18.ordinal().downcast_truncate()
    total += arr[s18 as usize]
    let s19: u8 = Many::V19.ordinal().downcast_truncate()
    total += arr[s19 as usize]
    total
}

fn stores_after_read(_ arr: [u64; 32]) -> u64 {
    var cell: usize = 0
    let seen = arr[cell]
    cell = Many::V0.ordinal()
    cell = Many::V1.ordinal()
    cell = Many::V2.ordinal()
    cell = Many::V3.ordinal()
    cell = Many::V4.ordinal()
    cell = Many::V5.ordinal()
    cell = Many::V6.ordinal()
    cell = Many::V7.ordinal()
    cell = Many::V8.ordinal()
    cell = Many::V9.ordinal()
    cell = Many::V10.ordinal()
    cell = Many::V11.ordinal()
    cell = Many::V12.ordinal()
    cell = Many::V13.ordinal()
    cell = Many::V14.ordinal()
    cell = Many::V15.ordinal()
    cell = Many::V16.ordinal()
    cell = Many::V17.ordinal()
    cell = Many::V18.ordinal()
    cell = Many::V19.ordinal()
    seen
}

fn aggregate_return() -> [usize; 20] {
    [Many::V0.ordinal(), Many::V1.ordinal(), Many::V2.ordinal(), Many::V3.ordinal(), Many::V4.ordinal(), Many::V5.ordinal(), Many::V6.ordinal(), Many::V7.ordinal(), Many::V8.ordinal(), Many::V9.ordinal(), Many::V10.ordinal(), Many::V11.ordinal(), Many::V12.ordinal(), Many::V13.ordinal(), Many::V14.ordinal(), Many::V15.ordinal(), Many::V16.ordinal(), Many::V17.ordinal(), Many::V18.ordinal(), Many::V19.ordinal()]
}

// A branch selecting a discarded result must not keep its input facts live.
fn choose_branch(_ index: usize) -> usize { if index == 0 { 0 } else { 1 } }
fn dead_integer_branch_results() {
    let unused0 = choose_branch(Many::V0.ordinal())
    let unused1 = choose_branch(Many::V1.ordinal())
    let unused2 = choose_branch(Many::V2.ordinal())
    let unused3 = choose_branch(Many::V3.ordinal())
    let unused4 = choose_branch(Many::V4.ordinal())
    let unused5 = choose_branch(Many::V5.ordinal())
    let unused6 = choose_branch(Many::V6.ordinal())
    let unused7 = choose_branch(Many::V7.ordinal())
    let unused8 = choose_branch(Many::V8.ordinal())
    let unused9 = choose_branch(Many::V9.ordinal())
    let unused10 = choose_branch(Many::V10.ordinal())
    let unused11 = choose_branch(Many::V11.ordinal())
    let unused12 = choose_branch(Many::V12.ordinal())
    let unused13 = choose_branch(Many::V13.ordinal())
    let unused14 = choose_branch(Many::V14.ordinal())
    let unused15 = choose_branch(Many::V15.ordinal())
    let unused16 = choose_branch(Many::V16.ordinal())
    let unused17 = choose_branch(Many::V17.ordinal())
    let unused18 = choose_branch(Many::V18.ordinal())
    let unused19 = choose_branch(Many::V19.ordinal())
}
// Observing a constant result as an index does not observe its branch input.
fn constant_branch(_ index: usize) -> usize { if index == 0 { 0 } else { 0 } }
fn used_constant_branch_results(_ arr: [u64; 1]) -> u64 {
    var sum: u64 = 0
    sum += arr[constant_branch(Many::V0.ordinal())]
    sum += arr[constant_branch(Many::V1.ordinal())]
    sum += arr[constant_branch(Many::V2.ordinal())]
    sum += arr[constant_branch(Many::V3.ordinal())]
    sum += arr[constant_branch(Many::V4.ordinal())]
    sum += arr[constant_branch(Many::V5.ordinal())]
    sum += arr[constant_branch(Many::V6.ordinal())]
    sum += arr[constant_branch(Many::V7.ordinal())]
    sum += arr[constant_branch(Many::V8.ordinal())]
    sum += arr[constant_branch(Many::V9.ordinal())]
    sum += arr[constant_branch(Many::V10.ordinal())]
    sum += arr[constant_branch(Many::V11.ordinal())]
    sum += arr[constant_branch(Many::V12.ordinal())]
    sum += arr[constant_branch(Many::V13.ordinal())]
    sum += arr[constant_branch(Many::V14.ordinal())]
    sum += arr[constant_branch(Many::V15.ordinal())]
    sum += arr[constant_branch(Many::V16.ordinal())]
    sum += arr[constant_branch(Many::V17.ordinal())]
    sum += arr[constant_branch(Many::V18.ordinal())]
    sum += arr[constant_branch(Many::V19.ordinal())]
    sum
}

// Boolean result relations must be projected before repeated calls multiply them.
fn integer_predicate(_ index: usize) -> bool { index == 0 }
fn boolean_branch(_ index: usize) -> bool { if index == 0 { true } else { false } }
fn constant_boolean_branch(_ index: usize) -> bool { if index == 0 { true } else { true } }
fn dead_boolean_predicate_results() {
    let unused0 = integer_predicate(Many::V0.ordinal())
