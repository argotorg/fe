    if constant_boolean_branch(Many::V19.ordinal()) { sum += 1 }
    sum
}

// Binding a live wrapper's arguments must leave dead predicate results unread.
fn pass_boolean(_ flag: bool) -> bool { flag }
fn constant_boolean(_ flag: bool) -> bool { true }
fn dead_boolean_argument_predicates(k: usize) {
    let unused0 = pass_boolean(pass_boolean(Many::V0.ordinal() == k))
    let unused1 = pass_boolean(pass_boolean(Many::V1.ordinal() == k))
