// A loop calls a dispatcher that touches independent optional allocations.
// Keeping the call's branch choices after every observed aggregate field made
// the caller's availability requirements grow exponentially with field count.
// This many fields can reach the separation budget; it must still terminate.
use core::MemBuffer

struct Frame {
    b0: MemBuffer,
    b1: MemBuffer,
    b2: MemBuffer,
    b3: MemBuffer,
    b4: MemBuffer,
    b5: MemBuffer,
    b6: MemBuffer,
    b7: MemBuffer,
    b8: MemBuffer,
    b9: MemBuffer,
    b10: MemBuffer,
    b11: MemBuffer,
    b12: MemBuffer,
    b13: MemBuffer,
    b14: MemBuffer,
    b15: MemBuffer,
    pc: usize,
}

impl Frame {
    fn dispatch(mut self, op: u8, input: MemBuffer) {
        if op == 0 {
            self.b0[0] = input[0]
        } else if op == 1 {
            self.b1[0] = input[1]
        } else if op == 2 {
            self.b2[0] = input[2]
        } else if op == 3 {
            self.b3[0] = input[3]
        } else if op == 4 {
            self.b4[0] = input[4]
        } else if op == 5 {
            self.b5[0] = input[5]
        } else if op == 6 {
            self.b6[0] = input[6]
        } else if op == 7 {
            self.b7[0] = input[7]
        } else if op == 8 {
            self.b8[0] = input[8]
        } else if op == 9 {
            self.b9[0] = input[9]
        } else if op == 10 {
            self.b10[0] = input[10]
        } else if op == 11 {
            self.b11[0] = input[11]
        } else if op == 12 {
            self.b12[0] = input[12]
        } else if op == 13 {
            self.b13[0] = input[13]
        } else if op == 14 {
            self.b14[0] = input[14]
        } else if op == 15 {
            self.b15[0] = input[15]
        }
    }

    fn run(mut self, code: MemBuffer, input: MemBuffer) {
        while self.pc < code.len() {
            let op = code[self.pc]
            self.pc += 1
            self.dispatch(op, input)
        }
    }
}

fn caller(frame: mut Frame, code: MemBuffer, input: MemBuffer) {
    frame.run(code, input)
}
