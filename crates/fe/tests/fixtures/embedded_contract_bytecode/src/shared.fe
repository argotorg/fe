// Called by both `Child` and `Factory`. When both contracts were optimized in
// one Sonatina module, `Factory`'s call changed how `Child` was compiled, so
// the `Child` code embedded in `Factory` differed from `Child.bin`.
pub fn mix(_ a: u256, _ b: u256) -> u256 {
    var acc: u256 = a
    var i: u256 = 0
    while i < b {
        acc = (acc * 31 + i) ^ (acc >> 3)
        i += 1
    }
    acc
}
