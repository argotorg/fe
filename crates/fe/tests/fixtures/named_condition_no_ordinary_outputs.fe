trait Marker {}
trait Foo {
    type Out
    fn make() -> Self::Out
}
impl<T: Marker> Foo for T {
    type Out = u256
    fn make() -> u256 { 1 }
}
struct S {}
impl Marker for S as FakeMarker {}

fn gen<T: Marker>() -> <T as Foo>::Out { <T as Foo>::make() }
fn gen2<T: Marker>() -> u256 {
    let x: <T as Foo>::Out = <T as Foo>::make()
    x
}
fn boom() -> u256 { with (FakeMarker) { gen2<S>() } }
#[test]
fn t() { assert(boom() == 1) }
