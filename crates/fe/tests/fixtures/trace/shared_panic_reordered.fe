// Reverse the three requests to the shared Panic(0x11) helper.
msg SharedPanicMsg {
    #[selector = 0x01]
    Go { a: u32, b: u32, c: u32 } -> u32,
}

struct SharedPanicStore {}

pub contract SharedPanic {
    store: SharedPanicStore

    recv SharedPanicMsg {
        Go { a, b, c } -> u32 {
            let z: u32 = a + c
            let y: u32 = b + c
            let x: u32 = a + b
            return x
        }
    }
}
