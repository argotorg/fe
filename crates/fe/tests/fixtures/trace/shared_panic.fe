// Three checked additions on distinct lines share one compiler-generated
// panic block. The block belongs to no single statement, so no bytecode of
// it may be attributed to one of them.
msg SharedPanicMsg {
    #[selector = 0x01]
    Go { a: u32, b: u32, c: u32 } -> u32,
}

struct SharedPanicStore {}

pub contract SharedPanic {
    store: SharedPanicStore

    recv SharedPanicMsg {
        Go { a, b, c } -> u32 {
            let x: u32 = a + b
            let y: u32 = b + c
            let z: u32 = a + c
            return x
        }
    }
}
