#[unsafe(export)]
pub fn and32(a: u32, b: u32) -> u32 {
    a & b
}

#[unsafe(export)]
pub fn or32(a: u32, b: u32) -> u32 {
    a | b
}

#[unsafe(export)]
pub fn xor32(a: u32, b: u32) -> u32 {
    a ^ b
}

#[unsafe(export)]
pub fn not32(a: u32) -> u32 {
    !a
}

#[unsafe(export)]
pub fn xor64(a: u64, b: u64) -> u64 {
    a ^ b
}

#[unsafe(export)]
pub fn not64(a: u64) -> u64 {
    !a
}

#[unsafe(export)]
pub fn andnot_i32(a: i32, b: i32) -> i32 {
    a & !b
}
