// A small stack machine. The program is a constant table of (opcode, operand)
// pairs; the stack is a local array, so stack overflow and underflow are
// out-of-bounds accesses.
const PROGRAM: [[u8; 2]; 10] = [
    [1, 7],   // push 7
    [2, 0],   // push the input
    [3, 0],   // add
    [1, 3],   // push 3
    [4, 0],   // mul
    [5, 0],   // dup
    [3, 0],   // add
    [1, 100], // push 100
    [6, 0],   // sub
    [0, 0],   // halt
]

pub fn run(input: i32, steps: u32) -> i32 {
    var stack: [i32; 8] = [0; 8]
    var sp: usize = 0
    var pc: usize = 0
    var executed: u32 = 0
    while executed < steps {
        let op = PROGRAM[pc][0]
        let arg = PROGRAM[pc][1] as i32
        pc += 1
        executed += 1
        if op == 0 {
            break
        } else if op == 1 {
            stack[sp] = arg
            sp += 1
        } else if op == 2 {
            stack[sp] = input
            sp += 1
        } else if op == 3 {
            sp -= 1
            stack[sp - 1] = stack[sp - 1] + stack[sp]
        } else if op == 4 {
            sp -= 1
            stack[sp - 1] = stack[sp - 1] * stack[sp]
        } else if op == 5 {
            stack[sp] = stack[sp - 1]
            sp += 1
        } else {
            sp -= 1
            stack[sp - 1] = stack[sp - 1] - stack[sp]
        }
    }
    stack[sp - 1]
}
