use core::ops::{WrappingAdd, WrappingMul, WrappingSub}

// Frames of a few hundred bytes to a few kilobytes: copies of arrays larger
// than the inline copy limit, and a frame per recursive call.
fn checksum(a: [u32; 64]) -> u32 {
    var s: u32 = 0
    var i: usize = 0
    while i < 64 {
        s = s.wrapping_mul(3).wrapping_add(a[i])
        i += 1
    }
    s
}

fn filled(seed: u32) -> [u32; 64] {
    var a: [u32; 64] = [0; 64]
    var i: usize = 0
    while i < 64 {
        let k: u32 = i.downcast_unchecked()
        a[i] = seed + k
        i += 1
    }
    a
}

pub fn big_copy(seed: u32) -> u32 {
    let a = filled(seed: seed)
    var b = a
    b[10] = 0
    checksum(a: a).wrapping_sub(checksum(a: b))
}

fn deeper(n: u32, a: [u32; 64]) -> u32 {
    if n == 0 {
        return a[63]
    }
    var b = a
    b[63] = a[63] + 1
    deeper(n: n - 1, a: b)
}

pub fn recurse(n: u32) -> u32 {
    deeper(n: n, a: filled(seed: 1))
}

pub fn bytes_hash(seed: u8) -> u32 {
    var buf: [u8; 512] = [0; 512]
    var i: usize = 0
    while i < 512 {
        let k: u8 = i.downcast_truncate()
        buf[i] = k ^ seed
        i += 1
    }
    var h: u32 = 2166136261
    for b in buf {
        h = (h ^ (b as u32)).wrapping_mul(16777619)
    }
    h
}
