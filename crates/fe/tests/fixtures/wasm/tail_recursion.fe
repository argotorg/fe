// A function of a recursive cycle that ends in a call makes a tail call,
// whose frame replaces its own, so these run in constant stack.
fn count(n: u64, acc: u64) -> u64 {
    if n == 0 {
        return acc
    }
    count(n: n - 1, acc: acc + n)
}

pub fn sum_to(n: u64) -> u64 {
    count(n: n, acc: 0)
}

fn is_even(n: u32) -> bool {
    if n == 0 {
        return true
    }
    is_odd(n: n - 1)
}

fn is_odd(n: u32) -> bool {
    if n == 0 {
        return false
    }
    is_even(n: n - 1)
}

pub fn even(n: u32) -> bool {
    is_even(n: n)
}
