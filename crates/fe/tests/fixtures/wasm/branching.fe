#[unsafe(export)]
pub fn sign(x: i32) -> i32 {
    if x < 0 {
        -1
    } else if x == 0 {
        0
    } else {
        1
    }
}

#[unsafe(export)]
pub fn clamp(x: i32, lo: i32, hi: i32) -> i32 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    x
}

#[unsafe(export)]
pub fn abs(x: i32) -> i32 {
    if x < 0 { -x } else { x }
}

#[unsafe(export)]
pub fn classify(x: u32) -> u32 {
    if x < 10 {
        1
    } else if x < 100 {
        2
    } else if x < 1000 {
        3
    } else {
        4
    }
}
