            Result::Err(_) => {}
        }
//mock:     }
}

// Text alone: no host call.
#[unsafe(export)]
pub fn text_len(name: HostText) -> Reply {
    Reply::ok(name.len())
}

#[unsafe(export)]
pub fn text_byte(name: HostText, index: u32) -> Reply {
    let copy = name.copy()
    if index as usize >= copy.len() {
        return Reply::error(2)
    }
    Reply::ok(copy.byte_at(index as usize) as u32)
}

// Numbers on both sides of a text.
#[unsafe(export)]
pub fn mixed(a: u32, name: HostText, b: u64) -> Reply {
    Reply::ok(a + name.len() + b.downcast_truncate())
}

#[unsafe(export)]
pub fn plain(a: u32, b: u32) -> u32 {
    a + b
}

