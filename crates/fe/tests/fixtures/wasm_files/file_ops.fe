// Operations of the files contract (std::wasm::files), exported with text
// parameters and a reply result. Lines that start with `//host:` belong to the
// build that calls the imports of the host; lines that start with `//mock:`
// belong to the build with files held in Fe, which has no imports.
use core::ptr::MemArray
use std::wasm::{HostText, Reply}
use std::wasm::files::{Files, close, open, read, read_byte, reply, size}

//mock: use std::wasm::files::{MemFiles, mock}
//mock: fn provider() -> MemFiles {
//mock:     var files = mock()
//mock:     files.add("hello.txt", "Hello, world")
//mock:     files.add("digits", "0123456789")
//mock:     files.add("empty", "")
//mock:     files.add("grüß", "grüß")
//mock:     files
//mock: }

fn byte_at_impl(_ name: HostText, _ index: u32) -> Reply uses (files: mut Files) {
    match open(name.copy()) {
        Result::Ok(handle) => {
            let byte = read_byte(handle, index)
            close(handle)
            match byte {
                Result::Ok(b) => Reply::ok(b as u32)
                Result::Err(e) => Reply::error(e.code())
            }
        }
        Result::Err(e) => Reply::error(e.code())
    }
}

fn size_of_impl(_ name: HostText) -> Reply uses (files: mut Files) {
    match open(name.copy()) {
        Result::Ok(handle) => {
            let n = size(handle)
            close(handle)
            reply(n)
        }
        Result::Err(e) => Reply::error(e.code())
    }
}

// A `FileError` has no Sol encoding, and `unwrap` traps on it.
fn size_unwrapped_impl(_ name: HostText) -> Reply uses (files: mut Files) {
    let handle = open(name.copy()).unwrap()
    let n = size(handle).unwrap()
    close(handle)
    Reply::ok(n)
}

fn checksum_impl(_ name: HostText) -> Reply uses (files: mut Files) {
    match open(name.copy()) {
        Result::Ok(handle) => {
            let total = match size(handle) {
                Result::Ok(n) => {
                    var sum: u32 = 0
                    var i: u32 = 0
                    while i < n {
                        match read_byte(handle, i) {
                            Result::Ok(b) => { sum += b as u32 }
                            Result::Err(_) => { core::panic() }
                        }
                        i += 1
                    }
                    Reply::ok(sum)
                }
                Result::Err(e) => Reply::error(e.code())
            }
            close(handle)
            total
        }
        Result::Err(e) => Reply::error(e.code())
    }
}

// The sum of the bytes of a file, read `chunk` bytes at a time.
fn read_sum_impl(_ name: HostText, _ chunk: u32) -> Reply uses (files: mut Files) {
    match open(name.copy()) {
        Result::Ok(handle) => {
            var buf: MemArray<u8> = MemArray::new_zeroed(chunk as usize)
            var sum: u32 = 0
            var offset: u32 = 0
            var failure: u32 = 0
            var reading = true
            while reading {
                match read(handle, offset, mut buf.as_slice()) {
                    Result::Ok(count) => {
                        var i: usize = 0
                        while i < count as usize {
                            sum += buf[i] as u32
                            i += 1
                        }
                        offset += count
                        reading = count > 0
                    }
                    Result::Err(e) => {
                        failure = e.code()
                        reading = false
                    }
                }
            }
            close(handle)
            if failure == 0 { Reply::ok(sum) } else { Reply::error(failure) }
        }
        Result::Err(e) => Reply::error(e.code())
    }
}

fn open_n_impl(_ name: HostText, _ n: u32) -> Reply uses (files: mut Files) {
    var i: u32 = 0
    while i < n {
        match open(name.copy()) {
            Result::Ok(handle) => { close(handle) }
            Result::Err(e) => { return Reply::error(e.code()) }
        }
        i += 1
    }
    Reply::ok(n)
}

// Two handles are live at once and are closed in the opposite order.
fn sizes_two_impl(_ first: HostText, _ second: HostText) -> Reply uses (files: mut Files) {
    let a = match open(first.copy()) {
        Result::Ok(handle) => handle
        Result::Err(e) => { return Reply::error(e.code()) }
    }
    let b = match open(second.copy()) {
        Result::Ok(handle) => handle
        Result::Err(e) => {
            close(a)
            return Reply::error(e.code())
        }
    }
    let total = match size(a) {
        Result::Ok(x) => match size(b) {
            Result::Ok(y) => Reply::ok(x + y)
            Result::Err(e) => Reply::error(e.code())
        }
        Result::Err(e) => Reply::error(e.code())
    }
    close(b)
    close(a)
    total
}

// Opens a file and does not close it. The compiler does not report the leak;
// the host counts it.
fn leak_impl(_ name: HostText) -> Reply uses (files: mut Files) {
    match open(name.copy()) {
        Result::Ok(handle) => Reply::ok(0)
        Result::Err(e) => Reply::error(e.code())
    }
}

