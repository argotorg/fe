use core::derive::DeriveInherent
use core::meta::{Code, Item, Record}
const fn helper() -> u256 { 1 }
struct P {}
impl DeriveInherent for P {
    const fn derive(_ r: Record) -> Code<Item> {
        let a: Code<Item> = quote {
            const fn helper() -> u256 { 41 }
            const fn bump() -> u256 { helper() + 1 }
        }
        quote(bump) { pub const fn run() -> u256 { ${a}
            bump() } }
    }
}
struct S {}
impl S with (P)
#[test]
fn t() { assert(S::run() == 42) }
