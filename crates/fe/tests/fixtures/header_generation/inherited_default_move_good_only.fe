trait Make {
    const fn make() -> Self
}
impl Make for u256 {
    const fn make() -> Self { 1 }
}

trait T {
    type X: Make
    const PAIR: (Self::X, Self::X) = {
        let v = <Self::X as Make>::make()
        (v, v)
    }
}

struct Good {}
impl T for Good {
    type X = u256
}

#[test]
fn pair_works_for_copy() {
    let p = <Good as T>::PAIR
    assert(p.0 == 1 && p.1 == 1)
}
