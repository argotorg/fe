use core::abi::{AbiDecoder, AbiSize, ByteInput, Decode, store_word}
use core::ptr
use std::abi::Sol

/// A type whose `Decode<Sol>` implementation, written here, has an `unsafe`
/// block.
pub struct WI { pub v: u256 }
impl AbiSize for WI {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}
impl Decode<Sol> for WI {
    fn decode_payload<D: AbiDecoder<Sol>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
        let p = ptr::alloc_bytes(32)
        unsafe { store_word(ptr: p, value: 7) }
        WI { v: 0 }
    }
}
