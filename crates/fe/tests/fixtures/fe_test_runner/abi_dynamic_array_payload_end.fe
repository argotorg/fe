use core::ptr
use std::abi::sol::decode_input
use std::evm::RawMem

#[test]
fn test_dynamic_array_payload_end_uses_max_element_end() uses (raw: mut RawMem) {
    // bytes[] payload:
    //   len = 2
    //   offset0 = 64, offset1 = 96
    //   element0 len = 96, element1 len = 0
    //
    // The offsets are monotonic, but element0 extends past element1.
    let ptr = ptr::alloc_bytes(224)
    raw.mstore(addr: ptr, value: 2)
    raw.mstore(addr: ptr::offset_bytes(ptr, 32), value: 64)
    raw.mstore(addr: ptr::offset_bytes(ptr, 64), value: 96)
    raw.mstore(addr: ptr::offset_bytes(ptr, 96), value: 96)
    raw.mstore(addr: ptr::offset_bytes(ptr, 128), value: 0)
    raw.mstore(addr: ptr::offset_bytes(ptr, 160), value: 0)
    raw.mstore(addr: ptr::offset_bytes(ptr, 192), value: 0)

    let input = ptr::MemSpan::from_raw_parts(ptr, len: 224)
    let decoded: Vec<Bytes> = decode_input(input)

    assert!(decoded.len() == 2)
    assert!(decoded.encoded_size() == 224)
}
