use core::ptr
use core::abi::store_word
use std::abi::sol::decode_input

#[test]
fn test_dynamic_array_payload_end_uses_max_element_end() {
    // bytes[] payload:
    //   len = 2
    //   offset0 = 64, offset1 = 96
    //   element0 len = 96, element1 len = 0
    //
    // The offsets are monotonic, but element0 extends past element1.
    let ptr = ptr::alloc_bytes(224)
    unsafe { store_word(ptr: ptr, value: 2) }
    unsafe { store_word(ptr: ptr::offset_bytes(ptr, 32), value: 64) }
    unsafe { store_word(ptr: ptr::offset_bytes(ptr, 64), value: 96) }
    unsafe { store_word(ptr: ptr::offset_bytes(ptr, 96), value: 96) }
    unsafe { store_word(ptr: ptr::offset_bytes(ptr, 128), value: 0) }
    unsafe { store_word(ptr: ptr::offset_bytes(ptr, 160), value: 0) }
    unsafe { store_word(ptr: ptr::offset_bytes(ptr, 192), value: 0) }

    let input = unsafe { ptr::MemSpan::from_raw_parts(ptr, len: 224) }
    let decoded: Vec<Bytes> = decode_input(input)

    assert!(decoded.len() == 2)
    assert!(decoded.encoded_size() == 224)
}
