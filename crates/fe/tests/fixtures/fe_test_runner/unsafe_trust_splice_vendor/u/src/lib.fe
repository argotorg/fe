use core::derive::{Derive, DeriveInherent}
use core::meta::{Code, Expr, Item, Record}
use core::abi::{load_word, store_word}
use core::ptr

/// An expression fragment with an `unsafe` block that `u` wrote.
pub const fn frag() -> Code<Expr> {
    quote {
        {
            let p = ptr::alloc_bytes(32)
            unsafe {
                store_word(ptr: p, value: 7)
                load_word(p)
            }
        }
    }
}

/// The same code as an ordinary function of `u`.
pub fn raw() -> u256 {
    let p = ptr::alloc_bytes(32)
    unsafe {
        store_word(ptr: p, value: 7)
        load_word(p)
    }
}

/// A provider of `u` that splices `u`'s own fragment.
pub struct OwnGen {}

impl DeriveInherent for OwnGen {
    const fn derive(_ record: Record) -> Code<Item> {
        let e: Code<Expr> = frag()
        quote { pub fn spliced(self) -> u256 { ${e} } }
    }
}

/// A provider of `u` that splices a fragment that `t2` wrote.
pub struct SplicesT {}

impl DeriveInherent for SplicesT {
    const fn derive(_ record: Record) -> Code<Item> {
        let e: Code<Expr> = t2::frag()
        quote { pub fn spliced(self) -> u256 { ${e} } }
    }
}

/// A provider of `u` that splices a member that `t2` wrote, so `u` placed it.
pub struct SplicesItem {}

impl DeriveInherent for SplicesItem {
    const fn derive(_ record: Record) -> Code<Item> {
        let inner: Code<Item> = t2::item()
        quote { ${inner} }
    }
}
