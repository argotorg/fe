use core::abi::{Abi, AbiDecoder, AbiFrame, AbiSize, ByteInput, Decode, Encode, load_word, store_word}
use core::ptr
use std::abi::{AbiFields, Part, PartHead, Sol}

/// A message field that is read where it lies, by a `Part` implementation
/// with an `unsafe` block.
pub struct R { pub v: u256 }
impl AbiSize for R {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}
impl Encode<Sol> for R {
    fn encode(self, _ out: AbiFrame) {
        let Self { v } = self
        v.encode(out)
    }
}
impl Decode<Sol> for R {
    fn decode_payload<D: AbiDecoder<Sol>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
        let v = u256::decode_payload(mut d, input)
        Self { v }
    }
}
impl AbiFields for R {}
impl<I: ByteInput + Copy, A: Abi> Part<I, A> for R {
    type Of = u256

    fn read(_ part: PartHead<I, R>) -> u256 {
        let p = ptr::alloc_bytes(32)
        unsafe {
            store_word(ptr: p, value: part.extent().input().word_at(part.head()))
            load_word(p)
        }
    }
}
