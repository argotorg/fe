// `v`, which nothing trusts, wrote an `unsafe impl Pod` for its own type that
// the trusted `t` relies on through the bound of `peek`. It has no function
// for a call to reach, so it is refused at the call that relies on it.
use t::peek
use v::VType

#[test]
fn peeks_at_a_type_of_v() {
    assert(peek(VType {}) == 7)
}
