use super::{Alt}
use core::abi::{Abi, AbiDecoder, ByteInput, Decode, Encode, AbiFrame}
use core::message::MsgVariant
use std::abi::Sol
use std::evm::{Evm, Call}
use core::ptr
use core::abi::store_word

msg M {
    #[selector = 0x11111111]
    Ping { x: u256 } -> u256,
}

// `Ping` is encoded for the second ABI too, so that an implementation of
// `MsgVariant<Alt>` can be given to it.
impl Encode<Alt> for M::Ping { fn encode(self, _ out: AbiFrame) {} }
impl Decode<Alt> for M::Ping {
    fn decode_payload<D: AbiDecoder<Alt>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
        M::Ping { x: 0 }
    }
}

// A message type that no `msg` block and nothing written makes a message:
// its implementation of `MsgVariant<Sol>` is generated (see `lib.fe`).
#[abi]
pub struct Plain { pub x: u256 }

pub contract C {
    recv M {
        Ping { x } -> u256 { x + 1 }
    }

    recv {
        Plain { x } -> u256 { x + 3 }
    }
}

fn raw(_ sel: u256, _ salt: u256) -> bool uses (evm: mut Evm) {
    let c = evm.create2<C>(value: Wei::zero(), args: (), salt: salt)
    let p = ptr::alloc_bytes(64)
    unsafe { store_word(ptr: p, value: sel << 224) }
    unsafe { store_word(ptr: ptr::offset_bytes(p, 4), value: 5) }
    var ret = ptr::MemBuffer::empty()
    let outcome = unsafe {
        evm.raw_call(addr: c, gas: 1000000, value: Wei::zero(), args: ptr::MemSpan::from_raw_parts(ptr: p, len: 36), ret: mut ret)
    }
    outcome.success()
}

#[test]
fn the_generated_implementation_for_another_abi_can_be_read() {
    assert(<M::Ping as MsgVariant<Alt>>::SELECTOR == 0x22222222)
    assert(<M::Ping as MsgVariant<Sol>>::SELECTOR == 0x11111111)
}

#[test]
fn the_written_selector_of_the_blocks_abi_still_reaches_the_arm() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: Wei::zero(), args: (), salt: 0)
    let r: u256 = evm.call(addr: c, gas: 1000000, value: Wei::zero(), message: M::Ping { x: 5 })
    assert(r == 6)
    assert(raw(0x11111111, 1))
}

#[test]
fn the_selector_of_the_generated_implementation_for_another_abi_reaches_no_arm() uses (evm: mut Evm) {
    assert(!raw(0x22222222, 2))
}

#[test]
fn the_generated_implementation_of_the_blocks_abi_serves_the_arm_that_names_it() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: Wei::zero(), args: (), salt: 3)
    let r: u256 = evm.call(addr: c, gas: 1000000, value: Wei::zero(), message: Plain { x: 5 })
    assert(r == 8)
    assert(raw(0x44444444, 4))
}
