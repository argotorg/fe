// Tests that pass next to tests that the WebAssembly backend cannot build. Each
// of those fails with a message that names the reason.
use std::evm::ops::byte

// The host provides a `() -> i64` clock under this name, which the declared
// signature would match once its zero-sized parameter is erased.
extern {
    fn sys_wasm_now_ms(_ unit: ()) -> u64
}

#[test]
fn builds_and_passes() {
    let two: u32 = 1 + 1
    assert(two == 2)
}

#[test]
fn lowers_an_evm_builtin() {
    assert(byte(pos: 31, value: 0x1234) == 0x34)
}

#[test(balance = 5)]
fn needs_an_evm_balance() {
    let five: u32 = 5
    assert(five == 5)
}

#[test]
fn imports_a_zero_sized_parameter() {
    let _ = unsafe { sys_wasm_now_ms(()) }
}
