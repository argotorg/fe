// The choice of the contract's module needs `u256: Gate`, which nothing
// satisfies: `fe check` and `fe build` both refuse the entry code of the
// contract at the arm.
use core::abi::{AbiDecoder, AbiFrame, AbiSize, ByteInput, Decode, Encode}
use core::message::MsgVariant
use std::abi::Sol

pub struct Packet<T> { amount: u256 }
pub trait Gate {}
impl MsgVariant<Sol> for Packet<u256> {
    const SELECTOR: u32 = 0x11223344
    type Return = u256
}
impl<T> AbiSize for Packet<T> {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}
impl Encode<Sol> for Packet<u256> {
    fn encode(self, _ out: AbiFrame) {
        out.store_word(at: 0, value: self.amount)
    }
}
impl<T> Decode<Sol> for Packet<T> {
    fn decode_payload<D: AbiDecoder<Sol>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
        Packet { amount: d.read_word(input) }
    }
}
impl<T: Gate> Decode<Sol> for Packet<T> as AlternateDecode {
    fn decode_payload<D: AbiDecoder<Sol>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
        Packet { amount: d.read_word(input) + 9 }
    }
}
with (AlternateDecode)
pub contract Receiver {
    recv {
        Packet<u256> { amount } -> u256 { amount + 10 }
    }
}
