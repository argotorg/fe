use std::wasm::{Log, log_i32, log_u64}

//mock: fn provider() -> std::wasm::Mock { std::wasm::mock(1000, 10) }

fn collatz(_ start: u64) -> u32 uses (log: mut Log) {
    var n = start
    var steps: u32 = 0
    while n != 1 && n != 0 {
        log_u64(n)
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        steps += 1
    }
    log_u64(n)
    steps
}

//host: pub fn collatz_steps(start: u64) -> u32 uses (log: mut Log) {
//mock: pub fn collatz_steps(start: u64) -> u32 {
//mock:     var p = provider()
//mock:     with (Log = p) {
        collatz(start)
//mock:     }
}

