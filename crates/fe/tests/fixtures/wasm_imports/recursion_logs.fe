use std::wasm::{Log, log_i32}

//host: fn provider() -> std::wasm::Host { std::wasm::host() }
//mock: fn provider() -> std::wasm::Mock { std::wasm::mock(1000, 10) }

fn walk(_ depth: i32) -> i32 uses (log: mut Log) {
    log_i32(depth)
    if depth == 0 {
        return 0
    }
    let below = walk(depth - 1)
    log_i32(0 - depth)
    below + depth
}

pub fn walk_down(depth: i32) -> i32 {
    var p = provider()
    with (Log = p) {
        walk(depth)
    }
}
