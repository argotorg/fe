use std::wasm::{Abort, abort}

//mock: fn provider() -> std::wasm::Mock { std::wasm::mock(1000, 10) }

fn checked(_ x: i32) -> i32 uses (a: mut Abort) {
    if x > 100 {
        abort(7)
    }
    if x < 0 {
        abort(8)
    }
    x * 2
}

//host: pub fn checked_double(x: i32) -> i32 uses (a: mut Abort) {
//mock: pub fn checked_double(x: i32) -> i32 {
//mock:     var p = provider()
//mock:     with (Abort = p) {
        checked(x)
//mock:     }
}

//host: pub fn abort_with(code: u32) -> u32 uses (a: mut Abort) {
