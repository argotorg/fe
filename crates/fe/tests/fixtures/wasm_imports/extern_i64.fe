//host: extern {
//host:     fn host_mix(_ a: i64, _ b: u64) -> u64
//host:     fn host_high(_ a: u64) -> u32
//host: }
//mock: fn host_mix(_ a: i64, _ b: u64) -> u64 { b.wrapping_mul(31).wrapping_add(a.downcast_unchecked()) }
//mock: fn host_high(_ a: u64) -> u32 { (a / 4294967296).downcast_truncate() }

pub fn mix(a: i64, b: u64) -> u64 {
    unsafe { host_mix(a, b) }
}

pub fn high_word(a: u64) -> u32 {
    unsafe { host_high(a) }
}
