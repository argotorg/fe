// The log is a pure Fe provider in both builds; only the clock changes.
use std::wasm::{Clock, Log, log_i32, mock, now_ms}

fn stamp_and_log(_ x: i32) -> u64 uses (log: mut Log, clock: mut Clock) {
    log_i32(x)
    let t = now_ms()
    log_i32(x + 1)
    t
}

//host: pub fn stamp(x: i32) -> u64 uses (clock: mut Clock) {
//mock: pub fn stamp(x: i32) -> u64 {
//mock:     var clock = mock(1000, 10)
    var log = mock(0, 0)
//host:     with (Log = log) {
//mock:     with (Log = log, Clock = clock) {
        stamp_and_log(x)
    }
}

//host: pub fn stamp_count(x: i32) -> u32 uses (clock: mut Clock) {
//mock: pub fn stamp_count(x: i32) -> u32 {
//mock:     var clock = mock(1000, 10)
    var log = mock(0, 0)
//host:     with (Log = log) {
//mock:     with (Log = log, Clock = clock) {
        stamp_and_log(x)
    }
    log.i32_count
}
