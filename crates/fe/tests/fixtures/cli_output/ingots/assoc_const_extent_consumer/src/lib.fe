// An extent written with another ingot's associated constant is the same
// type on both sides of the ingot boundary, symbolically and once concrete.
// A bound naming another ingot's constant for a generic type is selected
// from this ingot, where the blanket impl for local types lives.
use assoc_const_extent_provider::{Size, Marker, Scaled, take}

pub fn forward<const N: usize>(_ x: [u8; <Marker<N> as Size>::LEN]) -> [u8; <Marker<N> as Size>::LEN] {
    take<N>(x)
}

pub fn concrete(_ x: [u8; 4]) -> [u8; <Marker<3> as Size>::LEN] {
    forward<3>(x)
}

trait Local {}

struct X {}

impl Local for X {}

impl<T: Local, const N: usize> Scaled<N> for T { const LEN: usize = N + 1 }

trait Has<const K: usize> {}

fn need<T: Local, const N: usize, U: Has<{ <T as Scaled<N>>::LEN }>>() {}

pub fn scaled<T: Local, U: Has<4>>() { need<T, 3, U>() }
