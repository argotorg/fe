// The return encode needs `u8: Codec2`, whose only implementation is a blanket one over a trait that is public but sits in a private module, so no code of this ingot can satisfy it.
use entry_hidden_provider::Codec2
use core::abi::{AbiDecoder, AbiFrame, AbiSize, ByteInput, Decode, Encode}
use std::abi::Sol
pub struct Out<T> { pub v: u256 }
impl<T> AbiSize for Out<T> {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}
impl<T> Decode<Sol> for Out<T> {
    fn decode_payload<D: AbiDecoder<Sol>, I: ByteInput>(_ d: mut D, _ i: I) -> Self { Out { v: 1 } }
}
impl<T: Codec2> Encode<Sol> for Out<T> { fn encode(self, _ f: AbiFrame) {} }
msg M {
    #[selector = 1]
    G -> Out<u8>,
}
pub contract C {
    recv M {
        G -> Out<u8> { Out { v: 1 } }
    }
}
