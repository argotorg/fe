use core::ops::Drop

pub trait Show {
    fn show(self)
}

pub struct Tag2 {}

pub impl Show for Tag2 as Loud2 {
    fn show(self) {}
}

pub struct Holder<T: Show> {
    t: T,
}

impl<T: Show> Drop for Holder<T> {
    fn drop(own self) {
        self.t.show()
    }
}

fn hold<T: Show>(_ t: own T) {
    let _held = Holder { t }
}

#[test]
fn a_call_after_return_does_not_run() {
    with (Loud2) {
        return
        hold(Tag2 {})
    }
}

#[test]
fn a_reachable_call_is_reported() {
    with (Loud2) {
        hold(Tag2 {})
    }
}
