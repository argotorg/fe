// The init root of a manual contract is entered by the build as well.
use core::ops::Drop
pub trait Show { fn show(self) }
pub struct Tag2 {}
pub impl Show for Tag2 as Loud2 { fn show(self) {} }
pub struct Holder<T: Show> { t: T }
impl<T: Show> Drop for Holder<T> { fn drop(own self) { self.t.show() } }
fn hold<T: Show>(_ t: own T) { let _held = Holder { t } }

use std::evm::{Evm, RawOps}
use core::ptr
#[contract_init(M)]
fn init() uses (evm: mut Evm) {
    with (Loud2) { hold(Tag2 {}) }
    let len = evm.code_region_len(runtime)
    let offset = evm.code_region_offset(runtime)
    var dest = ptr::MemBuffer::new(len.downcast_unchecked())
    evm.codecopy(dest: mut dest, dest_offset: 0, src_offset: offset, len)
    evm.return_data(data: dest.span())
}
#[contract_runtime(M)]
fn runtime() uses (evm: mut Evm) {
    evm.return_data(data: ptr::MemBuffer::new(0).span())
}
