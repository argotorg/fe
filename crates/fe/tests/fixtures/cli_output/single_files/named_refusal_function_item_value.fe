// A function item formed under a choice and called through a callable bound: the refusal is reported at the argument that is the function item, where the choice reaches it, and names the call through the bound.
pub trait Show { fn show() -> u256 }
pub struct Foo {}
impl Show for Foo { fn show() -> u256 { 100 } }
impl Show for Foo as Loud { fn show() -> u256 { 70 } }
impl Show for Foo as Quiet { fn show() -> u256 { 30 } }
pub struct W<T> {}
pub struct V<T> {}
pub trait Tr { type A: Show
    fn via() -> u256 }
impl<T: Show> Tr for W<T> { type A = T
    fn via() -> u256 { T::show() } }
pub trait Tr2 { type A: Tr
    fn via2() -> u256 }
impl<T: Tr> Tr2 for V<T> { type A = T
    fn via2() -> u256 { T::via() } }
pub struct U<T> {}
impl<T: Show> Tr for U<T> { type A = T
    fn via() -> u256 { T::show() + 1 } }
fn f<B: Tr<A = Foo>, C: Tr2<A = U<Foo>>>() -> u256 { Foo::show() * 1000000 + B::via() * 1000 + C::via2() }
fn run<G: Fn() -> u256>(_ g: G) -> u256 uses G::E { g() }
fn relay<C: Tr2<A = U<Foo>>>() -> u256 { with (Loud) { run(f<W<Foo>, C>) } }
fn go() -> u256 { relay<V<U<Foo>>>() }
