// `Decode<Sol> for W<T>` holds for every `T`, but `AbiSize` for `W<T>` needs
// `T: Marker`. The implementation of `Decode` is reported where it is written.
// The entry code of the contract is reported as well, so that no program that
// passes `fe check` fails in `fe build`.
use core::abi::{AbiDecoder, AbiFrame, AbiSize, ByteInput, Decode, Encode}
use std::abi::Sol
pub trait Marker {}
// Decode<Sol> for W<T> is unconditional, but AbiSize needs T: Marker (unmet for u8).
pub struct W<T> { v: u256 }
impl<T: Marker> AbiSize for W<T> {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}
impl<T> Decode<Sol> for W<T> {
    fn decode_payload<D: AbiDecoder<Sol>, I: ByteInput>(_ d: mut D, _ input: I) -> Self { W { v: d.read_word(input) } }
}
pub contract C {
    init(w: W<u8>) {}
}
