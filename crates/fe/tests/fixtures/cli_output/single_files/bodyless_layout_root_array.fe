struct Rooted<const ROOT: u256 = _> {}

// Signatures without a body are checked like any other callable.
trait Api {
    fn values(self, values: [Rooted; 2])
    fn generic<const ROOT: u256>() -> [Rooted<ROOT>; 0]
    fn plain(values: [u256; 2])
}

extern {
    fn external(values: [Rooted<7>; 2])
}
