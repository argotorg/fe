// Return type is a tuple whose element has Decode<Sol> but no Encode<Sol> at all.
use core::abi::{AbiDecoder, AbiSize, ByteInput, Decode}
use std::abi::Sol
pub struct S { v: u256 }
impl AbiSize for S {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}
impl Decode<Sol> for S {
    fn decode_payload<D: AbiDecoder<Sol>, I: ByteInput>(_ d: mut D, _ input: I) -> Self { S { v: d.read_word(input) } }
}
msg M {
    #[selector = 0x01]
    Get -> (S, u256),
}
pub contract C {
    recv M {
        Get -> (S, u256) { (S { v: 1 }, 2) }
    }
}
