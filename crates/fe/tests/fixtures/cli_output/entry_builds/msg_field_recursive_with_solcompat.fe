// control: Node declares a Solidity type name, so its ABI type is not recursive
use core::abi::{AbiDecoder, AbiFrame, AbiSize, AbiSpan, ByteInput, Decode, Encode}
use std::abi::{DynArray, Sol}
pub struct Node { pub v: u256, pub kids: DynArray<Node> }
impl AbiSize for Node {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}
impl AbiSpan<Sol> for Node {
    fn payload_end<I: ByteInput>(_ i: I, base: u256, pos: u256) -> u256 { pos + 32 }
}
impl Encode<Sol> for Node { fn encode(self, _ f: AbiFrame) {} }
impl Decode<Sol> for Node {
    fn decode_payload<D: AbiDecoder<Sol>, I: ByteInput>(_ d: mut D, _ i: I) -> Self { panic() }
}
use std::abi::SolCompat
impl SolCompat for Node {
    type S = String<7>
    const SOL_TYPE: Self::S = "uint256"
}
msg M {
    #[selector = 1]
    Put { n: Node } -> u8,
}
pub contract C {
    recv M {
        Put { n } -> u8 { 1 }
    }
}
