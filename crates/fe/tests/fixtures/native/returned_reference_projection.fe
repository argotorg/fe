struct Inner { value: u256 }
struct Outer { inner: Inner }
impl Inner {
    fn add(mut self, _ value: u256) { self.value += value }
    fn read(self) -> u256 { self.value }
}
fn view(_ outer: mut Outer, _ count: mut u256) -> mut Outer {
    count += 1
    outer
}
fn array(_ values: mut [Inner; 2]) -> mut [Inner; 2] { values }
fn pair(_ values: mut (Inner, Inner)) -> mut (Inner, Inner) { values }
fn shared(_ outer: ref Outer) -> ref Outer { outer }
fn fresh(_ count: mut u256) -> Outer {
    count += 1
    Outer { inner: Inner { value: 0 } }
}
pub fn main() -> i32 {
    var outer = Outer { inner: Inner { value: 0 } }
    var count: u256 = 0
    view(mut outer, mut count).inner.add(3)
    core::assert(outer.inner.value == 3 && count == 1)
    core::assert(shared(ref outer).inner.read() == 3)
    var values = [Inner { value: 10 }, Inner { value: 20 }]
    array(mut values)[1].add(7)
    core::assert(values[0].value == 10 && values[1].value == 27)
    var tuple = (Inner { value: 30 }, Inner { value: 40 })
    pair(mut tuple).0.add(9)
    core::assert(tuple.0.value == 39 && tuple.1.value == 40)
    fresh(mut count).inner.add(100)
    core::assert(count == 2 && outer.inner.value == 3)
    0
}
