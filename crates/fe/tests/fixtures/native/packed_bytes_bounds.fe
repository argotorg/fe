use core::{AsBytes, PackedBytes}

pub fn main(argc: i32, argv: **u8) -> i32 {
    let _ = argv
    if argc == 1 {
        let empty = PackedBytes::from_array([0 as u8; 0])
        assert!(empty[0] == 0)
    } else {
        let bytes = [1 as u8; 33].as_bytes()
        let index: usize = if argc == 2 { 32 } else { 33 }
        assert!(bytes[index] == 1)
    }
    0
}
