use core::{MemBuffer, MemVec, Option, Result}
use std::native::Args

struct Frame { value: u64, words: [u256; 4], memory: MemBuffer }

// Mode 1: the frame stack cannot be allocated. Mode 2: a frame's memory
// cannot be allocated. Nothing here frees memory: destruction does.
pub fn main(argc: i32, argv: **u8) -> i32 {
    core::assert(core::size_of<Frame>() == 160)
    let args = unsafe { Args::new(argc, argv) }
    let mode = if args.len() == 1 { 0 } else { args.get(1).byte_at(0) - 48 }
    var stack = match MemVec<Frame>::try_with_capacity(3) {
        Option::Some(stack) => stack
        Option::None => {
            core::assert(mode == 1)
            return 0
        }
    }
    core::assert(mode != 1)
    var count: u64 = 0
    var failed = false
    while count < 4 {
        var memory = MemBuffer::empty()
        if !memory.try_resize(8192) {
            failed = true
            break
        }
        memory[8191] = (count + 41).downcast_unchecked()
        let frame = Frame { value: count, words: [count as u256; 4], memory }
        if stack.len() == stack.capacity() {
            // A full stack takes no frame, which is destroyed.
            core::assert(count == 3 && frame.words[3] == 3 && frame.memory[8191] == 44)
            break
        }
        match stack.try_push(frame) {
            Result::Ok(()) => count += 1
            Result::Err(_) => core::panic()
        }
    }
    core::assert(failed == (mode == 2))
    // The top frame is popped and destroyed; the others go with the stack.
    match stack.last() {
        Option::Some(mut top) => {
            core::assert(top.value == count - 1)
            core::assert(top.memory[8191] == (count + 40).downcast_unchecked())
            top.memory[0] = 97
        }
        Option::None => core::assert(count == 0)
    }
    match stack.pop() {
        Option::Some(frame) => core::assert(frame.memory[0] == 97)
        Option::None => core::assert(count == 0)
    }
    0
}
