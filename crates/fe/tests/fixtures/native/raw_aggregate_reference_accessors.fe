use core::ptr

struct Pair { first: u64, second: u64 }
fn read(_ pointer: *Pair) -> ref Pair { unsafe { ref *pointer } }
fn edit(_ pointer: *Pair) -> mut Pair { unsafe { mut *pointer } }
fn read_generic<T>(_ pointer: *T) -> ref T { unsafe { ref *pointer } }
fn forward<T>(_ pointer: *T) -> ref T { read_generic(pointer) }
fn second(_ pointer: *Pair) -> ref u64 { unsafe { ref (*pointer).second } }

pub fn main() -> i32 {
    let pointer = ptr::alloc<Pair>()
    unsafe { *pointer = Pair { first: 4, second: 2 } }
    let view = mut edit(pointer)
    view.first += 1
    core::assert(read(pointer).first == 5)
    core::assert(read_generic(pointer).second == 2)
    core::assert(forward(pointer).first == 5)
    core::assert(second(pointer) == 2)
    let array = ptr::alloc<[u8; 257]>()
    unsafe { *array = [7; 257] }
    core::assert(read_generic(array)[256] == 7)
    0
}
