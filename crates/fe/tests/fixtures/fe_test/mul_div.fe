fn matches(_ value: Option<u256>, _ expected: u256, _ fits: bool) -> bool {
    match value {
        Option::Some(got,) => fits && got == expected,
        Option::None => !fits,
    }
}

#[test]
fn checked_mul_div_cases() {
    for (a, b, d, floor, ceil, fits) in CASES {
        let floor_fits = fits & FLOOR_FITS != 0
        let ceil_fits = fits & CEIL_FITS != 0
        assert!(matches(checked_mul_div(a, b, d), floor, floor_fits))
        assert!(matches(checked_mul_div_ceil(a, b, d), ceil, ceil_fits))
        if floor_fits {
            assert!(mul_div(a, b, d) == floor)
        }
        if ceil_fits {
            assert!(mul_div_ceil(a, b, d) == ceil)
        }
    }
}

#[test]
fn full_mul_cases() {
    for (a, b, high, low) in PRODUCTS {
        assert!(full_mul(a, b) == (high, low))
    }
}

#[test]
fn modular_intrinsics_in_core() {
    assert!(mulmod(MAX, MAX, 13) == 4)
    assert!(addmod(MAX, 2, 13) == 4)
    assert!(mulmod(5, 8, 0) == 0)
}

const COMPILE_TIME: u256 = mul_div(MAX, 3, 6)

#[test]
fn mul_div_is_const() {
    assert!(COMPILE_TIME == MAX / 2)
}

#[test(should_revert, panic = 0x12)]
fn mul_div_by_zero_panics() {
    let _ = mul_div(1, 1, 0)
}

#[test(should_revert, panic = 0x12)]
fn mul_div_ceil_by_zero_panics() {
    let _ = mul_div_ceil(0, 0, 0)
}

#[test(should_revert, panic = 0x11)]
fn mul_div_overflow_panics() {
    let _ = mul_div(MAX, MAX, 1)
}

#[test(should_revert, panic = 0x11)]
fn mul_div_ceil_rounding_overflow_panics() {
    // The floor result fits; only rounding up overflows.
    let _ = mul_div_ceil(MAX - 1, MAX - 1, MAX - 2)
}

// Calldata arguments keep the operands out of constant evaluation, so these
// cases exercise the runtime lowering.
msg MulDivMsg {
    #[selector = 0x11111111]
    Floor { a: u256, b: u256, d: u256 } -> u256,
    #[selector = 0x22222222]
    Ceil { a: u256, b: u256, d: u256 } -> u256,
}

pub contract MulDivProbe {
    recv MulDivMsg {
        Floor { a, b, d } -> u256 {
            mul_div(a, b, d)
        }
        Ceil { a, b, d } -> u256 {
            mul_div_ceil(a, b, d)
        }
    }
}

fn runtime_floor(_ probe: Address, _ a: u256, _ b: u256, _ d: u256) -> u256
uses (evm: mut Evm)
{
    evm.call(
        addr: probe,
        gas: 1000000,
        value: 0,
        message: MulDivMsg::Floor { a, b, d },
    )
}

fn runtime_ceil(_ probe: Address, _ a: u256, _ b: u256, _ d: u256) -> u256
uses (evm: mut Evm)
{
    evm.call(
        addr: probe,
        gas: 1000000,
        value: 0,
        message: MulDivMsg::Ceil { a, b, d },
    )
}

#[test]
fn mul_div_runtime_cases() uses (evm: mut Evm) {
    let probe = evm.create2<MulDivProbe>(value: 0, args: (), salt: 0)
    for (a, b, d, floor, ceil, fits) in CASES {
        let floor_fits = fits & FLOOR_FITS != 0
        let ceil_fits = fits & CEIL_FITS != 0
        if floor_fits {
            assert!(runtime_floor(probe, a, b, d) == floor)
        }
        if ceil_fits {
            assert!(runtime_ceil(probe, a, b, d) == ceil)
        }
    }
}

#[test(should_revert, panic = 0x12)]
fn mul_div_runtime_by_zero_panics() uses (evm: mut Evm) {
    let probe = evm.create2<MulDivProbe>(value: 0, args: (), salt: 0)
    let _ = runtime_floor(probe, 1, 1, 0)
}

#[test(should_revert, panic = 0x11)]
fn mul_div_runtime_ceil_overflow_panics() uses (evm: mut Evm) {
    let probe = evm.create2<MulDivProbe>(value: 0, args: (), salt: 0)
    let _ = runtime_ceil(probe, MAX - 1, MAX - 1, MAX - 2)
}
