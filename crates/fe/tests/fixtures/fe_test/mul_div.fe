// Tests for `core::num::{mul_div, mul_div_ceil, checked_mul_div, checked_mul_div_ceil, full_mul}`.
// Expected values were computed with Python arbitrary-precision integers.

use std::evm::{Address, Evm}
use core::num::{
    checked_mul_div,
    checked_mul_div_ceil,
    full_mul,
    mul_div,
    mul_div_ceil,
    mulmod,
    addmod,
}

