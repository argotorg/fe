use std::evm::{Ctx, Evm, wei}

msg PayableReturnMsg {
    #[selector = sol("deposit()")]
    Deposit -> Wei,
    #[selector = sol("pair(uint256)")]
    Pair { value: u256 } -> (u256, Wei),
    #[selector = sol("label()")]
    Label -> String<7>,
}

pub contract PayableReturnBox uses (ctx: Ctx) {
    recv PayableReturnMsg {
        #[payable]
        Deposit -> Wei uses ctx { ctx.value() }

        #[payable]
        Pair { value } -> (u256, Wei) uses ctx { (value, ctx.value()) }

        #[payable]
        Label -> String<7> { "deposit" }
    }
}

#[test]
fn test_payable_scalar_zero_value() uses (evm: mut Evm) {
    let addr = evm.create2<PayableReturnBox>(value: Wei::zero(), args: (), salt: 0)
    let received = evm.call(addr, gas: 100000, value: Wei::zero(), message: PayableReturnMsg::Deposit {})
    assert!(received == Wei::zero())
}

#[test(balance = 1000)]
fn test_payable_scalar_with_value() uses (evm: mut Evm) {
    let addr = evm.create2<PayableReturnBox>(value: Wei::zero(), args: (), salt: 0)
    let received = evm.call(addr, gas: 100000, value: wei(123), message: PayableReturnMsg::Deposit {})
    assert!(received == wei(123))
    assert!(evm.balance(addr) == wei(123))
}

#[test(balance = 1000)]
fn test_payable_tuple_with_value() uses (evm: mut Evm) {
    let addr = evm.create2<PayableReturnBox>(value: Wei::zero(), args: (), salt: 0)
    let (value, received) = evm.call(
        addr, gas: 100000, value: wei(456), message: PayableReturnMsg::Pair { value: 42 },
    )
    assert!(value == 42)
    assert!(received == wei(456))
    assert!(evm.balance(addr) == wei(456))
}

#[test(balance = 1000)]
fn test_payable_dynamic_return() uses (evm: mut Evm) {
    let addr = evm.create2<PayableReturnBox>(value: Wei::zero(), args: (), salt: 0)
    let label = evm.call(addr, gas: 100000, value: wei(7), message: PayableReturnMsg::Label {})
    let expected: String<7> = "deposit"
    assert!(label == expected)
    assert!(evm.balance(addr) == wei(7))
}
