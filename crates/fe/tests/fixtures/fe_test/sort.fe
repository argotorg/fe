// Tests for `core::sort` across containers (arrays, `MemSlice`, `MemArray`,
// `MemVec`) and element types (unsigned, signed, `Address`, a user type),
// the `sort` methods of memory collections, which need no `Copy`, and the
// order of slices and text.

use core::ops::{Drop, Eq, Ord}
use core::ptr::{self, MemArray, MemBuffer, MemVec}
use core::sort::{
    binary_search,
    dedup_sorted,
    heap_sort,
    insertion_sort,
    is_sorted,
    is_sorted_unique,
    lower_bound,
    reverse,
    sort,
}
use std::abi::{DynArray, DynString}
use std::abi::dyn_array::dyn_array_from
use std::evm::Address

// A bid ordered by price, highest first; equal prices by bidder.
struct Bid { price: u256, bidder: u256 }

impl Copy for Bid {}

impl Eq for Bid {
    fn eq(self, _ other: Bid) -> bool {
        self.price == other.price && self.bidder == other.bidder
    }
}

impl Ord for Bid {
    fn lt(self, _ other: Bid) -> bool {
        self.price > other.price || (self.price == other.price && self.bidder < other.bidder)
    }
    fn le(self, _ other: Bid) -> bool {
        !other.lt(self)
    }
    fn gt(self, _ other: Bid) -> bool {
        other.lt(self)
    }
    fn ge(self, _ other: Bid) -> bool {
        !self.lt(other)
    }
}

#[test]
fn sorts_unsigned_and_signed_arrays() {
    var a: [u256; 6] = [5, 3, 9, 1, 3, 0]
    sort(mut a)
    assert!(a == [0, 1, 3, 3, 5, 9])

    // Signed order needs no sign-bit trick.
    var b: [i256; 5] = [2, -7, 0, -1, 100]
    sort(mut b)
    assert!(b == [-7, -1, 0, 2, 100])

    var c: [u8; 3] = [255, 0, 7]
    insertion_sort(mut c)
    assert!(c == [0, 7, 255])
}

#[test]
fn sorts_addresses() {
    var signers: [Address; 3] = [
        Address::new(0xc0ffee),
        Address::new(0xa11ce),
        Address::new(0xb0b),
    ]
    assert!(!is_sorted_unique(signers))
    sort(mut signers)
    assert!(
        signers[0].word() == 0xb0b && signers[1].word() == 0xa11ce && signers[2].word() == 0xc0ffee,
    )
    assert!(is_sorted_unique(signers))
}

#[test]
fn sorts_a_user_type_by_its_own_order() {
    var bids: [Bid; 4] = [
        Bid { price: 10, bidder: 2 },
        Bid { price: 30, bidder: 1 },
        Bid { price: 10, bidder: 1 },
        Bid { price: 20, bidder: 9 },
    ]
    sort(mut bids)
    assert!(bids[0].price == 30)
    assert!(bids[1].price == 20)
    assert!(bids[2].price == 10 && bids[2].bidder == 1)
    assert!(bids[3].price == 10 && bids[3].bidder == 2)
    assert!(is_sorted(bids))
}

#[test]
fn sorts_memory_slices_and_arrays() {
    var arr = MemArray<u256>::new_zeroed(4)
    let slice = mut arr.as_slice()
    slice[0] = 40
    slice[1] = 10
    slice[2] = 30
    slice[3] = 20
    sort(mut slice)
    var total: u256 = 0
    for x in slice {
        total += x
    }
    assert!(total == 100)
    // The slice wrote through to the array's memory.
    assert!(arr[0] == 10 && arr[3] == 40)

    var owned = MemArray<i256>::new_zeroed(3)
    owned.set(0, 3)
    owned.set(1, -3)
    owned.set(2, 0)
    sort(mut owned)
    assert!(owned[0] == -3 && owned[2] == 3)
}

#[test]
fn sorts_a_copy_of_an_abi_array() {
    let input: DynArray<Address> = dyn_array_from(
        [Address::new(3), Address::new(1), Address::new(2)],
    )
    var copy = input.to_mem_array()
    sort(mut copy)
    assert!(
        copy[0].word() == 1 && copy[1].word() == 2 && copy[2].word() == 3,
    )
    let sorted = DynArray::from_slice(copy.as_slice())
    assert!(sorted.len() == 3 && sorted.get(0).word() == 1)
}

#[test]
fn sorts_a_mem_vec() {
    var v = MemVec<i256>::new()
    for x in [5, -1, 4] {
        v.push(x)
    }
    sort(mut v)
    assert!(v[0] == -1 && v[1] == 4 && v[2] == 5)
}

#[test]
fn heap_sort_handles_long_inputs() {
    // 64 pseudo-random values exercise the heapsort path of `sort`.
    var values: [u256; 64] = [0; 64]
    var x: u256 = 12345
    var i: usize = 0
    var sum: u256 = 0
    while i < 64 {
        x = (x * 1103515245 + 12345) % 2147483648
        values[i] = x % 1000
        sum += x % 1000
        i += 1
    }
    sort(mut values)
    assert!(is_sorted(values))
    var after: u256 = 0
    for v in values {
        after += v
    }
    assert!(after == sum)

    var descending: [u256; 20] = [0; 20]
    var k: usize = 0
    while k < 20 {
        descending[k] = (20 - k) as u256
        k += 1
    }
    heap_sort(mut descending)
    assert!(
        descending[0] == 1 && descending[19] == 20 && is_sorted_unique(descending),
    )
}

#[test]
fn searches_sorted_sequences() {
    let sorted: [u256; 6] = [1, 3, 3, 5, 8, 13]
    assert!(binary_search(sorted, 5).unwrap() == 3)
    assert!(binary_search(sorted, 3).unwrap() == 1)
    assert!(binary_search(sorted, 4).is_none())
    assert!(lower_bound(sorted, 4) == 3)
    assert!(lower_bound(sorted, 0) == 0)
    assert!(lower_bound(sorted, 100) == 6)
}

#[test]
fn dedups_and_reverses() {
    var values: [u256; 7] = [1, 1, 2, 3, 3, 3, 9]
    let unique = dedup_sorted(mut values)
    assert!(unique == 4)
    assert!(
        values[0] == 1 && values[1] == 2 && values[2] == 3 && values[3] == 9,
    )

    var seq: [u256; 5] = [1, 2, 3, 4, 5]
    reverse(mut seq)
    assert!(seq == [5, 4, 3, 2, 1])
    assert!(!is_sorted(seq))

    let empty: [u256; 0] = []
    assert!(is_sorted(empty) && is_sorted_unique(empty))
}

#[test]
fn text_orders_by_bytes() {
    let ab: DynString = "ab"
    let abc: DynString = "abc"
    let b: DynString = "b"
    let empty: DynString = ""
    assert!(ab < abc && abc < b && empty < ab)
    assert!(!(abc < ab) && b > abc && b >= b && ab <= ab && !(ab < ab))
    assert!(ab.span() < abc.span() && b.span() > abc.span())
    assert!(MemBuffer::from_span(abc.span()) < MemBuffer::from_span(b.span()))
    assert!(MemBuffer::from_span(ab.span()) >= MemBuffer::from_span(ab.span()))
    // Bytes order unsigned, and an uppercase letter before a lowercase one.
    var high = MemBuffer::empty()
    high.push(0xff)
    var low = MemBuffer::empty()
    low.push(0x7f)
    assert!(low < high)
    let upper: DynString = "Z"
    let lower: DynString = "a"
    assert!(upper < lower)
}

#[test]
fn slices_order_by_elements() {
    var a = MemVec<u256>::new()
    var b = MemVec<u256>::new()
    for value in [1 as u256, 300, 2] {
        a.push(value)
        b.push(value)
    }
    assert!(a.as_slice() <= b.as_slice() && a.as_slice() >= b.as_slice())
    b.push(0)
    assert!(a.as_slice() < b.as_slice())
    a.set(1, 301)
    assert!(a.as_slice() > b.as_slice())
}

// Text from an index, so equal indexes give equal text.
fn word(_ i: usize) -> DynString {
    std::text::concat(["w", std::text::decimal(((i * 7919) % 101) as u256)])
}

#[test]
fn sorts_owned_text() {
    for n in [0 as usize, 1, 2, 16, 17, 100] {
        var words = MemVec<DynString>::new()
        for i in 0..n {
            words.push(word(i))
        }
        words.sort()
        assert!(words.len() == n)
        for i in 1..words.len() {
            assert!(words[i - 1] <= words[i])
        }
    }
    var names = MemVec<MemBuffer>::new()
    let fruit: [DynString; 4] = ["pear", "apple", "fig", "apple"]
    for ref name in fruit {
        names.push(MemBuffer::from_span(name.span()))
    }
    names.sort()
    assert!(names[0] == "apple" && names[1] == "apple" && names[2] == "fig" && names[3] == "pear")
    var array = MemArray<u256>::new_zeroed(3)
    array[0] = 3
    array[1] = 1
    array[2] = 2
    array.sort()
    assert!(array[0] == 1 && array[1] == 2 && array[2] == 3)
}

// An element that counts its destruction.
struct Tracked {
    count: *u256,
    key: u256,
}

impl Drop for Tracked {
    fn drop(own self) {
        unsafe { *self.count += 1 }
    }
}

impl Ord for Tracked {
    fn lt(self, _ other: Tracked) -> bool { self.key < other.key }
    fn le(self, _ other: Tracked) -> bool { self.key <= other.key }
    fn gt(self, _ other: Tracked) -> bool { self.key > other.key }
    fn ge(self, _ other: Tracked) -> bool { self.key >= other.key }
}

#[test]
fn sorting_swaps_without_destroying() {
    let count = ptr::alloc<u256>()
    unsafe { *count = 0 }
    for n in [5 as usize, 40] {
        var items = MemVec<Tracked>::new()
        for i in 0..n {
            items.push(Tracked { count, key: ((i * 37) % n) as u256 })
        }
        items.sort()
        assert!(unsafe { *count } == 0)
        for i in 0..n {
            assert!(items[i].key == i as u256)
        }
        drop_all(items)
        assert!(unsafe { *count } == n as u256)
        unsafe { *count = 0 }
    }
}

fn drop_all(_ items: own MemVec<Tracked>) {}
