#[test]
fn live_mixed_capability_and_payload_arms_remain_write_through() {
    assert!(mixed_live_branch_scalar_write_result(use_capability_value: true) == 3708)
    assert!(mixed_live_branch_scalar_write_result(use_capability_value: false) == 3708)
}

fn mixed_live_branch_array_write_result(use_capability_value: bool) -> u256 {
    let mut first: [u8; 3] = "abc"
    let mut second: [u8; 3] = "def"
    let mut handle = ByteArrayHandle { target: mut first }

    handle.target = if use_capability_value { mut second } else { "ghi" }
    handle.target = "jkl"

    (first[0] as u256) * 1000 + (second[0] as u256)
}

#[test]
fn expected_array_context_reaches_live_mixed_payload_arms() {
    assert!(mixed_live_branch_array_write_result(use_capability_value: true) == 106100)
    assert!(mixed_live_branch_array_write_result(use_capability_value: false) == 106100)
}

#[test]
fn nested_capability_field_rebind_uses_the_inner_slot() {
    let mut first: u256 = 1
    let mut second: u256 = 2
    let mut inner = ScalarHandle { target: mut first }
    let outer = NestedScalarHandle { target: mut inner }

    outer.target.target = mut second
    outer.target.target = 19

    assert!(first == 1, "nested rebind changed the old scalar target")
    assert!(second == 19, "nested rebind did not update the new scalar target")
}

struct CapabilityForwarder {}

impl CapabilityForwarder {
    fn forward(self, value: mut u256) -> mut u256 {
        value
    }
}

struct OperatorForwarder {
    target: mut u256,
}

impl Add<OperatorForwarder> for OperatorForwarder {
    type Output = mut u256

    fn add(own self, _ other: own OperatorForwarder) -> mut u256 {
        self.target
    }
}

impl Neg for OperatorForwarder {
    type Output = mut u256

    fn neg(own self) -> mut u256 {
        self.target
    }
}

fn forward_capability(value: mut u256) -> mut u256 {
    value
}

fn forward_payload(value: u256) -> u256 {
    value
}

fn make_scalar_handle(target: mut u256) -> ScalarHandle {
    ScalarHandle { target }
}

#[test]
fn capability_returning_binary_and_unary_operators_rebind() {
    let mut binary_old: u256 = 1
    let mut binary_new: u256 = 2
    let mut binary_other: u256 = 3
    let mut binary_handle = ScalarHandle { target: mut binary_old }
    let left = OperatorForwarder { target: mut binary_new }
    let right = OperatorForwarder { target: mut binary_other }

    binary_handle.target = left + right
    binary_handle.target = 107

    assert!(binary_old == 1)
    assert!(binary_new == 107)
    assert!(binary_other == 3)

    let mut unary_old: u256 = 4
    let mut unary_new: u256 = 5
    let mut unary_handle = ScalarHandle { target: mut unary_old }

    unary_handle.target = -OperatorForwarder { target: mut unary_new }
    unary_handle.target = 109

    assert!(unary_old == 4)
    assert!(unary_new == 109)
}

#[test]
fn deferred_capability_operator_rebind_preserves_primitive_payload_inference() {
    let mut old: u256 = 6
    let mut selected: u256 = 7
    let mut other: u256 = 8
    let handle = ScalarHandle { target: mut old }
    let assign =
        |left: own, right: own, mut handle: own ScalarHandle| -> ScalarHandle {
            handle.target = left + right
            handle
        }
    let returned = assign.call_once(
        OperatorForwarder { target: mut selected },
        OperatorForwarder { target: mut other },
        handle,
    )

    returned.target = 113
    assert!(old == 6)
    assert!(selected == 113)
    assert!(other == 8)

    let mut payload: u256 = 9
    let mut payload_handle = ScalarHandle { target: mut payload }
    payload_handle.target = 20 + 22
    assert!(payload_handle.target == 42)
    payload_handle.target += 1
    assert!(payload_handle.target == 43)
}

#[test]
fn capability_returning_calls_rebind_while_payload_calls_write_through() {
    let mut first: u256 = 1
    let mut second: u256 = 2
    let mut handle = ScalarHandle { target: mut first }

    handle.target = forward_capability(value: mut second)
    handle.target = forward_payload(value: 101)

    assert!(first == 1)
    assert!(second == 101)
}

#[test]
fn capability_returning_methods_and_closure_calls_rebind() {
    let mut first: u256 = 3
    let mut second: u256 = 4
    let mut third: u256 = 5
    let mut handle = ScalarHandle { target: mut first }
    let forward = |value: mut u256| -> mut u256 { value }

    handle.target = CapabilityForwarder {}.forward(value: mut second)
    handle.target = forward.call_once(mut third)
    handle.target = 103

    assert!(first == 3)
    assert!(second == 4)
    assert!(third == 103)
}

#[test]
fn inferred_receiver_capability_return_rebinds_after_deferred_resolution() {
    let mut first: u256 = 6
    let mut second: u256 = 7
    let handle = ScalarHandle { target: mut first }
    let assign =
        |forwarder, target: mut u256, mut handle: own ScalarHandle| -> ScalarHandle {
        handle.target = forwarder.forward(value: mut target)
        handle
    }

    let returned = assign.call_once(CapabilityForwarder {}, mut second, handle)
    returned.target = 107

    assert!(first == 6)
    assert!(second == 107)
}

#[test]
fn nonplace_capability_projection_rebinds_but_local_projection_writes_through() {
    let mut first: u256 = 8
    let mut second: u256 = 9
    let mut handle = ScalarHandle { target: mut first }

    handle.target = make_scalar_handle(target: mut second).target
    handle.target = 109
    assert!(first == 8)
    assert!(second == 109)

    let mut third: u256 = 10
    let mut fourth: u256 = 11
    let mut destination = ScalarHandle { target: mut third }
    let source = ScalarHandle { target: mut fourth }
    destination.target = source.target
    destination.target = 113

    assert!(third == 113)
    assert!(fourth == 11)
}

#[test]
fn tuple_and_array_capability_slots_support_rebind_and_write_through() {
    let mut tuple_first: u256 = 12
    let mut tuple_second: u256 = 13
    let mut tuple_slots = (mut tuple_first,)
    tuple_slots.0 = mut tuple_second
    tuple_slots.0 = 127
    assert!(tuple_first == 12)
    assert!(tuple_second == 127)

    let mut array_first: u256 = 14
    let mut array_second: u256 = 15
    let mut array_slots: [mut u256; 1] = [mut array_first]
    array_slots[0] = mut array_second
    array_slots[0] = 131
    assert!(array_first == 14)
    assert!(array_second == 131)
}

fn nested_payload_match_result() -> u256 {
    let mut first: u256 = 132
    let mut second: u256 = 133
    let mut handle = ScalarHandle { target: mut first }

    handle.target = if let KnownOuterChoice::Value(KnownNestedChoice::Count(5)) = KnownOuterChoice::Value(KnownNestedChoice::Count(5)) {
        mut second
    } else {
        134
    }
    handle.target = 137
    first * 100 + second
}

fn nested_payload_miss_result() -> u256 {
    let mut first: u256 = 134
    let mut second: u256 = 135
    let mut handle = ScalarHandle { target: mut first }

    handle.target = if let KnownOuterChoice::Value(KnownNestedChoice::Count(6)) = KnownOuterChoice::Value(KnownNestedChoice::Count(5)) {
        136
    } else {
        mut second
    }
    handle.target = 139
    first * 100 + second
}

fn unknown_nested_payload_stays_conservative(flag: bool) -> u256 {
    let mut first: u256 = 136
    let mut second: u256 = 137
    let mut handle = ScalarHandle { target: mut first }

    handle.target = if let KnownOuterChoice::Value(KnownNestedChoice::Flag(true)) = KnownOuterChoice::Value(KnownNestedChoice::Flag(flag)) {
        mut second
    } else {
        138
    }
    handle.target = 149
    first * 100 + second
}

fn known_record_payload_match_result() -> u256 {
    let mut first: u256 = 140
    let mut second: u256 = 141
    let mut handle = ScalarHandle { target: mut first }

    handle.target = if let KnownRecord { flag: true, count: 5 } = (KnownRecord { count: 5, flag: true }) {
        mut second
    } else {
        142
    }
    handle.target = 151
    first * 100 + second
}

fn known_tuple_payload_match_result() -> u256 {
    let mut first: u256 = 142
    let mut second: u256 = 143
    let mut handle = ScalarHandle { target: mut first }

    handle.target = if let (true, 5) = (true, 5 as u256) {
        mut second
    } else {
        144
    }
    handle.target = 157
    first * 100 + second
}

fn known_const_payload_match_result() -> u256 {
    let mut first: u256 = 144
    let mut second: u256 = 145
    let mut handle = ScalarHandle { target: mut first }

    handle.target = if let KnownOuterChoice::Value(KnownNestedChoice::Flag(true)) = KNOWN_NESTED_PAYLOAD {
        mut second
    } else {
        146
    }
    handle.target = 163
    first * 100 + second
}

fn known_payload_wildcard_fallback_result() -> u256 {
    let mut first: u256 = 150
    let mut second: u256 = 151
    let mut handle = ScalarHandle { target: mut first }

    handle.target = match KnownNestedChoice::Flag(true) {
        KnownNestedChoice::Flag(false) => 152,
        _ => mut second,
    }
    handle.target = 179
    first * 100 + second
}

fn divergent_if_scrutinee_keeps_sole_normal_shape(abort: bool) -> u256 {
    let mut first: u256 = 146
    let mut second: u256 = 147
    let mut handle = ScalarHandle { target: mut first }

    handle.target = if let KnownNestedChoice::Flag(true) = if abort {
        core::panic()
    } else {
        KnownNestedChoice::Flag(true)
    } {
        mut second
    } else {
        148
    }
    handle.target = 167
    first * 100 + second
}

fn divergent_match_scrutinee_keeps_sole_normal_shape(abort: bool) -> u256 {
    let mut first: u256 = 148
    let mut second: u256 = 149
    let mut handle = ScalarHandle { target: mut first }

    handle.target = if let KnownNestedChoice::Flag(true) = match abort {
        true => core::panic(),
        false => KnownNestedChoice::Flag(true),
    } {
        mut second
    } else {
        150
    }
    handle.target = 173
    first * 100 + second
}

fn const_true_rebind_result() -> u256 {
    let mut first: u256 = 152
    let mut second: u256 = 153
    let mut handle = ScalarHandle { target: mut first }
    handle.target = if KNOWN_TRUE { mut second } else { 154 }
    handle.target = 181
    first * 100 + second
}

fn const_false_rebind_result() -> u256 {
    let mut first: u256 = 154
    let mut second: u256 = 155
    let mut handle = ScalarHandle { target: mut first }
    handle.target = if KNOWN_FALSE { 156 } else { mut second }
    handle.target = 191
    first * 100 + second
}

fn const_enum_rebind_result() -> u256 {
    let mut first: u256 = 156
    let mut second: u256 = 157
    let mut handle = ScalarHandle { target: mut first }
    handle.target = match KNOWN_CHOICE {
        KnownChoice::Second => mut second,
        KnownChoice::Payload => 158,
    }
    handle.target = 193
    first * 100 + second
}

#[test]
fn structural_and_constant_scrutinees_prune_only_proven_pattern_paths() {
    assert!(nested_payload_match_result() == 13337, "nested payload match")
    assert!(nested_payload_miss_result() == 13539, "nested payload miss")
    assert!(
        unknown_nested_payload_stays_conservative(flag: true) == 15037,
        "unknown nested payload true",
    )
    assert!(
        unknown_nested_payload_stays_conservative(flag: false) == 15037,
        "unknown nested payload false",
    )
    assert!(known_record_payload_match_result() == 14151, "record payload")
    assert!(known_tuple_payload_match_result() == 14357, "tuple payload")
    assert!(known_const_payload_match_result() == 14563, "const payload")
    assert!(
        known_payload_wildcard_fallback_result() == 15179,
        "wildcard fallback",
    )
    assert!(
        divergent_if_scrutinee_keeps_sole_normal_shape(abort: false) == 14767,
        "divergent if scrutinee",
    )
    assert!(
        divergent_match_scrutinee_keeps_sole_normal_shape(abort: false) == 14973,
        "divergent match scrutinee",
    )
    assert!(const_true_rebind_result() == 15381, "const true")
    assert!(const_false_rebind_result() == 15591, "const false")
    assert!(const_enum_rebind_result() == 15793, "const enum")
}
