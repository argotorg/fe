fn deferred_method_diverging_scalar_rebind_result(select_second: bool) -> u256 {
    let mut first: u256 = 1
    let mut second: u256 = 2
    let handle = ScalarHandle { target: mut first }
    let assign = |value, target: mut u256, mut handle: own ScalarHandle| -> ScalarHandle {
        handle.target = if select_second { mut target } else { value.fail() }
        handle
    }

    let returned = assign.call_once(Diverger {}, mut second, handle)
    returned.target = 83
    first * 100 + second
}

