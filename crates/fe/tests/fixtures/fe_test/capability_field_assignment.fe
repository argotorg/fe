#[test]
fn assertion_and_known_constructor_dead_results_do_not_force_write_through() {
    assert!(assert_false_scalar_rebind_result(select_second: true) == 2467)
    assert!(known_variant_scalar_rebind_result() == 2771)
}

#[test]
fn statically_known_wrapped_conditions_discard_dead_payload_results() {
    assert!(block_tail_condition_scalar_rebind_result() == 3883)
    assert!(with_body_condition_scalar_rebind_result() == 4189)
    assert!(nested_if_condition_scalar_rebind_result() == 4497)
}

#[test]
fn pattern_condition_reachability_selects_rebind_or_write_through() {
    assert!(irrefutable_if_let_scalar_rebind_result() == 5101)
    assert!(known_if_let_match_scalar_rebind_result() == 5307)
    assert!(known_if_let_miss_scalar_rebind_result() == 5509)
    assert!(irrefutable_while_let_scalar_rebind_result(select_second: true) == 5927)
    assert!(irrefutable_let_and_scalar_rebind_result(select_second: true) == 6131)
    assert!(dynamic_if_let_scalar_write_result(choice: KnownChoice::Second) == 13763)
    assert!(dynamic_if_let_scalar_write_result(choice: KnownChoice::Payload) == 13763)
    assert!(absorbing_and_scalar_rebind_result(flag: true) == 6539)
    assert!(absorbing_and_scalar_rebind_result(flag: false) == 6539)
    assert!(absorbing_or_scalar_rebind_result(flag: true) == 6749)
    assert!(absorbing_or_scalar_rebind_result(flag: false) == 6749)
    assert!(escape_normal_true_scalar_rebind_result(escape: false) == 6951)
    assert!(escape_normal_true_scalar_rebind_result(escape: true) == 9999)
    assert!(literal_if_let_match_scalar_rebind_result() == 7157)
    assert!(literal_if_let_miss_scalar_rebind_result() == 7363)
    assert!(known_literal_match_scalar_rebind_result() == 7567)
    assert!(known_payload_match_scalar_rebind_result() == 7773)
    assert!(known_payload_miss_scalar_rebind_result() == 7979)
    assert!(match_all_true_scalar_rebind_result(choice: KnownChoice::Second) == 8181)
    assert!(match_all_true_scalar_rebind_result(choice: KnownChoice::Payload) == 8181)
    assert!(match_all_false_scalar_rebind_result(choice: KnownChoice::Second) == 8391)
    assert!(match_all_false_scalar_rebind_result(choice: KnownChoice::Payload) == 8391)
    assert!(match_mixed_scalar_write_result(choice: KnownChoice::Second) == 19385)
    assert!(match_mixed_scalar_write_result(choice: KnownChoice::Payload) == 19385)
    assert!(match_known_scalar_rebind_result() == 8797)
    assert!(match_escape_scalar_rebind_result(choice: KnownChoice::Second) == 8999)
    assert!(match_escape_scalar_rebind_result(choice: KnownChoice::Payload) == 9999)
}

fn completing_short_circuit_write_result(use_capability_value: bool, use_and: bool) -> u256 {
    let mut first: u256 = 30
    let mut second: u256 = 31
    let mut handle = ScalarHandle { target: mut first }

    handle.target = if use_capability_value {
        mut second
    } else if use_and {
        false && core::panic()
        32
    } else {
        true || core::panic()
        33
    }
    handle.target = 73

    first * 100 + second
}

fn completing_loop_write_result(use_capability_value: bool) -> u256 {
    let mut first: u256 = 34
    let mut second: u256 = 35
    let mut handle = ScalarHandle { target: mut first }

    handle.target = if use_capability_value {
        mut second
    } else {
        while true {
            break
        }
        36
    }
    handle.target = 79

    first * 100 + second
}

#[test]
fn completing_short_circuits_and_loops_keep_write_through_semantics() {
    assert!(
        completing_short_circuit_write_result(
            use_capability_value: true,
            use_and: true,
        ) == 7331,
    )
    assert!(
        completing_short_circuit_write_result(
            use_capability_value: false,
            use_and: true,
        ) == 7331,
    )
    assert!(
        completing_short_circuit_write_result(
            use_capability_value: true,
            use_and: false,
        ) == 7331,
    )
    assert!(completing_loop_write_result(use_capability_value: true) == 7935)
    assert!(completing_loop_write_result(use_capability_value: false) == 7935)
}

