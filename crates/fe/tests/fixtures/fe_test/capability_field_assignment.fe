use core::ops::{Add, Neg}

struct ScalarHandle {
    target: mut u256,
}

struct ByteArrayHandle {
    target: mut [u8; 3],
}

struct Cell {
    value: u256,
}

struct CellHandle {
    target: mut Cell,
}

struct NestedScalarHandle {
    target: mut ScalarHandle,
}

enum RebindChoice {
    Second,
    Abort,
}

enum KnownChoice {
    Second,
    Payload,
}

enum KnownPayloadChoice {
    Value(bool),
    Other,
}

enum KnownNestedChoice {
    Flag(bool),
    Count(u256),
}

enum KnownOuterChoice {
    Value(KnownNestedChoice),
    Other,
}

struct KnownRecord {
    flag: bool,
    count: u256,
}

const KNOWN_NESTED_PAYLOAD: KnownOuterChoice =
    KnownOuterChoice::Value(KnownNestedChoice::Flag(true))
const KNOWN_TRUE: bool = true
const KNOWN_FALSE: bool = false
const KNOWN_CHOICE: KnownChoice = KnownChoice::Second

struct Diverger {}

struct NeverWrapper {
    value: u256,
}

impl Diverger {
    fn fail(self) -> ! {
        core::panic()
    }

    fn fail_mut(mut self) -> ! {
        core::panic()
    }
}

fn make_diverger() -> Diverger {
    Diverger {}
}

fn scalar_rebind_result() -> u256 {
    let mut first: u256 = 1
    let mut second: u256 = 2
    let mut handle = ScalarHandle { target: mut first }

    handle.target = mut second
    handle.target = 7

    first * 100 + second
}

#[test]
fn scalar_capability_field_rebind_survives_a_function_boundary() {
    assert!(scalar_rebind_result() == 107)
}

#[test]
fn direct_write_through_scalar_capability_field_updates_the_target() {
    let mut value: u256 = 1
    let mut handle = ScalarHandle { target: mut value }

    handle.target = 7

    assert!(value == 7)
}

fn refined_capability_join_result() -> u256 {
    let mut first: u256 = 1
    let mut second: u256 = 2
    let known = true
    let selected = if known { mut first } else { mut second }

    selected = 9
    first * 100 + second
}

fn dynamic_capability_join_result(select_first: bool) -> u256 {
    let mut first: u256 = 1
    let mut second: u256 = 2
    let selected = if select_first { mut first } else { mut second }

    selected = 9
    first * 100 + second
}

fn refined_handle_join_result() -> u256 {
    let mut first: u256 = 1
    let mut second: u256 = 2
    let known = true
    let selected = if known {
        ScalarHandle { target: mut first }
    } else {
        ScalarHandle { target: mut second }
    }

    selected.target = 9
    first * 100 + second
}

fn dynamic_handle_join_result(select_first: bool) -> u256 {
    let mut first: u256 = 1
    let mut second: u256 = 2
    let selected = if select_first {
        ScalarHandle { target: mut first }
    } else {
        ScalarHandle { target: mut second }
    }

    selected.target = 9
    first * 100 + second
}

#[test]
fn capability_join_uses_only_executable_sources() {
    assert!(refined_capability_join_result() == 902)
    assert!(dynamic_capability_join_result(select_first: true) == 902)
    assert!(dynamic_capability_join_result(select_first: false) == 109)
    assert!(refined_handle_join_result() == 902)
    assert!(dynamic_handle_join_result(select_first: true) == 902)
    assert!(dynamic_handle_join_result(select_first: false) == 109)
}

#[test]
fn extracted_scalar_capability_after_field_rebind_updates_the_new_target() {
    let mut first: u256 = 1
    let mut second: u256 = 2
    let mut handle = ScalarHandle { target: mut first }

    handle.target = mut second
    let target = handle.target
    target = 9

    assert!(first == 1, "rebind changed the old scalar target")
    assert!(second == 9, "extracted handle did not update the new scalar target")
}

#[test]
fn direct_write_after_scalar_capability_field_rebind_updates_the_new_target() {
    let mut first: u256 = 3
    let mut second: u256 = 4
    let mut handle = ScalarHandle { target: mut first }

    handle.target = mut second
    handle.target = 11

    assert!(first == 3, "direct rebind changed the old scalar target")
    assert!(second == 11, "direct write did not update the new scalar target")
}

#[test]
fn projected_write_after_aggregate_capability_field_rebind_updates_the_new_target() {
    let mut first = Cell { value: 5 }
    let mut second = Cell { value: 6 }
    let mut handle = CellHandle { target: mut first }

    handle.target = mut second
    handle.target.value = 13

    assert!(first.value == 5, "rebind changed the old aggregate target")
    assert!(
        second.value == 13,
        "projected write did not update the new aggregate target",
    )
}

fn conditional_scalar_rebind_result(select_second: bool) -> u256 {
    let mut first: u256 = 1
    let mut second: u256 = 2
    let mut third: u256 = 3
    let mut handle = ScalarHandle { target: mut first }

    handle.target = if select_second { mut second } else { mut third }
    handle.target = 17

    first * 10000 + second * 100 + third
}

#[test]
fn capability_field_rebind_preserves_control_flow_sources() {
    assert!(conditional_scalar_rebind_result(select_second: true) == 11703)
    assert!(conditional_scalar_rebind_result(select_second: false) == 10217)
}

