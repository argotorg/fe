use core::ptr
use core::ptr::MemArray

// Every call below writes through a pointer loaded from raw memory, which may
// overwrite the pointers stored next to it. Borrow checking must keep the
// resulting replacement families bounded across calls and loop iterations.

struct Arr<T> {
    ptr: *T,
    len: u256,
}

impl<T> Copy for Arr<T> {}

impl<T> Arr<T> {
    fn new(_ len: u256) -> Self {
        // The array outlives this frame, so its owner is forgotten.
        let array = unsafe { MemArray<T>::new_uninit(len.downcast_unchecked()) }
        let ptr = array.ptr_at(0)
        core::mem::forget(array)
        Arr { ptr, len }
    }

    fn at(self, _ i: u256) -> *T {
        if i >= self.len {
            core::panic()
        }
        ptr::offset(self.ptr, i.downcast_unchecked())
    }
}

struct Item {
    t: u256,
    id: u256,
}

impl Copy for Item {}

struct Pair {
    a: Arr<Item>,
    b: Arr<Item>,
    n: u256,
}

impl Copy for Pair {}

fn update(_ items: Arr<Item>, _ value: u256) {
    let item = items.at(0)
    unsafe { item.t = item.t + value }
}

fn step(_ pairs: Arr<Pair>, _ i: u256) {
    let pair = pairs.at(i)
    unsafe { update(pair.a, 1) }
    unsafe { update(pair.b, 2) }
}

fn apply(_ pairs: Arr<Pair>, n: u256) {
    var i: u256 = 0
    while i < n {
        step(pairs, i)
        i += 1
    }
}

fn apply_inline(_ pairs: Arr<Pair>, n: u256) {
    var i: u256 = 0
    while i < n {
        let pair = pairs.at(i)
        unsafe { update(pair.a, 20) }
        unsafe { update(pair.b, 40) }
        i += 1
    }
}

fn apply_straight(_ pairs: Arr<Pair>) {
    let pair = pairs.at(1)
    unsafe { update(pair.a, 200) }
    unsafe { update(pair.b, 200) }
    unsafe { update(pair.a, 200) }
    unsafe { update(pair.b, 200) }
}

fn pairs(_ n: u256) -> Arr<Pair> {
    let pairs = Arr<Pair>::new(n)
    var i: u256 = 0
    while i < n {
        let a = Arr<Item>::new(1)
        let b = Arr<Item>::new(1)
        unsafe { *a.at(0) = Item { t: 0, id: i } }
        unsafe { *b.at(0) = Item { t: 0, id: i } }
        unsafe { *pairs.at(i) = Pair { a, b, n: i } }
        i += 1
    }
    pairs
}

fn item(_ pairs: Arr<Pair>, _ i: u256, second: bool) -> *Item {
    let pair = pairs.at(i)
    let items = unsafe { if second { pair.b } else { pair.a } }
    items.at(0)
}

#[test]
fn writes_through_stored_pointers_in_loops() {
    let pairs = pairs(2)
    apply(pairs, n: 2)
    apply_inline(pairs, n: 2)
    apply_straight(pairs)
    let first_a = item(pairs, 0, second: false)
    let first_b = item(pairs, 0, second: true)
    let last_a = item(pairs, 1, second: false)
    let last_b = item(pairs, 1, second: true)
    unsafe { assert(first_a.t == 21) }
    unsafe { assert(first_b.t == 42) }
    unsafe { assert(last_a.t == 421) }
    unsafe { assert(last_b.t == 442) }
    unsafe { assert(last_b.id == 1) }
}
