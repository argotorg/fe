// Regression test for `#[event]` structs with many data fields.
//
// The generated `emit` is built from one flat sequence of field operations, so
// the size of the generated code grows with the number of fields. It used to
// nest the code of the earlier fields in the code of each later one, and an
// event of 47 or more non-indexed fields was refused with "generated code tree
// exceeds the expanded AST node limit of 4096". `event_dynamic.rs` asserts the
// emitted log: one word for each field, in declaration order.

use std::evm::{Evm, Log}

#[event]
struct Wide {
    f0: u256,
    f1: u256,
    f2: u256,
    f3: u256,
    f4: u256,
    f5: u256,
    f6: u256,
    f7: u256,
    f8: u256,
    f9: u256,
    f10: u256,
    f11: u256,
    f12: u256,
    f13: u256,
    f14: u256,
    f15: u256,
    f16: u256,
    f17: u256,
    f18: u256,
    f19: u256,
    f20: u256,
    f21: u256,
    f22: u256,
    f23: u256,
    f24: u256,
    f25: u256,
    f26: u256,
    f27: u256,
    f28: u256,
    f29: u256,
    f30: u256,
    f31: u256,
    f32: u256,
    f33: u256,
    f34: u256,
    f35: u256,
    f36: u256,
    f37: u256,
    f38: u256,
    f39: u256,
    f40: u256,
    f41: u256,
    f42: u256,
    f43: u256,
    f44: u256,
    f45: u256,
    f46: u256,
    f47: u256,
    f48: u256,
    f49: u256,
    f50: u256,
    f51: u256,
    f52: u256,
    f53: u256,
    f54: u256,
    f55: u256,
    f56: u256,
    f57: u256,
    f58: u256,
    f59: u256,
    f60: u256,
    f61: u256,
    f62: u256,
    f63: u256,
    f64: u256,
    f65: u256,
    f66: u256,
    f67: u256,
    f68: u256,
    f69: u256,
    f70: u256,
    f71: u256,
    f72: u256,
    f73: u256,
    f74: u256,
    f75: u256,
    f76: u256,
    f77: u256,
    f78: u256,
    f79: u256,
    f80: u256,
    f81: u256,
    f82: u256,
    f83: u256,
    f84: u256,
    f85: u256,
    f86: u256,
    f87: u256,
    f88: u256,
    f89: u256,
    f90: u256,
    f91: u256,
    f92: u256,
    f93: u256,
    f94: u256,
    f95: u256,
    f96: u256,
    f97: u256,
    f98: u256,
    f99: u256,
}

msg ProbeMsg {
    #[selector = sol("emitWide()")]
    EmitWide -> u256,
}

pub contract Probe uses (log: mut Log) {
    recv ProbeMsg {
        EmitWide -> u256 uses (mut log) {
            log.emit(Wide {
                f0: 0,
                f1: 1,
                f2: 2,
                f3: 3,
                f4: 4,
                f5: 5,
                f6: 6,
                f7: 7,
                f8: 8,
                f9: 9,
                f10: 10,
                f11: 11,
                f12: 12,
                f13: 13,
                f14: 14,
                f15: 15,
                f16: 16,
                f17: 17,
                f18: 18,
                f19: 19,
                f20: 20,
                f21: 21,
                f22: 22,
                f23: 23,
                f24: 24,
                f25: 25,
                f26: 26,
                f27: 27,
                f28: 28,
                f29: 29,
                f30: 30,
                f31: 31,
                f32: 32,
                f33: 33,
                f34: 34,
                f35: 35,
                f36: 36,
                f37: 37,
                f38: 38,
                f39: 39,
                f40: 40,
                f41: 41,
                f42: 42,
                f43: 43,
                f44: 44,
                f45: 45,
                f46: 46,
                f47: 47,
                f48: 48,
                f49: 49,
                f50: 50,
                f51: 51,
                f52: 52,
                f53: 53,
                f54: 54,
                f55: 55,
                f56: 56,
                f57: 57,
                f58: 58,
                f59: 59,
                f60: 60,
                f61: 61,
                f62: 62,
                f63: 63,
                f64: 64,
                f65: 65,
                f66: 66,
                f67: 67,
                f68: 68,
                f69: 69,
                f70: 70,
                f71: 71,
                f72: 72,
                f73: 73,
                f74: 74,
                f75: 75,
                f76: 76,
                f77: 77,
                f78: 78,
                f79: 79,
                f80: 80,
                f81: 81,
                f82: 82,
                f83: 83,
                f84: 84,
                f85: 85,
                f86: 86,
                f87: 87,
                f88: 88,
                f89: 89,
                f90: 90,
                f91: 91,
                f92: 92,
                f93: 93,
                f94: 94,
                f95: 95,
                f96: 96,
                f97: 97,
                f98: 98,
                f99: 99,
            })
            let ret: u256 = 1
            ret
        }
    }
}

#[test]
fn emit_wide_event() uses (evm: mut Evm) {
    let c = evm.create2<Probe>(value: Wei::zero(), args: (), salt: 0)
    let r: u256 = evm.call(addr: c, gas: 5000000, value: Wei::zero(), message: ProbeMsg::EmitWide {})
    assert!(r == 1)
}
