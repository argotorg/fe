use core::functional::{Fn, FnOnce}
use core::option::Option::{self, Some}

struct Boxed {
    value: u256,
}

impl Boxed {
    fn read_via_closure(self) -> u256 {
        let read = || self.value
        read.call()
    }
}

struct Borrowed {
    value: ref u256,
}

struct MutHolder {
    value: mut u256,
}

struct BoxedHolder {
    boxed: Boxed,
}

struct ViewPair {
    left: view Boxed,
    right: view Boxed,
}

struct ScalarViewPair {
    left: view u256,
    right: view u256,
}

struct MutBoxedPair {
    left: mut Boxed,
    right: mut Boxed,
}

struct NestedView {
    boxed: view Boxed,
}

struct NestedViewPair {
    left: view NestedView,
    right: view NestedView,
}

struct MutableNestedView {
    boxed: view Boxed,
    count: u256,
}

struct TwoMut {
    left: mut u256,
    right: mut u256,
}

struct ScalarPair {
    left: u256,
    right: u256,
}

struct ClosureHolder<F> {
    function: F,
}

struct ClosureValueHolder<F> {
    function: F,
    value: u256,
}

struct view {
    value: u256,
}

enum Mixed {
    Value(u256, Boxed),
}

enum ViewChoice {
    Pair(view Boxed, view Boxed),
    Empty,
}

trait Marker {}

struct MarkerImpl {}

impl Marker for MarkerImpl {}

fn marker_zero<T: Marker>(_ marker: T) -> u256 {
    0
}

struct AddPair {}

struct FortyTwo {}

struct AddInto {}

struct TakeBoxed {
    boxed: Boxed,
}

struct Overloaded {}

struct ReusableOrOnce {}

impl FnOnce<(u256, u256), u256> for AddPair {
    fn call_once(self: own Self, _ args: own (u256, u256)) -> u256 {
        self.call(args.0, args.1)
    }
}

impl Fn<(u256, u256), u256> for AddPair {
    fn call(self, _ args: own (u256, u256)) -> u256 {
        args.0 + args.1
    }
}

impl FnOnce<(), u256> for FortyTwo {
    fn call_once(self: own Self, _ args: own ()) -> u256 {
        42
    }
}

impl Fn<(), u256> for FortyTwo {
    fn call(self, _ args: own ()) -> u256 {
        42
    }
}

impl FnOnce<(mut u256, view u256), ()> for AddInto {
    fn call_once(self: own Self, _ args: own (mut u256, view u256)) {
        self.call(args.0, args.1)
    }
}

impl Fn<(mut u256, view u256), ()> for AddInto {
    fn call(self, mut _ args: own (mut u256, view u256)) {
        args.0 += args.1
    }
}

impl FnOnce<(), Boxed> for TakeBoxed {
    fn call_once(self: own Self, _ args: own ()) -> Boxed {
        self.boxed
    }
}

impl FnOnce<(u256,), u256> for Overloaded {
    fn call_once(self: own Self, _ args: own (u256,)) -> u256 {
        args.0 + 1
    }
}

impl Fn<(u256,), u256> for Overloaded {
    fn call(self, _ args: own (u256,)) -> u256 {
        args.0 + 1
    }
}

impl FnOnce<(bool,), bool> for Overloaded {
    fn call_once(self: own Self, _ args: own (bool,)) -> bool {
        !args.0
    }
}

impl Fn<(bool,), bool> for Overloaded {
    fn call(self, _ args: own (bool,)) -> bool {
        !args.0
    }
}

impl FnOnce<(u256,), u256> for ReusableOrOnce {
    fn call_once(self: own Self, _ args: own (u256,)) -> u256 {
        args.0 + 1
    }
}

impl Fn<(u256,), u256> for ReusableOrOnce {
    fn call(self, _ args: own (u256,)) -> u256 {
        args.0 + 1
    }
}

impl FnOnce<(bool,), bool> for ReusableOrOnce {
    fn call_once(self: own Self, _ args: own (bool,)) -> bool {
        !args.0
    }
}

enum Choice {
    Left,
    Right,
}

fn invoke<T, U, F: Fn<(T,), U>>(_ func: F, _ value: own T) -> U {
    func.call(value)
}

fn invoke_once<T, U, F: FnOnce<(T,), U>>(_ func: own F, _ value: own T) -> U {
    func.call_once(value)
}

fn invoke_direct<T, U, F: Fn<(T,), U>>(_ func: F, _ value: own T) -> U {
    func(value)
}

fn invoke_once_direct<T, U, F: FnOnce<(T,), U>>(_ func: own F, _ value: own T) -> U {
    func(value)
}

fn invoke_zero_once<U, F: FnOnce<(), U>>(_ func: own F) -> U {
    func.call_once()
}

fn invoke_zero<T, F: Fn<(), T>>(_ func: F) -> T {
    func.call()
}

fn invoke_reusable_once<T, U, F: Fn<(T,), U>>(_ func: own F, _ value: own T) -> U {
    func.call_once(value)
}

fn apply_view<T, F: Fn<(view T,), T>>(_ func: F, _ value: own T) -> T {
    func.call(value)
}

fn read_named_view(_ value: view) -> u256 {
    value.value
}

fn write_mut(_ target: mut u256, _ value: u256) {
    target = value
}

fn consume_boxed(_ boxed: own Boxed) {}

fn call_with_owned_capture(_ boxed: own Boxed) -> u256 {
    let add_boxed = |value: own u256| -> u256 { value + boxed.value }
    add_boxed.call(1)
}

fn call_with_ref_and_owned_capture(_ boxed: own Boxed) -> u256 {
    let x: u256 = 1
    let r = ref x
    let add_both = |value: own u256| -> u256 { value + r + boxed.value }
    add_both.call(40)
}

fn closure_passthrough<T>(_ value: own T) -> T {
    let passthrough = |_ unit: own ()| -> T { value }
    passthrough.call_once(())
}

fn generic_identity_closure<T>(_ value: own T) -> T {
    let identity = |value: own T| -> T { value }
    identity.call_once(value)
}

fn closure_const<const N: u256>() -> u256 {
    let value = |_ unit: own ()| -> u256 { N }
    value.call(())
}

fn call_closure_before_diverging() -> ! {
    let answer = |_ unit: own ()| -> u256 { 42 }
    assert(answer.call(()) == 42)
    core::panic_with_value(0 as u256)
}

#[arithmetic(unchecked)]
mod unchecked_parent {
    use core::functional::Fn

    #[arithmetic(checked)]
    pub fn checked_closure_overflow() -> u8 {
        let add_one = |value: own u8| -> u8 { value + 1 }
        add_one.call(255)
    }
}

#[test]
fn test_closure_call_method() {
    let offset: u256 = 1
    let inc = |value: own u256| -> u256 { value + offset }
    assert(inc.call(41) == 42)
}

#[test]
fn test_closure_captured_view_aggregate_projection() {
    let boxed = Boxed { value: 42 }
    assert(boxed.read_via_closure() == 42)
    assert(boxed.value == 42)
}

#[test]
fn test_reusable_closure_projected_from_aggregate() {
    let value: u256 = 21
    let shared = ref value
    let read = || -> u256 { shared }
    let holder = ClosureHolder { function: read }
    assert(holder.function.call() == 21)
    assert(holder.function.call() == 21)
}

#[test]
fn test_projected_closure_repeated_mut_return_after_last_use() {
    let mut value = 0
    let captured = mut value
    let get = || captured
    let holder = ClosureHolder { function: get }
    let first = holder.function.call()
    write_mut(first, 20)
    let second = holder.function.call()
    write_mut(second, 42)
    assert(value == 42)
}

fn exercise_dynamic_closure_projection(_ index: usize) {
    let mut value = 0
    let captured = mut value
    let get = || captured
    let functions = [get]
    let first = functions[index].call()
    write_mut(first, 20)
    let second = functions[index].call()
    write_mut(second, 42)
    assert(value == 42)
}

#[test]
fn test_dynamic_closure_projection_preserves_mut_capture() {
    exercise_dynamic_closure_projection(0)
}

fn exercise_dynamic_projection_of_returned_closures(_ index: usize) -> u256 {
    let mut left = 0
    let mut right = 0
    let make = |target: mut u256| {
        let project = || -> mut u256 { target }
        project
    }
    let functions = [make.call(mut left), make.call(mut right)]
    let selected = functions[index].call()
    selected = 42
    left + right
}

#[test]
fn test_dynamic_projection_of_returned_closures_preserves_each_environment() {
    assert(exercise_dynamic_projection_of_returned_closures(0) == 42)
    assert(exercise_dynamic_projection_of_returned_closures(1) == 42)
}

fn exercise_dynamic_ref_borrowed_closure_projection(_ index: usize) {
    let mut value = 0
    let captured = mut value
    let get = || captured
    let functions = [get, get]
    let borrowed = ref functions
    let first = borrowed[index].call()
    write_mut(first, 20)
    let second = borrowed[index].call()
    write_mut(second, 42)
    assert(value == 42)
}

#[test]
fn test_dynamic_ref_borrowed_closure_projection_preserves_mut_capture() {
    exercise_dynamic_ref_borrowed_closure_projection(0)
}

#[test]
fn test_borrowed_closure_holder_preserves_mut_capture() {
    let mut value = 0
    let captured = mut value
    let get = || captured
    let mut holder = ClosureHolder { function: get }
    let borrowed = mut holder
    let first = borrowed.function.call()
    write_mut(first, 20)
    let second = borrowed.function.call()
    write_mut(second, 42)
    assert(value == 42)
}

#[test]
fn test_captured_mut_handle_can_be_reborrowed() {
    let mut value: u256 = 0
    let captured = mut value
    let borrow = || -> mut u256 { mut captured }
    let returned = borrow.call()
    write_mut(returned, 42)
    assert(value == 42)
}

#[test]
fn test_closure_mut_parameter_can_be_reborrowed() {
    let mut value: u256 = 0
    let parent = mut value
    let reborrow = |target: mut u256| -> mut u256 { mut target }
    let returned = reborrow.call(parent)
    returned = 42
    assert(value == 42)
}

#[test]
fn test_captured_mut_handle_can_be_written_through() {
    let mut value: u256 = 0
    let captured = mut value
    let write = || {
        captured = 42
    }
    write.call()
    assert(value == 42)
}

#[test]
fn test_captured_mut_handle_field_can_be_written_through() {
    let mut value: u256 = 0
    let holder = MutHolder { value: mut value }
    let write = || {
        holder.value = 42
    }
    write.call()
    assert(value == 42)
}

#[test]
fn test_captured_mut_handle_field_can_be_reborrowed() {
    let mut value: u256 = 0
    let holder = MutHolder { value: mut value }
    let borrow = || -> mut u256 { mut holder.value }
    let returned = borrow.call()
    write_mut(returned, 42)
    assert(value == 42)
}

#[test]
fn test_captured_mut_aggregate_handle_can_project_for_write() {
    let mut boxed = Boxed { value: 0 }
    let handle = mut boxed
    let write = || {
        handle.value = 42
    }
    write.call()
    assert(boxed.value == 42)
}

#[test]
fn test_nested_closure_can_write_through_captured_mut_handle() {
    let mut value: u256 = 0
    let captured = mut value
    let outer = || {
        let inner = || {
            captured = 42
        }
        inner.call()
    }
    outer.call()
    assert(value == 42)
}

#[test]
fn test_captured_ref_handle_can_be_reborrowed() {
    let value: u256 = 42
    let captured = ref value
    let borrow = || -> ref u256 { ref captured }
    let returned = borrow.call()
    assert(returned == 42)
}

#[test]
fn test_captured_array_of_mut_handles_can_project_for_write() {
    let mut value = 0
    let handles: [mut u256; 1] = [mut value]
    let write = || {
        handles[0] = 42
    }
    write.call()
    assert(value == 42)
}

#[test]
fn test_captured_mut_array_handle_can_dynamically_project_for_write() {
    let mut values = [0 as u256, 0]
    let handle = mut values
    let write = |index: own usize| {
        handle[index] = 42
    }
    write.call(1)
    assert(values[1] == 42)
}

#[test]
fn test_inferred_mut_aggregate_parameter_can_project_for_write() {
    let mut boxed = Boxed { value: 0 }
    let write = |target: mut| {
        target.value = 42
    }
    write.call(mut boxed)
    assert(boxed.value == 42)
}

#[test]
fn test_deferred_inferred_mut_parameter_stored_in_struct_writes_pointee() {
    let write = |target: mut| {
        target = 42
    }
    let holder = ClosureHolder { function: write }
    let mut value: u256 = 0
    holder.function.call(mut value)
    assert(value == 42)
}

#[test]
fn test_stored_closure_receiver_and_mut_argument_use_disjoint_fields() {
    let write = |target: mut u256| {
        target = 42
    }
    let mut holder = ClosureValueHolder {
        function: write,
        value: 0,
    }
    holder.function.call(mut holder.value)
    assert(holder.value == 42)
}

#[test]
fn test_deferred_capability_parameters_through_dynamic_and_nested_closures() {
    let write = |target: mut| {
        target = 20
    }
    let functions = [write, write]
    let index: usize = 1
    let mut value: u256 = 0
    functions[index].call(mut value)

    let make = |target: mut| {
        let add = || {
            target += 22
        }
        add
    }
    let holder = ClosureHolder { function: make }
    let add = holder.function.call(mut value)
    add.call()
    assert(value == 42)
}

#[test]
fn test_inferred_handle_array_parameter_uses_element_capability() {
    let mut value = 0
    let handles: [mut u256; 1] = [mut value]
    let increment = |items| {
        items[0] += 1
    }
    increment.call(handles)

    let handles: [mut u256; 1] = [mut value]
    let borrow = |items| -> mut u256 { mut items[0] }
    let returned = borrow.call(handles)
    returned = 42
    assert(value == 42)
}

#[test]
fn test_inferred_owned_aggregate_parameter_can_return_a_borrow() {
    let borrow = |boxed: own| -> ref u256 { ref boxed.value }
    let returned = borrow.call_once(Boxed { value: 42 })
    assert(returned == 42)
}

#[test]
fn test_owned_aggregate_parameter_can_return_a_whole_view() {
    let borrow = |boxed: own Boxed| -> view Boxed { boxed }
    let first = borrow.call(Boxed { value: 20 })
    let second = borrow.call(Boxed { value: 22 })
    assert(first.value + second.value == 42)

    let borrow_mut = |mut boxed: own Boxed| -> mut Boxed { mut boxed }
    let first_mut = borrow_mut.call(Boxed { value: 0 })
    let second_mut = borrow_mut.call(Boxed { value: 0 })
    first_mut.value = 20
    second_mut.value = 22
    assert(first_mut.value + second_mut.value == 42)
}

#[test]
fn test_returned_closure_can_borrow_its_owned_environment() {
    let make = |boxed: own Boxed| {
        let read = || -> ref u256 { ref boxed.value }
        read
    }
    let read = make.call_once(Boxed { value: 42 })
    let returned = read.call()
    assert(returned == 42)
}

#[test]
fn test_consuming_closure_can_return_borrow_into_moved_environment() {
    let borrowed = Boxed { value: 42 }
    let consumed = Boxed { value: 0 }
    let borrow_once = || -> ref u256 {
        consume_boxed(consumed)
        ref borrowed.value
    }
    let returned = borrow_once.call_once()
    assert(returned == 42)
}

#[test]
fn test_returned_closure_preserves_a_mut_parameter_handle() {
    let mut value = 0
    let make = |handle: mut u256| {
        let write = || {
            handle = 42
        }
        write
    }
    let write = make.call(mut value)
    write.call()
    assert(value == 42)
}

#[test]
fn test_returned_closure_preserves_default_view_rvalue_backing_storage() {
    let make = |boxed| {
        || boxed.value
    }
    let read = make.call(Boxed { value: 42 })
    assert(read.call() == 42)
}

#[test]
fn test_copy_capture_closure_is_copyable() {
    let offset = 1
    let add = |value: own u256| value + offset
    let copied = add
    assert(add.call(20) + copied.call(20) == 42)
}

#[test]
fn test_aggregate_return_preserves_multiple_mut_handles() {
    let mut left = 0
    let mut right = 0
    let borrow_both = |left: mut u256, right: mut u256| -> TwoMut {
        TwoMut { left, right }
    }
    let returned = borrow_both.call(mut left, mut right)
    returned.left = 20
    returned.right = 22
    assert(left + right == 42)
}

#[test]
fn test_array_return_preserves_multiple_mut_handles() {
    let mut left = 0
    let mut right = 0
    let borrow_both = |left: mut u256, right: mut u256| -> [mut u256; 2] {
        [left, right]
    }
    let returned = borrow_both.call(mut left, mut right)
    returned[0] = 20
    returned[1] = 22
    assert(left + right == 42)
}

#[test]
fn test_option_map_closure_capture() {
    let offset: u256 = 10
    let input: Option<u256> = Some(32)
    let result = input.map(|value: own u256| -> u256 { value + offset }).unwrap()
    assert(result == 42)
}

#[test]
fn test_readonly_noncopy_capture_is_reusable() {
    let boxed = Boxed { value: 20 }
    let read = |_ unit: own ()| -> u256 { boxed.value }
    let first = invoke(func: read, value: ())
    let second = read.call(())
    assert(first + second == 40)
}

#[test]
fn test_consuming_capture_call_once() {
    let boxed = Boxed { value: 42 }
    let take = |_ unit: own ()| -> Boxed { boxed }
    let result = take.call_once(())
    assert(result.value == 42)
}

#[test]
fn test_consuming_capture_generic_call_once() {
    let boxed = Boxed { value: 42 }
    let take = |_ unit: own ()| -> Boxed { boxed }
    let result = invoke_once(func: take, value: ())
    assert(result.value == 42)
}

#[test]
fn test_match_consuming_capture_call_once() {
    let wrapped: Option<Boxed> = Some(Boxed { value: 42 })
    let take = |_ unit: own ()| -> Boxed {
        match wrapped {
            Some(value) => value,
            Option::None => Boxed { value: 0 },
        }
    }
    assert(take.call_once(()).value == 42)
}

#[test]
fn test_match_consuming_capture_generic_call_once() {
    let wrapped: Option<Boxed> = Some(Boxed { value: 42 })
    let take = |_ unit: own ()| -> Boxed {
        match wrapped {
            Some(value) => value,
            Option::None => Boxed { value: 0 },
        }
    }
    assert(invoke_once(func: take, value: ()).value == 42)
}

#[test]
fn test_if_let_consuming_capture_call_once() {
    let wrapped: Option<Boxed> = Some(Boxed { value: 42 })
    let take = |_ unit: own ()| -> Boxed {
        if let Some(value) = wrapped {
            value
        } else {
            Boxed { value: 0 }
        }
    }
    assert(take.call_once(()).value == 42)
}

#[test]
fn test_match_without_payload_binding_is_reusable() {
    let wrapped: Option<Boxed> = Some(Boxed { value: 42 })
    let is_some = |_ unit: own ()| -> bool {
        match wrapped {
            Some(_) => true,
            Option::None => false,
        }
    }
    assert(is_some.call(()))
    assert(is_some.call(()))
}

#[test]
fn test_match_borrowed_capture_is_reusable() {
    let wrapped: Option<Boxed> = Some(Boxed { value: 21 })
    let read = |_ unit: own ()| -> u256 {
        match ref wrapped {
            Some(value) => value.value,
            Option::None => 0,
        }
    }
    assert(read.call(()) + read.call(()) == 42)
}

#[test]
fn test_match_copy_scrutinee_capture_is_reusable() {
    let wrapped: (u256,) = (21,)
    let take = |_ unit: own ()| -> u256 {
        match wrapped {
            (value,) => value,
        }
    }
    assert(take.call(()) + take.call(()) == 42)
}

#[test]
fn test_inferred_copy_capture_is_reusable() {
    let value = 21
    let read = |_ unit: own ()| -> u256 { value }
    assert(read.call(()) + read.call(()) == 42)
}

#[test]
fn test_copy_pattern_binding_from_noncopy_capture_is_reusable() {
    let mixed = Mixed::Value(21, Boxed { value: 1 })
    let read = |_ unit: own ()| -> u256 {
        match mixed {
            Mixed::Value(value, _) => value,
        }
    }
    let first = invoke(func: read, value: ())
    let second = read.call(())
    assert(first + second == 42)
}

#[test]
fn test_block_wrapped_pattern_capture_call_once() {
    let mixed = Mixed::Value(0, Boxed { value: 42 })
    let take = |_ unit: own ()| -> Boxed {
        let Mixed::Value(_, owned) = { mixed }
        owned
    }
    assert(take.call_once(()).value == 42)
}

#[test]
fn test_block_wrapped_pattern_capture_generic_call_once() {
    let mixed = Mixed::Value(0, Boxed { value: 42 })
    let take = |_ unit: own ()| -> Boxed {
        let Mixed::Value(_, owned) = { mixed }
        owned
    }
    assert(invoke_once(func: take, value: ()).value == 42)
}

#[test]
fn test_with_wrapped_pattern_capture_generic_call_once() {
    let mixed = Mixed::Value(0, Boxed { value: 42 })
    let take = |_ unit: own ()| -> Boxed {
        let Mixed::Value(_, owned) = with (Marker = MarkerImpl {}) { mixed }
        owned
    }
    assert(invoke_once(func: take, value: ()).value == 42)
}

#[test]
fn test_cast_wrapped_pattern_capture_generic_call_once() {
    let mixed = Mixed::Value(0, Boxed { value: 42 })
    let take = |_ unit: own ()| -> Boxed {
        let Mixed::Value(_, owned) = mixed as Mixed
        owned
    }
    assert(invoke_once(func: take, value: ()).value == 42)
}

#[test]
fn test_if_wrapped_pattern_capture_generic_call_once() {
    let mixed = Mixed::Value(0, Boxed { value: 42 })
    let take = |pick_left: own bool| -> Boxed {
        let Mixed::Value(_, owned) = if pick_left { mixed } else { mixed }
        owned
    }
    assert(invoke_once(func: take, value: true).value == 42)
}

#[test]
fn test_match_wrapped_pattern_capture_generic_call_once() {
    let mixed = Mixed::Value(0, Boxed { value: 42 })
    let take = |choice: own Choice| -> Boxed {
        let Mixed::Value(_, owned) = match choice {
            Choice::Left => mixed,
            Choice::Right => mixed,
        }
        owned
    }
    assert(invoke_once(func: take, value: Choice::Left).value == 42)
}

#[test]
fn test_block_wrapped_copy_pattern_capture_is_reusable() {
    let mixed = Mixed::Value(21, Boxed { value: 1 })
    let read = |_ unit: own ()| -> u256 {
        let Mixed::Value(value, _) = { mixed }
        value
    }
    let first = invoke(func: read, value: ())
    let second = read.call(())
    assert(first + second == 42)
}

#[test]
fn test_option_map_consuming_closure() {
    let boxed = Boxed { value: 42 }
    let result: Boxed = Some(()).map(|_ unit: own ()| -> Boxed { boxed }).unwrap()
    assert(result.value == 42)
}

