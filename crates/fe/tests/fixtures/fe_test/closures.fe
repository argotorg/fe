#[test]
fn test_closures_return_disjoint_stored_mut_fields_through_ref_container() {
    let mut left = 0
    let mut right = 0
    let handles = TwoMut {
        left: mut left,
        right: mut right,
    }
    let borrowed = ref handles
    let project_left = || -> mut u256 {
        let TwoMut { left, right: _ } = borrowed
        left
    }
    let project_right = || -> mut u256 {
        let TwoMut { left: _, right } = borrowed
        right
    }

    let returned_left = project_left.call()
    let returned_right = project_right.call()
    returned_left = 20
    returned_right = 22
    assert(left + right == 42)
}

