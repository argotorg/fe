#[test]
fn test_ref_borrowed_tuple_and_enum_closure_projections_preserve_mut_capture() {
    let mut tuple_value = 0
    let tuple_capture = mut tuple_value
    let tuple_project = || -> mut u256 { tuple_capture }
    let tuple = (tuple_project, 0 as u256)
    let (tuple_projected, _) = ref tuple
    let first = tuple_projected.call()
    first = 20
    let second = tuple_projected.call()
    second = 42
    assert(tuple_value == 42)

    let mut enum_value = 0
    let enum_capture = mut enum_value
    let enum_project = || -> mut u256 { enum_capture }
    let wrapped = Some(enum_project)
    let Option::Some(enum_projected) = ref wrapped
    let first = enum_projected.call()
    first = 20
    let second = enum_projected.call()
    second = 42
    assert(enum_value == 42)
}

#[test]
fn test_copied_mut_capture_closure_returns_are_reusable_after_last_use() {
    let mut value = 0
    let captured = mut value
    let project = || -> mut u256 { captured }
    let copied = project

    let first = project.call()
    first = 20
    let second = copied.call()
    second = 42
    assert(value == 42)
}

#[test]
fn test_mutable_pattern_bindings_alias_struct_tuple_and_enum_payloads() {
    let mut holder = BoxedHolder { boxed: Boxed { value: 0 } }
    let BoxedHolder { boxed } = mut holder
    boxed.value = 40

    let mut pair = (Boxed { value: 0 }, 2 as u256)
    let (boxed, _) = mut pair
    boxed.value = 41

    let mut wrapped: Option<Boxed> = Some(Boxed { value: 0 })
    match mut wrapped {
        Option::Some(boxed) => boxed.value = 42,
        Option::None => (),
    }

    assert(holder.boxed.value == 40)
    assert(pair.0.value == 41)
    let Option::Some(boxed) = wrapped
    assert(boxed.value == 42)
}

