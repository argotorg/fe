#[test]
fn test_closure_mutable_enum_pattern_binding_aliases_captured_payload() {
    let mut wrapped: Option<Boxed> = Some(Boxed { value: 0 })
    let handle = mut wrapped
    let write = || {
        match handle {
            Option::Some(boxed) => boxed.value = 42,
            Option::None => (),
