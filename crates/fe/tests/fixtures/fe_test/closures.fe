    let result: u256 = Some(()).map(|_ unit: own ()| -> u256 { boxed.value }).unwrap()
    assert(result == 42)
}

#[test]
fn test_reusable_closure_supports_both_call_abis() {
    let boxed = Boxed { value: 21 }
    let read = |_ unit: own ()| -> u256 { boxed.value }
    let first = read.call(())
    let second = read.call_once(())
    assert(first + second == 42)
}

#[test]
fn test_direct_closure_invocation_selects_reusable_and_consuming_abis() {
    let offset: u256 = 1
    let increment = |value: own u256| -> u256 { value + offset }
    assert(increment(20) + increment(20) == 42)
    let borrowed_increment = ref increment
    assert(borrowed_increment(41) == 42)

    let boxed = Boxed { value: 42 }
    let take = || -> Boxed { boxed }
    assert(take().value == 42)
}

#[test]
fn test_direct_generic_callable_invocation() {
    let offset: u256 = 1
    let increment = |value: own u256| -> u256 { value + offset }
    assert(invoke_direct(func: increment, value: 41) == 42)

    let boxed = Boxed { value: 42 }
    let take = |_ unit: own ()| -> Boxed { boxed }
    assert(invoke_once_direct(func: take, value: ()).value == 42)
}

#[test]
fn test_direct_callable_values_support_zero_multi_and_projection_calls() {
    let answer = || -> u256 { 42 }
    let holder = ClosureHolder { function: answer }
    assert((holder.function)() == 42)
    let functions = [answer, answer]
    assert(functions[1]() == 42)

    let add = |left: own u256, right: own u256| -> u256 { left + right }
    assert(add(20, 22) == 42)
    assert(AddPair {}(20, 22) == 42)
    assert(FortyTwo {}() == 42)
    assert(TakeBoxed { boxed: Boxed { value: 42 } }().value == 42)
    assert((|value: own u256| -> u256 { value + 1 })(41) == 42)
    assert(Overloaded {}(41 as u256) == 42)
    assert(Overloaded {}(false))
    assert(ReusableOrOnce {}(41 as u256) == 42)
    assert(ReusableOrOnce {}(false))
    let add = AddPair {}
    let borrowed_add = ref add
    assert(borrowed_add(20, 22) == 42)
}

#[test]
fn test_direct_closure_call_preserves_mut_capture_returns() {
    let mut value = 0
    let captured = mut value
    let project = || -> mut u256 { captured }
    let first = project()
    first = 20
    let second = project()
    second += 22
    assert(value == 42)
}

#[test]
fn test_copyable_reusable_mut_capture_supports_both_call_abis() {
