#[test]
fn test_looped_mutually_exclusive_borrows_share_fresh_local_storage() {
    let mut initial_left = 0
    let mut initial_right = 0
    let mut returned = TwoMut {
        left: mut initial_left,
        right: mut initial_right,
    }
    let mut index: usize = 0
    while index < 2 {
        let mut boxed = Boxed { value: 0 }
        let next = if index == 0 {
            mut boxed.value
        } else {
            mut boxed.value
        }
        returned = if index == 0 {
            TwoMut { left: next, right: returned.right }
        } else {
            TwoMut { left: returned.left, right: next }
        }
        index += 1
    }
    returned.left = 20
    returned.right = 22
    assert(returned.left + returned.right == 42)
}

#[test]
fn test_looped_disjoint_borrows_share_fresh_local_storage() {
    let mut initial_left = 0
    let mut initial_right = 0
    let mut returned = TwoMut {
        left: mut initial_left,
        right: mut initial_right,
    }
    let mut index: usize = 0
    while index < 2 {
        let mut pair = ScalarPair { left: 0, right: 0 }
        let next_left = mut pair.left
        let next_right = mut pair.right
        returned = if index == 0 {
            TwoMut { left: next_left, right: returned.right }
        } else {
            TwoMut { left: returned.left, right: next_right }
        }
        index += 1
    }
    returned.left = 20
    returned.right = 22
    assert(returned.left + returned.right == 42)
}

#[test]
fn test_looped_multi_argument_closure_calls_keep_fresh_storage_disjoint() {
    let borrow_both = |mut left: own Boxed, mut right: own Boxed| -> MutBoxedPair {
        MutBoxedPair { left: mut left, right: mut right }
    }
    let mut returned = borrow_both.call(
        Boxed { value: 0 },
        Boxed { value: 0 },
    )
    let mut index: usize = 0
    while index < 2 {
        let next = borrow_both.call(
            Boxed { value: 0 },
            Boxed { value: 0 },
        )
        returned = if index == 0 {
            MutBoxedPair { left: next.left, right: returned.right }
        } else {
            MutBoxedPair { left: returned.left, right: next.right }
        }
        index += 1
    }
    returned.left.value = 20
    returned.right.value = 22
    assert(returned.left.value + returned.right.value == 42)
}

#[test]
fn test_looped_nested_view_aggregates_use_fresh_backing_storage() {
    let identity = |nested| nested
    let mut returned = NestedViewPair {
        left: NestedView { boxed: Boxed { value: 0 } },
        right: NestedView { boxed: Boxed { value: 0 } },
    }
    let mut index: usize = 0
    while index < 2 {
        let value = if index == 0 { 20 } else { 22 }
        let next = identity.call(NestedView { boxed: Boxed { value } })
        returned = if index == 0 {
            NestedViewPair { left: next, right: returned.right }
        } else {
            NestedViewPair { left: returned.left, right: next }
        }
        index += 1
    }
    assert(returned.left.boxed.value + returned.right.boxed.value == 42)
}

#[test]
fn test_looped_nested_closure_storage_preserves_fresh_owned_parameter_storage() {
    let make = |mut value: own u256| {
        let target = mut value
        let get = || -> mut u256 { target }
        get
    }
    let mut functions = [
        make.call(0),
        make.call(0),
    ]
    let mut index: usize = 0
    while index < 2 {
        let next = make.call(0)
        if index == 0 {
            functions[0] = next
        } else {
            functions[1] = next
        }
        index += 1
    }
    let left = functions[0].call()
    let right = functions[1].call()
    left = 20
    right = 22
    assert(left + right == 42)
}

#[test]
fn test_returned_enum_wrapped_closures_preserve_fresh_owned_parameter_storage() {
    let make = |mut value: own u256| {
        let target = mut value
        Some(|| -> mut u256 { target })
    }
    let Option::Some(left_function) = make.call(0)
    let Option::Some(right_function) = make.call(0)
    let left = left_function.call()
    let right = right_function.call()
    left = 20
    right = 22
    assert(left + right == 42)
}

#[test]
fn test_returned_array_wrapped_closures_preserve_fresh_owned_parameter_storage() {
    let make = |mut value: own u256| {
        let target = mut value
        let get = || -> mut u256 { target }
        [get, get]
    }
    let left_functions = make.call(0)
    let right_functions = make.call(0)
    let left = left_functions[0].call()
    let right = right_functions[1].call()
    left = 20
    right = 22
    assert(left + right == 42)
}

#[test]
fn test_returned_closure_control_flow_capture_preserves_each_owned_parameter_storage() {
    let make =
        |mut left: own u256, mut right: own u256, choose_left: own bool| {
            let left_target = mut left
            let right_target = mut right
            let target = if choose_left { left_target } else { right_target }
            let get = || -> mut u256 { target }
            get
        }
    let left_function = make.call(0, 100, true)
    let right_function = make.call(100, 0, false)
    let left = left_function.call()
    let right = right_function.call()
    left = 20
    right = 22
    assert(left + right == 42)
}

#[test]
fn test_looped_nested_closure_storage_preserves_default_view_rvalue_storage() {
    let make = |boxed| {
        || boxed.value
    }
    let mut readers = [
        make.call(Boxed { value: 0 }),
        make.call(Boxed { value: 0 }),
    ]
    let mut index: usize = 0
    while index < 2 {
        let value = if index == 0 { 20 } else { 22 }
        readers[index] = make.call(Boxed { value })
        index += 1
    }
    assert(readers[0].call() + readers[1].call() == 42)
}

#[test]
fn test_looped_nested_closure_storage_preserves_enum_payload_views() {
    let make = |value: view Option<Boxed>| {
        let Option::Some(boxed) = value
        let read = || boxed.value
        read
    }
    let mut readers = [
        make.call(Some(Boxed { value: 0 })),
        make.call(Some(Boxed { value: 0 })),
    ]
    let mut index: usize = 0
    while index < 2 {
        let value = if index == 0 { 20 } else { 22 }
        readers[index] = make.call(Some(Boxed { value }))
        index += 1
    }
    assert(readers[0].call() + readers[1].call() == 42)
}

#[test]
fn test_closure_capture_of_mut_aggregate_with_nested_view_preserves_aliasing() {
    let mut holder = MutableNestedView {
        boxed: Boxed { value: 40 },
        count: 0,
    }
    let handle = mut holder
    let update = || {
        handle.count += 2
        handle.boxed.value + handle.count
    }

    assert(update.call() == 42)
    assert(holder.count == 2)
}

#[test]
fn test_returned_closures_preserve_mut_aliases_across_nested_view_layouts() {
    let make = |handle: mut MutableNestedView| {
        let update = || {
            handle.count += 1
            handle.boxed.value + handle.count
        }
        update
    }
    let boxed = Boxed { value: 19 }
    let mut left_holder = MutableNestedView { boxed, count: 0 }
    let mut right_holder = MutableNestedView {
        boxed: Boxed { value: 21 },
        count: 0,
    }
    let updates = [
        make.call(mut left_holder),
        make.call(mut right_holder),
    ]

    assert(updates[0].call() + updates[1].call() == 42)
    assert(left_holder.count + right_holder.count == 2)
}

#[test]
fn test_returned_closure_rebuilds_owned_capture_with_nested_const_views() {
    let make = |pair: own ViewPair| {
        let read = || pair.left.value + pair.right.value
        read
    }
    let readers = [
        make.call(ViewPair {
            left: Boxed { value: 10 },
            right: Boxed { value: 11 },
        }),
        make.call(ViewPair {
            left: Boxed { value: 9 },
            right: Boxed { value: 12 },
        }),
    ]

    assert(readers[0].call() + readers[1].call() == 42)
}

#[test]
fn test_returned_closure_rebuilds_array_capture_with_nested_const_views() {
    let make = |values: own [view Boxed; 2]| {
        let read = || values[0].value + values[1].value
        read
    }
    let reader = make.call([
        Boxed { value: 20 },
        Boxed { value: 22 },
    ])

    assert(reader.call() == 42)
}

#[test]
fn test_returned_closure_rebuilds_repeated_array_capture_with_nested_const_views() {
    let boxed = Boxed { value: 21 }
    let make = |values: own [view Boxed; 2]| {
        let read = || values[0].value + values[1].value
        read
    }
    let reader = make.call([boxed; 2])

    assert(reader.call() == 42)
}

#[test]
fn test_returned_closure_rebuilds_tuple_capture_with_nested_const_views() {
    let make = |values: own (view Boxed, view Boxed)| {
        let read = || values.0.value + values.1.value
        read
    }
    let reader = make.call((
        Boxed { value: 20 },
        Boxed { value: 22 },
    ))

    assert(reader.call() == 42)
}

#[test]
fn test_returned_closure_rebuilds_enum_capture_with_nested_const_views() {
    let make = |choice: own ViewChoice| {
        let read = || match choice {
            ViewChoice::Pair(left, right) => left.value + right.value,
            ViewChoice::Empty => 0,
        }
        read
    }
    let left = Boxed { value: 20 }
    let right = Boxed { value: 22 }
    let reader = make.call(ViewChoice::Pair(
        ref left,
        ref right,
    ))

    assert(reader.call() == 42)
}

#[test]
fn test_closure_captures_const_enum_payload_projection() {
    let wrapped: Option<Boxed> = Some(Boxed { value: 42 })
    let borrowed = ref wrapped
    let Option::Some(boxed) = borrowed
    let read = || boxed.value

    assert(read.call() == 42)
}

#[test]
fn test_nested_closure_capture_type_is_resolved_from_the_outer_call() {
    let make = |boxed: own| {
        let take = || boxed
        take
    }
    let take = make.call_once(Boxed { value: 42 })

    assert(take.call_once().value == 42)
}

#[test]
fn test_nested_copy_capture_is_reusable_after_outer_parameter_inference() {
    let return_reader = |value: own| {
        let read = || value
        read
    }
    let read = return_reader.call_once(21 as u256)

    let call_reader = |value: own| {
        let read = || value
        read.call() + read.call()
    }
    let invoke_reader = |value: own| {
        let read = || value
        invoke_zero(read)
    }
    assert(
        read.call()
            + read.call()
            + call_reader.call_once(21 as u256)
            + invoke_reader.call_once(42 as u256)
            == 126
    )
}

#[test]
fn test_nested_copy_pattern_capture_is_reusable_after_outer_inference() {
    let make = |pair: own| {
        let read = || {
            let (value,) = pair
            value
        }
        read
    }
    let read = make.call_once((21 as u256,))

    assert(read.call() + read.call() == 42)
}

#[test]
fn test_inferred_copy_capture_reusability_propagates_through_nested_closures() {
    let make = |value: own| {
        let outer = || {
            let inner = || value
            inner
        }
        outer
    }
    let outer = make.call_once(21 as u256)
    let left = outer.call()
    let right = outer.call()

    assert(left.call() + right.call() == 42)
}

#[test]
fn test_generic_fn_once_preserves_a_borrow_into_the_consumed_environment() {
    let borrowed = Boxed { value: 42 }
    let consumed = Boxed { value: 0 }
    let borrow_once = || -> ref u256 {
        consume_boxed(consumed)
        ref borrowed.value
    }
    let returned = invoke_zero_once(borrow_once)

    assert(returned == 42)
}

#[test]
fn test_direct_fn_once_preserves_a_borrow_into_a_noncopy_reusable_environment() {
    let boxed = Boxed { value: 42 }
    let borrow_once = || -> ref u256 { ref boxed.value }
    let returned = borrow_once()

    assert(returned == 42)
}
