    write.call()

    let Option::Some(boxed) = wrapped
    assert(boxed.value == 42)
}

#[test]
fn test_closure_mutable_enum_argument_pattern_updates_original_payload() {
    let update = |value: mut Option<Boxed>| {
        match value {
            Option::Some(boxed) => boxed.value = 42,
            Option::None => (),
        }
    }
    let mut wrapped: Option<Boxed> = Some(Boxed { value: 0 })
    update.call(mut wrapped)

    let Option::Some(boxed) = wrapped
    assert(boxed.value == 42)
}

fn closure_view_roundtrip_dynamic_rvalue(_ value: own u256) -> u256 {
    let identity = |boxed| boxed
    let returned = identity.call(Boxed { value })
    returned.value
}

#[test]
fn test_closure_view_return_from_rvalue_preserves_backing_storage() {
    let identity = |boxed| boxed
    let returned = identity.call(Boxed { value: 20 })
    assert(returned.value + closure_view_roundtrip_dynamic_rvalue(22) == 42)
}

#[test]
fn test_closure_control_flow_joins_views_of_distinct_rvalues() {
    let choose = |flag: own bool, left, right| if flag { left } else { right }
    let selected_left =
        choose.call(true, Boxed { value: 20 }, Boxed { value: 0 })
    let selected_right =
        choose.call(false, Boxed { value: 0 }, Boxed { value: 22 })
    assert(selected_left.value + selected_right.value == 42)
}

#[test]
fn test_looped_closure_view_returns_use_fresh_backing_storage() {
    let identity = |boxed| boxed
    let mut returned = ViewPair {
        left: Boxed { value: 0 },
        right: Boxed { value: 0 },
    }
    let mut index: usize = 0
    while index < 2 {
        let value = if index == 0 { 20 } else { 22 }
        let next = identity.call(Boxed { value })
        returned = if index == 0 {
            ViewPair { left: next, right: returned.right }
        } else {
            ViewPair { left: returned.left, right: next }
        }
        index += 1
    }
    assert(returned.left.value + returned.right.value == 42)
}

#[test]
fn test_looped_closure_scalar_views_use_fresh_backing_storage() {
    let identity = |value| value
    let mut returned = ScalarViewPair { left: 0, right: 0 }
    let mut index: usize = 0
    while index < 2 {
        let value = if index == 0 { 20 } else { 22 }
        let next = identity.call(value)
        returned = if index == 0 {
            ScalarViewPair { left: next, right: returned.right }
        } else {
            ScalarViewPair { left: returned.left, right: next }
        }
        index += 1
    }
    assert(returned.left + returned.right == 42)
}

#[test]
fn test_looped_closure_mut_returns_use_fresh_backing_storage() {
    let borrow = |mut boxed: own Boxed| -> mut Boxed { mut boxed }
    let mut returned = MutBoxedPair {
        left: borrow.call(Boxed { value: 0 }),
        right: borrow.call(Boxed { value: 0 }),
    }
    let mut index: usize = 0
    while index < 2 {
        let next = borrow.call(Boxed { value: 0 })
        returned = if index == 0 {
            MutBoxedPair { left: next, right: returned.right }
        } else {
            MutBoxedPair { left: returned.left, right: next }
        }
        index += 1
    }
    returned.left.value = 20
    returned.right.value = 22
    assert(returned.left.value + returned.right.value == 42)
}

#[test]
fn test_looped_nested_closure_calls_forward_fresh_backing_storage() {
    let allocate = |mut boxed: own Boxed| -> mut Boxed { mut boxed }
    let forward = |boxed: mut Boxed| -> mut Boxed { mut boxed }
    let mut returned = MutBoxedPair {
        left: allocate.call(Boxed { value: 0 }),
        right: allocate.call(Boxed { value: 0 }),
    }
    let mut index: usize = 0
    while index < 2 {
        let next = forward.call(allocate.call(Boxed { value: 0 }))
        returned = if index == 0 {
            MutBoxedPair { left: next, right: returned.right }
        } else {
            MutBoxedPair { left: returned.left, right: next }
        }
        index += 1
    }
    returned.left.value = 20
    returned.right.value = 22
    assert(returned.left.value + returned.right.value == 42)
}

#[test]
fn test_looped_control_flow_forwarding_preserves_fresh_backing_storage() {
    let allocate = |mut boxed: own Boxed| -> mut Boxed { mut boxed }
    let forward = |boxed: mut Boxed| -> mut Boxed { mut boxed }
    let mut returned = MutBoxedPair {
        left: allocate.call(Boxed { value: 0 }),
        right: allocate.call(Boxed { value: 0 }),
    }
    let mut index: usize = 0
    while index < 2 {
        let next = forward.call(if index == 0 {
            allocate.call(Boxed { value: 0 })
        } else {
            allocate.call(Boxed { value: 0 })
        })
        returned = if index == 0 {
            MutBoxedPair { left: next, right: returned.right }
        } else {
            MutBoxedPair { left: returned.left, right: next }
        }
        index += 1
    }
    returned.left.value = 20
    returned.right.value = 22
    assert(returned.left.value + returned.right.value == 42)
}

#[test]
fn test_looped_local_borrows_use_fresh_backing_storage() {
    let mut initial_left = 0
    let mut initial_right = 0
    let mut returned = TwoMut {
        left: mut initial_left,
        right: mut initial_right,
    }
    let mut index: usize = 0
    while index < 2 {
        let mut boxed = Boxed { value: 0 }
        let next = mut boxed.value
        returned = if index == 0 {
            TwoMut { left: next, right: returned.right }
        } else {
            TwoMut { left: returned.left, right: next }
        }
        index += 1
    }
    returned.left = 20
    returned.right = 22
    assert(returned.left + returned.right == 42)
}

#[test]
fn test_looped_owned_scalar_closure_arguments_use_fresh_backing_storage() {
    let borrow = |mut value: own u256| -> mut u256 { mut value }
    let mut returned = TwoMut {
        left: borrow.call(0),
        right: borrow.call(0),
    }
    let mut index: usize = 0
    while index < 2 {
        let next = borrow.call(0)
        returned = if index == 0 {
            TwoMut { left: next, right: returned.right }
        } else {
            TwoMut { left: returned.left, right: next }
        }
        index += 1
    }
    returned.left = 20
    returned.right = 22
    assert(returned.left + returned.right == 42)
}

#[test]
fn test_looped_named_copy_arguments_use_fresh_owned_parameter_storage() {
    let borrow = |mut value: own u256| -> mut u256 { mut value }
    let seed: u256 = 0
    let mut returned = TwoMut {
        left: borrow.call(seed),
        right: borrow.call(seed),
    }
    let mut index: usize = 0
    while index < 2 {
        let next = borrow.call(seed)
        returned = if index == 0 {
            TwoMut { left: next, right: returned.right }
        } else {
            TwoMut { left: returned.left, right: next }
        }
        index += 1
    }
    returned.left = 20
    returned.right = 22
    assert(returned.left + returned.right == 42)
    assert(seed == 0)
}

#[test]
fn test_looped_projected_copy_arguments_use_fresh_owned_parameter_storage() {
    let borrow = |mut value: own u256| -> mut u256 { mut value }
    let seed = ScalarPair { left: 0, right: 1 }
    let mut returned = TwoMut {
        left: borrow.call(seed.left),
        right: borrow.call(seed.left),
    }
    let mut index: usize = 0
    while index < 2 {
        let next = borrow.call(seed.left)
        returned = if index == 0 {
            TwoMut { left: next, right: returned.right }
        } else {
            TwoMut { left: returned.left, right: next }
        }
        index += 1
    }
    returned.left = 20
    returned.right = 22
    assert(returned.left + returned.right == 42)
    assert(seed.left == 0)
}

#[test]
fn test_looped_dynamic_owned_array_arguments_use_fresh_parameter_storage() {
    let borrow_at = |mut values: own [u256; 2], index: own usize| -> mut u256 {
        mut values[index]
    }
    let mut initial_left = 0
    let mut initial_right = 0
    let mut returned = TwoMut {
        left: mut initial_left,
        right: mut initial_right,
    }
    let mut index: usize = 0
    while index < 2 {
        let next = borrow_at.call([0 as u256, 0], index)
        returned = if index == 0 {
            TwoMut { left: next, right: returned.right }
        } else {
            TwoMut { left: returned.left, right: next }
        }
        index += 1
    }
    returned.left = 20
    returned.right = 22
    assert(returned.left + returned.right == 42)
}

