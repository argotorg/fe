}

#[test]
fn test_closure_returns_stored_mut_handle_through_ref_container() {
    let mut value = 0
    let holder = MutHolder { value: mut value }
    let borrowed = ref holder
    let project = || -> mut u256 {
        let MutHolder { value: projected } = borrowed
        projected
    }

    let first = project.call()
    first = 20
    assert(first == 20)

    let second = project.call()
    second = 42
    assert(second == 42)
    assert(value == 42)
}

