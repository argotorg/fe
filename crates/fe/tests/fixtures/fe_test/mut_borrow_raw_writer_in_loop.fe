use core::ptr::{self, MemBuffer, MemSpan}

// A local writer holding a growable buffer is lent to a helper as `mut`. The
// helper writes through the buffer pointer in a loop while it reads through
// a pointer stored in a Copy parameter. A raw write can overwrite the
// writer's own buffer pointer only if that pointer points into the writer,
// which the caller refutes for a local writer. The loan must therefore end
// at the call, and the caller must be able to keep using the writer.

struct Arr<T> {
    ptr: *T,
    len: u256,
}

impl<T> Copy for Arr<T> {}

impl<T> Arr<T> {
    fn alloc(_ len: u256) -> Self {
        Arr { ptr: ptr::cast<u8, T>(ptr::alloc_bytes((len * 64).downcast_saturate())), len }
    }

    fn at(self, _ i: u256) -> *T {
        if i >= self.len {
            core::panic()
        }
        ptr::offset(self.ptr, i.downcast_unchecked())
    }
}

struct Item {
    a: u256,
    b: u256,
}

impl Copy for Item {}

struct Book {
    items: Arr<Item>,
}

impl Copy for Book {}

struct Writer {
    buffer: MemBuffer,
}

impl Writer {
    fn new() -> Self {
        Writer { buffer: MemBuffer::empty() }
    }

    fn append(mut self, _ size: usize) -> *u8 {
        self.buffer.reserve(size)
        let len = self.buffer.len()
        unsafe { self.buffer.set_len(len + size) }
        ptr::offset_bytes(self.buffer.ptr(), len)
    }

    fn word(mut self, _ value: u256) {
        let at = self.append(32)
        unsafe { *ptr::cast<u8, u256>(at) = value }
    }

    fn bytes(mut self, _ data: MemSpan) {
        self.word(data.len() as u256)
        let at = self.append(data.len())
        unsafe { ptr::copy(dest: at, source: data) }
    }

    fn finish(own self) -> MemBuffer {
        self.buffer
    }
}

fn load_word(_ at: *u8) -> u256 {
    unsafe { *ptr::cast<u8, u256>(at) }
}

fn write_items(_ book: Book, w: mut Writer) {
    var i: u256 = 0
    while i < book.items.len {
        let item = book.items.at(i)
        unsafe { w.word(item.a) }
        unsafe { w.word(item.b) }
        i += 1
    }
}

fn sum_into(_ data: MemSpan, ret: mut u256) {
    var offset: usize = 0
    while offset < data.len() {
        ret += load_word(ptr::offset_bytes(data.ptr(), offset))
        offset += 32
    }
}

fn encode(_ book: Book) -> MemBuffer {
    var w = Writer::new()
    w.word(book.items.len)
    write_items(book, w: mut w)
    let tail = MemBuffer::alloc(32)
    unsafe { *ptr::cast<u8, u256>(tail.ptr()) = 0xabcd }
    w.bytes(tail.span())
    var total: u256 = 0
    sum_into(w.buffer.span(), ret: mut total)
    w.word(total)
    w.finish()
}

#[test]
fn local_writer_lent_to_a_loop_over_pointer_params() {
    let items = Arr<Item>::alloc(2)
    unsafe { *items.at(0) = Item { a: 1, b: 2 } }
    unsafe { *items.at(1) = Item { a: 3, b: 4 } }
    let out = encode(Book { items })
    assert(out.len() == 8 * 32)
    let expected = Arr<u256>::alloc(8)
    unsafe { *expected.at(0) = 2 }
    unsafe { *expected.at(1) = 1 }
    unsafe { *expected.at(2) = 2 }
    unsafe { *expected.at(3) = 3 }
    unsafe { *expected.at(4) = 4 }
    unsafe { *expected.at(5) = 32 }
    unsafe { *expected.at(6) = 0xabcd }
    unsafe { *expected.at(7) = 2 + 1 + 2 + 3 + 4 + 32 + 0xabcd }
    var i: u256 = 0
    while i < 8 {
        unsafe { assert(load_word(ptr::offset_bytes(out.ptr(), (i * 32).downcast_unchecked())) == *expected.at(i)) }
        i += 1
    }
    unsafe { assert((*items.at(1)).b == 4) }
}
