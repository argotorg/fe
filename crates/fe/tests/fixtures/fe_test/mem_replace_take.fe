/// `core::mem::replace` and `take`, and `Option::take`: moving a value out of
/// a `mut` place while filling it, for memory values, fields, collection
/// elements and `Copy` contract state.

use core::mem::{replace, take}
use core::option::Option
use core::ptr::{MemArray, MemBuffer}
use std::evm::{Evm, StorageMap}

struct Pending {
    buffer: MemBuffer,
    next: Option<MemBuffer>,
    count: u256,
}

struct Store {
    total: u256,
    last: Option<u256>,
    balances: StorageMap<u256, u256>,
}

msg M {
    #[selector = 1]
    Go -> u256,
}

pub contract C {
    mut store: Store,

    init() {}

    recv M {
        Go -> u256 uses (mut store) {
            store.total = 5
            store.last = Option::Some(7)
            store.balances[1] = 3
            let old = replace(mut store.total, 9)
            let total = take(mut store.total)
            let last = store.last.take().unwrap()
            let balance = replace(mut store.balances[1], 4)
            assert(store.total == 0 && store.last.is_none() && store.balances[1] == 4)
            old * 1000 + total * 100 + last * 10 + balance
        }
    }
}

#[test]
fn replace_moves_the_old_value_out() {
    var pending = Pending { buffer: MemBuffer::alloc(3), next: Option::None, count: 1 }
    let old = replace(mut pending.buffer, MemBuffer::alloc(7))
    assert(old.len() == 3 && pending.buffer.len() == 7)
    assert(replace(mut pending.count, 2) == 1 && pending.count == 2)

    var n: u256 = 4
    assert(replace(mut n, 5) == 4 && n == 5)
}

#[test]
fn take_leaves_the_default() {
    var pending = Pending { buffer: MemBuffer::alloc(3), next: Option::Some(MemBuffer::alloc(4)), count: 6 }
    let next = take(mut pending.next)
    assert(next.unwrap().len() == 4 && pending.next.is_none())
    assert(take(mut pending.count) == 6 && pending.count == 0)
}

#[test]
fn option_take_empties_the_option() {
    var pending = Pending { buffer: MemBuffer::empty(), next: Option::Some(MemBuffer::alloc(2)), count: 0 }
    assert(pending.next.take().unwrap().len() == 2)
    assert(pending.next.take().is_none())
}

#[test]
fn replace_works_on_elements() {
    var buffers = MemArray::from_fn(2, |i| MemBuffer::alloc(i + 1))
    let first = replace(mut buffers[0], MemBuffer::alloc(9))
    assert(first.len() == 1 && buffers[0].len() == 9 && buffers[1].len() == 2)

    var words: [u256; 3] = [1, 2, 3]
    assert(take(mut words[1]) == 2 && words[1] == 0)
}

#[test]
fn replace_and_take_contract_state() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: 0, args: (), salt: 0)
    let r: u256 = evm.call(addr: c, gas: 1000000, value: 0, message: M::Go {})
    assert(r == 5973)
}
