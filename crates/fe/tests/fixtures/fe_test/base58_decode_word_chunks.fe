use core::abi::{Bytes, DynString}
use core::ptr::MemBuffer
use core::text

fn canonical(_ decoded: Bytes) {
    let encoded = decoded.encoded_span()
    assert!(encoded.read_word(0) == decoded.len() as u256)
    for i in decoded.len() + 32 .. encoded.len() {
        assert!(encoded.byte_at(i) == 0)
    }
}

#[test]
fn decode58_handles_every_limb_tail_and_leading_zero_count() {
    var data = MemBuffer::new(100)
    for prefix in 0 .. 4 {
        for len in 0 .. 75 {
            for i in 0 .. len + prefix {
                data[i] = if i < prefix {
                    0
                } else {
                    (i * 73 + 17).downcast_truncate()
                }
            }
            let input = data.slice(offset: 0, len: len + prefix)
            let encoded = text::base58(input)
            let result = text::decode_base58(encoded).unwrap()
            assert!(result.span() == input)
            canonical(result)
            assert!(
                text::decode_base58(encoded.span()).unwrap().span() == input,
            )
        }
    }
}

#[test]
fn decode58_counts_every_possible_top_limb_bit() {
    for bit in 0 .. 192 {
        let top_len = bit / 8 + 1
        for lower_limbs in 0 .. 3 {
            var input = MemBuffer::new(top_len + lower_limbs * 24)
            input[0] = ((1 as u256) << ((bit % 8) as u256)).downcast_truncate()
            for i in top_len .. input.len() {
                input[i] = (i * 37 + 1).downcast_truncate()
            }
            let result = text::decode_base58(text::base58(input.span())).unwrap()
            assert!(result.span() == input.span())
            canonical(result)
        }
    }
}

#[test]
fn decode58_preserves_all_zero_inputs() {
    for len in 0 .. 75 {
        var input = MemBuffer::new(len)
        for i in 0 .. len {
            input[i] = b'1'
        }
        let result = text::decode_base58(input.span()).unwrap()
        assert!(result.len() == len)
        for i in 0 .. len {
            assert!(result.byte_at(i) == 0)
        }
        canonical(result)
    }
}

fn check_vector(_ encoded: DynString, _ hex: DynString) {
    let result = text::decode_base58(encoded).unwrap()
    assert!(result == text::decode_hex(hex).unwrap())
    canonical(result)
}

