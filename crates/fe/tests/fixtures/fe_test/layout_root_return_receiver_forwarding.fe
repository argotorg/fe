use std::evm::{Evm, StorageMap}

struct Wrapped<const ROOT: u256 = _> {
    map: StorageMap<u256, u256, ROOT>,
}

impl<const ROOT: u256> Wrapped<ROOT> {
    fn into_map(self) -> StorageMap<u256, u256, ROOT> {
        self.map
    }
}

fn read_wrapped(wrapped: Wrapped, key: u256) -> u256 {
    wrapped.into_map().get(key: key)
}

msg Msg {
    #[selector = 1]
    Set { lane: usize, key: u256, value: u256 },

    #[selector = 2]
    Get { lane: usize, key: u256 } -> u256,
}

pub contract C {
    mut first: Wrapped,
    mut second: Wrapped,

    recv Msg {
        Set { lane, key, value } uses (mut first, mut second) {
            if lane == 0 {
                first.map.set(key: key, value: value)
            } else {
                second.map.set(key: key, value: value)
            }
        }

        Get { lane, key } -> u256 uses (first, second) {
            if lane == 0 {
                read_wrapped(wrapped: first, key: key)
            } else {
                read_wrapped(wrapped: second, key: key)
            }
        }
    }
}

#[test]
fn returned_receiver_fields_preserve_layout_sources() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: 0, args: (), salt: 1)
    evm.call(
        addr: c,
        gas: 200000,
        value: 0,
        message: Msg::Set { lane: 1, key: 7, value: 42 },
    )
    let value: u256 = evm.call(
        addr: c,
        gas: 200000,
        value: 0,
        message: Msg::Get { lane: 1, key: 7 },
    )
    assert!(value == 42)
    let untouched: u256 = evm.call(
        addr: c,
        gas: 200000,
        value: 0,
        message: Msg::Get { lane: 0, key: 7 },
    )
    assert!(untouched == 0)
}
