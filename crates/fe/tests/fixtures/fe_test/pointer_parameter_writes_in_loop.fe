use core::ptr

// The functions below take Copy structs holding raw pointers and, inside
// loops, write through several of those pointers and through a buffer
// pointer in callees. Every write may overwrite the pointers stored in the
// parameter places. Borrow checking must keep those conditional replacements
// bounded: one per possibly overlapping pair of objects, not one per write
// site, offset and loop iteration.

struct Arr<T> {
    ptr: *T,
    len: u256,
}

impl<T> Copy for Arr<T> {}

impl<T> Arr<T> {
    fn alloc(_ len: u256) -> Self {
        Arr { ptr: ptr::cast<u8, T>(ptr::alloc_bytes((len * 64).downcast_saturate())), len }
    }

    fn at(self, _ i: u256) -> *T {
        if i >= self.len {
            core::panic()
        }
        ptr::offset(self.ptr, i.downcast_unchecked())
    }
}

struct Item {
    amount: u256,
    original: u256,
}

impl Copy for Item {}

struct Order {
    start: u256,
    len: u256,
}

impl Copy for Order {}

struct Book {
    orders: Arr<Order>,
    items: Arr<Item>,
    used: u256,
    blob: *u8,
}

impl Copy for Book {}

impl Book {
    fn order(self, _ i: u256) -> *Order {
        self.orders.at(i)
    }

    fn item(self, _ order: *Order, _ i: u256) -> *Item {
        unsafe { self.items.at(order.start + i) }
    }
}

fn store_word(_ at: *u8, _ value: u256) {
    let word = ptr::cast<u8, u256>(at)
    unsafe { *word = value }
}

fn load_word(_ at: *u8) -> u256 {
    unsafe { *ptr::cast<u8, u256>(at) }
}

fn record(_ buf: *u8, _ value: u256) -> u256 {
    let at = ptr::offset_bytes(buf, ((value & 3) * 0xc0).downcast_unchecked())
    store_word(at, value)
    store_word(ptr::offset_bytes(at, 0x20), value)
    store_word(ptr::offset_bytes(at, 0x40), value)
    store_word(ptr::offset_bytes(at, 0x60), value)
    store_word(ptr::offset_bytes(at, 0x80), value)
    store_word(ptr::offset_bytes(at, 0xa0), value)
    value + 1
}

fn dispatch(_ buf: *u8, _ kind: u256, _ value: u256) -> u256 {
    if kind == 0 {
        return record(buf, value)
    }
    if kind == 1 {
        return record(buf, value + 1)
    }
    record(buf, value + 2)
}

fn settle_item(_ book: Book, order: *Order, index: u256, acc: u256, buf: *u8) -> u256 {
    let item = book.item(order, index)
    var current = acc
    unsafe {
        if item.amount != 0 {
            current = dispatch(buf, item.original, item.amount)
        }
        item.amount = item.original
        if item.original != 0 {
            current = dispatch(buf, current, item.amount)
        }
        item.original = current
    }
    store_word(book.blob, current)
    current
}

fn check_item(_ book: Book, order: *Order, index: u256) {
    let item = book.item(order, index)
    unsafe {
        if item.amount > item.original {
            core::panic()
        }
        item.amount = item.original
    }
}

fn settle(_ book: Book, available: Arr<bool>, index: u256, acc: u256, buf: *u8) -> u256 {
    let order = book.order(index)
    unsafe { *available.at(index) = order.len != 0 }
    var current = acc
    var j: u256 = 0
    while j < unsafe { order.len } {
        current = settle_item(book, order, index: j, acc: current, buf)
        j += 1
    }
    j = 0
    while j < unsafe { order.len } {
        check_item(book, order, index: j)
        current = dispatch(book.blob, current, j)
        j += 1
    }
    current
}

fn settle_all(_ book: Book, available: Arr<bool>, acc: u256, buf: *u8) -> u256 {
    var current = acc
    var i: u256 = 0
    while i < book.orders.len {
        current = settle(book, available, index: i, acc: current, buf)
        i += 1
    }
    current
}

fn settle_rounds(_ book: Book, available: Arr<bool>, rounds: u256, buf: *u8) -> u256 {
    var current: u256 = 0
    var r: u256 = 0
    while r < rounds {
        current = settle_all(book, available, acc: current, buf)
        r += 1
    }
    current
}

#[test]
fn writes_through_pointer_parameters_in_loops() {
    let orders = Arr<Order>::alloc(1)
    unsafe { *orders.at(0) = Order { start: 0, len: 2 } }
    let items = Arr<Item>::alloc(2)
    unsafe { *items.at(0) = Item { amount: 5, original: 1 } }
    unsafe { *items.at(1) = Item { amount: 0, original: 0 } }
    let book = Book { orders, items, used: 2, blob: ptr::alloc_bytes(0x300) }
    let available = Arr<bool>::alloc(1)
    let buf = ptr::alloc_bytes(0x300)
    let result = settle_rounds(book, available, rounds: 1, buf)
    assert(result == 4)
    unsafe { assert(*available.at(0)) }
    let first = items.at(0)
    let second = items.at(1)
    unsafe { assert(first.amount == 4) }
    unsafe { assert(second.original == 4) }
    assert(load_word(book.blob) == 4)
    assert(load_word(ptr::offset_bytes(buf, 0x2a0)) == 3)
    assert(load_word(ptr::offset_bytes(book.blob, 0x240)) == 3)
}
