// A field's head size may read the enclosing message's IS_DYNAMIC, which is
// computed without the layout, so the two do not form a cycle.
struct RecursiveHead {}

msg CycleMsg {
    #[selector = 1]
    Probe { value: RecursiveHead } -> bool,
}

impl core::abi::AbiSize for RecursiveHead {
    const HEAD_SIZE: u256 = if <CycleMsg::Probe as core::abi::AbiSize>::IS_DYNAMIC { 32 } else { 7 }
    const IS_DYNAMIC: bool = false
}

impl core::abi::Encode<std::abi::Sol> for RecursiveHead {
    fn encode(own self, _ ptr: *u8) {}
}

impl core::abi::Decode<std::abi::Sol> for RecursiveHead {
    fn decode_payload<D: core::abi::AbiDecoder<std::abi::Sol>>(_ decoder: mut D) -> Self {
        RecursiveHead {}
    }
}

static_assert(!<CycleMsg::Probe as core::abi::AbiSize>::IS_DYNAMIC)
static_assert(<CycleMsg::Probe as core::abi::AbiSize>::HEAD_SIZE == 7)

#[test]
fn head_size_reads_message_metadata() {
    assert!(<CycleMsg::Probe as core::abi::AbiSize>::HEAD_SIZE == 7)
}
