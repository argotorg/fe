use core::hint::black_box
use core::num::{checked_mul_div, checked_mul_div_ceil}
fn check(_ a: u256, _ b: u256, _ d: u256, _ floor: u256, _ ceil: u256, _ flags: u8) {
    let a = black_box(a)
    let b = black_box(b)
    let d = black_box(d)
    let f = checked_mul_div(a, b, d)
    let c = checked_mul_div_ceil(a, b, d)
    assert!(f.is_some() == (flags & 1 != 0))
    assert!(c.is_some() == (flags & 2 != 0))
    if flags & 1 != 0 {
        assert!(f.unwrap() == floor)
    }
    if flags & 2 != 0 {
        assert!(c.unwrap() == ceil)
    }
}
#[test]
fn every_power_of_two_divisor() {
    for k in 0 .. 256 {
        let d: u256 = 1 << (k as u256)
        check(u256::max(), d, d, u256::max(), u256::max(), 3)
    }
}
