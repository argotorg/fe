#[test]
fn python_big_integer_vectors() {
    for (a, b, d, f, c, flags) in CASES {
        check(a, b, d, f, c, flags)
    }
}

// For a = MAX and b = d - 1, a*b/d = MAX - MAX/d. Hence the
// ceiling is MAX - floor(MAX/d), and the floor subtracts another one
// exactly when MAX/d has a remainder. This reference needs no wide product.
fn check_nonzero_remainder(_ d: u256) {
    let max = u256::max()
    let ceil = max - max / d
    let floor = ceil - ((max % d != 0) as u256)
    check(max, d - 1, d, floor, ceil, 3)
}

#[test]
fn every_divisor_shift_with_remainders() {
    for k in 0 .. 256 {
        let d: u256 = 1 << (k as u256)
        check_nonzero_remainder(d)
        if k < 255 {
            check_nonzero_remainder(3 << (k as u256))
        }
    }
}
