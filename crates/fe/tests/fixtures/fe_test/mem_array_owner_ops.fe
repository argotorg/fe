// Owner-side primitives move into and out of dynamically indexed elements
// through stable `mut` accesses, which a direct move out of `xs[i]` cannot.
use core::option::Option
use core::ptr::MemArray

struct Item { n: u256 }

#[test]
fn owner_primitives() {
    var xs = unsafe { MemArray<Item>::new_uninit(3) }
    xs[0] = Item { n: 1 }
    xs[1] = Item { n: 2 }
    xs[2] = Item { n: 3 }
    let old = xs.replace(1, Item { n: 20 })
    assert!(old.n == 2 && xs[1].n == 20)
    xs.swap(0, 2)
    assert!(xs[0].n == 3 && xs[2].n == 1)
    xs.set(2, Item { n: 30 })
    assert!(xs[2].n == 30)
    xs.swap(1, 1)
    assert!(xs[1].n == 20)
}

struct Counter { calls: u256 }

impl FnMut(usize) -> Item for Counter {
    fn call_mut(mut self, _ i: usize) -> Item {
        self.calls += 1
        Item { n: i as u256 * 10 + self.calls }
    }
}

#[test]
fn from_fn_fills_each_element_in_order() {
    let squares = MemArray::from_fn(4, |i| i * i)
    assert!(squares.len() == 4 && squares[3] == 9)

    // Non-`Copy` elements, from a callable that keeps state between calls.
    var counter = Counter { calls: 0 }
    let items = MemArray::from_fn(3, mut counter)
    assert!(items[0].n == 1 && items[1].n == 12 && items[2].n == 23)
    assert!(counter.calls == 3)

    let none = MemArray<u256>::from_fn(0, |i| i as u256)
    assert!(none.is_empty())
}

#[test]
fn get_copies_an_element() {
    let xs = MemArray::from_fn(3, |i| i as u256 + 5)
    match xs.get(2) {
        Option::Some(x) => assert!(x == 7)
        Option::None => assert!(false)
    }
    assert!(xs.get(3).is_none())
}
