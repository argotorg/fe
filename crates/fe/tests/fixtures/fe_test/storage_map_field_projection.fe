use std::evm::{Evm, StorageMap}

struct Pair {
    left: StorageMap<u256, u256>,
    right: StorageMap<u256, u256>,
}

// A projection yields a field of the place it was given.
fn left_map(pair: Pair) -> ref StorageMap<u256, u256> {
    ref pair.left
}

fn read_left(pair: Pair, key: u256) -> u256 {
    left_map(pair: pair).get(key: key)
}

fn read_pair_left(pair: Pair, key: u256) -> u256 {
    read_left(pair: pair, key: key)
}

msg Msg {
    #[selector = 1]
    Set { lane: usize, key: u256, value: u256 },

    #[selector = 2]
    Get { lane: usize, key: u256 } -> u256,
}

pub contract C {
    mut first: Pair,
    mut second: Pair,

    recv Msg {
        Set { lane, key, value } uses (mut first, mut second) {
            if lane == 0 {
                first.left.set(key: key, value: value)
            } else {
                second.left.set(key: key, value: value)
            }
        }

        Get { lane, key } -> u256 uses (first, second) {
            // The pair's maps are places in the fields this arm reads.
            if lane == 0 {
                read_pair_left(pair: first, key: key)
            } else {
                read_pair_left(pair: second, key: key)
            }
        }
    }
}

#[test]
fn field_projections_yield_the_field_map() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: Wei::zero(), args: (), salt: 1)
    evm.call(
        addr: c,
        gas: 200000,
        value: Wei::zero(),
        message: Msg::Set { lane: 1, key: 7, value: 42 },
    )
    let value: u256 = evm.call(
        addr: c,
        gas: 200000,
        value: Wei::zero(),
        message: Msg::Get { lane: 1, key: 7 },
    )
    assert!(value == 42)
    let untouched: u256 = evm.call(
        addr: c,
        gas: 200000,
        value: Wei::zero(),
        message: Msg::Get { lane: 0, key: 7 },
    )
    assert!(untouched == 0)
}
