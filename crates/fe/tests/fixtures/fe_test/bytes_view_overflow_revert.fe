use core::ptr::{self, MemBuffer, MemSpan}
use core::abi::ByteInput
use std::abi::{decode_bytes_view, decode_bytes_view_at}
use std::evm::{Address, CallData, Evm, RawMem}

msg ViewMsg {
    /// f(bytes): returns the length of the argument, read through a view.
    #[selector = 0x01]
    Len -> u256,
}

pub contract Viewer {
    recv ViewMsg {
        Len {} -> u256 {
            decode_bytes_view_at(CallData::with_base(4), base: 0, head_pos: 0).len()
        }
    }
}

struct Outcome { success: bool, ret_len: u256, word0: u256 }

fn call_words<const N: usize>(_ addr: Address, words: [u256; N]) -> Outcome uses (evm: mut Evm) {
    let len = 4 + (N as u256) * 32
    let data = MemBuffer::alloc(len + 32)
    evm.mstore(addr: data.ptr(), value: 1 << 224)
    let mut i: usize = 0
    while i < N {
        evm.mstore(addr: ptr::offset_bytes(data.ptr(), 4 + (i as u256) * 32), value: words[i])
        i += 1
    }
    let mut ret = MemBuffer::alloc(64)
    let outcome = evm.raw_call(
        addr: addr,
        gas: 1000000,
        value: 0,
        args: MemSpan::from_raw_parts(ptr: data.ptr(), len: len),
        ret: mut ret,
    )
    let rlen = outcome.returndata_len()
    Outcome {
        success: outcome.success(),
        ret_len: rlen,
        word0: if rlen >= 32 {
            ret.span().word_at(0)
        } else {
            0
        },
    }
}

fn reverts_empty<const N: usize>(_ addr: Address, words: [u256; N]) uses (evm: mut Evm) {
    let out = call_words(addr, words: words)
    assert!(!out.success)
    assert!(out.ret_len == 0)
}

const MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

#[test]
fn test_overflowing_bytes_offsets_and_lengths_revert_empty() uses (evm: mut Evm) {
    let v = evm.create2<Viewer>(value: 0, args: (), salt: 0)
    let ok = call_words(v, words: [0x20, 2, 0xabcd << 240])
    assert!(ok.success && ok.word0 == 2)
    // Offsets whose sum with the base wraps around.
    reverts_empty(v, words: [MAX, 0])
    reverts_empty(v, words: [MAX - 31, 0])
    // Lengths whose sum with the data position wraps around.
    reverts_empty(v, words: [0x20, MAX])
    reverts_empty(v, words: [0x20, MAX - 31])
}

const TWO_64: u256 = 0x10000000000000000

// Model an input longer than `2**64` bytes without allocating it: two words
// at offsets 0 and 32, zero everywhere else. Its bounds checks pass for any
// offset and length, so only the explicit `2**64` limits reject them.
struct SparseInput { w0: u256, w1: u256 }
impl Copy for SparseInput {}
impl ByteInput for SparseInput {
    fn len(self) -> u256 { MAX }
    fn word_at(self, _ byte_offset: u256) -> u256 {
        if byte_offset == 0 {
            self.w0
        } else if byte_offset == 32 {
            self.w1
        } else {
            0
        }
    }
    fn byte_at(self, _: u256) -> u8 { panic() }
    fn copy_to_memory(self, dest: *u8, src_offset: u256, len: u256) { panic() }
}

#[test]
fn test_offsets_and_lengths_below_two_64_accepted_on_long_input() {
    assert!(decode_bytes_view(SparseInput { w0: TWO_64 - 32, w1: 0 }).len() == 0)
    assert!(decode_bytes_view(SparseInput { w0: 0x20, w1: TWO_64 - 1 }).len() == TWO_64 - 1)
}

#[test(should_revert)]
fn test_offset_of_two_64_rejected_on_long_input() {
    let _ = decode_bytes_view(SparseInput { w0: TWO_64, w1: 0 })
}

#[test(should_revert)]
fn test_length_of_two_64_rejected_on_long_input() {
    let _ = decode_bytes_view(SparseInput { w0: 0x20, w1: TWO_64 })
}
