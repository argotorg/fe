use core::num::Abs
use core::ops::{
    SaturatingAdd, SaturatingMul, SaturatingSub, WrappingAdd, WrappingMul, WrappingNeg, WrappingPow,
    WrappingSub,
}
use std::evm::ops::{byte, signextend}

// These operations resolve to core implementations, including their
// numeric extern intrinsics, rather than to same-named user declarations.
const CHECKED_ADD: u8 = (10 as u8) + 5
const CHECKED_NEG: i8 = -(-5 as i8)
const SATURATING_ADD: u8 = (250 as u8).saturating_add(10)
const SATURATING_SUB: u8 = (0 as u8).saturating_sub(10)
const SATURATING_MUL: i8 = (64 as i8).saturating_mul(4)

const WRAPPING_ADD: u8 = (255 as u8).wrapping_add(2)
const WRAPPING_SUB: u8 = (0 as u8).wrapping_sub(1)
const WRAPPING_MUL: u8 = (16 as u8).wrapping_mul(16)
const WRAPPING_POW: u8 = (2 as u8).wrapping_pow(9)
const WRAPPING_SIGNED_POW: i8 = (-3 as i8).wrapping_pow(5)
const WRAPPING_NEG_MIN: i8 = ((-127 as i8) - 1).wrapping_neg()
const WRAPPING_NEG_WIDE: i256 = (7 as i256).wrapping_neg()
const WRAPPING_SHL: u8 = (1 as u8) << 8
const WRAPPING_SIGNED_SHR: i8 = ((-127 as i8) - 1) >> 7
const WRAPPING_SIGNED_SHR_255: i8 = (-1 as i8) >> (-1 as i8)
const WRAPPING_SIGNED_SHR_300: i16 = (-1 as i16) >> 300
const WRAPPING_NEG: i8 = ((-127 as i8) - 1).wrapping_abs()
const BIT_NOT: u8 = !(0 as u8)
const BIT_AND: u8 = (0b1010 as u8) & 0b1100
const BIT_OR: u8 = (0b1010 as u8) | 0b1100
const BIT_XOR: u8 = (0b1010 as u8) ^ 0b1100
const LT_SIGNED: bool = (-1 as i8) < 1
const GE_UNSIGNED: bool = (2 as u8) >= 2

const BOOL_NOT: bool = !false
const BOOL_AND: bool = true & false
const BOOL_OR: bool = true | false
const BOOL_XOR: bool = true ^ false
const BOOL_EQ: bool = true == true
const BOOL_NE: bool = true != false

#[test]
fn const_numeric_extern_intrinsics() {
    assert!(CHECKED_ADD == 15)
    assert!(CHECKED_NEG == 5)
    assert!(SATURATING_ADD == 255)
    assert!(SATURATING_SUB == 0)
    assert!(SATURATING_MUL == 127)

    assert!(WRAPPING_ADD == 1)
    assert!(WRAPPING_SUB == 255)
    assert!(WRAPPING_MUL == 0)
    assert!(WRAPPING_POW == 0)
    assert!(WRAPPING_SIGNED_POW == 13)
    assert!(WRAPPING_NEG_MIN == -128)
    assert!(WRAPPING_NEG_WIDE == -7)
    assert!(WRAPPING_SHL == 0)
    assert!(WRAPPING_SIGNED_SHR == -1)
    assert!(WRAPPING_SIGNED_SHR_255 == -1)
    assert!(WRAPPING_SIGNED_SHR_300 == -1)
    assert!(WRAPPING_NEG == -128)
    assert!(BIT_NOT == 255)
    assert!(BIT_AND == 0b1000)
    assert!(BIT_OR == 0b1110)
    assert!(BIT_XOR == 0b0110)
    assert!(LT_SIGNED)
    assert!(GE_UNSIGNED)

    assert!(BOOL_NOT)
    assert!(!BOOL_AND)
    assert!(BOOL_OR)
    assert!(BOOL_XOR)
    assert!(BOOL_EQ)
    assert!(BOOL_NE)

    let true_word: u256 = true as u256
    let false_word: u256 = false as u256
    let true_i32: i32 = true as i32
    let false_u8: u8 = false as u8
    assert!(true_word == 1)
    assert!(false_word == 0)
    assert!(true_i32 == 1)
    assert!(false_u8 == 0)

    let word: u256 = 0x1234567890abcdef0000000000000000000000000000000000000000000000ff
    assert!(byte(pos: 0, value: word) == 0x12)
    assert!(byte(pos: 1, value: word) == 0x34)
    assert!(byte(pos: 31, value: word) == 0xff)
    assert!(byte(pos: 32, value: word) == 0)
    assert!(signextend(byte: 0, value: 0x7f) == 0x7f)
    assert!(signextend(byte: 0, value: 0xff) == 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)
}

#[test]
fn runtime_wrapping_pow_and_neg() {
    let two: u8 = 2
    let minus_three: i8 = -3
    let min: i8 = -128
    let seven: i256 = 7
    assert!(two.wrapping_pow(9) == 0)
    assert!(minus_three.wrapping_pow(5) == 13)
    assert!(min.wrapping_neg() == -128)
    assert!(seven.wrapping_neg() == -7)
}
