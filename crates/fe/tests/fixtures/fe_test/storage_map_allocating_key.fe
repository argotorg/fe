use core::ptr
use std::evm::{Evm, StorageKey, StorageMap}

struct AllocatingKey { value: u256 }

impl StorageKey for AllocatingKey {
    fn encoded_len(self) -> u256 {
        32
    }

    fn write_key(ptr: *u8, self) {
        *ptr::cast<u8, u256>(ptr) = self.value
        let unrelated = ptr::alloc_bytes(32)
        ptr::zero_bytes(unrelated, 32)
    }
}

msg Msg {
    #[selector = 1]
    Set { key: u256, value: u256 },
    #[selector = 2]
    Get { key: u256 } -> u256,
}

pub contract C {
    mut values: StorageMap<(u256, AllocatingKey), u256>,
    recv Msg {
        Set { key, value } uses (mut values) {
            values.set(key: (99, AllocatingKey { value: key }), value)
        }
        Get { key } -> u256 uses (values) {
            values.get(key: (99, AllocatingKey { value: key }))
        }
    }
}

#[test]
fn allocation_inside_key_encoding_keeps_keys_distinct() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: Wei::zero(), args: (), salt: 1)
    evm.call(addr: c, gas: 200000, value: Wei::zero(), message: Msg::Set { key: 7, value: 11 })
    evm.call(addr: c, gas: 200000, value: Wei::zero(), message: Msg::Set { key: 8, value: 22 })
    let first: u256 = evm.call(addr: c, gas: 200000, value: Wei::zero(), message: Msg::Get { key: 7 })
    let second: u256 = evm.call(addr: c, gas: 200000, value: Wei::zero(), message: Msg::Get { key: 8 })
    assert!(first == 11)
    assert!(second == 22)
}
