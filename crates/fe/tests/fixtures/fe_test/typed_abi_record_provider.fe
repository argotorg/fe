use core::abi::{Abi, AbiDecoder, AbiFrame, AbiSize, AbiSpan, ByteInput, Decode, Encode, encode_alloc}
use std::abi::Sol
use std::derive::{StructAbiDecode, StructAbiEncode, StructAbiSize, StructAbiSpan}

pub struct Alt {}
pub struct AltDec { pub pos: u256, pub base: u256 }
impl AbiDecoder<Alt> for AltDec {
    fn base(self) -> u256 { self.base }
    fn set_base(mut self, _ new_base: u256) { self.base = new_base }
    fn pos(self) -> u256 { self.pos }
    fn set_pos(mut self, _ new_pos: u256) { self.pos = new_pos }
    fn read_u8<I: ByteInput>(mut self, _ input: I) -> u8 { 0 }
    fn read_word<I: ByteInput>(mut self, _ input: I) -> u256 { 0 }
    fn peek_word<I: ByteInput>(self, _ input: I, _ at: u256) -> u256 { 0 }
}
impl Abi for Alt {
    type Selector = u32
    type Decoder = AltDec
    const SELECTOR_SIZE: u256 = 4
    fn selector_from_prefix(_ prefix: u256) -> u32 { 0 }
    fn decode_bool_word(_ w: u256) -> bool { false }
    fn decode_u8_word(_ w: u256) -> u8 { 0 }
    fn decode_u16_word(_ w: u256) -> u16 { 0 }
    fn decode_u32_word(_ w: u256) -> u32 { 0 }
    fn decode_u64_word(_ w: u256) -> u64 { 0 }
    fn decode_u128_word(_ w: u256) -> u128 { 0 }
    fn decode_i8_word(_ w: u256) -> i8 { 0 }
    fn decode_i16_word(_ w: u256) -> i16 { 0 }
    fn decode_i32_word(_ w: u256) -> i32 { 0 }
    fn decode_i64_word(_ w: u256) -> i64 { 0 }
    fn decode_i128_word(_ w: u256) -> i128 { 0 }
    fn decode_error() -> ! { <Sol as Abi>::decode_error() }
    fn validate_runtime_head(input_len: u256, base: u256, head_size: u256) {}
    fn decoder_new() -> AltDec { AltDec { pos: 0, base: 0 } }
    fn decoder_with_base(_ base: u256) -> AltDec {
        // The checked word and empty-record paths below must not start a cursor.
        assert!(base != 64)
        AltDec { pos: base, base }
    }
}

struct Inner { value: u256 }
impl AbiSize for Inner {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}
impl<A: Abi> Encode<A> for Inner {
    fn encode(self, _ out: AbiFrame) { out.store_word(at: 0, value: self.value) }
}
impl<A: Abi> AbiSpan<A> for Inner {
    fn payload_end<I: ByteInput>(_ input: I, base: u256, pos: u256) -> u256 { pos + 32 }
}
impl Decode<Sol> for Inner {
    fn decode_payload<D: AbiDecoder<Sol>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
        Inner { value: d.read_word(input) }
    }
}
impl Decode<Alt> for Inner {
    fn decode_payload<D: AbiDecoder<Alt>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
        Inner { value: 90 + d.read_word(input) }
    }
}

struct Packet { nested: Inner, word: u256 }
impl AbiSize for Packet with (StructAbiSize)
impl Encode<Sol> for Packet with (StructAbiEncode)
impl Encode<Alt> for Packet with (StructAbiEncode)
impl AbiSpan<Sol> for Packet with (StructAbiSpan)
impl AbiSpan<Alt> for Packet with (StructAbiSpan)
impl Decode<Sol> for Packet with (StructAbiDecode)
impl Decode<Alt> for Packet with (StructAbiDecode)

#[test]
fn one_provider_preserves_both_abi_types_in_nested_field_decoding() {
    let bytes = encode_alloc<Sol, Packet>(Packet { nested: Inner { value: 13 }, word: 29 })
    let alternate_bytes = encode_alloc<Alt, Packet>(Packet { nested: Inner { value: 13 }, word: 29 })
    assert(<Packet as AbiSpan<Sol>>::payload_end(bytes.span(), base: 0, pos: 0) == 64)
    assert(<Packet as AbiSpan<Alt>>::payload_end(alternate_bytes.span(), base: 0, pos: 0) == 64)
    let standard = <Packet as Decode<Sol>>::decode_from(bytes.span(), 0)
    let alternate = <Packet as Decode<Alt>>::decode_from(alternate_bytes.span(), 0)
    assert(standard.nested.value == 13)
    assert(standard.word == 29)
    assert(alternate.nested.value == 90)
    // An opaque u256 reads its checked head directly. The nested codec
    // uses the selected ABI cursor, as does cursor-based decoding below.
    assert(alternate.word == 29)
    var cursor = <Alt as Abi>::decoder_with_base(0)
    let through_cursor = <Packet as Decode<Alt>>::decode_payload(mut cursor, alternate_bytes.span())
    assert(through_cursor.nested.value == 90)
    assert(through_cursor.word == 0)
}

struct Empty {}
impl AbiSize for Empty with (StructAbiSize)
impl Decode<Alt> for Empty with (StructAbiDecode)

struct WordOnly { word: u256 }
impl AbiSize for WordOnly with (StructAbiSize)
impl Decode<Alt> for WordOnly with (StructAbiDecode)

#[test]
fn prechecked_records_do_not_start_an_unused_decoder() {
    let raw = encode_alloc<Sol, (u256, u256, u256)>((10, 20, 29))
    let _ = <Empty as Decode<Alt>>::decode_from(raw.span(), 64)
    let word = <WordOnly as Decode<Alt>>::decode_from(raw.span(), 64)
    assert!(word.word == 29)
}
