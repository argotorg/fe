use core::ptr::{self, MemBuffer}
use core::abi::store_word
use std::abi::{Bytes, Bytes32, DynArray}
use std::evm::{Evm, RawOps, Call}
msg ArrayMsg {
    #[selector = 0x11223344]
    Read { values: DynArray<Bytes32> } -> u256,
    #[selector = 0x11223345]
    ReadDynamic { values: DynArray<Bytes> } -> u256,
}
pub contract ArrayReceiver {
    recv ArrayMsg {
        Read { values } -> u256 {
            values.len() as u256
        }
        ReadDynamic { values } -> u256 {
            values.len() as u256
        }
    }
}
fn rejects_empty(_ offset: u256, _ length: u256, _ salt: u256)
uses (evm: mut Evm)
{
    let receiver = evm.create2<ArrayReceiver>(value: Wei::zero(), args: (), salt: salt)
    let data = MemBuffer::alloc(68)
    unsafe { store_word(ptr: data.ptr(), value: (0x11223344 as u256) << 224) }
    unsafe { store_word(ptr: ptr::offset_bytes(data.ptr(), 4), value: offset) }
    unsafe { store_word(ptr: ptr::offset_bytes(data.ptr(), 36), value: length) }
    var ret = MemBuffer::empty()
    let outcome = evm
        .raw_call(
            addr: receiver,
            gas: 1000000,
            value: Wei::zero(),
            args: data.span(),
            ret: mut ret,
        )
    assert!(!outcome.success())
    assert!(outcome.returndata_len() == 0)
}
#[test]
fn overflowing_relative_tail_reverts_empty() uses (evm: mut Evm) {
    rejects_empty(!(0 as u256), 0, 1)
}
#[test]
fn overflowing_tail_head_reverts_empty() uses (evm: mut Evm) {
    rejects_empty(!(0 as u256) - 16, 0, 2)
}
#[test]
fn overflowing_array_multiplication_reverts_empty() uses (evm: mut Evm) {
    rejects_empty(32, (1 as u256) << 251, 3)
}
#[test]
fn overflowing_array_end_reverts_empty() uses (evm: mut Evm) {
    rejects_empty(32, (!(0 as u256)) / 32, 4)
}

#[test]
fn overflowing_dynamic_element_tail_reverts_empty() uses (evm: mut Evm) {
    let receiver = evm.create2<ArrayReceiver>(value: Wei::zero(), args: (), salt: 5)
    let data = MemBuffer::alloc(100)
    unsafe { store_word(ptr: data.ptr(), value: (0x11223345 as u256) << 224) }
    unsafe { store_word(ptr: ptr::offset_bytes(data.ptr(), 4), value: 32) }
    unsafe { store_word(ptr: ptr::offset_bytes(data.ptr(), 36), value: 1) }
    unsafe {
        store_word(
            ptr: ptr::offset_bytes(data.ptr(), 68),
            value: !(0 as u256) - 31,
        )
    }
    var ret = MemBuffer::empty()
    let outcome = evm
        .raw_call(
            addr: receiver,
            gas: 1000000,
            value: Wei::zero(),
            args: data.span(),
            ret: mut ret,
        )
    assert!(!outcome.success())
    assert!(outcome.returndata_len() == 0)
}
