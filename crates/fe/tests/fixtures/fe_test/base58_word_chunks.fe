// Word reads must exclude bytes outside each 24-byte block and span.
use core::abi::DynString
use core::ptr::MemBuffer
use core::text

#[test]
fn base58_roundtrips_all_block_tails_and_unaligned_spans() {
    var data = MemBuffer::new(160)
    for i in 0 .. 160 {
        data[i] = (i * 73 + 17).downcast_truncate()
    }
    for offset in 0 .. 8 {
        for len in 0 .. 74 {
            let input = data.slice(offset, len)
            let encoded = text::base58(input)
            assert!(text::decode_base58(encoded).unwrap().span() == input)
        }
    }
}

#[test]
fn base58_handles_leading_zeroes_and_exact_allocation_ends() {
    for len in 0 .. 74 {
        var input = MemBuffer::new(len)
        let zeros = text::base58(input.span())
        assert!(zeros.len() == len)
        for i in 0 .. len {
            assert!(zeros.byte_at(i) == b'1')
        }
        assert!(text::decode_base58(zeros).unwrap().span() == input.span())
        if len > 0 {
            input[len - 1] = 255
            let encoded = text::base58(input.span())
            assert!(
                text::decode_base58(encoded).unwrap().span() == input.span(),
            )
            input[0] = 128
            let encoded = text::base58(input.span())
            assert!(
                text::decode_base58(encoded).unwrap().span() == input.span(),
            )
        }
    }
}

fn check_vector(_ hex: DynString, _ expected: DynString) {
    let data = text::decode_hex(hex).unwrap()
    assert!(text::base58(data.span()) == expected)
}

#[test]
fn base58_matches_independent_vectors_at_block_boundaries() {
    check_vector(
        "ffffffffffffffffffffffffffffffffffffffffffffff",
        "6HgC8KRBEhXYbF4riJyJFLSHt32XBnGv",
    )
    check_vector(
        "115aa3ec357ec71059a2eb347dc60f58a1ea337cc50e57",
        "MnnKvsS2LixkpWBWdtQKDKaeww8H1Rx",
    )
    check_vector(
        "0000808080808080808080808080808080808080808080",
        "118uJcBywRgR26uXyPp8csFKUDVx9u1",
    )
    check_vector(
        "ffffffffffffffffffffffffffffffffffffffffffffffff",
        "QLbz7JHiBTspS962RLKV8GndWFwiEaqKL",
    )
    check_vector(
        "115aa3ec357ec71059a2eb347dc60f58a1ea337cc50e57a0",
