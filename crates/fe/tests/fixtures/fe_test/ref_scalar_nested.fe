struct Slot {
    value: u256,
}

struct Reader {
    slot: Slot,
    bias: u256,
}

impl Reader {
    fn source(self) -> ref Slot {
        ref self.slot
    }
}

fn sum_reader(_ r: Reader) -> u256 {
    var total = 0
    var i: u256 = 0
    while i < 4 {
        total += r.source().value + r.bias
        i += 1
    }
    total
}

#[test]
fn test_ref_scalar_nested() {
    let reader = Reader { slot: Slot { value: 7 }, bias: 3 }
    assert!(sum_reader(reader) == 40)
}
