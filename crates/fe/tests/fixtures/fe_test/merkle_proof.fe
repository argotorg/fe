// `std::evm::merkle`: OpenZeppelin `MerkleProof` parity for sorted-pair
// trees and Seaport bulk-order parity for positional (indexed) trees.
//
// Every expected value was precomputed outside Fe with Foundry's
// `cast keccak` as the hash oracle (leaf i = keccak256(abi.encode(uint256(i)))):
// sorted trees pair adjacent nodes with OpenZeppelin's commutative
// `_hashPair` and promote an odd last node unchanged (merkletreejs
// `sortPairs`), positional trees are complete and were cross-checked
// against a re-implementation of Seaport's `_computeBulkOrderProof` walk.
// The fixture is not its own oracle.

use core::ptr::{self, MemSlice}
use std::abi::{Bytes32, DynArray, FixedBytes, MemVec}
use std::evm::{Evm, merkle}

fn words<const N: usize>(_ values: [u256; N]) -> MemSlice<u256> {
    let mut array = ptr::alloc_array<u256>(N as u256)
    let mut i: usize = 0
    for value in values {
        array[i] = value
        i += 1
    }
    array.as_slice()
}

fn empty() -> MemSlice<u256> {
    MemSlice<u256>::empty()
}

// keccak256(abi.encode(uint256(1))), keccak256(abi.encode(uint256(2)))
const PAIR_A: u256 = 0xb10e2d527612073b26eecdfd717e6a320cf44b4afac2b0732d9fcbe2b7fa0cf6
const PAIR_B: u256 = 0x405787fa12a823e0f2b7631cc41b3ba8828b3321ca811111fa75cd3aa3bb5ace
// keccak256(abi.encode(min(a, b), max(a, b)))
const PAIR_AB: u256 = 0x2a171b5bcd1449348c3e09a5424946b5e6d6f5471221941d585131d673952ee4
// keccak256(abi.encode(a, a))
const PAIR_AA: u256 = 0xb6fd98eeb7e08fc521f11511289afe4d8e873fd7a3fb76ab757fa47c23f596e9

#[test]
fn test_hash_pair_sorted() {
    assert!(merkle::hash_pair_sorted(PAIR_A, PAIR_B) == PAIR_AB)
    assert!(merkle::hash_pair_sorted(PAIR_B, PAIR_A) == PAIR_AB)
    assert!(merkle::hash_pair_sorted(PAIR_A, PAIR_A) == PAIR_AA)
}

// A one-leaf tree: the root is the leaf and the proof is empty.
#[test]
fn test_empty_proof() {
    assert!(merkle::process_proof(proof: empty(), leaf: PAIR_A) == PAIR_A)
    assert!(merkle::verify(proof: empty(), root: PAIR_A, leaf: PAIR_A))
    assert!(!merkle::verify(proof: empty(), root: PAIR_A, leaf: PAIR_B))
    assert!(merkle::process_indexed_proof(proof: empty(), leaf: PAIR_A, index: 7) == PAIR_A)
    assert!(merkle::verify_indexed(proof: empty(), root: PAIR_A, leaf: PAIR_A, index: 7))
    assert!(!merkle::verify_indexed(proof: empty(), root: PAIR_A, leaf: PAIR_B, index: 0))
}

const ROOT_2: u256 = 0x891370df4fadf33f50e41f7c8a791e680c0655695ea3404385a909c8f5e13fb4
const LEAF_2_0: u256 = 0x290decd9548b62a8d60345a988386fc84ba6bc95484008f6362f93160ef3e563
const LEAF_2_1: u256 = 0xb10e2d527612073b26eecdfd717e6a320cf44b4afac2b0732d9fcbe2b7fa0cf6

const ROOT_3: u256 = 0x038a2f0e22b3057e8442080dd34c298001ff0796b494235f125d681d5507068c
const LEAF_3_0: u256 = 0x290decd9548b62a8d60345a988386fc84ba6bc95484008f6362f93160ef3e563
