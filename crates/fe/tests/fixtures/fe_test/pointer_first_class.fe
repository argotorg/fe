use core::abi::ByteInput

struct Data {
    a: u256,
    b: u256,
}

struct Holder {
    data: *Data,
}

msg PointerBoundsMsg {
    #[selector = 0x01]
    MemArrayRead,
    #[selector = 0x02]
    MemArrayWrite,
    #[selector = 0x03]
    MemSpanSlice,
    #[selector = 0x04]
    MemBufferLen,
}

pub contract PointerBounds {
    recv PointerBoundsMsg {
        MemArrayRead {} {
            let array = core::ptr::MemArray<u256>::new_uninit(1)
            let _value = *array.ptr_at(1)
        }

        MemArrayWrite {} {
            let array = core::ptr::MemArray<u256>::new_uninit(1)
            *array.ptr_at(1) = 1
        }

        MemSpanSlice {} {
            let array = core::ptr::MemArray<u8>::new_uninit(4)
            let _slice = array.span().slice(offset: 3, len: 2)
        }

        MemBufferLen {} {
            let mut buffer = core::ptr::MemBuffer::with_capacity(4)
            buffer.set_len(5)
        }
    }
}

fn read_data(_ data: *Data) -> u256 {
    data.a
}

fn write_data(_ data: *Data, value: u256) {
    data.a = value
}

fn replace_holder_data(_ holder: *Holder, _ data: *Data) {
    holder.data = data
}

fn pointers_equal<T>(_ lhs: T, _ rhs: T) -> bool where T: core::ops::Eq {
    lhs == rhs
}

#[test]
fn test_first_class_memory_pointers() {
    let data = core::ptr::alloc<Data>()
    data.a = 5
    data.b = 8

    let words = core::ptr::cast<Data, u256>(data)
    let second = core::ptr::offset(words, 1)
    *second = *second + 3
    assert(data.a == 5)
    assert(data.b == 11)

    let holder = Holder { data: data }
    holder.data.b = holder.data.a + holder.data.b
    assert(holder.data.b == 16)
    assert(data.b == 16)

    let byte_ptr = core::ptr::byte_ptr(data)
    let roundtrip = core::ptr::cast<u8, Data>(byte_ptr)
    let first = *roundtrip
    assert(first.a == 5)
    assert(first.b == 16)

    let raw_array = core::ptr::alloc_array<u256>(1)
    raw_array[0] = 19
    assert(raw_array[0] == 19)

    let byte_alloc = core::ptr::alloc_bytes(1)
    *byte_alloc = 37
    assert(*byte_alloc == 37)

    let mut array = core::ptr::alloc_array<u256>(2)
    array[0] = first.a
    array[1] = first.b
    let array_sum = array[0] + array[1]

    let bytes = array.into_bytes()
    assert(bytes.len() == 64)
    let (first_word, second_word) = bytes.span().split_at(offset: 32)
    assert(first_word.len() == 32)
    assert(second_word.len() == 32)
    assert(array_sum == 21)

    let mut zeroed = core::ptr::MemArray<u256>::new_zeroed(2)
    assert(!zeroed.is_empty())
    assert(zeroed[0] == 0)
    assert(zeroed[1] == 0)
    zeroed[0] = 99
    zeroed.zero()
    assert(zeroed[0] == 0)

    let pair = core::ptr::alloc<[u256; 2]>()
    pair[0] = 13
    pair[1] = 21
    let pair_bytes = core::ptr::byte_ptr(pair)
    let pair_words = core::ptr::cast<u8, u256>(pair_bytes)
    assert(pair[0] == 13)
    assert(pair[1] == 21)
    assert(*pair_words + *core::ptr::offset(pair_words, 1) == 34)
}

#[test]
fn test_pointer_parameter_field_access() {
    let data = core::ptr::alloc<Data>()
    write_data(data, value: 42)
    assert(read_data(data) == 42)

    let replacement = core::ptr::alloc<Data>()
    replacement.a = 99
    let holder = core::ptr::alloc<Holder>()
    replace_holder_data(holder, replacement)
    assert(holder.data.a == 99)
}

#[test]
fn test_pointer_equality() {
    let p = core::ptr::alloc<u256>()
    let q = core::ptr::alloc<u256>()
    assert(p == p)
    assert(p != q)
    assert(core::ptr::offset(p, 0) == p)
    assert(pointers_equal(p, p))

    let p_bytes = core::ptr::cast<u256, u8>(p)
    let q_bytes = core::ptr::cast<u256, u8>(q)
    assert(p_bytes != q_bytes)
    assert(core::ptr::cast<u8, u256>(p_bytes) == p)
}

#[test]
fn test_subword_memory_pointer_roundtrip() {
    let mut bytes = core::ptr::MemArray<u8>::new_zeroed(4)
    bytes[0] = 1
    bytes[1] = 2
    bytes[2] = 3
    bytes[3] = 4
    assert(bytes[0] == 1)
    assert(bytes[1] == 2)
    assert(bytes[2] == 3)
    assert(bytes[3] == 4)

    let mut words = core::ptr::MemArray<u16>::new_zeroed(2)
    words[0] = 0x1234
    words[1] = 0xabcd
    assert(words[0] == 0x1234)
    assert(words[1] == 0xabcd)
}

#[test]
fn test_subword_static_array_pointer_roundtrip() {
    let pair = core::ptr::alloc<[u8; 4]>()
    pair[0] = 9
    pair[1] = 8
    pair[2] = 7
    pair[3] = 6
    assert(pair[0] == 9)
    assert(pair[1] == 8)
    assert(pair[2] == 7)
    assert(pair[3] == 6)
}

#[test]
fn test_typed_memory_slices_and_growable_buffers() {
    let mut words = core::ptr::MemArray<u16>::new_zeroed(3)
    words[0] = 0x1234
    words[1] = 0x5678
    words[2] = 0x9abc

    let typed = words.as_slice()
    assert!(typed.len() == 3)
    assert!(typed.byte_len() == 6)
    assert!(typed[1] == 0x5678)
    match typed.get(2) {
        Option::Some(value) => assert!(value == 0x9abc)
        Option::None => assert!(false)
    }
    match typed.try_slice(start: 1, len: 2) {
        Option::Some(tail) => {
            assert!(tail[0] == 0x5678)
            assert!(tail[1] == 0x9abc)
        }
        Option::None => assert!(false)
    }
    assert!(typed.try_slice(start: 2, len: 2).is_none())

    let mut source = core::ptr::MemArray<u8>::new_zeroed(4)
    source[0] = 1
    source[1] = 2
    source[2] = 3
    source[3] = 4

    let mut buffer = core::ptr::MemBuffer::from_span(source.span())
    assert!(buffer.len() == 4)
    assert!(buffer.capacity() == 4)

    // The append exceeds the exact initial capacity and exercises copy-on-grow.
    let mut append_bytes = core::ptr::MemArray<u8>::new_zeroed(2)
    append_bytes[0] = 2
    append_bytes[1] = 3
    buffer.extend_from(append_bytes.span())
    assert!(buffer.len() == 6)
    assert!(buffer.span().byte_at(4) == 2)
    assert!(buffer.span().byte_at(5) == 3)

    buffer.reserve(70)
    assert!(buffer.remaining_capacity() >= 70)
    assert!(buffer.span().byte_at(0) == 1)
    let mut overwrite = core::ptr::MemArray<u8>::new_zeroed(2)
    overwrite[0] = 1
    overwrite[1] = 2
    buffer.copy_from(dest_offset: 8, source: overwrite.span())
    assert!(buffer.len() == 10)
    assert!(buffer.span().byte_at(6) == 0)
    assert!(buffer.span().byte_at(7) == 0)
    assert!(buffer.span().byte_at(8) == 1)
    assert!(buffer.span().byte_at(9) == 2)
    buffer.copy_from(
        dest_offset: 20,
        source: core::ptr::MemSpan::empty(),
    )
    assert!(buffer.len() == 10)

    let mut input = core::ptr::MemArray<u8>::new_zeroed(4)
    input[0] = 1
    input[1] = 2
    input[2] = 3
    input[3] = 4
    let mut copied = core::ptr::MemArray<u8>::new_zeroed(3)
    input.span().copy_to_memory(dest: copied.ptr(), src_offset: 1, len: 3)
    assert!(copied[0] == 2)
    assert!(copied[1] == 3)
    assert!(copied[2] == 4)
}

#[test]
fn test_pointer_to_pointer_deref() {
    let p = core::ptr::alloc<u256>()
    *p = 5
    let pp = core::ptr::alloc<*u256>()
    *pp = p
    assert(*(*pp) == 5)
}

#[test]
fn test_borrowed_pointer_deref() {
    let mut p = core::ptr::alloc<u256>()
    let borrowed = mut p
    *borrowed = 3
    assert(*p == 3)
}

#[test]
fn test_memory_region_bounds_halt_before_access() uses (evm: mut std::evm::Evm) {
    let bounds = evm.create2<PointerBounds>(value: 0, args: (), salt: 0)
    assert!(!evm.try_call(
        addr: bounds,
        gas: 100000,
        value: 0,
        message: PointerBoundsMsg::MemArrayRead {},
    ).success())
    assert!(!evm.try_call(
        addr: bounds,
        gas: 100000,
        value: 0,
        message: PointerBoundsMsg::MemArrayWrite {},
    ).success())
    assert!(!evm.try_call(
        addr: bounds,
        gas: 100000,
        value: 0,
        message: PointerBoundsMsg::MemSpanSlice {},
    ).success())
    assert!(!evm.try_call(
        addr: bounds,
        gas: 100000,
        value: 0,
        message: PointerBoundsMsg::MemBufferLen {},
    ).success())
}
