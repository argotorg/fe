// Returning a link through a helper makes borrow-summary reachability follow
// the array's recursive referents, rather than just the initialized local cells.
struct Node { value: u256, links: [*Node; 2] }

fn follow(_ node: *Node, index: usize) -> *Node { unsafe { node.links[index] } }

fn walk(_ node: *Node, steps: usize) -> u256 {
    var current = node
    var remaining = steps
    while remaining > 0 {
        current = follow(current, index: 0)
        remaining -= 1
    }
    unsafe { current.value }
}

#[test]
fn recursive_array_handles_through_helpers() {
    let head = core::ptr::alloc<Node>()
    let tail = core::ptr::alloc<Node>()
    unsafe { head.value = 10 }
    unsafe { head.links = [tail, head] }
    unsafe { tail.value = 20 }
    unsafe { tail.links = [head, tail] }
    unsafe { assert!(follow(head, index: 0).value == 20) }
    unsafe { assert!(follow(head, index: 1).value == 10) }
    assert!(walk(head, steps: 8) == 10)
    assert!(walk(head, steps: 9) == 20)
    unsafe { follow(head, index: 0).value = 21 }
    unsafe { assert!(tail.value == 21) }
    assert!(walk(head, steps: 3) == 21)

    let borrowed = unsafe { mut head.value }
    unsafe { tail.value = 22 }
    borrowed = 11
    unsafe { assert!(head.value == 11) }
    unsafe { assert!(follow(head, index: 0).value == 22) }
}
