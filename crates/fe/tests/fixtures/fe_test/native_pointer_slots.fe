use core::ptr
use std::evm::Evm

fn replace_shared(slot: *ref u256, value: ref u256) {
    *slot = value
}

fn replace_mutable(slot: *mut u256, value: mut u256) {
    *slot = value
}

fn read_shared(slot: *ref u256) -> u256 {
    *slot
}

fn read_mutable(slot: *mut u256) -> u256 {
    *slot
}

fn increment(slot: *mut u256) {
    *slot += 1
}

fn read_array(slot: *ref [u256; 2]) -> [u256; 2] {
    *slot
}

fn increment_byte(slot: *mut u8) {
    *slot += 1
}

fn read_byte(slot: *ref u8) -> u8 {
    *slot
}

#[test]
fn native_scalar_slot_preserves_layout_and_aliases() {
    let mut owner: u8 = 7
    let slot = ptr::alloc<mut u8>()
    *slot = mut owner
    increment_byte(slot)
    replace_mutable_with_heap(slot, value: 0)
    assert!(owner == 8)
}

#[test]
fn shared_native_scalar_slot_reads_the_word_layout() {
    let owner: u8 = 19
    let slot = ptr::alloc<ref u8>()
    *slot = ref owner
    assert!(read_byte(slot) == 19)
    replace_shared_with_heap(slot, value: 0)
}

#[test]
fn packed_scalar_slot_preserves_adjacent_bytes() {
    let owner = ptr::alloc<[u8; 2]>()
    *owner = [7, 99]
    let slot = ptr::alloc<mut u8>()
    *slot = mut (*owner)[0]
    increment_byte(slot)
    assert!((*owner)[0] == 8)
    assert!((*owner)[1] == 99)
}

#[test]
fn shared_slot_replacement_reads_the_new_referent() {
    let old = ptr::alloc<u256>()
    let next = ptr::alloc<u256>()
    *old = 11
    *next = 22
    let slot = ptr::alloc<ref u256>()
    *slot = ref *old
    replace_shared(slot, value: ref *next)
    assert!(read_shared(slot) == 22)
    assert!(*old == 11)
}

#[test]
fn mutable_slot_replacement_updates_the_new_referent() {
    let old = ptr::alloc<u256>()
    let next = ptr::alloc<u256>()
    *old = 11
    *next = 22
    let slot = ptr::alloc<mut u256>()
    *slot = mut *old
    replace_mutable(slot, value: mut *next)
    increment(slot)
    assert!(read_mutable(slot) == 23)
    assert!(*old == 11)
    assert!(*next == 23)
}

#[test]
fn replacement_initializes_a_clobbered_slot() {
    let owner = ptr::alloc<u256>()
    *owner = 7
    let slot = ptr::alloc<ref u256>()
    let native = ref *owner
    ptr::zero_bytes(ptr::byte_ptr(slot), 32)
    replace_shared(slot, value: native)
    assert!(read_shared(slot) == 7)
}

#[test]
fn aggregate_read_copies_the_referent() {
    let owner = ptr::alloc<[u256; 2]>()
    *owner = [11, 22]
    let slot = ptr::alloc<ref [u256; 2]>()
    *slot = ref *owner
    let copied = read_array(slot)
    *owner = [33, 44]
    assert!(copied[0] == 11)
    assert!(copied[1] == 22)
}


fn choose_byte(
    slot: *mut u8,
    first: mut u8,
    second: mut u8,
    use_first: bool,
) {
    if use_first {
        *slot = first
    } else {
        *slot = second
    }
}

#[test]
fn reference_slots_keep_layout_across_control_flow() {
    let mut native: u8 = 8
    let packed = ptr::alloc<u8>()
    *packed = 31
    let slot = ptr::alloc<mut u8>()
    choose_byte(slot, first: mut native, second: mut *packed, use_first: true)
    increment_byte(slot)
    replace_mutable_with_heap(slot, value: 0)
    assert!(native == 9)
    assert!(*packed == 31)
    choose_byte(slot, first: mut native, second: mut *packed, use_first: false)
    increment_byte(slot)
    replace_mutable_with_heap(slot, value: 0)
    assert!(native == 9)
    assert!(*packed == 32)
}

fn increment_array_byte(slot: *mut [u8; 2]) {
    (*slot)[1] += 1
}

#[test]
fn native_aggregate_slot_preserves_field_layout_and_aliases() {
    let mut native: [u8; 2] = [11, 22]
    let slot = ptr::alloc<mut [u8; 2]>()
    *slot = mut native
    increment_array_byte(slot)
    replace_mutable_with_heap(slot, value: [0, 0])
    assert!(native[0] == 11)
    assert!(native[1] == 23)
}

struct NativeLinks {
    first: ref u8,
    pair: ref [u8; 2],
}

impl Copy for NativeLinks {}

fn read_links(slot: *ref NativeLinks) -> u8 {
    let links = *slot
    links.first + links.pair[1]
}

#[test]
fn nested_native_references_keep_their_layout() {
    let first: u8 = 3
    let pair: [u8; 2] = [4, 5]
    let links = NativeLinks { first: ref first, pair: ref pair }
    let slot = ptr::alloc<ref NativeLinks>()
    *slot = ref links
    assert!(read_links(slot) == 8)
    let heap_first = ptr::alloc<u8>()
    *heap_first = 0
    let heap_pair = ptr::alloc<[u8; 2]>()
    *heap_pair = [0, 0]
    replace_shared_with_heap(slot, value: NativeLinks { first: ref *heap_first, pair: ref *heap_pair })
}

enum NativeChoice {
    First(u8),
    Second(u256, u8),
}

impl Copy for NativeChoice {}

impl NativeChoice {
    fn change(mut self) {
        self = NativeChoice::Second(17, 23)
    }

    fn last(self) -> u8 {
        match self {
            NativeChoice::First(value) => value,
            NativeChoice::Second(_, value) => value,
        }
    }
}

fn change_choice(slot: *mut NativeChoice) {
    (*slot).change()
}

fn choice_last(slot: *ref NativeChoice) -> u8 {
    (*slot).last()
}

#[test]
fn native_enum_slot_preserves_variant_layout_and_aliases() {
    let mut native = NativeChoice::First(7)
    let slot = ptr::alloc<mut NativeChoice>()
    *slot = mut native
    change_choice(slot)
    replace_mutable_with_heap(slot, value: NativeChoice::First(0))
    assert!(native.last() == 23)
    let shared = ptr::alloc<ref NativeChoice>()
    *shared = ref native
    assert!(choice_last(slot: shared) == 23)
    replace_shared_with_heap(slot: shared, value: NativeChoice::First(0))
}

#[test]
fn packed_enum_slot_preserves_variant_layout_and_aliases() {
    let packed = ptr::alloc<NativeChoice>()
    *packed = NativeChoice::First(7)
    let slot = ptr::alloc<mut NativeChoice>()
    *slot = mut *packed
    change_choice(slot)
    assert!((*packed).last() == 23)
    let shared = ptr::alloc<ref NativeChoice>()
    *shared = ref *packed
    assert!(choice_last(slot: shared) == 23)
}

// Typed replacement ends the retained local borrow before the local expires.
fn replace_mutable_with_heap<T>(slot: *mut T, value: own T) {
    let replacement = ptr::alloc<T>()
    *replacement = value
    *slot = mut *replacement
}

fn replace_shared_with_heap<T>(slot: *ref T, value: own T) {
    let replacement = ptr::alloc<T>()
    *replacement = value
    *slot = ref *replacement
}


msg NativeSlotMsg {
    #[selector = 1]
    Increment -> u256,
    #[selector = 2]
    ChangeChoice -> u8,
}

pub contract NativeSlotContract {
    mut value: u256,
    mut choice: NativeChoice,

    recv NativeSlotMsg {
        Increment -> u256 uses (mut value) {
            let slot = ptr::alloc<mut u256>()
            *slot = mut value
            increment(slot)
            value
        }
        ChangeChoice -> u8 uses (mut choice) {
            let slot = ptr::alloc<mut NativeChoice>()
            *slot = mut choice
            change_choice(slot)
            choice.last()
        }
    }
}

#[test]
fn native_slots_preserve_storage_addresses_and_layouts() uses (evm: mut Evm) {
    let c = evm.create2<NativeSlotContract>(value: Wei::zero(), args: (), salt: 0)
    let first: u256 = evm.call(addr: c, gas: 200000, value: Wei::zero(), message: NativeSlotMsg::Increment {})
    let second: u256 = evm.call(addr: c, gas: 200000, value: Wei::zero(), message: NativeSlotMsg::Increment {})
    let last: u8 = evm.call(addr: c, gas: 200000, value: Wei::zero(), message: NativeSlotMsg::ChangeChoice {})
    assert!(first == 1)
    assert!(second == 2)
    assert!(last == 23)
}

fn load_shared_byte(slot: *ref u8) -> ref u8 { *slot }

fn choose_shared_byte(first: ref u8, second: ref u8, use_first: bool) -> ref u8 {
    if use_first { first } else { second }
}

#[test]
fn returning_a_stored_native_reference_preserves_its_carrier() {
    let owner = ptr::alloc<u8>()
    *owner = 23
    let slot = ptr::alloc<ref u8>()
    *slot = ref *owner
    let loaded = load_shared_byte(slot)
    assert!(loaded == 23)
    assert!(load_shared_byte(slot) == 23)
}

#[test]
fn mixed_native_reference_returns_preserve_both_layouts() {
    let native: u8 = 11
    let packed = ptr::alloc<u8>()
    *packed = 37
    assert!(choose_shared_byte(first: ref native, second: ref *packed, use_first: true) == 11)
    assert!(choose_shared_byte(first: ref native, second: ref *packed, use_first: false) == 37)
}

struct NativeBytePair { first: u8, second: u8 }

#[test]
fn stored_constant_field_reference_preserves_its_value() {
    let owner = NativeBytePair { first: 11, second: 23 }
    let slot = ptr::alloc<ref u8>()
    *slot = ref owner.second
    assert!(read_byte(slot) == 23)
    replace_shared_with_heap(slot, value: 0)
}
