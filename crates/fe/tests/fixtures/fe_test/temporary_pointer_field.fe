use core::ptr::MemArray

struct Item {
    a: u256,
    b: u256,
}

struct Order {
    items: MemArray<Item>,
    n: u256,
}

struct Link {
    next: *Item,
}

fn first(_ orders: MemArray<Order>) -> *Order {
    orders.ptr_at(0)
}

fn orders_with_one_item() -> MemArray<Order> {
    var orders = unsafe { MemArray<Order>::new_uninit(1) }
    var items = unsafe { MemArray<Item>::new_uninit(1) }
    items[0] = Item { a: 1, b: 2 }
    orders[0] = Order { items, n: 5 }
    orders
}

#[test]
fn read_field_of_temporary_pointer() {
    let orders = orders_with_one_item()
    unsafe { assert(orders.ptr_at(0).n == 5) }
    unsafe { assert(first(orders).n == 5) }
    unsafe { assert(orders.ptr_at(0).items.ptr_at(0).a == 1) }
    let o = orders.ptr_at(0)
    unsafe { assert(o.items.ptr_at(0).b == 2) }
}

#[test]
fn write_field_of_temporary_pointer() {
    let orders = orders_with_one_item()
    unsafe { orders.ptr_at(0).n = 9 }
    unsafe { first(orders).items.ptr_at(0).b = 7 }
    unsafe { orders.ptr_at(0).items.ptr_at(0).a += 5 }
    let o = orders.ptr_at(0)
    unsafe { assert(o.n == 9) }
    unsafe { assert(o.items.ptr_at(0).a == 6) }
    unsafe { assert(o.items.ptr_at(0).b == 7) }
}

#[test]
fn field_through_pointer_field_of_temporary_pointer() {
    var items = unsafe { MemArray<Item>::new_uninit(1) }
    items[0] = Item { a: 3, b: 4 }
    var links = unsafe { MemArray<Link>::new_uninit(1) }
    links[0] = Link { next: items.ptr_at(0) }
    unsafe { assert(links.ptr_at(0).next.a == 3) }
    unsafe { links.ptr_at(0).next.b = 8 }
    unsafe { assert(items.ptr_at(0).b == 8) }
}

#[test]
fn explicitly_borrow_field_of_temporary_pointer() {
    let orders = orders_with_one_item()
    let value = unsafe { mut orders.ptr_at(0).n }
    value += 7
    unsafe { assert(orders.ptr_at(0).n == 12) }
    let shared = unsafe { ref first(orders).n }
    assert(shared == 12)
    let nested = unsafe { mut orders.ptr_at(0).items.ptr_at(0).a }
    nested += 8
    unsafe { assert(orders.ptr_at(0).items.ptr_at(0).a == 9) }
}
