// A call gives some of its callee's generic arguments and infers the rest:
// each instance runs with the constant it is given and the type its
// arguments infer.
trait Rules {
    const DUPN: bool = false
}

struct Osaka {}
struct Amsterdam {}

impl Rules for Osaka {}
impl Rules for Amsterdam {
    const DUPN: bool = true
}

struct Cursor<F: Rules> { gas: u64 }

impl<F: Rules> Copy for Cursor<F> {}

trait Tracer {
    fn trace(mut self, _ n: u64)
}

struct Count { calls: u64, sum: u64 }

impl Tracer for Count {
    fn trace(mut self, _ n: u64) {
        self.calls += 1
        self.sum += n
    }
}

fn op<const N: u64, F: Rules>(_ c: Cursor<F>) -> u64 {
    if F::DUPN { c.gas + N } else { c.gas }
}

fn scaled<const N: u64, F: Rules, const SCALE: u64 = 10>(_ c: Cursor<F>) -> u64 {
    op<N>(c) * SCALE
}

struct Vm { pc: u64 }

impl Vm {
    fn op_push<const N: u64, F: Rules, T: Tracer>(self, _ c: Cursor<F>, _ tracer: mut T) -> u64 {
        tracer.trace(N)
        self.pc + op<N>(c)
    }

    fn step<F: Rules, T: Tracer>(self, _ c: Cursor<F>, _ tracer: mut T) -> u64 {
        self.op_push<1>(c, mut tracer) + self.op_push<2, F>(c, mut tracer)
    }

    fn step_inferred<F: Rules, T: Tracer>(self, _ c: Cursor<F>, _ tracer: mut T) -> u64 {
        self.op_push<3, _, T>(c, mut tracer) + self.op_push<4, _, _>(c, mut tracer)
    }
}

fn size_of_default<T = u8>(_ value: own T) -> usize {
    core::size_of<T>()
}

fn len<T, const N: usize>(_ values: [T; N]) -> usize {
    N
}

fn run<F: Rules>(_ c: Cursor<F>) -> u64 {
    op<1>(c)
}

#[test]
fn omitted_arguments_are_inferred() {
    assert!(run(Cursor<Amsterdam> { gas: 5 }) == 6)
    assert!(run(Cursor<Osaka> { gas: 5 }) == 5)
    assert!(scaled<3>(Cursor<Amsterdam> { gas: 1 }) == 40)
    assert!(scaled<3, Osaka, 2>(Cursor<Osaka> { gas: 1 }) == 2)
}

#[test]
fn omitted_method_arguments_are_inferred() {
    let vm = Vm { pc: 100 }
    var tracer = Count { calls: 0, sum: 0 }
    assert!(
        vm.step(Cursor<Amsterdam> { gas: 5 }, mut tracer) == 106 + 107,
    )
    assert!(vm.step(Cursor<Osaka> { gas: 5 }, mut tracer) == 105 + 105)
    assert!(tracer.calls == 4)
    assert!(tracer.sum == 6)
}

#[test]
fn underscore_arguments_are_inferred() {
    assert!(op<1, _>(Cursor<Amsterdam> { gas: 5 }) == 6)
    assert!(op<1, _>(Cursor<Osaka> { gas: 5 }) == 5)
    assert!(scaled<2, _>(Cursor<Amsterdam> { gas: 1 }) == 30)
    assert!(len<_, 3>([true, false, true]) == 3)
    assert!(len<u16, _>([1, 2]) == 2)
    // `_` infers a parameter that has a default.
    let wide: u256 = 1
    assert!(size_of_default<_>(wide) == 32)
    assert!(size_of_default(1) == 1)
    let vm = Vm { pc: 0 }
    var tracer = Count { calls: 0, sum: 0 }
    assert!(
        vm.step_inferred(Cursor<Amsterdam> { gas: 1 }, mut tracer) == 4 + 5,
    )
    assert!(tracer.sum == 7)
}
