// Mutable views write their owners: a `mut` span from `span` or `slice`, a
// generic `mut MemSlice` parameter, the halves of `split_at` and the parts of
// `as_chunks` at `mut`, and owner-side byte indexing on `MemBuffer`.
use core::abi::{Bytes, DynString}
use core::ptr::{MemArray, MemBuffer, MemSlice}

fn fill<T: Copy>(_ s: mut MemSlice<T>, _ v: T) {
    for mut x in s {
        x = v
    }
}

#[test]
fn mutable_views_write_their_owners() {
    var buf = MemBuffer::new(8)
    let s = mut buf.span()
    s[0] = 10
    assert!(buf[0] == 10)
    let part = mut buf.slice(offset: 2, len: 3)
    fill(mut part, 7)
    assert!(buf[1] == 0 && buf[2] == 7 && buf[4] == 7 && buf[5] == 0)
    buf[7] = 9
    assert!(buf.span().byte_at(7) == 9)

    var xs = MemArray<u256>::new_zeroed(4)
    let all = mut xs.as_slice()
    let (mut head, mut tail) = all.split_at(1)
    head[0] = 1
    tail[0] = 2
    tail.at(2) += 3
    assert!(xs[0] == 1 && xs[1] == 2 && xs[2] == 0 && xs[3] == 3)
}

#[test]
fn splits_read_and_check_their_bounds() {
    var buf = MemBuffer::new(4)
    buf[1] = 5
    buf[2] = 6
    let (head, tail) = buf.span().split_at(2)
    assert!(head.len() == 2 && tail.len() == 2)
    assert!(head.byte_at(1) == 5 && tail.byte_at(0) == 6)
    let s = mut buf.span()
    if let Option::Some((mut a, mut b)) = s.try_split_at(1) {
        a[0] = 1
        b[0] = 2
    }
    assert!(buf[0] == 1 && buf[1] == 2)
    let missing = match buf.span().try_split_at(9) {
        Option::Some(_) => false
        Option::None => true
    }
    assert!(missing)
}

#[test]
fn chunks_cover_whole_chunks_then_the_rest() {
    var buf = MemBuffer::new(8)
    for i in 0..8 {
        buf[i] = (i + 1).downcast_truncate()
    }
    let (chunks, rest) = buf.span().as_chunks<3>()
    assert!(chunks.len() == 2 && rest.len() == 2)
    assert!(chunks[0][0] == 1 && chunks[1][2] == 6 && rest[0] == 7 && rest[1] == 8)
    let (whole, none) = buf.span().as_chunks<4>()
    assert!(whole.len() == 2 && none.is_empty())
    let (wide, short) = buf.span().as_chunks<9>()
    assert!(wide.is_empty() && short.len() == 8)

    var xs = MemArray<u256>::new_zeroed(5)
    let (mut pairs, mut last) = xs.as_slice().as_chunks<2>()
    pairs[1][0] = 3
    pairs[1] = [pairs[1][0], 4]
    last[0] = 5
    assert!(xs[0] == 0 && xs[2] == 3 && xs[3] == 4 && xs[4] == 5)
}

#[test(should_revert, selector = 0x4e487b71)]
fn chunks_of_no_elements_revert() {
    let buf = MemBuffer::new(4)
    let (chunks, _) = buf.span().as_chunks<0>()
    assert!(chunks.is_empty())
}

#[test]
fn string_and_bytes_spans_write_their_payloads() {
    var s = DynString::zeroed(3)
    let text = mut s.span()
    text[0] = b'a'
    text[1] = b'b'
    text[2] = b'c'
    let expected: DynString = "abc"
    assert!(s == expected && s.len() == 3)

    var b = Bytes::zeroed(33)
    b.span()[32] = 7
    assert!(b.len() == 33 && b.byte_at(32) == 7 && b.byte_at(31) == 0)
    // The padding after the payload stays zero.
    assert!(b.encoded_span().read_word(64) == 7 << 248)
}
