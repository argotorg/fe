use std::evm::{Evm, StorPtr, TStorPtr}

// Projections that yield a packed storage field grant a place in its lane:
// the write updates only the field's bytes of the shared slot.

struct Pair { a: u8, b: u8 }

impl Pair {
    fn b_mut(mut self) -> mut u8 {
        mut self.b
    }

    fn b_ref(self) -> ref u8 {
        ref self.b
    }
}

struct Generic<T> { a: T, b: T }

impl<T> Generic<T> {
    fn b_mut(mut self) -> mut T {
        mut self.b
    }
}

struct Pairs { ps: [Pair; 3] }

impl Pairs {
    fn b_mut(mut self, _ i: usize) -> mut u8 {
        mut self.ps[i].b
    }
}

trait Me {
    fn me(mut self) -> mut u8
}

impl Me for u8 {
    fn me(mut self) -> mut u8 {
        mut self
    }
}

// A projection whose slide writes its `mut` parameter.
fn cached(_ x: mut u8) -> mut u8 {
    var tmp: u8 = x
    yield mut tmp
    x = tmp
}

trait Cached {
    fn cached(mut self) -> mut u8
}

impl Cached for u8 {
    fn cached(mut self) -> mut u8 {
        var tmp: u8 = self
        yield mut tmp
        self = tmp
    }
}

fn set_b() uses (pair: mut Pair) {
    let b = mut pair.b_mut()
    b = 0x2a
}

fn b() -> u8 uses (pair: Pair) {
    let b = pair.b_ref()
    b
}

fn set_generic_b() uses (pair: mut Generic<u8>) {
    let b = mut pair.b_mut()
    b = 0x2a
}

fn set_element_b() uses (pairs: mut Pairs) {
    let b = mut pairs.b_mut(1)
    b = 0x2a
}

fn set_b_through_receiver() uses (pair: mut Pair) {
    let b = mut pair.b.me()
    b = 0x2a
}

fn set_b_in_slide() uses (pair: mut Pair) {
    let b = mut cached(mut pair.b)
    b = 0x2a
}

fn set_b_in_receiver_slide() uses (pair: mut Pair) {
    let b = mut pair.b.cached()
    b = 0x2a
}

#[test]
fn test_packed_field_projections() uses (evm: mut Evm) {
    unsafe {
        evm.sstore(slot: 0x100, value: 0x11)
        let pair = 0x100 as u256 as StorPtr<Pair>
        with (mut *pair) { set_b() }
        assert(evm.sload(0x100) == 0x2a11)
        assert(with (*pair) { b() } == 0x2a)

        let generic = 0x200 as u256 as StorPtr<Generic<u8>>
        with (mut *generic) { set_generic_b() }
        assert(evm.sload(0x200) == 0x2a00)

        let pairs = 0x300 as u256 as StorPtr<Pairs>
        with (mut *pairs) { set_element_b() }
        assert(evm.sload(0x300) == 0)
        assert(evm.sload(0x301) == 0x2a00)
        assert(evm.sload(0x302) == 0)

        evm.sstore(slot: 0x400, value: 0x11)
        let receiver = 0x400 as u256 as StorPtr<Pair>
        with (mut *receiver) { set_b_through_receiver() }
        assert(evm.sload(0x400) == 0x2a11)
    }
}

// The slide's write to a packed field passed as a `mut` argument or receiver
// is stored after the slide runs.
#[test]
fn test_slide_writes_packed_argument() uses (evm: mut Evm) {
    unsafe {
        evm.sstore(slot: 0x500, value: 0x11)
        let pair = 0x500 as u256 as StorPtr<Pair>
        with (mut *pair) { set_b_in_slide() }
        assert(evm.sload(0x500) == 0x2a11)

        evm.sstore(slot: 0x600, value: 0x11)
        let receiver = 0x600 as u256 as StorPtr<Pair>
        with (mut *receiver) { set_b_in_receiver_slide() }
        assert(evm.sload(0x600) == 0x2a11)
    }
}

#[test]
fn test_transient_packed_field_projection() uses (evm: mut Evm) {
    unsafe {
        let pair = 0x100 as u256 as TStorPtr<Pair>
        with (mut *pair) { set_b() }
        let word = 0x100 as u256 as TStorPtr<u256>
        assert(*word == 0x2a00)
    }
}
