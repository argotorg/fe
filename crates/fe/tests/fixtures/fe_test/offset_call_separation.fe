use core::{Option, ptr}

struct Token { value: u256 }
struct Slot { pointer: *Option<Token> }
struct Buffer { data: *u8, offset: u256, len: u256 }

fn clear(_ state: mut Buffer) {
    ptr::zero_bytes(ptr: ptr::offset(state.data, state.offset), len: state.len)
    state.len = 0
}

fn run_children(_ state: mut Buffer) -> u256 {
    let slot = ptr::alloc<Option<Token>>()
    *slot = Option::Some(Token { value: 7 })
    let mut holder = Slot { pointer: slot }
    let mut sum = 0
    while true {
        let value = *holder.pointer
        *holder.pointer = Option::None
        match value {
            Option::Some(value,) => {
                clear(mut state)
                sum += value.value
            },
            Option::None => {
                break
            },
        }
    }
    sum
}

#[test]
fn offset_write_preserves_a_pointer_held_in_a_local() {
    let data = ptr::alloc_bytes(2)
    *data = 12
    *ptr::offset(data, 1) = 25
    let mut state = Buffer { data, offset: 1, len: 1 }
    assert(run_children(mut state) == 7)
    assert(state.len == 0)
    assert(*data == 12)
    assert(*ptr::offset(data, 1) == 0)
}
