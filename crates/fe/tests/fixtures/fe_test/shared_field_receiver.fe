struct Buffer { value: u256 }

impl Buffer {
    fn new(_ value: u256) -> Self { Self { value } }
    fn read(self) -> u256 { self.value }
    fn write(mut self, _ value: u256) { self.value = value }
    fn into_value(own self) -> u256 { self.value }
}

struct Frame { memory: Buffer }

impl Frame {
    fn clear(mut self) { self.memory.write(0) }
    fn into_value(own self) -> u256 { self.memory.into_value() }
}

fn read(_ buffer: Buffer) -> u256 { buffer.read() }

#[test]
fn shared_field_calls_preserve_frame_ownership_and_observe_updates() {
    let mut frame = Frame { memory: Buffer::new(42) }
    core::assert(frame.memory.read() == 42)
    core::assert(read(frame.memory) == 42)
    frame.clear()
    core::assert(Buffer::read(frame.memory) == 0)
    frame.memory.write(91)
    core::assert(frame.into_value() == 91)
}

#[test]
fn shared_indexed_field_calls_keep_distinct_owners() {
    let mut frames = [Frame { memory: Buffer::new(3) }, Frame { memory: Buffer::new(8) }]
    let mut index: usize = 0
    while index < 2 {
        let value = frames[index].memory.read()
        core::assert(read(frames[index].memory) == value)
        frames[index].memory.write(value + 10)
        core::assert(frames[index].memory.read() == value + 10)
        index += 1
    }
    core::assert(frames[0].memory.read() == 13)
    core::assert(frames[1].memory.read() == 18)
}

#[test]
fn shared_field_calls_preserve_immutable_frame_ownership() {
    let frame = Frame { memory: Buffer::new(42) }
    core::assert(frame.memory.read() == 42)
    core::assert(read(frame.memory) == 42)
    core::assert(frame.into_value() == 42)
}
