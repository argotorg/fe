use core::ptr

struct Frame { first: u8, value: u64, last: u8 }

fn scalar(pointer: *u64, flag: bool) -> mut u64 {
    unsafe { if flag { mut *pointer } else { core::panic() } }
}

fn aggregate(pointer: *Frame, flag: bool) -> mut Frame {
    unsafe { if flag { mut *pointer } else { core::panic() } }
}

fn fail() { core::panic() }
fn fail_indirect() { fail() }
fn fail_twice() { fail_indirect() }
fn fail_borrow() -> mut Frame { core::panic() }

fn dead_continuation(pointer: *Frame, fallback: mut Frame, flag: bool) -> mut Frame {
    if flag {
        unsafe { mut *pointer }
    } else {
        fail_twice()
        if flag { fallback } else { fallback }
    }
}

fn dead_return(pointer: *Frame, fallback: mut Frame, flag: bool) -> mut Frame {
    unsafe { if flag { return mut *pointer } }
    fail_indirect()
    fallback
}

fn diverging_result(pointer: *Frame, flag: bool) -> mut Frame {
    unsafe { if flag { mut *pointer } else { fail_borrow() } }
}

fn after_returns(pointer: *Frame, fallback: mut Frame, flag: bool) -> mut Frame {
    unsafe { if flag { return mut *pointer } else { return mut *pointer } }
    fallback
}

fn constant_branch(pointer: *Frame, fallback: mut Frame) -> mut Frame {
    let done = true
    unsafe { if done { mut *pointer } else { fallback } }
}

fn correlated_branch(pointer: *Frame, fallback: mut Frame, flag: bool) -> mut Frame {
    if flag {
        unsafe { if flag { mut *pointer } else { fallback } }
    } else {
        unsafe { mut *pointer }
    }
}

fn dead_param(live: mut Frame, dead: mut Frame, flag: bool) -> mut Frame {
    if flag {
        live
    } else {
        fail()
        dead
    }
}

fn dead_raw(live: mut Frame, pointer: *Frame, flag: bool) -> mut Frame {
    if flag {
        live
    } else {
        fail()
        unsafe { mut *pointer }
    }
}

pub fn main() -> i32 {
    let pointer = ptr::alloc<u64>()
    unsafe { *pointer = 41 }
    let value = mut scalar(pointer, flag: true)
    value += 1
    core::assert(value == 42)
    unsafe { core::assert(*pointer == 42) }

    let pointer = ptr::alloc<Frame>()
    unsafe { *pointer = Frame { first: 7, value: 1000, last: 9 } }
    var fallback = Frame { first: 1, value: 2, last: 3 }
    let frame = mut aggregate(pointer, flag: true)
    frame.value += 1
    let frame = mut dead_continuation(pointer, fallback: mut fallback, flag: true)
    frame.value += 2
    let frame = mut dead_return(pointer, fallback: mut fallback, flag: true)
    frame.value += 3
    let frame = mut diverging_result(pointer, flag: true)
    frame.value += 4
    let frame = mut after_returns(pointer, fallback: mut fallback, flag: true)
    frame.value += 5
    let frame = mut constant_branch(pointer, fallback: mut fallback)
    frame.value += 6
    let frame = mut correlated_branch(pointer, fallback: mut fallback, flag: true)
    frame.value += 7
    let frame = unsafe { mut dead_param(live: mut *pointer, dead: mut fallback, flag: true) }
    frame.value += 8
    let frame = unsafe { mut dead_param(live: mut fallback, dead: mut *pointer, flag: true) }
    frame.value += 9
    let frame = unsafe { mut dead_raw(live: mut *pointer, pointer, flag: true) }
    frame.value += 10
    let frame = mut dead_raw(live: mut fallback, pointer, flag: true)
    frame.value += 11
    core::assert(frame.first == 1)
    unsafe { core::assert((*pointer).first == 7) }
    unsafe { core::assert((*pointer).value == 1046) }
    unsafe { core::assert((*pointer).last == 9) }
    core::assert(fallback.value == 22)
    0
}

#[test]
fn nonreturning_borrow_joins() { core::assert(main() == 0) }
