use core::{MemBuffer, Option}
use core::ops::Drop
use core::ptr

// The scopes a `yield` statement's operand opens end when the projection's
// session resumes, after the caller's last use of the grant and before the
// slide; a `return` in the operand yields and runs no slide. Each event
// appends a digit to a trace a raw pointer reaches, so destructors log too:
//
// 1 the operand reaches its yield     6 the operand leaves early
// 2 an operand binding is destroyed   7 a nested projection's slide runs
// 3 an inner operand binding is too   8 a later or nested slide runs
// 4 a binding outside the operand is  9 the `yield` statement's slide runs
// 5 the caller uses the grant
fn log(_ trace: *u256, _ event: u256) {
    unsafe { *trace = *trace * 10 + event }
}

fn new_trace() -> *u256 {
    let trace = ptr::alloc<u256>()
    unsafe { *trace = 0 }
    trace
}

fn read(_ trace: *u256) -> u256 {
    unsafe { *trace }
}

struct Guard {
    trace: *u256,
    event: u256,
}

impl Drop for Guard {
    fn drop(own self) {
        log(self.trace, self.event)
    }
}

struct Cell {
    a: u256,
    b: u256,
}

struct Tracer {
    at: *u256,
}

fn note(_ event: u256) uses (tracer: Tracer) {
    log(tracer.at, event)
}

fn bump(_ x: mut u256, _ trace: *u256) {
    log(trace, 5)
    x += 1
}

fn look(_ x: ref u256, _ trace: *u256) -> u256 {
    log(trace, 5)
    x
}

fn look_guard(_ guard: ref Guard) {
    log(guard.trace, 5)
}

struct Holder {
    v: u256,
    guard: Guard,
}

// Its slide logs what the caller wrote through the grant.
fn slot(_ holder: mut Holder, _ trace: *u256) -> mut u256 {
    yield mut holder.v
    log(trace, holder.v)
}

// `late` belongs to the block declaring it, though the operand assigns it.
fn fallthrough(_ cell: mut Cell, _ trace: *u256) -> mut u256 {
    let _own = Guard { trace, event: 4 }
    var late: Guard
    yield {
        let _operand = Guard { trace, event: 2 }
        late = Guard { trace, event: 4 }
        log(trace, 1)
        mut cell.a
    }
    log(trace, 9)
}

// The grant borrows an operand binding, which outlives the caller's use and
// the nested session's slide.
fn through(_ trace: *u256) -> mut u256 {
    yield {
        var holder = Holder { v: 6, guard: Guard { trace, event: 2 } }
        slot(mut holder, trace)
    }
    log(trace, 9)
}

// A yielded value is held in a temporary of the operand's scope.
fn held(_ trace: *u256) -> ref Guard {
    yield {
        log(trace, 1)
        Guard { trace, event: 2 }
    }
    log(trace, 9)
}

fn returns(_ cell: mut Cell, _ trace: *u256, _ early: bool) -> mut u256 {
    let _own = Guard { trace, event: 4 }
    yield {
        let _operand = Guard { trace, event: 2 }
        let _bytes = MemBuffer::new(32)
        if early {
            let _arm = Guard { trace, event: 3 }
            log(trace, 6)
            return mut cell.b
        }
        log(trace, 1)
        mut cell.a
    }
    log(trace, 9)
}

fn read_returns(_ cell: ref Cell, _ trace: *u256, _ early: bool) -> ref u256 {
    yield {
        let _operand = Guard { trace, event: 2 }
        if early {
            log(trace, 6)
            return ref cell.b
        }
        log(trace, 1)
        ref cell.a
    }
    log(trace, 9)
}

fn either(_ cell: mut? Cell, _ trace: *u256, _ early: bool) -> mut? u256 {
    yield {
        let _operand = Guard { trace, event: 2 }
        if early {
            log(trace, 6)
            return mut? cell.b
        }
        log(trace, 1)
        mut? cell.a
    }
    log(trace, 9)
}

fn branches(_ cell: mut Cell, _ trace: *u256, _ first: bool) -> mut u256 {
    yield {
        let _operand = Guard { trace, event: 2 }
        if first {
            let _arm = Guard { trace, event: 3 }
            mut cell.a
        } else {
            mut cell.b
        }
    }
    log(trace, 9)
}

fn matched(_ cell: mut Cell, _ trace: *u256, _ arm: Option<u256>) -> mut u256 {
    yield match arm {
        Option::Some(event) => {
            let _arm = Guard { trace, event }
            mut cell.a
        }
        Option::None => mut cell.b
    }
    log(trace, 9)
}

fn nested(_ cell: mut Cell, _ trace: *u256) -> mut u256 {
    yield {
        let _operand = Guard { trace, event: 2 }
        {
            let _inner = Guard { trace, event: 3 }
            log(trace, 1)
            mut cell.a
        }
    }
    log(trace, 9)
}

fn provided(_ cell: mut Cell, _ trace: *u256) -> mut u256 {
    yield with (Tracer = Tracer { at: trace }) {
        let _operand = Guard { trace, event: 2 }
        note(1)
        mut cell.a
    }
    log(trace, 9)
}

fn tried(_ cell: mut Cell, _ trace: *u256, _ key: Option<u256>) -> Option<mut u256> {
    yield {
        let _operand = Guard { trace, event: 2 }
        let event = key?
        log(trace, event)
        Option::Some(mut cell.a)
    }
    log(trace, 9)
}

fn retried(_ cell: mut Cell, _ trace: *u256, _ tries: u256) -> mut u256 {
    var left = tries
    loop {
        yield {
            let _operand = Guard { trace, event: 2 }
            if left > 0 {
                left -= 1
                log(trace, 6)
                continue
            }
            mut cell.a
        }
        log(trace, 9)
        break
    }
}

fn abandoned(_ cell: mut Cell, _ trace: *u256, _ quit: bool) -> mut u256 {
    loop {
        yield {
            let _operand = Guard { trace, event: 2 }
            if quit {
                log(trace, 6)
                break
            }
            mut cell.a
        }
        log(trace, 9)
        return
    }
    yield mut cell.b
    log(trace, 8)
}

fn consume(_ guard: own Guard) {}

fn guard_if(_ trace: *u256, _ c: bool, _ event: u256) -> Option<Guard> {
    if c { Option::Some(Guard { trace, event }) } else { Option::None }
}

// A `return` in a compound yield yields on its own.
fn opt_return(_ cell: mut Cell, _ trace: *u256, _ c: bool) -> Option<mut u256> {
    yield Option::Some({
        if c {
            return {
                let _g = Guard { trace, event: 3 }
                Option::Some(mut cell.b)
            }
        }
        mut cell.a
    })
    log(trace, 9)
}

// So does each branch of a branching `return` there.
fn opt_branch_return(_ cell: mut Cell, _ trace: *u256, _ early: bool, _ d: bool) -> Option<mut u256> {
    yield Option::Some({
        if early {
            return if d { Option::Some(mut cell.b) } else { Option::None }
        }
        mut cell.a
    })
    log(trace, 9)
}

// A nested `yield` statement in a compound yield yields on its own.
fn opt_nested_yield(_ cell: mut Cell, _ trace: *u256, _ c: bool) -> Option<mut u256> {
    yield Option::Some({
        if c {
            yield Option::Some(mut cell.b)
            log(trace, 8)
            return
        }
        mut cell.a
    })
    log(trace, 9)
}

// A tuple yield whose element is a block with a `return`.
fn pair(_ cell: mut Cell, _ trace: *u256, _ c: bool) -> (mut u256, mut u256) {
    yield ({
        let _g = Guard { trace, event: 2 }
        if c {
            return (mut cell.b, mut cell.a)
        }
        mut cell.a
    }, mut cell.b)
    log(trace, 9)
}

// A block in a compound yield keeps its bindings until the resume.
fn opt_block(_ cell: mut Cell, _ trace: *u256) -> Option<mut u256> {
    yield Option::Some({
        let _g = Guard { trace, event: 2 }
        mut cell.a
    })
    log(trace, 9)
}

fn owned_block(_ cell: mut Cell, _ trace: *u256) -> (u256, mut u256) {
    yield ({
        let _g = Guard { trace, event: 3 }
        7
    }, mut cell.a)
    log(trace, 9)
}

// The grant borrows a binding of a block in a compound yield.
fn opt_ref(_ trace: *u256) -> Option<ref Guard> {
    yield Option::Some({
        let g = Guard { trace, event: 2 }
        ref g
    })
    log(trace, 9)
}

// A tail compound yield ends the block with every scope.
fn tail_opt(_ cell: mut Cell, _ trace: *u256) -> Option<mut u256> {
    Option::Some({
        let _g = Guard { trace, event: 2 }
        mut cell.a
    })
}

// A `return` in the operand whose own value opens scopes, branches, or
// is the empty variant.
fn return_block(_ cell: mut Cell, _ trace: *u256, _ c: bool) -> mut u256 {
    yield {
        let _o = Guard { trace, event: 2 }
        if c {
            return {
                let _r = Guard { trace, event: 3 }
                mut cell.b
            }
        }
        mut cell.a
    }
    log(trace, 9)
}

fn return_branch(_ cell: mut Cell, _ trace: *u256, _ c: bool, _ d: bool) -> mut u256 {
    yield {
        let _o = Guard { trace, event: 2 }
        if c {
            return if d { mut cell.b } else { mut cell.a }
        }
        mut cell.a
    }
    log(trace, 9)
}

fn return_none(_ cell: mut Cell, _ trace: *u256, _ c: bool) -> Option<mut u256> {
    yield {
        let _o = Guard { trace, event: 2 }
        if c {
            return Option::None
        }
        Option::Some(mut cell.a)
    }
    log(trace, 9)
}

// A nested `yield` in an operand, its slide ended by a bare `return`.
fn nested_yield(_ cell: mut Cell, _ trace: *u256, _ c: bool) -> mut u256 {
    yield {
        let _o = Guard { trace, event: 2 }
        if c {
            yield {
                let _i = Guard { trace, event: 3 }
                mut cell.b
            }
            log(trace, 8)
            return
        }
        mut cell.a
    }
    log(trace, 9)
}

// `let .. else` and `if let` on a `Drop` scrutinee.
fn let_else(_ cell: mut Cell, _ trace: *u256, _ c: bool) -> mut u256 {
    yield {
        let Option::Some(_g) = guard_if(trace, c, 2) else {
            log(trace, 6)
            return mut cell.b
        }
        mut cell.a
    }
    log(trace, 9)
}

fn if_let(_ cell: mut Cell, _ trace: *u256, _ c: bool) -> mut u256 {
    yield if let Option::Some(_g) = guard_if(trace, c, 3) {
        mut cell.a
    } else {
        mut cell.b
    }
    log(trace, 9)
}

// A binding moved on one path: a flag decides at resume.
fn moved(_ cell: mut Cell, _ trace: *u256, _ early: bool) -> mut u256 {
    yield {
        let g = Guard { trace, event: 2 }
        if early {
            consume(g)
        }
        mut cell.a
    }
    log(trace, 9)
}

// At compile time, a `return` in the operand runs no slide either.
const fn pick(_ cell: mut Cell, _ early: bool) -> mut u256 {
    yield {
        if early {
            return mut cell.b
        }
        mut cell.a
    }
    cell.b += 10
}

const fn picked(_ early: bool) -> u256 {
    var cell = Cell { a: 0, b: 0 }
    let x = mut pick(mut cell, early)
    x += 1
    cell.a * 100 + cell.b
}

const PICKED_EARLY: u256 = picked(true)
const PICKED_LATE: u256 = picked(false)

fn take_holder(_ h: mut Holder) -> mut u256 {
    mut h.v
}

fn ref_guard(_ g: Guard) -> ref Guard {
    ref g
}

// An access block in the operand has no scope of its own: its bindings and
// the temporaries a `let` in it extends belong to the operand's scope.
fn access_block(_ trace: *u256) -> mut u256 {
    let _outer = Guard { trace, event: 4 }
    yield take_holder({
        var h = Holder { v: 6, guard: Guard { trace, event: 2 } }
        mut h
    })
    log(trace, 9)
    let _after = Guard { trace, event: 8 }
}

fn access_block_in_compound(_ trace: *u256) -> Option<mut u256> {
    let _outer = Guard { trace, event: 4 }
    yield Option::Some(take_holder({
        var h = Holder { v: 6, guard: Guard { trace, event: 2 } }
        mut h
    }))
    log(trace, 9)
}

fn access_block_extended(_ trace: *u256) -> mut u256 {
    let _outer = Guard { trace, event: 4 }
    yield take_holder({
        var h = Holder { v: 6, guard: Guard { trace, event: 2 } }
        let _r = ref ref_guard(Guard { trace, event: 3 })
        mut h
    })
    log(trace, 9)
}

// `g` in the access block shadows the outer `g`; `late` belongs to the
// block declaring it, though the access block assigns it.
fn access_block_shadows(_ trace: *u256) -> mut u256 {
    let g = Guard { trace, event: 4 }
    var late: Guard
    yield take_holder({
        late = Guard { trace, event: 8 }
        let g = Guard { trace, event: 2 }
        var h = Holder { v: g.event, guard: Guard { trace, event: 3 } }
        mut h
    })
    log(trace, g.event + 5)
}

// Passed blocks end innermost and latest first.
fn two_blocks(_ cell: mut Cell, _ trace: *u256) -> (mut u256, mut u256) {
    yield ({
        let _a = Guard { trace, event: 3 }
        mut cell.a
    }, {
        let _b = Guard { trace, event: 2 }
        mut cell.b
    })
    log(trace, 9)
}

fn nested_blocks(_ cell: mut Cell, _ trace: *u256) -> Option<mut u256> {
    yield Option::Some({
        let _a = Guard { trace, event: 3 }
        {
            let _b = Guard { trace, event: 2 }
            mut cell.a
        }
    })
    log(trace, 9)
}

fn late_return(_ cell: mut Cell, _ trace: *u256, _ c: bool) -> (mut u256, mut u256) {
    yield ({
        let _a = Guard { trace, event: 3 }
        mut cell.a
    }, {
        if c {
            return (mut cell.a, mut cell.b)
        }
        mut cell.b
    })
    log(trace, 9)
}

fn maybe_set(_ cell: mut Cell, _ trace: *u256, _ c: bool) -> Option<mut u256> {
    yield Option::Some({
        var g: Guard
        if c {
            g = Guard { trace, event: 2 }
        }
        mut cell.a
    })
    log(trace, 9)
}

fn handed_out(_ cell: mut Cell, _ trace: *u256) -> (Guard, mut u256) {
    yield ({
        let g = Guard { trace, event: 2 }
        let _a = Guard { trace, event: 3 }
        g
    }, mut cell.a)
    log(trace, 9)
}

// A branch inside a compound yield yields on its own path, so what it binds
// ends at resume too.
fn branch_in_compound(_ cell: mut Cell, _ trace: *u256, _ c: bool) -> (u256, mut u256) {
    yield (if c {
        let _g = Guard { trace, event: 3 }
        7
    } else {
        8
    }, mut cell.a)
    log(trace, 9)
}

#[test]
fn operand_bindings_end_before_the_slide() {
    let trace = new_trace()
    var cell = Cell { a: 0, b: 0 }
    bump(mut fallthrough(mut cell, trace), trace)
    assert(read(trace) == 152944)
    assert(cell.a == 1)
}

#[test]
fn a_borrowed_operand_binding_outlives_the_grant() {
    let trace = new_trace()
    bump(mut through(trace), trace)
    assert(read(trace) == 5729)
}

#[test]
fn a_yielded_value_ends_with_the_operand() {
    let trace = new_trace()
    look_guard(ref held(trace))
    assert(read(trace) == 1529)
}

#[test]
fn a_return_in_the_operand_runs_no_slide() {
    let trace = new_trace()
    var cell = Cell { a: 0, b: 0 }
    bump(mut returns(mut cell, trace, true), trace)
    assert(read(trace) == 65324)
    assert(cell.a == 0 && cell.b == 1)
}

#[test]
fn an_operand_with_a_return_falls_through_to_the_slide() {
    let trace = new_trace()
    var cell = Cell { a: 0, b: 0 }
    bump(mut returns(mut cell, trace, false), trace)
    assert(read(trace) == 15294)
    assert(cell.a == 1 && cell.b == 0)
}

#[test]
fn a_ref_yield_operand() {
    let cell = Cell { a: 7, b: 8 }
    let trace = new_trace()
    assert(look(ref read_returns(ref cell, trace, true), trace) == 8)
    assert(read(trace) == 652)
    let trace = new_trace()
    assert(look(ref read_returns(ref cell, trace, false), trace) == 7)
    assert(read(trace) == 1529)
}

#[test]
fn a_maybe_mut_yield_operand_at_both_modes() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    bump(mut either(mut cell, trace, true), trace)
    assert(read(trace) == 652)
    let trace = new_trace()
    bump(mut either(mut cell, trace, false), trace)
    assert(read(trace) == 1529)
    let trace = new_trace()
    assert(look(ref either(ref cell, trace, true), trace) == 1)
    assert(read(trace) == 652)
    let trace = new_trace()
    assert(look(ref either(ref cell, trace, false), trace) == 1)
    assert(read(trace) == 1529)
}

#[test]
fn each_yielding_branch_ends_the_operand_scopes() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    bump(mut branches(mut cell, trace, true), trace)
    assert(read(trace) == 5329)
    let trace = new_trace()
    bump(mut branches(mut cell, trace, false), trace)
    assert(read(trace) == 529)
    let trace = new_trace()
    bump(mut matched(mut cell, trace, Option::Some(3)), trace)
    assert(read(trace) == 539)
    let trace = new_trace()
    bump(mut matched(mut cell, trace, Option::None), trace)
    assert(read(trace) == 59)
    assert(cell.a == 2 && cell.b == 2)
}

#[test]
fn nested_operand_scopes_end_innermost_first() {
    let trace = new_trace()
    var cell = Cell { a: 0, b: 0 }
    bump(mut nested(mut cell, trace), trace)
    assert(read(trace) == 15329)
}

#[test]
fn a_with_block_operand() {
    let trace = new_trace()
    var cell = Cell { a: 0, b: 0 }
    bump(mut provided(mut cell, trace), trace)
    assert(read(trace) == 1529)
}

#[test]
fn a_failing_question_mark_in_the_operand() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    match tried(mut cell, trace, Option::None) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 26)
    let trace = new_trace()
    match tried(mut cell, trace, Option::Some(1)) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 1529)
    assert(cell.a == 1)
}

#[test]
fn loop_exits_from_the_operand() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    bump(mut retried(mut cell, trace, 2), trace)
    assert(read(trace) == 6262529)
    let trace = new_trace()
    bump(mut abandoned(mut cell, trace, true), trace)
    assert(read(trace) == 6258)
    let trace = new_trace()
    bump(mut abandoned(mut cell, trace, false), trace)
    assert(read(trace) == 529)
    assert(cell.a == 2 && cell.b == 1)
}

#[test]
fn a_return_in_a_compound_yield() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    match opt_return(mut cell, trace, true) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 53)
    let trace = new_trace()
    match opt_return(mut cell, trace, false) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 59)
}

#[test]
fn a_branching_return_in_a_compound_yield() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    match opt_branch_return(mut cell, trace, true, true) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 5)
    let trace = new_trace()
    match opt_branch_return(mut cell, trace, true, false) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 6)
    let trace = new_trace()
    match opt_branch_return(mut cell, trace, false, false) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 59)
    assert(cell.a == 1 && cell.b == 1)
}

#[test]
fn a_nested_yield_in_a_compound_yield() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    match opt_nested_yield(mut cell, trace, true) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 58)
    let trace = new_trace()
    match opt_nested_yield(mut cell, trace, false) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 59)
    assert(cell.a == 1 && cell.b == 1)
}

#[test]
fn a_tuple_yield_with_a_return() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    let (mut x, _) = pair(mut cell, trace, true)
    bump(mut x, trace)
    assert(read(trace) == 52)
    let trace = new_trace()
    let (mut y, _) = pair(mut cell, trace, false)
    bump(mut y, trace)
    assert(read(trace) == 529)
    assert(cell.a == 1 && cell.b == 1)
}

#[test]
fn a_block_in_a_compound_yield_ends_at_resume() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    match opt_block(mut cell, trace) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 529)
    let trace = new_trace()
    let (n, mut x) = owned_block(mut cell, trace)
    bump(mut x, trace)
    assert(n == 7 && read(trace) == 539)
    let trace = new_trace()
    match tail_opt(mut cell, trace) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 52)
}

#[test]
fn a_compound_yield_grants_a_block_binding() {
    let trace = new_trace()
    if let Option::Some(ref g) = opt_ref(trace) {
        look_guard(ref g)
    }
    assert(read(trace) == 529)
}

#[test]
fn a_return_of_a_block_or_branch_in_the_operand() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    bump(mut return_block(mut cell, trace, true), trace)
    assert(read(trace) == 532)
    let trace = new_trace()
    bump(mut return_branch(mut cell, trace, true, false), trace)
    assert(read(trace) == 52)
    assert(cell.a == 1 && cell.b == 1)
}

#[test]
fn a_return_of_the_empty_variant_in_the_operand() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    match return_none(mut cell, trace, true) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 26)
    let trace = new_trace()
    match return_none(mut cell, trace, false) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 529)
}

#[test]
fn a_nested_yield_in_the_operand() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    bump(mut nested_yield(mut cell, trace, true), trace)
    assert(read(trace) == 5382)
    assert(cell.b == 1)
}

#[test]
fn let_else_and_if_let_on_a_drop_scrutinee() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    bump(mut let_else(mut cell, trace, true), trace)
    assert(read(trace) == 529)
    let trace = new_trace()
    bump(mut let_else(mut cell, trace, false), trace)
    assert(read(trace) == 65)
    let trace = new_trace()
    bump(mut if_let(mut cell, trace, true), trace)
    assert(read(trace) == 539)
    let trace = new_trace()
    bump(mut if_let(mut cell, trace, false), trace)
    assert(read(trace) == 59)
}

#[test]
fn a_binding_moved_on_one_path() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    bump(mut moved(mut cell, trace, true), trace)
    assert(read(trace) == 259)
    let trace = new_trace()
    bump(mut moved(mut cell, trace, false), trace)
    assert(read(trace) == 529)
}

#[test]
fn a_return_in_the_operand_at_compile_time() {
    assert(PICKED_EARLY == 1)
    assert(PICKED_LATE == 110)
}

#[test]
fn access_block_bindings_end_at_resume() {
    let trace = new_trace()
    bump(mut access_block(trace), trace)
    assert(read(trace) == 52984)
    let trace = new_trace()
    match access_block_in_compound(trace) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 5294)
    let trace = new_trace()
    bump(mut access_block_extended(trace), trace)
    assert(read(trace) == 53294)
}

#[test]
fn an_access_block_shadowing_and_assigning_outer_bindings() {
    let trace = new_trace()
    bump(mut access_block_shadows(trace), trace)
    assert(read(trace) == 532984)
}

#[test]
fn passed_blocks_end_latest_first() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    let (mut x, _) = two_blocks(mut cell, trace)
    bump(mut x, trace)
    assert(read(trace) == 5239)
    let trace = new_trace()
    match nested_blocks(mut cell, trace) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 5239)
}

#[test]
fn a_return_after_a_passed_block() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    let (mut x, _) = late_return(mut cell, trace, true)
    bump(mut x, trace)
    assert(read(trace) == 53)
    let trace = new_trace()
    let (mut y, _) = late_return(mut cell, trace, false)
    bump(mut y, trace)
    assert(read(trace) == 539)
}

#[test]
fn passed_owners_initialized_or_moved_on_some_paths() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    match maybe_set(mut cell, trace, true) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 529)
    let trace = new_trace()
    match maybe_set(mut cell, trace, false) {
        Option::Some(mut x) => bump(mut x, trace)
        Option::None => log(trace, 6)
    }
    assert(read(trace) == 59)
    let trace = new_trace()
    {
        let (g, mut x) = handed_out(mut cell, trace)
        bump(mut x, trace)
        assert(g.event == 2)
    }
    assert(read(trace) == 5392)
}

#[test]
fn a_branch_in_a_compound_yield_ends_at_resume() {
    var cell = Cell { a: 0, b: 0 }
    let trace = new_trace()
    let (n, mut x) = branch_in_compound(mut cell, trace, true)
    bump(mut x, trace)
    assert(n == 7 && read(trace) == 539)
}
