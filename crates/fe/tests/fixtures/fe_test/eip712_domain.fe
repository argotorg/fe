// Tests for `std::evm::eip712` (OpenZeppelin `EIP712` parity).
//
// Expected values were computed with Foundry, independent of this
// implementation:
//   cast keccak "<string>"
//   cast keccak $(cast abi-encode "f(bytes32,bytes32,bytes32,uint256,address)" \
//       <typehash> <name hash> <version hash> <chain id> <address>)
//   cast keccak $(cast concat-hex 0x1901 <separator> <struct hash>)

use core::keccak
use core::ptr::MemBuffer
use std::evm::{Address, Call, Ctx, Evm, RawMem, crypto}
use std::evm::eip712::{self, DOMAIN_TYPEHASH, Domain}

const SEAPORT: Address = Address { inner: 0x0000000000000068f116a894984e2ddb2f0000d1 }

// cast keccak "Seaport" / cast keccak "1.6", written as compile-time hashes.
const SEAPORT_NAME_HASH: u256 = keccak("Seaport")
const SEAPORT_VERSION_HASH: u256 = keccak("1.6")
// Domain("Seaport", "1.6", 1, SEAPORT)
const SEAPORT_SEPARATOR: u256 = 0x74dd84ad5408ae2607600b0cbd294cc878845e9e14d6622c739d5639ef6f2548
// Domain("Test", "1", 31337, 0xcccc...cccc)
const TEST_SEPARATOR: u256 = 0x95f58733df49c372bc8cdfd2abc7f90ea7bca78840ba9d81ca28a3aa2939439f
// Domain("", "", 2**256 - 1, 0xffff...ffff)
const EXTREME_SEPARATOR: u256 = 0x6e8fbdd40cdd2390d3042a77e050aa1f1b2be211e2f48f7a06da9a07f3d1fadf

const STRUCT_HASH: u256 = 0xc2f8787176b8ac6bf7215b4adcc1e069bf4ab82d9ab1df05a57a91d425935b6e
// keccak(0x1901 ++ SEAPORT_SEPARATOR ++ STRUCT_HASH)
const SEAPORT_DIGEST: u256 = 0x404303ee5390fce385c3a45a1fdfe338e80103f26a59e76a721e568240178f29
// keccak(0x1901 ++ 0x00 * 64)
const ZERO_DIGEST: u256 = 0x0b15111afa5c2b936d8dd23e1ffc4a97dd7a9af57a8144231ff70b749ab128d0

const NAME_HASH: u256 = keccak("Test")
const VERSION_HASH: u256 = keccak("1")

#[test]
fn test_domain_typehash() {
    assert!(
        DOMAIN_TYPEHASH == 0x8b73c3c69bb8fe3d512ecc4cf759cc79239f7b179b0ffacaa9a75d522b39400f,
    )
}

#[test]
fn test_const_string_hashes() {
    assert!(
        SEAPORT_NAME_HASH == 0x32b5c112df393a49218d7552f96b2eeb829dfb4272f4f24eef510a586b85feef,
    )
    assert!(
        SEAPORT_VERSION_HASH == 0x95f740a33d720b7cd93c75d515ac95ca3bbaa2594cce46ea48e00974ea8fcd14,
    )
    assert!(
        NAME_HASH == 0x85cc825a98ec217d960f113f5f80a95d7fd18e3725d37df428eb14f880bdfc12,
    )
    assert!(
        VERSION_HASH == 0xc89efdaa54c0f20c7adf612882df0950f5a951637e0307cdcb4c672f298b8bc6,
    )
    // keccak("") of the empty string.
    assert!(
        keccak("") == 0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470,
    )
}

#[test]
fn test_domain_separator_vectors() {
    assert!(
        eip712::domain_separator(
                name_hash: SEAPORT_NAME_HASH,
                version_hash: SEAPORT_VERSION_HASH,
                chain_id: 1,
                verifying_contract: SEAPORT,
            )
            == SEAPORT_SEPARATOR,
    )
    assert!(
        eip712::domain_separator(
                name_hash: NAME_HASH,
                version_hash: VERSION_HASH,
                chain_id: 31337,
                verifying_contract: Address { inner: 0xcccccccccccccccccccccccccccccccccccccccc },
            )
            == TEST_SEPARATOR,
    )
    assert!(
        eip712::domain_separator(
                name_hash: keccak(""),
                version_hash: keccak(""),
                chain_id: 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff,
                verifying_contract: Address { inner: 0xffffffffffffffffffffffffffffffffffffffff },
            )
            == EXTREME_SEPARATOR,
    )
}

#[test]
fn test_digest_vectors() {
    assert!(
        eip712::digest(
                domain_separator: SEAPORT_SEPARATOR,
                struct_hash: STRUCT_HASH,
            )
            == SEAPORT_DIGEST,
    )
    assert!(
        eip712::digest(domain_separator: 0, struct_hash: 0) == ZERO_DIGEST,
    )
}

// `crypto::eip712_digest` is kept as an alias of `eip712::digest` and no
// longer needs the `RawMem` effect.
#[test]
fn test_digest_matches_crypto_eip712_digest() {
    assert!(
        crypto::eip712_digest(
                domain_separator: SEAPORT_SEPARATOR,
                struct_hash: STRUCT_HASH,
            )
            == SEAPORT_DIGEST,
    )
}

// The preimage lives in its own allocation: memory allocated before and after
// hashing is left intact, and the digest does not depend on it.
#[test]
fn test_digest_leaves_neighbouring_memory_intact() uses (mem: mut RawMem) {
    let before = MemBuffer::alloc(32)
    mem.mstore(addr: before.ptr(), value: 0xaa)
    assert!(
        eip712::digest(
                domain_separator: SEAPORT_SEPARATOR,
                struct_hash: STRUCT_HASH,
            )
            == SEAPORT_DIGEST,
    )
    let after = MemBuffer::alloc(32)
    mem.mstore(addr: after.ptr(), value: 0xbb)
    assert!(
        eip712::digest(
                domain_separator: SEAPORT_SEPARATOR,
                struct_hash: STRUCT_HASH,
            )
            == SEAPORT_DIGEST,
    )
    assert!(mem.mload(before.ptr()) == 0xaa)
    assert!(mem.mload(after.ptr()) == 0xbb)
}

msg SignerMsg {
    #[selector = 1]
    Separator -> u256,
    #[selector = 2]
    Digest { struct_hash: u256 } -> u256,
}

/// Keeps the domain in an immutable field, like OpenZeppelin's `EIP712`.
pub contract Signer {
    domain: Domain,

    init()
    uses (mut domain, ctx: Ctx)
    {
        domain = Domain::new(name_hash: NAME_HASH, version_hash: VERSION_HASH)
    }

    recv SignerMsg {
        Separator -> u256 uses (domain, ctx: Ctx) {
            domain.separator()
        }

        Digest { struct_hash } -> u256 uses (domain, ctx: Ctx) {
            domain.digest(struct_hash)
        }
    }
}

msg ProxyMsg {
    #[selector = 1]
    Separator { implementation: Address } -> u256,
    #[selector = 2]
    Digest { implementation: Address, struct_hash: u256 } -> u256,
}

/// Runs `Signer`'s code in its own context through `DELEGATECALL`.
pub contract Proxy {
    recv ProxyMsg {
        Separator { implementation } -> u256 uses (call: mut Call) {
            call.delegate(
                addr: implementation,
                gas: 100000,
                message: SignerMsg::Separator {},
            )
        }

        Digest { implementation, struct_hash } -> u256
        uses (call: mut Call)
        {
            call.delegate(
                addr: implementation,
                gas: 100000,
                message: SignerMsg::Digest { struct_hash },
            )
        }
    }
}

fn separator_for(_ account: Address) -> u256 uses (ctx: Ctx) {
    eip712::domain_separator(
        name_hash: NAME_HASH,
        version_hash: VERSION_HASH,
        chain_id: ctx.chainid(),
        verifying_contract: account,
    )
}

#[test]
fn test_domain_new_matches_free_function() uses (ctx: Ctx) {
    let domain = Domain::new(name_hash: NAME_HASH, version_hash: VERSION_HASH)
    assert!(domain.separator() == separator_for(ctx.address()))
    assert!(
        domain.digest(struct_hash: STRUCT_HASH)
            == eip712::digest(
                domain_separator: separator_for(ctx.address()),
                struct_hash: STRUCT_HASH,
            ),
    )
}

#[test]
fn test_cached_separator_in_immutable_field() uses (evm: mut Evm, ctx: Ctx) {
    let signer = evm.create2<Signer>(value: 0, args: (), salt: 0)
    let separator = evm.call(
            addr: signer,
            gas: 100000,
            value: 0,
            message: SignerMsg::Separator {},
        )
    assert!(separator == separator_for(signer))
    let digest = evm
        .call(
            addr: signer,
            gas: 100000,
            value: 0,
            message: SignerMsg::Digest { struct_hash: STRUCT_HASH },
        )
    assert!(
        digest == eip712::digest(domain_separator: separator, struct_hash: STRUCT_HASH),
    )
}

// Through DELEGATECALL the executing address is the proxy's, so the cached
// separator (bound to `Signer`'s address) must not be used.
#[test]
fn test_separator_rederived_under_delegatecall() uses (evm: mut Evm, ctx: Ctx) {
    let signer = evm.create2<Signer>(value: 0, args: (), salt: 0)
    let proxy = evm.create2<Proxy>(value: 0, args: (), salt: 0)
    let separator = evm
        .call(
            addr: proxy,
            gas: 200000,
            value: 0,
            message: ProxyMsg::Separator { implementation: signer },
        )
    assert!(separator == separator_for(proxy))
    assert!(separator != separator_for(signer))
    let digest = evm
        .call(
            addr: proxy,
            gas: 200000,
            value: 0,
            message: ProxyMsg::Digest { implementation: signer, struct_hash: STRUCT_HASH },
        )
    assert!(
        digest == eip712::digest(
                domain_separator: separator_for(proxy),
                struct_hash: STRUCT_HASH,
            ),
    )
}
