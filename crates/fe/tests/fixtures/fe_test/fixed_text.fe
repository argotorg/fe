// Tests for the decimal text of `core::fixed` numbers: `UFixed::parse`,
// `Fixed::parse` and their `Display`.
use core::fixed::{Fixed, SWad, UFixed, Wad}

const U256_MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

#[test]
fn unsigned_parses() {
    assert!(Wad::parse("12").unwrap() == Wad::from_int(12))
    assert!(Wad::parse("0.25").unwrap() == Wad::from_ratio(1, 4))
    assert!(Wad::parse("007.50").unwrap() == Wad::from_ratio(15, 2))
    assert!(
        Wad::parse("1.000000000000000001").unwrap().raw() == 1000000000000000001,
    )
    assert!(UFixed<2>::parse("0.05").unwrap().raw() == 5)
    assert!(UFixed<0>::parse("42").unwrap().raw() == 42)
    let max = UFixed<2>::parse(
        "1157920892373161954235709850086879078532699846656405640394575840079131296399.35",
    )
    assert!(max.unwrap().raw() == U256_MAX)
}

#[test]
fn unsigned_rejects() {
    assert!(Wad::parse("").is_none())
    assert!(Wad::parse(".5").is_none())
    assert!(Wad::parse("5.").is_none())
    assert!(Wad::parse("1.2.3").is_none())
    assert!(Wad::parse("+1").is_none())
    assert!(Wad::parse("-1").is_none())
    assert!(Wad::parse(" 1").is_none())
    assert!(Wad::parse("1e3").is_none())
    assert!(UFixed<2>::parse("0.125").is_none())
    assert!(UFixed<0>::parse("1.0").is_none())
    // One hundredth above the largest value, and a whole part ten times too
    // large.
    assert!(
        UFixed<2>::parse(
            "1157920892373161954235709850086879078532699846656405640394575840079131296399.36",
        )
            .is_none(),
    )
    assert!(
        UFixed<2>::parse(
            "11579208923731619542357098500868790785326998466564056403945758400791312963990",
        )
            .is_none(),
    )
}

#[test]
fn signed_parses() {
    assert!(
        SWad::parse("-0.5").unwrap() == SWad::from_raw(-500000000000000000),
    )
    assert!(SWad::parse("+2").unwrap() == SWad::from_int(2))
    assert!(SWad::parse("-0").unwrap() == SWad::zero())
    let min = Fixed<2>::parse(
        "-578960446186580977117854925043439539266349923328202820197287920039565648199.68",
    )
    assert!(min.unwrap().raw() == i256::min())
    assert!(
        Fixed<2>::parse(
            "578960446186580977117854925043439539266349923328202820197287920039565648199.68",
        )
            .is_none(),
    )
    assert!(SWad::parse("-").is_none())
    assert!(SWad::parse("--1").is_none())
    assert!(SWad::parse("-.5").is_none())
}

#[test]
fn display_trims_the_fraction() {
    assert!(format!(Wad::from_ratio(5, 2)) == "2.5")
    assert!(format!(Wad::from_int(3)) == "3")
    assert!(format!(Wad::zero()) == "0")
    assert!(format!(Wad::from_raw(1)) == "0.000000000000000001")
    assert!(format!(UFixed<2>::from_raw(205)) == "2.05")
    assert!(format!(UFixed<0>::from_int(7)) == "7")
    assert!(format!(SWad::from_raw(-500000000000000000)) == "-0.5")
    assert!(format!(SWad::zero()) == "0")
    assert!(
        format!(UFixed<2>::from_raw(U256_MAX))
            == "1157920892373161954235709850086879078532699846656405640394575840079131296399.35",
    )
    assert!(
        format!(Fixed<2>::from_raw(i256::min()))
            == "-578960446186580977117854925043439539266349923328202820197287920039565648199.68",
    )
}

#[test]
fn display_round_trips() {
    let wads = [
        Wad::from_ratio(1, 3),
        Wad::from_raw(10),
        Wad::from_int(1000000),
        Wad::from_raw(U256_MAX),
    ]
    for wad in wads {
        assert!(Wad::parse(format!(wad)).unwrap() == wad)
    }
    let swads = [SWad::from_raw(-1), SWad::from_int(-42), SWad::from_raw(i256::max())]
    for swad in swads {
        assert!(SWad::parse(format!(swad)).unwrap() == swad)
    }
}
