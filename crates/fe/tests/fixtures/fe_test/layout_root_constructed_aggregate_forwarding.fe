use std::evm::{Evm, StorageMap}

struct Pair<const LEFT: u256, const RIGHT: u256> {
    left: StorageMap<u256, u256, LEFT>,
    right: StorageMap<u256, u256, RIGHT>,
}

fn read_left<const LEFT: u256, const RIGHT: u256>(
    pair: Pair<LEFT, RIGHT>,
    key: u256,
) -> u256 {
    pair.left.get(key: key)
}

fn make_pair<const LEFT: u256, const RIGHT: u256>(
    left: StorageMap<u256, u256, LEFT>,
    right: StorageMap<u256, u256, RIGHT>,
) -> Pair<LEFT, RIGHT> {
    Pair { left, right }
}

fn read_after_same_source_field_assignment<const LEFT: u256, const RIGHT: u256>(
    left: StorageMap<u256, u256, LEFT>,
    right: StorageMap<u256, u256, RIGHT>,
    key: u256,
) -> u256 {
    let mut pair = Pair { left, right }
    pair.left = left
    pair.left.get(key: key)
}

fn read_constructed(
    left: StorageMap<u256, u256>,
    right: StorageMap<u256, u256>,
    key: u256,
) -> u256 {
    let pair = make_pair(left: left, right: right)
    read_left(pair: pair, key: key)
}

fn read_reassigned(
    left: StorageMap<u256, u256>,
    right: StorageMap<u256, u256>,
    key: u256,
) -> u256 {
    read_after_same_source_field_assignment(left: left, right: right, key: key)
}

msg Msg {
    #[selector = 1]
    Set { lane: usize, key: u256, value: u256 },

    #[selector = 2]
    Get { lane: usize, key: u256 } -> u256,

    #[selector = 3]
    GetReassigned { lane: usize, key: u256 } -> u256,
}

pub contract C {
    mut first: StorageMap<u256, u256>,
    mut second: StorageMap<u256, u256>,

    recv Msg {
        Set { lane, key, value } uses (mut first, mut second) {
            if lane == 0 {
                first.set(key: key, value: value)
            } else {
                second.set(key: key, value: value)
            }
        }

        Get { lane, key } -> u256 uses (first, second) {
            if lane == 0 {
                read_constructed(left: first, right: first, key: key)
            } else {
                read_constructed(left: second, right: first, key: key)
            }
        }

        GetReassigned { lane, key } -> u256 uses (first, second) {
            if lane == 0 {
                read_reassigned(left: first, right: first, key: key)
            } else {
                read_reassigned(left: second, right: first, key: key)
            }
        }
    }
}

#[test]
fn constructed_aggregate_preserves_each_layout_source() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: 0, args: (), salt: 1)
    evm.call(
        addr: c,
        gas: 200000,
        value: 0,
        message: Msg::Set { lane: 0, key: 7, value: 42 },
    )
    evm.call(
        addr: c,
        gas: 200000,
        value: 0,
        message: Msg::Set { lane: 1, key: 7, value: 99 },
    )
    let value: u256 = evm.call(
        addr: c,
        gas: 200000,
        value: 0,
        message: Msg::Get { lane: 1, key: 7 },
    )
    assert!(value == 99)
    let reassigned: u256 = evm.call(
        addr: c,
        gas: 200000,
        value: 0,
        message: Msg::GetReassigned { lane: 1, key: 7 },
    )
    assert!(reassigned == 99)
}
