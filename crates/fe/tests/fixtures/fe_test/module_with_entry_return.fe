// The entry code of a contract is planned under the frame of the contract's
// module: the return value is encoded with `Twice` there (42), and with the
// ordinary encoder in a contract of an unframed module (21).
use core::abi::{AbiDecoder, AbiFrame, AbiSize, ByteInput, Decode, Encode}
use std::abi::Sol
use std::evm::{Call, Evm}

pub struct Out { pub v: u256 }
impl AbiSize for Out {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}
impl Encode<Sol> for Out {
    fn encode(self, _ f: AbiFrame) { f.store_word(at: 0, value: self.v) }
}
impl Decode<Sol> for Out {
    fn decode_payload<D: AbiDecoder<Sol>, I: ByteInput>(_ d: mut D, _ input: I) -> Self { Out { v: d.read_word(input) } }
}
pub impl Encode<Sol> for Out as Twice {
    fn encode(self, _ f: AbiFrame) { f.store_word(at: 0, value: self.v * 2) }
}
msg M {
    #[selector = 1]
    Get -> Out,
}
pub mod chosen {
    use super::{M, Out, Twice}
    with (Twice)
    pub contract C {
        recv M {
            Get -> Out { Out { v: 21 } }
        }
    }
}
pub contract Plain {
    recv M {
        Get -> Out { Out { v: 21 } }
    }
}
#[test]
fn return_encoding_follows_the_contract_modules_choice() uses (evm: mut Evm, call: mut Call) {
    let plain = evm.create2<Plain>(value: Wei::zero(), args: (), salt: 0)
    let result = plain.try_call(M::Get {})
    assert!(result.success() && result.returndata().word_at(0) == 21)
    let chosen = evm.create2<chosen::C>(value: Wei::zero(), args: (), salt: 1)
    let result = chosen.try_call(M::Get {})
    assert!(result.success() && result.returndata().word_at(0) == 42)
}
