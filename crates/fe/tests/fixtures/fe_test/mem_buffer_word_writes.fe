use core::ptr::MemBuffer
use std::evm::packed::encode_packed
use std::evm::crypto::keccak256

#[test]
fn unaligned_call_payload() {
    var buffer = MemBuffer::with_capacity(68)
    buffer.write_word(offset: 0, value: 0xa9059cbb << 224)
    buffer.write_word(offset: 4, value: 0x1234)
    buffer.write_word(offset: 36, value: 7)
    assert!(buffer.len() == 68 && buffer.capacity() == 68)
    let expected = encode_packed((0xa9059cbb as u32, 0x1234 as u256, 7 as u256))
    assert!(keccak256(buffer.span()) == expected.keccak256())
}

#[test]
fn gap_and_truncated_bytes_are_zeroed() {
    var buffer = MemBuffer::with_capacity(96)
    buffer.write_word(offset: 0, value: 1)
    buffer.write_word(offset: 32, value: 0xffff)
    buffer.truncate(32)
    buffer.write_word(offset: 64, value: 2)
    assert!(buffer.len() == 96)
    assert!(buffer.span().byte_at(31) == 1)
    for i in 32..95 {
        assert!(buffer.span().byte_at(i) == 0)
    }
    assert!(buffer.span().byte_at(95) == 2)
}

#[test]
fn overwrite_preserves_prefix_suffix_and_extent() {
    var buffer = MemBuffer::with_capacity(64)
    buffer.write_word(offset: 0, value: 0x11 << 248)
    buffer.write_word(offset: 32, value: 0x22)
    buffer.write_word(offset: 1, value: 3)
    assert!(buffer.len() == 64 && buffer.capacity() == 64)
    assert!(buffer.span().byte_at(0) == 0x11)
    assert!(buffer.span().byte_at(32) == 3)
    assert!(buffer.span().byte_at(63) == 0x22)
}

#[test(should_revert, panic = 0x32)]
fn rejects_short_capacity() {
    var buffer = MemBuffer::with_capacity(31)
    buffer.write_word(offset: 0, value: 1)
}

#[test(should_revert, panic = 0x32)]
fn rejects_crossing_capacity() {
    var buffer = MemBuffer::with_capacity(32)
    buffer.write_word(offset: 1, value: 1)
}

#[test(should_revert, panic = 0x32)]
fn rejects_wrapping_offset() {
    var buffer = MemBuffer::with_capacity(32)
    buffer
        .write_word(
            offset: usize::max(),
            value: 1,
        )
}

#[test]
fn unaligned_word_reads() {
    var buffer = MemBuffer::with_capacity(64)
    buffer.write_word(offset: 0, value: 0x0102 << 240)
    buffer.write_word(offset: 32, value: 0x0304)
    assert!(buffer.read_word(0) == 0x0102 << 240)
    assert!(buffer.read_word(1) == 0x02 << 248)
    assert!(buffer.read_word(31) == 0x03)
    assert!(buffer.span().read_word(32) == 0x0304)
}

#[test]
fn span_word_writes_stay_in_the_span() {
    var buffer = MemBuffer::alloc(66)
    buffer.slice(offset: 1, len: 64).write_word(offset: 30, value: u256::max())
    assert!(buffer.read_word(0) == 0xff)
    assert!(buffer.read_word(32) == u256::max() << 8)
    assert!(buffer.span().byte_at(63) == 0)
}

#[test(should_revert, panic = 0x32)]
fn rejects_read_past_the_extent() {
    var buffer = MemBuffer::with_capacity(64)
    buffer.write_word(offset: 0, value: 1)
    let _ = buffer.read_word(1)
}

#[test(should_revert, panic = 0x32)]
fn rejects_span_write_past_its_end() {
    var buffer = MemBuffer::alloc(64)
    buffer.slice(offset: 0, len: 40).write_word(offset: 9, value: 1)
}
