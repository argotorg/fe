/// `MemVec`: a growable array of Fe values. Growth, element access and loops,
/// and conversion to and from `DynArray`, whose payloads byte-match Solidity
/// `abi.encode(uint256[])` both as msg returndata and through
/// `encode_abi_payload` (the raw-log event payload path).

use std::abi::DynArray
use core::abi::store_word
use core::iter::FromProducer
use core::option::Option
use core::ptr::{self, MemArray, MemBuffer, MemVec}
use std::evm::{
    Evm,
    Log,
    encode_abi_payload,
    encode_msg_calldata,
    keccak256,
    copy_returndata,
}

msg VecMsg {
    #[selector = 0x01]
    BuildRange { n: usize } -> DynArray<u256>,
    #[selector = 0x02]
    CopyProbe { values: DynArray<u256> } -> u256,
    #[selector = 0x03]
    PayloadHash { a: u256, b: u256 } -> u256,
}

pub contract VecContract uses (log: mut Log) {
    init() {}

    recv VecMsg {
        BuildRange { n } -> DynArray<u256> {
            var v = MemVec<u256>::new()
            for i in 0..n {
                v.push((i as u256 + 1) * 100)
            }
            DynArray::from_slice(v.as_slice())
        }

        CopyProbe { values } -> u256 {
            var copy = values.to_mem_array()
            copy[0] = 999
            // If the copy aliased the source payload, this would read 999.
            values.get(0)
        }

        PayloadHash { a, b } -> u256 uses (mut log) {
            var v = MemVec::with_capacity(2)
            v.push(a)
            v.push(b)
            let payload = encode_abi_payload((DynArray::from_slice(v.as_slice()),))
            log.log1(data: payload.span(), topic0: 1)
            keccak256(payload.span())
        }
    }
}

#[test]
fn push_grows_and_keeps_elements() {
    var v = MemVec<u256>::new()
    assert!(v.is_empty() && v.capacity() == 0)
    for i in 0..9 {
        v.push(i as u256 * 3)
    }
    assert!(v.len() == 9 && v.capacity() == 16)
    var sum = 0
    for x in v {
        sum += x
    }
    assert!(sum == 108)
    assert!(v[8] == 24)

    var w = MemVec<u256>::with_capacity(2)
    w.push(1)
    w.push(2)
    assert!(w.capacity() == 2)
    w.reserve(3)
    assert!(w.capacity() == 8 && w.len() == 2 && w[1] == 2)
}

#[test]
fn push_unchecked_fills_reserved_capacity() {
    var v = MemVec<u256>::with_capacity(4)
    for i in 0..4 {
        unsafe { v.push_unchecked(i as u256 + 1) }
    }
    assert!(v.len() == 4 && v.capacity() == 4)
    assert!(v[0] == 1 && v[3] == 4)
}

#[test]
fn set_len_over_raw_writes() {
    var v = MemVec<u256>::new()
    v.push(1)
    assert!(v.try_reserve(2))
    unsafe {
        *ptr::offset(v.ptr(), 1) = 2
        *ptr::offset(v.ptr(), 2) = 3
        v.set_len(3)
    }
    assert!(v.len() == 3 && v[1] == 2 && v[2] == 3)
    unsafe { v.set_len(1) }
    assert!(v.len() == 1 && v[0] == 1)
}

#[test]
fn get_and_set_unchecked_within_len() {
    var v = MemVec<u256>::new()
    v.extend_from_slice(MemArray::from_fn(3, |i| i as u256 + 1).as_slice())
    unsafe {
        let first = v.get_unchecked(0)
        v.set_unchecked(0, v.get_unchecked(2))
        v.set_unchecked(2, first)
    }
    assert!(v[0] == 3 && v[1] == 2 && v[2] == 1 && v.len() == 3)
    unsafe { v.truncate_unchecked(1) }
    assert!(v.len() == 1 && v[0] == 3)
}

#[test]
fn pop_truncate_and_access() {
    var v = MemVec<u256>::new()
    v.extend_from_slice(MemArray::from_fn(4, |i| i as u256 + 1).as_slice())
    match v.pop() {
        Option::Some(x) => assert!(x == 4)
        Option::None => assert!(false)
    }
    assert!(v.len() == 3)
    v.set(0, 10)
    assert!(v.replace(1, 20) == 2)
    v.swap(0, 2)
    assert!(v[0] == 3 && v[1] == 20 && v[2] == 10)
    match v.get(1) {
        Option::Some(mut x) => x += 1
        Option::None => assert!(false)
    }
    assert!(v[1] == 21)
    match v.get(3) {
        Option::Some(_) => assert!(false)
        Option::None => {}
    }
    for mut x in v {
        x *= 2
    }
    assert!(v[0] == 6 && v[2] == 20)
    v.truncate(1)
    assert!(v.len() == 1 && v.pop().unwrap() == 6 && v.pop().is_none())
}

#[test]
fn non_copy_elements_move_in_and_out() {
    var v = MemVec<MemBuffer>::new()
    for n in 1..6 {
        v.push(MemBuffer::alloc(n))
    }
    assert!(v[4].len() == 5)
    let last = v.pop().unwrap()
    assert!(last.len() == 5 && v.len() == 4)
    var total = 0
    for ref buffer in v.reversed() {
        total = total * 10 + buffer.len()
    }
    assert!(total == 4321)
    let array = v.into_array()
    assert!(array.len() == 4 && array[0].len() == 1)
}

#[test]
fn collects_a_producer() {
    let xs: [u256; 4] = [1, 2, 3, 4]
    let v = MemVec::collect(xs, xs.map(|x| x * x))
    assert!(v.len() == 4 && v[3] == 16)
}

#[test(should_revert, panic = 0x32)]
fn index_past_the_end_reverts() {
    var v = MemVec<u256>::with_capacity(4)
    v.push(1)
    let _ = v[1]
}

#[test(should_revert, panic = 0x32)]
fn swap_of_an_index_past_the_end_with_itself_reverts() {
    var v = MemVec<u256>::new()
    v.swap(0, 0)
}

#[test(should_revert, panic = 0x32)]
fn truncate_past_the_end_reverts() {
    var v = MemVec<u256>::new()
    v.push(1)
    v.truncate(2)
}

#[test]
fn test_address_elements()
{
    var v = MemVec<Address>::new()
    v.push(Address::new(0))
    v.push(Address::new(0xbeef))
    let arr = DynArray::from_slice(v.as_slice())
    assert!(arr.len() == 2)
    assert!(arr.get(1).word() == 0xbeef)
    let back = arr.to_mem_array()
    assert!(back[0].word() == 0 && back[1].word() == 0xbeef)
}

#[test]
fn test_to_mem_array_copies_locally()
{
    let arr = DynArray::from_slice(MemArray::from_fn(1, |_| 5 as u256).as_slice())
    var copy = arr.to_mem_array()
    copy[0] = 6
    assert!(copy[0] == 6)
    assert!(arr.get(0) == 5)
}

#[test]
fn test_to_mem_array_copies_across_call()
uses (evm: mut Evm)
{
    let c = evm.create2<VecContract>(value: Wei::zero(), args: (), salt: 0)
    assert!(c.word() != 0)

    let values = DynArray::from_slice(MemArray::from_fn(2, |i| i as u256 + 7).as_slice())
    let original: u256 = evm.call(addr: c, gas: 1000000, value: Wei::zero(), message: VecMsg::CopyProbe { values })
    assert!(original == 7)
}

#[test]
fn test_round_trip_returndata_matches_solidity_encoding()
uses (evm: mut Evm, call: mut Call, ctx: Ctx)
{
    let c = evm.create2<VecContract>(value: Wei::zero(), args: (), salt: 0)
    assert!(c.word() != 0)

    let args = encode_msg_calldata(VecMsg::BuildRange { n: 3 })
    var output = MemBuffer::empty()
    let outcome = call.raw_call(addr: c, gas: ctx.gas(), value: Wei::zero(), args: args.span(), ret: mut output)
    assert!(outcome.success())
    let ret = copy_returndata()
    assert!(ret.len() == 160)

    // Precomputed Solidity abi.encode(uint256[]): offset, length, elements.
    let expected = MemBuffer::alloc(160)
    unsafe { store_word(ptr: expected.ptr(), value: 0x20) }
    unsafe { store_word(ptr: ptr::offset_bytes(expected.ptr(), 32), value: 3) }
    unsafe { store_word(ptr: ptr::offset_bytes(expected.ptr(), 64), value: 100) }
    unsafe { store_word(ptr: ptr::offset_bytes(expected.ptr(), 96), value: 200) }
    unsafe { store_word(ptr: ptr::offset_bytes(expected.ptr(), 128), value: 300) }
    assert!(keccak256(ret.span()) == keccak256(expected.span()))
}

#[test]
fn test_round_trip_typed_decode()
uses (evm: mut Evm)
{
    let c = evm.create2<VecContract>(value: Wei::zero(), args: (), salt: 0)
    assert!(c.word() != 0)

    let arr: DynArray<u256> = evm.call(addr: c, gas: 1000000, value: Wei::zero(), message: VecMsg::BuildRange { n: 4 })
    assert!(arr.len() == 4)
    assert!(arr.get(0) == 100)
    assert!(arr.get(3) == 400)
}

#[test]
fn test_encode_abi_payload_matches_solidity_encoding()
uses (evm: mut Evm)
{
    let c = evm.create2<VecContract>(value: Wei::zero(), args: (), salt: 0)
    assert!(c.word() != 0)

    let hash: u256 = evm.call(addr: c, gas: 1000000, value: Wei::zero(), message: VecMsg::PayloadHash { a: 0xaaaa, b: 0xbbbb })

    let expected = MemBuffer::alloc(128)
    unsafe { store_word(ptr: expected.ptr(), value: 0x20) }
    unsafe { store_word(ptr: ptr::offset_bytes(expected.ptr(), 32), value: 2) }
    unsafe { store_word(ptr: ptr::offset_bytes(expected.ptr(), 64), value: 0xaaaa) }
    unsafe { store_word(ptr: ptr::offset_bytes(expected.ptr(), 96), value: 0xbbbb) }
    assert!(hash == keccak256(expected.span()))
}
