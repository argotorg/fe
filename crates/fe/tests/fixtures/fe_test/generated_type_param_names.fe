// Generated ABI code declares its own type parameters. User types spelled
// like them (`D` for decoders, `I` for byte inputs, `L` for logs) must still
// resolve to the user types in `msg`, `#[abi]` and `#[event]` fields.
use core::abi::Decode
use std::abi::{Sol, sol}
use std::evm::{Evm, RawMem, encode_abi_payload}

#[abi]
pub struct D {
    pub x: u256,
}
impl Copy for D {}

#[abi]
pub struct I {
    pub y: u256,
}
impl Copy for I {}

type L = u256

#[abi]
pub struct Both {
    pub d: D,
    pub i: I,
    pub l: L,
}

#[event]
struct Logged {
    d: D,
    i: I,
    value: L,
}

msg M {
    #[selector = sol("sum((uint256),(uint256),uint256)")]
    Sum { d: D, i: I, l: L } -> u256,
}

pub contract C {
    recv M {
        Sum { d, i, l } -> u256 {
            d.x + i.y + l
        }
    }
}

// Generated names avoid the identifiers of the source they are generated
// from, including ones spelled like the generated names themselves.
#[abi]
pub struct __fe_D {
    pub x: u256,
}
impl Copy for __fe_D {}

type __fe_I = u256
type __fe_L = u256
const __fe_abi_struct_pos: usize = 2

#[abi]
pub struct Spelled {
    pub d: __fe_D,
    pub i: __fe_I,
    pub values: [__fe_L; __fe_abi_struct_pos],
}

#[event]
struct SpelledEvent {
    d: __fe_D,
    value: __fe_L,
}

msg Spelling {
    #[selector = sol("sum((uint256),uint256)")]
    Sum { d: __fe_D, i: __fe_I } -> u256,
}

pub contract SpellingC {
    recv Spelling {
        Sum { d, i } -> u256 {
            d.x + i
        }
    }
}

#[test]
fn fields_spelled_like_generated_names() uses (evm: mut Evm) {
    let encoded = encode_abi_payload(Spelled { d: __fe_D { x: 1 }, i: 2, values: [3, 4] })
    let decoded = <Spelled as Decode<Sol>>::decode_from_bounded(encoded.span(), 0, encoded.len())
    assert(decoded.d.x == 1)
    assert(decoded.i == 2)
    assert(decoded.values[1] == 4)
    let c = evm.create2<SpellingC>(value: Wei::zero(), args: (), salt: 0)
    let sum: u256 = evm.call(addr: c, gas: 1000000, value: Wei::zero(), message: Spelling::Sum { d: __fe_D { x: 5 }, i: 6 })
    assert(sum == 11)
}

#[test]
fn abi_struct_fields_named_like_generated_params() uses (mem: mut RawMem) {
    let encoded = encode_abi_payload(Both { d: D { x: 1 }, i: I { y: 2 }, l: 3 })
    let decoded = <Both as Decode<Sol>>::decode_from_bounded(encoded.span(), 0, encoded.len())
    assert(decoded.d.x == 1)
    assert(decoded.i.y == 2)
    assert(decoded.l == 3)
}

#[test]
fn msg_fields_named_like_generated_params() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: Wei::zero(), args: (), salt: 0)
    let sum: u256 = evm.call(addr: c, gas: 1000000, value: Wei::zero(), message: M::Sum { d: D { x: 3 }, i: I { y: 4 }, l: 5 })
    assert(sum == 12)
}
