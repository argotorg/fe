// Tests for the `core::text` hex and base64 decoders and base58 codec.
// Base64 vectors are from RFC 4648 section 10, base58 vectors from Bitcoin
// Core's `base58_encode_decode.json`.
use core::num::IntDowncast
use core::ptr::{self, MemBuffer}
use std::abi::{Bytes, DynString}
use std::text::{self, TextBuilder}

fn to_hex(_ bytes: Bytes) -> DynString {
    var builder = TextBuilder::new()
    for i in 0..bytes.len() {
        builder = builder.push(text::hex(bytes.byte_at(i) as u256, 1))
    }
    builder.finish()
}

// The 256 bytes 0x00, 0x01, ..., 0xff.
fn all_bytes() -> Bytes {
    let buffer = MemBuffer::new(256)
    var i: u256 = 0
    while i < 256 {
        unsafe { *ptr::offset_bytes(buffer.ptr(), i.downcast_unchecked()) = i.downcast_truncate() }
        i += 1
    }
    Bytes::from_payload(source: buffer.span())
}

fn decodes_base64(_ encoded: DynString, _ expected: DynString) -> bool {
    text::decode_base64(encoded).unwrap().span() == expected.span()
}

#[test]
fn hex_decodes_either_case_and_prefix() {
    assert!(to_hex(text::decode_hex("00ff7f80").unwrap()) == "00ff7f80")
    assert!(to_hex(text::decode_hex("0xDeadBEEF").unwrap()) == "deadbeef")
    assert!(text::decode_hex("").unwrap().len() == 0)
    assert!(text::decode_hex("0x").unwrap().len() == 0)
    let data = all_bytes()
    assert!(text::decode_hex(to_hex(data)).unwrap() == data)
    let long: DynString = "0x6000600055600160015560026002556003600355600460045560056005556006600655"
    assert!(text::decode_hex(long).unwrap().len() == 35)
}

#[test]
fn hex_rejects() {
    // An odd number of digits.
    assert!(text::decode_hex("0").is_none())
    assert!(text::decode_hex("0x0").is_none())
    assert!(text::decode_hex("abc").is_none())
    // Bytes that are not digits, a second prefix, or an uppercase `X`.
    assert!(text::decode_hex("0g").is_none())
    assert!(text::decode_hex("0x0x00").is_none())
    assert!(text::decode_hex("0X00").is_none())
    assert!(text::decode_hex(" 0").is_none())
    assert!(text::decode_hex("-1").is_none())
}

#[test]
fn base64_rfc4648_vectors() {
    assert!(decodes_base64("", ""))
    assert!(decodes_base64("Zg==", "f"))
    assert!(decodes_base64("Zm8=", "fo"))
    assert!(decodes_base64("Zm9v", "foo"))
    assert!(decodes_base64("Zm9vYg==", "foob"))
    assert!(decodes_base64("Zm9vYmE=", "fooba"))
    assert!(decodes_base64("Zm9vYmFy", "foobar"))
    assert!(decodes_base64("PHN2Zz4/", "<svg>?"))
    assert!(to_hex(text::decode_base64("+/+/").unwrap()) == "fbffbf")
}

#[test]
fn base64_roundtrip() {
    let data = all_bytes()
    let encoded = text::base64(data.span())
    assert!(text::decode_base64(encoded).unwrap() == data)
}

#[test]
fn base64_encodes_rfc4648_vectors() {
    assert!(text::base64(("").span()) == "")
    assert!(text::base64(("f").span()) == "Zg==")
    assert!(text::base64(("fo").span()) == "Zm8=")
    assert!(text::base64(("foo").span()) == "Zm9v")
    assert!(text::base64(("foob").span()) == "Zm9vYg==")
    assert!(text::base64(("fooba").span()) == "Zm9vYmE=")
    assert!(text::base64(("foobar").span()) == "Zm9vYmFy")
}

#[test]
fn base64_roundtrips_every_tail_length() {
    // Inputs of every length up to 40 end in each tail and cross the
    // encoder's 4-byte reads; the bytes from 0xd7 on have their high bits set.
    let data = all_bytes()
    for n in 0..41 {
        let input = data.span().slice(offset: 215, len: n)
        let encoded = text::base64(input)
        assert!(encoded.len() == 4 * ((n + 2) / 3))
        assert!(text::decode_base64(encoded).unwrap().span() == input)
    }
}

#[test]
fn base64_rejects() {
    // Wrong length or missing padding.
    assert!(text::decode_base64("Zg").is_none())
    assert!(text::decode_base64("Zg=").is_none())
    assert!(text::decode_base64("Zm9vY").is_none())
    // Padding anywhere but the end.
    assert!(text::decode_base64("Z===").is_none())
    assert!(text::decode_base64("====").is_none())
    assert!(text::decode_base64("Zg=a").is_none())
    assert!(text::decode_base64("Zg==Zg==").is_none())
    // Bytes outside the standard alphabet, including base64url digits.
    assert!(text::decode_base64("Zm9v!A==").is_none())
    assert!(text::decode_base64("Zm-v").is_none())
    assert!(text::decode_base64("Zm_v").is_none())
    assert!(text::decode_base64("Zm9 ").is_none())
    // Nonzero bits under the padding.
    assert!(text::decode_base64("Zh==").is_none())
    assert!(text::decode_base64("Zm9=").is_none())
}

fn base58_roundtrip(_ hex: DynString, _ encoded: DynString) -> bool {
    let data = text::decode_hex(hex).unwrap()
    text::base58(data.span()) == encoded && text::decode_base58(encoded).unwrap() == data
}

#[test]
fn base58_bitcoin_vectors() {
    assert!(base58_roundtrip("", ""))
    assert!(base58_roundtrip("61", "2g"))
    assert!(base58_roundtrip("626262", "a3gV"))
    assert!(base58_roundtrip("636363", "aPEr"))
    assert!(
        base58_roundtrip(
            "73696d706c792061206c6f6e6720737472696e67",
            "2cFupjhnEsSn59qHXstmK2ffpLv2",
        ),
    )
    assert!(
        base58_roundtrip(
            "00eb15231dfceb60925886b67d065299925915aeb172c06647",
            "1NS17iag9jJgTHD1VXjvLCEnZuQ3rJDE9L",
        ),
    )
    assert!(base58_roundtrip("516b6fcd0f", "ABnLTmg"))
    assert!(base58_roundtrip("bf4f89001e670274dd", "3SEo3LWLoPntC"))
    assert!(base58_roundtrip("572e4794", "3EFU7m"))
    assert!(base58_roundtrip("ecac89cad93923c02321", "EJDM8drfXA6uyA"))
    assert!(base58_roundtrip("10c8511e", "Rt5zm"))
    assert!(base58_roundtrip("00000000000000000000", "1111111111"))
    assert!(
        base58_roundtrip(
            "000111d38e5fc9071ffcd20b4a763cc9ae4f252bb4e48fd66a835e252ada93ff480d6dd43dc62a641155a5",
            "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz",
        ),
    )
}

#[test]
fn base58_long_input() {
    let data = all_bytes()
    let encoded = text::base58(data.span())
    assert!(
        encoded
            == "",
    )
    assert!(text::decode_base58(encoded).unwrap() == data)
}

#[test]
fn base58_rejects() {
    // `0`, `O`, `I` and `l` are not in the alphabet, nor is anything else.
    assert!(text::decode_base58("0").is_none())
    assert!(text::decode_base58("1O").is_none())
    assert!(text::decode_base58("2I").is_none())
    assert!(text::decode_base58("l1").is_none())
    assert!(text::decode_base58("2g ").is_none())
    assert!(text::decode_base58("2g+").is_none())
}

#[test]
fn decoders_read_any_text() {
    let encoded: DynString = "Zm9v"
    assert!(text::decode_base64(encoded.span()).unwrap() == text::decode_base64("Zm9v").unwrap())
    let buffer = MemBuffer::from_span(encoded.span())
    assert!(text::decode_base64(buffer).unwrap() == text::decode_base64("Zm9v").unwrap())

    let hex = MemBuffer::from_span(encoded.span())
    assert!(text::decode_hex(hex.span()).is_none())
    let digits: DynString = "0x0a0b"
    assert!(text::decode_hex(MemBuffer::from_span(digits.span())).unwrap() == text::decode_hex("0a0b").unwrap())

    let base58: DynString = "2g"
    assert!(text::decode_base58(base58.span()).unwrap() == text::decode_base58("2g").unwrap())
    assert!(text::decode_base58(MemBuffer::from_span(base58.span())).unwrap() == text::decode_base58("2g").unwrap())
}
