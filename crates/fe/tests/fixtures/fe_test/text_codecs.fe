// Tests for the `core::text` base64 decoder and base58 codec. Base64
// vectors are from RFC 4648 section 10, base58 vectors from Bitcoin Core's
// `base58_encode_decode.json`.
use core::num::IntDowncast
use core::ptr::{self, MemBuffer}
use std::abi::{Bytes, DynString}
use std::text::{self, TextBuilder}

fn from_hex(_ hex: DynString) -> Bytes {
    let len = hex.len() / 2
    let buffer = MemBuffer::alloc(len)
    let mut i: u256 = 0
    while i < len {
        let byte = text::parse_hex_uint(hex.slice(start: 2 * i, len: 2)).unwrap()
        *ptr::offset_bytes(buffer.ptr(), i) = byte.downcast_truncate()
        i += 1
    }
    Bytes::from_payload(source: buffer.span())
}

fn to_hex(_ bytes: Bytes) -> DynString {
    let mut builder = TextBuilder::new()
    let mut i: u256 = 0
    while i < bytes.len() {
        builder = builder.push(text::hex(bytes.byte_at(i) as u256, 1))
        i += 1
    }
    builder.finish()
}

// The 256 bytes 0x00, 0x01, ..., 0xff.
fn all_bytes() -> Bytes {
    let buffer = MemBuffer::alloc(256)
    let mut i: u256 = 0
    while i < 256 {
        *ptr::offset_bytes(buffer.ptr(), i) = i.downcast_truncate()
        i += 1
    }
    Bytes::from_payload(source: buffer.span())
}

fn decodes_base64(_ encoded: DynString, _ expected: DynString) -> bool {
    text::decode_base64(encoded).unwrap() == expected.as_bytes()
}

#[test]
fn base64_rfc4648_vectors() {
    assert!(decodes_base64("", ""))
    assert!(decodes_base64("Zg==", "f"))
    assert!(decodes_base64("Zm8=", "fo"))
    assert!(decodes_base64("Zm9v", "foo"))
    assert!(decodes_base64("Zm9vYg==", "foob"))
    assert!(decodes_base64("Zm9vYmE=", "fooba"))
    assert!(decodes_base64("Zm9vYmFy", "foobar"))
    assert!(decodes_base64("PHN2Zz4/", "<svg>?"))
    assert!(to_hex(text::decode_base64("+/+/").unwrap()) == "fbffbf")
}

#[test]
fn base64_roundtrip() {
    let data = all_bytes()
    let encoded = text::base64(data.payload_span())
    assert!(text::decode_base64(encoded).unwrap() == data)
}

#[test]
fn base64_rejects() {
    // Wrong length or missing padding.
    assert!(text::decode_base64("Zg").is_none())
    assert!(text::decode_base64("Zg=").is_none())
    assert!(text::decode_base64("Zm9vY").is_none())
    // Padding anywhere but the end.
    assert!(text::decode_base64("Z===").is_none())
    assert!(text::decode_base64("====").is_none())
    assert!(text::decode_base64("Zg=a").is_none())
    assert!(text::decode_base64("Zg==Zg==").is_none())
    // Bytes outside the standard alphabet, including base64url digits.
    assert!(text::decode_base64("Zm9v!A==").is_none())
    assert!(text::decode_base64("Zm-v").is_none())
    assert!(text::decode_base64("Zm_v").is_none())
    assert!(text::decode_base64("Zm9 ").is_none())
    // Nonzero bits under the padding.
    assert!(text::decode_base64("Zh==").is_none())
    assert!(text::decode_base64("Zm9=").is_none())
}

fn base58_roundtrip(_ hex: DynString, _ encoded: DynString) -> bool {
    let data = from_hex(hex)
    text::base58(data.payload_span()) == encoded && text::decode_base58(encoded).unwrap() == data
}

#[test]
fn base58_bitcoin_vectors() {
    assert!(base58_roundtrip("", ""))
    assert!(base58_roundtrip("61", "2g"))
    assert!(base58_roundtrip("626262", "a3gV"))
    assert!(base58_roundtrip("636363", "aPEr"))
    assert!(
        base58_roundtrip(
            "73696d706c792061206c6f6e6720737472696e67",
            "2cFupjhnEsSn59qHXstmK2ffpLv2",
        ),
    )
    assert!(
        base58_roundtrip(
            "00eb15231dfceb60925886b67d065299925915aeb172c06647",
            "1NS17iag9jJgTHD1VXjvLCEnZuQ3rJDE9L",
        ),
    )
    assert!(base58_roundtrip("516b6fcd0f", "ABnLTmg"))
    assert!(base58_roundtrip("bf4f89001e670274dd", "3SEo3LWLoPntC"))
    assert!(base58_roundtrip("572e4794", "3EFU7m"))
    assert!(base58_roundtrip("ecac89cad93923c02321", "EJDM8drfXA6uyA"))
    assert!(base58_roundtrip("10c8511e", "Rt5zm"))
    assert!(base58_roundtrip("00000000000000000000", "1111111111"))
    assert!(
        base58_roundtrip(
            "000111d38e5fc9071ffcd20b4a763cc9ae4f252bb4e48fd66a835e252ada93ff480d6dd43dc62a641155a5",
            "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz",
        ),
    )
}

#[test]
fn base58_long_input() {
    let data = all_bytes()
    let encoded = text::base58(data.payload_span())
    assert!(
        encoded
            == "",
    )
    assert!(text::decode_base58(encoded).unwrap() == data)
}

#[test]
fn base58_rejects() {
    // `0`, `O`, `I` and `l` are not in the alphabet, nor is anything else.
    assert!(text::decode_base58("0").is_none())
    assert!(text::decode_base58("1O").is_none())
    assert!(text::decode_base58("2I").is_none())
    assert!(text::decode_base58("l1").is_none())
    assert!(text::decode_base58("2g ").is_none())
    assert!(text::decode_base58("2g+").is_none())
}
