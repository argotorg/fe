use core::{MemVec, Option, Result}
use core::ops::Drop
use core::ptr

// Each drop counts itself through a raw pointer, which no scope owns.
struct Counted {
    counter: *u256,
}

impl Drop for Counted {
    fn drop(own self) {
        unsafe { *self.counter += 1 }
    }
}

fn count(_ counter: *u256) -> u256 {
    unsafe { *counter }
}

struct Store {
    items: MemVec<u64>,
    counter: *u256,
    slides: u256,
}

impl Store {
    fn find(mut self, _ value: u64) -> Result<u64, mut u64> {
        var at: usize = 0
        while at < self.items.len() {
            if self.items[at] == value {
                return Result::Ok(mut self.items[at])
            }
            at += 1
        }
        Result::Err(value)
    }

    // An error that owns a resource.
    fn find_counted(mut self, _ value: u64) -> Result<Counted, mut u64> {
        var at: usize = 0
        while at < self.items.len() {
            if self.items[at] == value {
                return Result::Ok(mut self.items[at])
            }
            at += 1
        }
        Result::Err(Counted { counter: self.counter })
    }

    // A slide that counts how often it runs.
    fn tracked(mut self, _ at: usize) -> Option<mut u64> {
        if at >= self.items.len() {
            return Option::None
        }
        yield Option::Some(mut self.items[at])
        self.slides += 1
    }

    fn first(self) -> ref u64 {
        self.items.get(0).unwrap()
    }

    fn first_mut(mut self) -> mut u64 {
        mut self.items.get(0).unwrap()
    }
}

fn store() -> Store {
    let counter = ptr::alloc<u256>()
    unsafe { *counter = 0 }
    Store { items: MemVec::new(), counter, slides: 0 }
}

#[test]
fn options_test_and_unwrap() {
    var v: MemVec<u64> = MemVec::new()
    assert(v.get(0).is_none())
    assert(!v.get(0).is_some())
    v.push(7)
    v.push(9)
    assert(v.get(0).is_some())
    assert(v.get(5).is_none())
    assert(v.get(1).unwrap() == 9)
    assert(v.last().unwrap() == 9)
    let x = v.get(0).unwrap()
    assert(x == 7)
}

#[test]
fn unwrap_writes_through_mut() {
    var v: MemVec<u64> = MemVec::new()
    v.push(1)
    v.push(2)
    let m = mut v.get(1).unwrap()
    m += 40
    assert(v[1] == 42)
    v.last().unwrap() = 5
    assert(v[1] == 5)
}

#[test]
fn results_test_and_unwrap() {
    var s = store()
    s.items.push(3)
    assert(s.find(3).is_ok())
    assert(s.find(4).is_err())
    s.find(3).unwrap() = 11
    assert(s.items[0] == 11)
}

#[test]
fn tests_destroy_an_error_once() {
    var s = store()
    s.items.push(5)
    assert(s.find_counted(5).is_ok())
    assert(count(s.counter) == 0)
    assert(s.find_counted(6).is_err())
    assert(count(s.counter) == 1)
    assert(!s.find_counted(6).is_ok())
    assert(count(s.counter) == 2)
}

#[test]
fn a_test_ends_the_access() {
    var v: MemVec<u64> = MemVec::new()
    v.push(1)
    if v.get(0).is_some() {
        v.push(2)
    }
    assert(v.len() == 2)
}

#[test]
fn slides_run_after_the_last_use() {
    var s = store()
    s.items.push(1)
    assert(s.tracked(0).is_some())
    assert(s.slides == 1)
    assert(s.tracked(3).is_none())
    assert(s.slides == 1)
    let x = mut s.tracked(0).unwrap()
    x += 1
    assert(s.slides == 2)
    s.tracked(0).unwrap() = 7
    assert(s.slides == 3)
    assert(s.items[0] == 7)
}

#[test]
fn projections_forward_unwrap() {
    var s = store()
    s.items.push(8)
    assert(s.first() == 8)
    s.first_mut() = 9
    assert(s.items[0] == 9)
}

struct Node {
    children: MemVec<Node>,
    value: u64,
}

impl Node {
    fn child(self, _ at: usize) -> Option<ref Node> {
        self.children.get(at)
    }
}

#[test]
fn unwraps_chain() {
    var mid = Node { children: MemVec::new(), value: 2 }
    mid.children.push(Node { children: MemVec::new(), value: 3 })
    var root = Node { children: MemVec::new(), value: 1 }
    root.children.push(mid)
    assert(root.child(0).unwrap().child(0).unwrap().value == 3)
    assert(root.child(0).unwrap().child(1).is_none())
    let held = ref root.child(0).unwrap()
    assert(held.value == 2)
}

fn first_or<T: Copy>(_ v: ref MemVec<T>, _ default: T) -> T {
    if v.get(0).is_some() { v.get(0).unwrap() } else { default }
}

#[test]
fn generic_payloads() {
    var v: MemVec<u64> = MemVec::new()
    assert(first_or(ref v, 4) == 4)
    v.push(6)
    assert(first_or(ref v, 4) == 6)
}

// `unwrap` panics as `Result::unwrap` does, with the error.
#[test(should_revert)]
fn unwrap_panics_on_an_error() {
    var s = store()
    let _x = mut s.find(4).unwrap()
}

struct Cell {
    value: u64,
}

impl Cell {
    fn set(mut self, _ value: u64) {
        self.value = value
    }
}

fn advance(_ at: mut usize) -> u64 {
    at += 1
    99
}

// As for any projection receiver, the arguments run before `get` opens.
#[test]
fn unwrap_receivers_open_after_the_arguments() {
    var cells = MemVec::new()
    cells.push(Cell { value: 0 })
    cells.push(Cell { value: 0 })
    cells.push(Cell { value: 0 })
    var at: usize = 0
    cells.get(at).unwrap().set(advance(mut at))
    assert(cells[0].value == 0)
    assert(cells[1].value == 99)
    cells.get(at).unwrap().value = advance(mut at)
    assert(cells[2].value == 99)
}
