// A `TStorPtr` raw pointer stored as an ordinary struct field: the pointer
// lives in persistent storage (written by `init`, read back in later
// transactions) while the flag it points at lives in transient storage.
// For reentrancy locks prefer `std::evm::Mutex`, whose zero-sized `TSlot`
// lock costs no storage and gets its slot from the layout; this pins the
// stored-pointer composition itself.
use std::evm::effects::TStorPtr
use std::evm::{Create, Evm, RawStorage}

struct Flagged {
    count: u256,
    flag: TStorPtr<bool>,
}

impl Flagged {
    fn attach(mut self, _ flag: TStorPtr<bool>) {
        self.flag = flag
    }
}

msg CMsg {
    #[selector = 1]
    HandleSlot -> u256,
    #[selector = 2]
    Bump -> u256,
}

pub contract C {
    mut state: Flagged,

    init() uses (mut state, evm: Evm) {
        let flag = 0xfe as u256 as TStorPtr<bool>
        state.attach(flag)
    }

    recv CMsg {
        HandleSlot -> u256 uses (state) {
            // The pointer written by `init` persists across transactions.
            state.flag as u256
        }

        Bump -> u256 uses (mut state, raw: mut RawStorage) {
            // Set and clear the transient flag through the persisted pointer;
            // the persistent counter advances while the flag round-trips.
            // `init` made the pointer to a slot nothing else uses, and the
            // arm's raw storage authority covers the access.
            unsafe {
                assert!(!*state.flag)
                *state.flag = true
                assert!(*state.flag)
                *state.flag = false
                assert!(!*state.flag)
            }
            state.count += 1
            state.count
        }
    }
}

#[test]
fn pointer_persists_flag_is_transient() uses (cr: mut Create, evm: mut Evm) {
    let c = cr.create2<C>(value: Wei::zero(), args: (), salt: 1)
    let gas = 200000
    let value = Wei::zero()

    let slot = evm.call(addr: c, gas, value, message: CMsg::HandleSlot {})
    assert!(slot == 0xfe)

    let a = evm.call(addr: c, gas, value, message: CMsg::Bump {})
    assert!(a == 1)
    let b = evm.call(addr: c, gas, value, message: CMsg::Bump {})
    assert!(b == 2)
}
