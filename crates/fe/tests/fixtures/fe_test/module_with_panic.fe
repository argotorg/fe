// The payload of a panic is encoded as the type says, not as the `with`
// declaration of the module that panics: the choice reaches the written
// calls of a body and no call that the compiler makes for it.
use core::abi::{AbiFrame, AbiSize, Encode}
use core::panic_with_value
use std::abi::Sol
use std::evm::{Call, Evm}

pub struct E { pub v: u256 }
impl AbiSize for E {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}
impl Encode<Sol> for E {
    fn encode(self, _ f: AbiFrame) { f.store_word(at: 0, value: self.v) }
}
pub impl Encode<Sol> for E as Twice {
    fn encode(self, _ f: AbiFrame) { f.store_word(at: 0, value: self.v * 2) }
}
msg M {
    #[selector = 1]
    Fail -> u256,
}
mod framed {
    use super::*
    with (Twice)
    pub fn fail() -> u256 {
        panic_with_value(E { v: 21 })
        0
    }
}
pub contract C {
    recv M {
        Fail -> u256 { framed::fail() }
    }
}
#[test]
fn revert_data_uses_the_ordinary_encoder() uses (evm: mut Evm, call: mut Call) {
    let addr = evm.create2<C>(value: Wei::zero(), args: (), salt: 0)
    let result = addr.try_call(M::Fail {})
    assert!(!result.success())
    assert!(result.returndata().word_at(0) == 21)
}
