use std::abi::sol
use std::evm::{Ctx, Evm}
use core::abi::store_word

msg M {
    #[selector = sol("foo(bytes,bytes)")]
    Foo { a: Bytes, b: Bytes },
}

pub contract C uses (ctx: Ctx) {
    init() {}

    recv M {
        Foo { a, b } uses () { return }
    }
}

fn build_bytes() -> Bytes {
    let data = core::ptr::alloc_bytes(64)
    unsafe { store_word(ptr: data, value: 32) }
    unsafe { Bytes::from_abi_tail(data: data, len: 32, size: 64) }
}

#[test]
fn test_msg_call_with_two_dynamic_bytes_fields()
uses (evm: mut Evm)
{
    let c = evm.create2<C>(value: Wei::zero(), args: (), salt: 0)

    evm.call(
        addr: c,
        gas: 2000000,
        value: Wei::zero(),
        message: M::Foo { a: build_bytes(), b: build_bytes() },
    )
}
