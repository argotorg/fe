struct Counter {
    n: u256,
}

struct Cell {
    counter: Counter,
    counters: [Counter; 2],
    next: *Cell,
}

fn new_cell() -> *Cell {
    let cell = core::ptr::alloc<Cell>()
    unsafe { cell.counter = Counter { n: 0 } }
    unsafe { cell.counters = [Counter { n: 0 }, Counter { n: 0 }] }
    unsafe { cell.next = cell }
    cell
}

fn id(_ cell: *Cell) -> *Cell {
    cell
}

fn bump(_ counter: mut Counter) {
    counter.n += 1
}

fn incr() uses (counter: mut Counter) {
    counter.n += 1
}

#[test]
fn test_writes_and_borrows_through_temporary_pointers() {
    let cell = new_cell()
    unsafe { id(cell).counter.n = 1 }
    unsafe { (*id(cell)).counter.n += 1 }
    unsafe { id(cell).counters[1].n = 5 }
    unsafe { bump(mut id(cell).counter) }
    unsafe { assert(cell.counter.n == 3) }
    unsafe { assert(cell.counters[1].n == 5) }
}

#[test]
fn test_with_captures_temporary_pointer_places() {
    let cell = new_cell()
    let other = new_cell()
    unsafe {
        with ((*id(cell)).counter) {
            incr()
        }
    }
    var i: usize = 0
    unsafe {
        with (id(cell).counters[i]) {
            i = 1
            incr()
        }
    }
    unsafe {
        with (id(cell).next.counter) {
            cell.next = other
            incr()
        }
    }
    unsafe { assert(cell.counter.n == 2) }
    unsafe { assert(cell.counters[0].n == 1) }
    unsafe { assert(cell.counters[1].n == 0) }
    unsafe { assert(other.counter.n == 0) }
}
