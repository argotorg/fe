// `keccak_words` hashes its words as `keccak256(abi.encode(...))` does,
// whether the compiler folds it (known words, constant evaluation) or
// computes it at run time.
use core::abi::store_word
use core::ptr::{self, MemSpan}
use std::evm::{keccak256, keccak_words}

const ZERO_PAIR: u256 = keccak_words([0, 0])
const EMPTY_WORDS: u256 = keccak_words([0; 0])

// keccak256 over the memory words `a`, `b`.
fn hash_memory(_ a: u256, _ b: u256) -> u256 {
    let buffer = ptr::alloc_bytes(64)
    unsafe { store_word(ptr: buffer, value: a) }
    unsafe { store_word(ptr: ptr::offset_bytes(buffer, 32), value: b) }
    unsafe { keccak256(MemSpan::from_raw_parts(ptr: buffer, len: 64)) }
}

#[inline(never)]
fn runtime_hash(_ a: u256, _ b: u256) -> u256 {
    keccak_words([a, b])
}

#[test]
fn folded_digests_match_abi_encoded_hashes() {
    assert!(EMPTY_WORDS == 0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470)
    assert!(ZERO_PAIR == 0xad3228b676f7d3cd4284a5443f17f1962b36e491b30a40b2405849e597ba5fb5)
    assert!(keccak_words([0]) == 0x290decd9548b62a8d60345a988386fc84ba6bc95484008f6362f93160ef3e563)
    assert!(keccak_words([1, 0]) == 0xada5013122d395ba3c54772283fb069b10426056ef8ca54750cb9bb552a59e7d)
    assert!(keccak_words([u256::max()]) == 0xa9c584056064687e149968cbab758a3376d22aedc6a55823d1b3ecbee81b8fb9)
}

#[test]
fn runtime_digests_match_folded_and_memory_hashes() {
    assert!(runtime_hash(1, 0) == keccak_words([1, 0]))
    assert!(runtime_hash(u256::max(), 0) == 0xbbd6e7dddd4326dd7c827841ab9733c6e3fcdf38a516374bd10feec8f674ea8a)
    assert!(runtime_hash(7, 9) == hash_memory(7, 9))
    assert!(runtime_hash(0, 1) != runtime_hash(1, 0))
}

#[test]
fn hashes_read_the_words_at_the_call() {
    var words: [u256; 2] = [1, 0]
    let first = keccak_words(words)
    words[1] = 1
    assert!(keccak_words(words) != first)
    assert!(keccak_words(words) == hash_memory(1, 1))
}
