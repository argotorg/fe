// An `if let` whose pattern has `|` alternatives binds an access once, where
// the alternatives meet.
use core::option::Option

struct Pair { a: u256, b: u256 }

impl Pair {
    fn sum_and_b(mut self) -> Option<(u256, mut u256)> {
        Option::Some((self.a + self.b, mut self.b))
    }
}

fn bump(_ x: mut u256) {
    x += 1
}

fn read(_ x: ref u256) -> u256 {
    x
}

fn bump_if_small(_ p: mut Pair) -> bool {
    if let Option::Some((0 | 1 | 2, mut x)) = p.sum_and_b() {
        bump(mut x)
        return true
    }
    false
}

fn read_if_small(_ p: mut Pair) -> u256 {
    if let Option::Some((0 | 1 | 2, ref x)) = p.sum_and_b() {
        return read(x)
    }
    100
}

fn bump_while_small(_ p: mut Pair) {
    while let Option::Some((0 | 1, mut x)) = p.sum_and_b() {
        x += 1
    }
}

fn value_if_small(_ o: Option<(u256, u256)>) -> u256 {
    if let Option::Some((0 | 1, x)) = o {
        return x
    }
    100
}

struct Token { v: u256 }

enum Kind {
    A(u256),
    B(Token),
}

fn token_if_small(_ n: u256) -> u256 {
    // The test extracts the payload, which the binding takes from.
    if let Option::Some((0 | 1, t)) = Option::Some((n, Token { v: n + 10 })) {
        return t.v
    }
    100
}

fn token_if_kind(_ k: own Kind, _ n: u256) -> u256 {
    if let Option::Some((Kind::A(0) | Kind::B(_), t)) = Option::Some((k, Token { v: n })) {
        return t.v
    }
    100
}

enum Tag {
    A,
    B(u256),
}

fn token_if_tag(_ tag: own Tag, _ n: u256) -> u256 {
    // The tests check `tag` first, so each alternative extracts the token on
    // its own path and binds what it extracted.
    if let (Option::Some(t), Tag::A | Tag::B(0)) = (Option::Some(Token { v: n }), tag) {
        return t.v
    }
    100
}

fn bump_through(_ o: mut Option<(u256, u256)>) {
    if let Option::Some((0 | 1, mut x)) = o {
        x += 1
    }
}

#[test]
fn test_if_let_or_access() {
    var p = Pair { a: 0, b: 1 }
    assert(bump_if_small(mut p))
    assert(p.b == 2)
    assert(read_if_small(mut p) == 2)
    p.b = 5
    assert(!bump_if_small(mut p))
    assert(p.b == 5)
    assert(read_if_small(mut p) == 100)
    var q = Pair { a: 0, b: 0 }
    bump_while_small(mut q)
    assert(q.b == 2)
    assert(value_if_small(Option::Some((1, 7))) == 7)
    assert(value_if_small(Option::Some((3, 7))) == 100)
    assert(token_if_small(1) == 11)
    assert(token_if_small(3) == 100)
    assert(token_if_kind(Kind::A(0), 7) == 7)
    assert(token_if_kind(Kind::B(Token { v: 1 }), 8) == 8)
    assert(token_if_kind(Kind::A(1), 9) == 100)
    assert(token_if_tag(Tag::A, 5) == 5)
    assert(token_if_tag(Tag::B(0), 6) == 6)
    assert(token_if_tag(Tag::B(1), 7) == 100)
    var o = Option::Some((1, 5))
    bump_through(mut o)
    match o {
        Option::Some((_, x)) => assert(x == 6),
        Option::None => assert(false),
    }
}
