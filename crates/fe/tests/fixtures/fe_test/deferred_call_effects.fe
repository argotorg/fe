// A method call whose receiver's type is known only later in the body
// resolves then, but takes its effects where it is written: from the `with`
// blocks over it and, in a closure's body, from the closure's row.
struct Log {
    n: u256,
}

struct W<T> {
    v: T,
}

trait Note {
    fn note(self) -> u256 uses (log: Log)
    fn bump(self) uses (log: mut Log)
}

impl Note for W<u256> {
    fn note(self) -> u256 uses (log: Log) {
        log.n + self.v
    }

    fn bump(self) uses (log: mut Log) {
        log.n += self.v
    }
}

impl Note for W<u8> {
    fn note(self) -> u256 uses (log: Log) {
        0
    }

    fn bump(self) uses (log: mut Log) {}
}

struct R {}

trait Apply {
    fn apply<F: Fn(R) -> u256>(self, _ f: F) -> u256 uses F::E
}

impl Apply for W<u256> {
    fn apply<F: Fn(R) -> u256>(self, _ f: F) -> u256 uses F::E {
        f(R {}) + self.v
    }
}

impl Apply for W<u8> {
    fn apply<F: Fn(R) -> u256>(self, _ f: F) -> u256 uses F::E {
        0
    }
}

fn direct<F: Fn(R) -> u256>(_ f: F) -> u256 uses F::E {
    f(R {})
}

fn logged(_ r: R) -> u256 uses (log: Log) {
    log.n
}

fn in_with() -> u256 {
    with (Log = Log { n: 1 }) {
        let x = 5
        let r = W { v: x }.note()
        let y: u256 = x
        r
    }
}

fn in_closure() -> u256 uses (log: Log) {
    let g = || {
        let x = 5
        let r = W { v: x }.note()
        let y: u256 = x
        r
    }
    g()
}

fn in_nested_closure() -> u256 uses (log: Log) {
    let g = || {
        let h = || {
            let x = 5
            let r = W { v: x }.note()
            let y: u256 = x
            r
        }
        h()
    }
    g()
}

fn with_in_closure() -> u256 {
    let g = || {
        with (Log = Log { n: 1 }) {
            let x = 5
            let r = W { v: x }.note()
            let y: u256 = x
            r
        }
    }
    g()
}

// A row the call forwards is a component of the closure's row.
fn row_in_closure<F: Fn(R) -> u256>(_ f: own F) -> u256 uses F::E {
    let g = || {
        let x = 5
        let r = W { v: x }.apply(f)
        let y: u256 = x
        r
    }
    g()
}

// Resolved after `g` is checked, `apply` forwards `g`'s `F::E` component,
// not `late_row_in_closure`'s own row.
fn late_row_in_closure<F: Fn(R) -> u256>(_ f: own F, _ f2: own F) -> u256 uses (F::E, log: Log) {
    let x = 5
    let g = || {
        let d = log.n * 100 + direct(f2)
        let r = W { v: x }.apply(f)
        d + r
    }
    let y: u256 = x
    g()
}

fn bump_in_closure() uses (log: mut Log) {
    let g = || {
        let x = 5
        W { v: x }.bump()
        let y: u256 = x
    }
    g()
}

#[test]
fn deferred_calls_take_their_call_sites_effects() {
    assert!(in_with() == 6)
    assert!(with_in_closure() == 6)
    var log = Log { n: 2 }
    with (Log = log) {
        assert!(in_closure() == 7)
        assert!(in_nested_closure() == 7)
        assert!(row_in_closure(logged) == 7)
        assert!(late_row_in_closure(logged, logged) == 209)
        bump_in_closure()
    }
    assert!(log.n == 7)
}

// Each deferred call keeps the `with` blocks over it, not a sibling's.
#[test]
fn deferred_siblings_keep_their_providers() {
    let x = 5
    let first: u256 = with (Log = Log { n: 65 }) {
        W { v: x }.note()
    }
    let second: u256 = with (Log = Log { n: 95 }) {
        W { v: x }.note()
    }
    let y: u256 = x
    assert!(first == 70)
    assert!(second == 100)
}

#[test]
fn deferred_mutations_keep_their_places() {
    var a = Log { n: 65 }
    var b = Log { n: 95 }
    let x = 5
    with (Log = a) {
        W { v: x }.bump()
    }
    with (Log = b) {
        W { v: x }.bump()
    }
    let y: u256 = x
    assert!(a.n == 70)
    assert!(b.n == 100)
}

#[test]
fn nested_closure_deferred_siblings() {
    let g = || {
        let h = || {
            let x = 5
            let first: u256 = with (Log = Log { n: 65 }) {
                W { v: x }.note()
            }
            let second: u256 = with (Log = Log { n: 95 }) {
                W { v: x }.note()
            }
            let y: u256 = x
            first + second
        }
        h()
    }
    assert!(g() == 170)
}
