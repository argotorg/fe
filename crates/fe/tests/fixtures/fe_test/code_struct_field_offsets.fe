use std::evm::Evm

struct Rooted {
    value: u256,
}

msg StructGapMsg {
    #[selector = 1]
    Values -> (u256, u256),
}

pub contract StructGap {
    first: Rooted,
    after: u256,

    init() uses (mut first, mut after) {
        first = Rooted { value: 11 }
        after = 22
    }

    recv StructGapMsg {
        Values -> (u256, u256) uses (first, after) {
            (first.value, after)
        }
    }
}

#[test]
fn code_fields_after_a_struct_field_keep_their_offsets() uses (evm: mut Evm) {
    let c = evm.create2<StructGap>(value: Wei::zero(), args: (), salt: 0)
    let values: (u256, u256) = evm.call(
        addr: c,
        gas: 100000,
        value: Wei::zero(),
        message: StructGapMsg::Values {},
    )
    assert!(values.0 == 11)
    assert!(values.1 == 22)
}
