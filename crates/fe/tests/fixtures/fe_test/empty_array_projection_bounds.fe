struct Holder<const N: usize> { items: [u256; N] }

fn nested_element<const N: usize>(_ values: [[u256; N]; 1], _ index: usize) -> bool {
    values[0][index] == values[0][index]
}

fn field_element<const N: usize>(_ holder: Holder<N>, _ index: usize) -> bool {
    holder.items[index] == holder.items[index]
}

#[test(should_revert)]
fn nested_empty_array_reverts() {
    let values: [[u256; 0]; 1] = [[]]
    assert!(nested_element(values, 0))
}

#[test(should_revert)]
fn empty_array_field_reverts() {
    let holder: Holder<0> = Holder { items: [] }
    assert!(field_element(holder, 0))
}

#[test]
fn nonempty_projections_remain_accessible() {
    let values: [[u256; 2]; 1] = [[3, 4]]
    assert!(nested_element(values, 1))
    let holder: Holder<2> = Holder { items: [3, 4] }
    assert!(field_element(holder, 1))
}

fn borrowed_field<const N: usize>(_ holder: ref Holder<N>, _ index: usize) -> bool {
    holder.items[index] == holder.items[index]
}

fn tuple_element<const N: usize>(_ value: ([u256; N], bool), _ index: usize) -> bool {
    value.0[index] == value.0[index]
}

enum Choice<const N: usize> {
    Items([u256; N],),
    None,
}

fn variant_element<const N: usize>(_ choice: Choice<N>, _ index: usize) -> bool {
    match choice {
        Choice::Items(items,) => items[index] == 7,
        Choice::None => false,
    }
}

#[test(should_revert)]
fn borrowed_empty_array_field_reverts() {
    let holder: Holder<0> = Holder { items: [] }
    assert!(borrowed_field(ref holder, 0))
}

#[test(should_revert)]
fn empty_array_tuple_field_reverts() {
    let value: ([u256; 0], bool) = ([], true)
    assert!(tuple_element(value, 0))
}

#[test(should_revert)]
fn empty_array_variant_field_reverts() {
    let choice: Choice<0> = Choice::Items([])
    assert!(variant_element(choice, 0))
}

#[test]
fn nonempty_borrowed_tuple_and_variant_projections() {
    let holder: Holder<1> = Holder { items: [7] }
    assert!(borrowed_field(ref holder, 0))
    let value: ([u256; 1], bool) = ([7], true)
    assert!(tuple_element(value, 0))
    let choice: Choice<1> = Choice::Items([7])
    assert!(variant_element(choice, 0))
}

#[test(should_revert)]
fn nonempty_nested_array_oob_reverts() {
    let values: [[u256; 1]; 1] = [[7]]
    assert!(nested_element(values, 1))
}
