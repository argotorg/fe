struct Node {
    value: u256,
    next: *Node,
}

struct A {
    value: u256,
    b: *B,
}

struct B {
    value: u256,
    a: *A,
}

struct GNode<T> {
    value: T,
    next: *GNode<T>,
}

enum Link {
    Nil,
    Cons(*ENode),
}

struct ENode {
    value: u256,
    next: Link,
}

struct ONode {
    value: u256,
    next: Option<*ONode>,
}

struct Tree {
    value: u256,
    kids: [*Tree; 2],
}

struct Pair {
    value: u256,
    link: (u256, *Pair),
}

struct MovePair {
    a: u256,
    b: u256,
}

struct PNode {
    value: u256,
    next: **PNode,
}

impl Node {
    fn set_value(mut self, _ value: u256) {
        self.value = value
    }
}

fn next_value(_ p: *Node) -> u256 {
    unsafe { p.next.value }
}

fn follow(_ p: *Node) -> *Node {
    unsafe { p.next }
}

fn node_sum(_ n: Node) -> u256 {
    unsafe { n.value + n.next.value }
}

fn make_node(value: u256, _ next: *Node) -> Node {
    Node { value, next }
}

fn pick(_ first: *Node, _ second: *Node, use_first: bool) -> *Node {
    if use_first { first } else { second }
}

fn walk(_ start: *Node, steps: u256) -> u256 {
    var p = start
    var i: u256 = 0
    while i < steps {
        unsafe { p = p.next }
        i += 1
    }
    unsafe { p.value }
}

fn generic_next<T: Copy>(_ p: *GNode<T>) -> T {
    unsafe { p.next.value }
}

#[test]
fn test_self_recursive_reads_writes_and_copies() {
    let tail = core::ptr::alloc<Node>()
    unsafe { tail.value = 20 }
    unsafe { tail.next = tail }
    let head = core::ptr::alloc<Node>()
    unsafe { head.value = 10 }
    unsafe { head.next = tail }
    assert(next_value(head) == 20)
    unsafe { assert(head.next.next.value == 20) }

    unsafe { head.next.value = 21 }
    unsafe { assert(tail.value == 21) }

    // A whole-value copy copies the pointer, not the referent.
    let copy = unsafe { *head }
    let slot = core::ptr::alloc<Node>()
    unsafe { *slot = copy }
    unsafe { assert(slot.value == 10) }
    unsafe { slot.next.value = 22 }
    unsafe { assert(tail.value == 22) }
    assert(core::size_of<Node>() == 32 + core::size_of<*Node>())
}

#[test]
fn test_recursive_params_returns_and_values() {
    let tail = core::ptr::alloc<Node>()
    unsafe { tail.value = 7 }
    unsafe { tail.next = tail }
    let head = core::ptr::alloc<Node>()
    unsafe { *head = make_node(value: 5, tail) }
    assert(follow(head) == tail)
    let second = follow(follow(head))
    unsafe { assert(second.value == 7) }
    unsafe { assert(node_sum(*head) == 12) }
    let built = make_node(value: 1, head)
    assert(node_sum(built) == 6)
}

#[test]
fn test_recursive_joins() {
    let b = core::ptr::alloc<Node>()
    unsafe { b.value = 2 }
    unsafe { b.next = b }
    let a = core::ptr::alloc<Node>()
    unsafe { a.value = 1 }
    unsafe { a.next = b }
    let first = pick(a, b, use_first: true)
    unsafe { assert(first.value == 1) }
    let second = pick(a, b, use_first: false)
    unsafe { assert(second.value == 2) }
    unsafe { assert(pick(a, b, use_first: false).value == 2) }
    unsafe { assert(pick(a, b, use_first: true).next.value == 2) }
    let chosen = unsafe { if a.value == 1 { a.next } else { a } }
    unsafe { assert(chosen.next.value == 2) }
    unsafe { (*pick(a, b, use_first: false)).set_value(3) }
    unsafe { assert(b.value == 3) }
}

#[test]
fn test_recursive_loops() {
    let c = core::ptr::alloc<Node>()
    unsafe { c.value = 3 }
    let b = core::ptr::alloc<Node>()
    unsafe { b.value = 2 }
    unsafe { b.next = c }
    let a = core::ptr::alloc<Node>()
    unsafe { a.value = 1 }
    unsafe { a.next = b }
    unsafe { c.next = a }
    assert(walk(a, steps: 4) == 2)
    assert(walk(a, steps: 8) == 3)
}

#[test]
fn test_mutual_recursion() {
    let a = core::ptr::alloc<A>()
    let b = core::ptr::alloc<B>()
    unsafe { a.value = 1 }
    unsafe { a.b = b }
    unsafe { b.value = 2 }
    unsafe { b.a = a }
    unsafe { assert(a.b.value == 2) }
    unsafe { assert(a.b.a.b.a.value == 1) }
    unsafe { b.a.value = 9 }
    unsafe { assert(a.value == 9) }
}

#[test]
fn test_generic_recursion() {
    let n = core::ptr::alloc<GNode<u8>>()
    unsafe { n.value = 3 }
    unsafe { n.next = n }
    unsafe { assert(n.next.next.value == 3) }
    assert(generic_next(n) == 3)

    let w = core::ptr::alloc<GNode<u256>>()
    unsafe { w.value = 300 }
    unsafe { w.next = w }
    assert(generic_next(w) == 300)
}

fn relink(_ node: *ENode, _ next: own Link) {
    unsafe { node.next = next }
}

fn is_cons(_ link: Link) -> bool {
    match link {
        Link::Nil => false
        Link::Cons(_) => true
    }
}

fn read_next_ptr(_ start: *ONode) -> Option<*ONode> {
    unsafe { start.next }
}

fn optional_next_value(_ start: *ONode) -> u256 {
    unsafe {
        if let Option::Some(node) = start.next {
            node.value
        } else {
            0
        }
    }
}

#[test]
fn test_enum_payload_recursion() {
    let last = core::ptr::alloc<ENode>()
    unsafe { last.value = 4 }
    unsafe { last.next = Link::Nil }
    let first = core::ptr::alloc<ENode>()
    unsafe { first.value = 6 }
    relink(first, Link::Cons(last))
    assert(is_cons(Link::Cons(first)))
    unsafe { assert(is_cons(first.next)) }
    let copy = unsafe { *first }
    let slot = core::ptr::alloc<ENode>()
    unsafe { *slot = copy }
    unsafe { assert(slot.value == 6) }
    unsafe { last.next = Link::Cons(first) }
    unsafe { assert(last.value == 4) }

    let o2 = core::ptr::alloc<ONode>()
    unsafe { o2.value = 2 }
    unsafe { o2.next = Option::None }
    let o1 = core::ptr::alloc<ONode>()
    unsafe { o1.value = 1 }
    unsafe { o1.next = Option::Some(o2) }
    assert(optional_next_value(o1) == 2)
    assert(optional_next_value(o2) == 0)
    let node = unsafe { *o1 }
    assert(node.value == 1)
    assert(node.next.is_some())
    unsafe { assert(o2.next.is_none()) }
}

#[test]
fn test_recursive_read_only_call_frame_after_move() {
    let first = core::ptr::alloc<MovePair>()
    unsafe { first.a = 6 }
    unsafe { first.b = 0 }
    let copy = unsafe { *first }
    assert(copy.a == 6)

    let o2 = core::ptr::alloc<ONode>()
    unsafe { o2.value = 2 }
    unsafe { o2.next = Option::None }
    let o1 = core::ptr::alloc<ONode>()
    unsafe { o1.value = 1 }
    unsafe { o1.next = Option::Some(o2) }
    assert(optional_next_value(o1) == 2)
    assert(optional_next_value(o1) == 2)
    let next = read_next_ptr(o1)
    assert(next.is_some())
    assert(optional_next_value(o2) == 0)
    unsafe { assert(o2.next.is_none()) }
}

#[test]
fn test_pointer_arrays_tuples_and_nested_pointers() {
    let leaf = core::ptr::alloc<Tree>()
    unsafe { leaf.value = 5 }
    unsafe { leaf.kids = [leaf, leaf] }
    let root = core::ptr::alloc<Tree>()
    unsafe { root.value = 1 }
    unsafe { root.kids = [leaf, root] }
    unsafe { assert(root.kids[0].value == 5) }
    unsafe { assert(root.kids[1].kids[0].kids[1].value == 5) }

    let pair = core::ptr::alloc<Pair>()
    unsafe { pair.value = 8 }
    unsafe { pair.link = (1, pair) }
    unsafe { assert(pair.link.1.link.1.value == 8) }

    let node = core::ptr::alloc<PNode>()
    let cell = core::ptr::alloc<*PNode>()
    unsafe { *cell = node }
    unsafe { node.value = 11 }
    unsafe { node.next = cell }
    unsafe { assert((*node.next).value == 11) }
    unsafe { assert((*(*node.next).next).value == 11) }
}
