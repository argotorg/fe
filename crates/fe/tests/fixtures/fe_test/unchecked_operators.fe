// An arithmetic operator wraps in unchecked code, where it is written: on
// primitive operands it is a wrapping operation, and on other operands it
// calls the wrapping operator trait if their type implements it, which a type
// parameter must be bounded by. A called function's own operators keep its
// own mode.
use core::fixed::Wad
use core::ops::{Add, WrappingAdd}
use std::evm::{Duration, Timestamp, seconds, wei}

struct Pair {
    a: u8,
    b: [i8; 2],
}

fn increment(_ x: mut u8) {
    x += 1
}

#[arithmetic(unchecked)]
fn increment_wrapping(_ x: mut u8) {
    x += 1
}

#[arithmetic(unchecked)]
#[test]
fn primitive_operators_wrap() {
    let max: u8 = 255
    let min: i8 = -128
    assert!(max + 1 == 0)
    assert!(0 - max == 1)
    assert!(max * max == 1)
    assert!(max ** 2 == 1)
    assert!(-min == min)
    assert!(min / -1 == min)
}

#[arithmetic(unchecked)]
#[test]
fn compound_assignments_wrap() {
    var x: u8 = 255
    x += 2
    assert!(x == 1)
    x -= 2
    assert!(x == 255)
    x *= 2
    assert!(x == 254)
    x **= 2
    assert!(x == 4)
    var pair = Pair { a: 255, b: [127, -128] }
    pair.a += 1
    pair.b[0] += 1
    pair.b[1] -= 1
    assert!(pair.a == 0 && pair.b[0] == -128 && pair.b[1] == 127)
    var y: u8 = 255
    increment_wrapping(mut y)
    assert!(y == 0)
    // An integer whose type is known only later.
    var z = 255
    z += 1
    let typed: u8 = z
    assert!(typed == 0)
}

#[arithmetic(unchecked)]
#[test]
fn closures_wrap_in_unchecked_code() {
    let add_one = |value: u8| value + 1
    assert!(add_one(255) == 0)
}

#[test(should_revert, panic = 0x11)]
fn checked_compound_assignment_reverts() {
    var x: u8 = 255
    x += 1
}

#[test(should_revert, panic = 0x11)]
fn checked_field_compound_assignment_reverts() {
    var pair = Pair { a: 0, b: [-128, 0] }
    pair.b[0] -= 1
}

#[test(should_revert, panic = 0x11)]
fn checked_negation_reverts() {
    let min: i8 = -128
    let x = -min
}

#[arithmetic(unchecked)]
#[test(should_revert, panic = 0x11)]
fn called_function_stays_checked() {
    var x: u8 = 255
    increment(mut x)
}

#[arithmetic(unchecked)]
#[test(should_revert, panic = 0x11)]
fn explicit_operator_method_stays_checked() {
    let x: u8 = 255
    let y = x.add(1)
}

fn sum<T: Add<Output = T>>(_ a: own T, _ b: own T) -> T {
    a + b
}

#[arithmetic(unchecked)]
#[test(should_revert, panic = 0x11)]
fn generic_operator_stays_checked() {
    let x: u8 = 255
    let y = sum(x, 1)
}

#[arithmetic(unchecked)]
fn unchecked_wrapping_sum<T: WrappingAdd<Output = T>>(_ a: own T, _ b: own T) -> T {
    a + b
}

// `.add` is the checked operation in any mode.
#[arithmetic(unchecked)]
fn unchecked_explicit_sum<T: Add<Output = T>>(_ a: own T, _ b: own T) -> T {
    a.add(b)
}

#[test(should_revert, panic = 0x11)]
fn unchecked_generic_explicit_method_is_checked() {
    let x: u8 = 255
    let y = unchecked_explicit_sum(x, 1)
}

#[test]
fn unchecked_generic_operator_with_wrapping_bound_wraps() {
    let x: u8 = 255
    assert!(unchecked_wrapping_sum(x, 1) == 0)
}

// `Wad` implements no wrapping traits, so its operators stay checked.
#[arithmetic(unchecked)]
#[test(should_revert, panic = 0x11)]
fn fixed_point_operators_stay_checked() {
    let max = Wad::from_raw(u256::max())
    let sum = max + Wad::from_raw(1)
}

#[arithmetic(unchecked)]
#[test]
fn bool_compound_assignments() {
    var flag = true
    flag &= false
    assert!(!flag)
    flag ^= true
    assert!(flag)
    flag |= false
    assert!(flag)
}

#[arithmetic(unchecked)]
#[test]
fn wei_wraps() {
    let max = Wei::zero() - wei(1)
    assert!(max.as_wei() == u256::max())
    assert!((max + wei(2)).as_wei() == 1)
    assert!((max * 2).as_wei() == u256::max() - 1)
    var total = max
    total += wei(1)
    assert!(total == Wei::zero())
    total -= wei(1)
    assert!(total == max)
    assert!(max / 2 == wei(u256::max() / 2))
}

struct Holder {
    amount: Wei,
}

#[arithmetic(unchecked)]
fn add_through_borrows(_ total: mut Wei, _ holder: ref Holder) -> Wei {
    total + holder.amount
}

// An operand reached through a borrow wraps like an owned one.
#[test]
fn borrowed_wei_wraps() {
    var total = wei(u256::max())
    let holder = Holder { amount: wei(1) }
    assert!(add_through_borrows(mut total, ref holder) == Wei::zero())
}

#[test(should_revert, panic = 0x11)]
fn wei_add_reverts() {
    let max = wei(u256::max())
    let sum = max + wei(1)
}

#[test(should_revert, panic = 0x11)]
fn wei_add_assign_reverts() {
    var total = wei(u256::max())
    total += wei(1)
}

#[arithmetic(unchecked)]
#[test]
fn time_wraps() {
    let start = Timestamp::from_seconds(1)
    let earlier = start - seconds(2)
    assert!(earlier.as_seconds() == u256::max())
    assert!((start - earlier).as_seconds() == 2)
    assert!((earlier + seconds(2)) == start)
    var later = earlier
    later += seconds(3)
    assert!(later.as_seconds() == 2)
    later -= seconds(3)
    assert!(later == earlier)
    assert!((seconds(u256::max()) * 2).as_seconds() == u256::max() - 1)
    var span = seconds(0)
    span -= seconds(1)
    assert!(span.as_seconds() == u256::max())
}

#[test(should_revert, panic = 0x11)]
fn time_sub_reverts() {
    let start = Timestamp::from_seconds(1)
    let earlier = start - seconds(2)
}

#[test(should_revert, panic = 0x11)]
fn duration_sub_assign_reverts() {
    var span: Duration = seconds(0)
    span -= seconds(1)
}
