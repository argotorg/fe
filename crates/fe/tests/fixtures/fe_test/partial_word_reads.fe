use core::{ByteSource, Bytes, MemBuffer, MemSpan}

fn source_word<S: ByteSource>(_ source: S, _ offset: usize) -> u256 {
    source.word_at(offset as u256)
}

fn source_byte<S: ByteSource>(_ source: S, _ offset: usize) -> u8 {
    source.byte_at(offset as u256)
}

// The 32 bytes from `offset` on, read one at a time, with those past the end
// of `span` zero.
fn expected_word(_ span: MemSpan, _ offset: usize) -> u256 {
    var word: u256 = 0
    for i in offset..offset + 32 {
        word = word << 8 | if i < span.len() { span.byte_at(i) as u256 } else { 0 }
    }
    word
}

// 97 nonzero bytes, so a read past the end of a prefix finds nonzero bytes.
fn filled() -> MemBuffer {
    var buffer = MemBuffer::alloc(97)
    for i in 0..97 {
        buffer[i] = (0xff - i).downcast_truncate()
    }
    buffer
}

#[test]
fn span_reads_zero_the_bytes_past_the_span() {
    let buffer = filled()
    for len in 0..66 {
        let span = buffer.slice(offset: 0, len)
        for offset in 0..len + 2 {
            core::assert(source_word(span, offset) == expected_word(span, offset))
            let byte = if offset < len { span.byte_at(offset) } else { 0 }
            core::assert(source_byte(span, offset) == byte)
        }
    }
}

#[test]
fn bytes_words_zero_the_bytes_past_the_payload() {
    let buffer = filled()
    for len in 1..66 {
        let bytes = Bytes::from_payload(source: buffer.slice(offset: 0, len))
        for offset in 0..len {
            core::assert(bytes.word_at(offset) == expected_word(bytes.payload_span(), offset))
        }
    }
}
