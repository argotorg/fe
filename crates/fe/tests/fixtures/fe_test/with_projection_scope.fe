use core::{Option, ptr}
use core::ops::Drop

// A `with` provider that is a projection's result is evaluated once, where
// the block begins, and its slide runs when control leaves the block: at its
// end, by `return`, `break`, `continue` or a failing `?`, or for a `yield`
// statement's operand when the projection's session resumes, whether or not
// a call in the block takes the provider; a path that panics never leaves
// the block, and runs no slide. Each event appends a digit to a
// trace a raw pointer reaches, so slides and destructors log too:
//
// 0-4 the indent a callee sees, or  3 a binding in the block is destroyed
//     code in the block             5 the caller uses a grant
// 6 a second provider slides        7 a nested projection slides
// 8 the provider slides             9 the slide after a `yield` runs
fn log(_ trace: *u256, _ event: u256) {
    unsafe { *trace = *trace * 10 + event }
}

fn new_trace() -> *u256 {
    let trace = ptr::alloc<u256>()
    unsafe { *trace = 0 }
    trace
}

fn read(_ trace: *u256) -> u256 {
    unsafe { *trace }
}

struct Guard {
    trace: *u256,
    event: u256,
}

impl Drop for Guard {
    fn drop(own self) {
        log(self.trace, self.event)
    }
}

struct Frame {
    indent: u256,
    trace: *u256,
}

impl Frame {
    // The same as a method, which takes the frame as a parameter.
    fn clip(mut self, _ by: u256, _ event: u256) -> mut Frame {
        self.indent += by
        yield mut self
        self.indent -= by
        log(self.trace, event)
    }
}

// Indents the frame and logs `event` when its slide runs.
fn indented(_ by: u256, _ event: u256) -> mut Frame uses (frame: mut Frame) {
    frame.indent += by
    yield mut frame
    frame.indent -= by
    log(frame.trace, event)
}

// The same at either mode, without the indent.
fn viewed(_ event: u256) -> mut? Frame uses (frame: mut? Frame) {
    yield mut? frame
    log(frame.trace, event)
}

// Grants the frame only if `ok`.
fn maybe(_ ok: bool) -> Option<mut Frame> uses (frame: mut Frame) {
    if !ok {
        return Option::None
    }
    frame.indent += 1
    yield Option::Some(mut frame)
    frame.indent -= 1
    log(frame.trace, 8)
}

// Logs the indent the provider in scope has.
fn mark() uses (frame: mut Frame) {
    log(frame.trace, frame.indent)
}

fn look() uses (frame: Frame) {
    log(frame.trace, frame.indent)
}

struct Tally {
    trace: *u256,
}

fn counted() -> mut Tally uses (tally: mut Tally) {
    yield mut tally
    log(tally.trace, 6)
}

fn tick() uses (tally: mut Tally) {
    log(tally.trace, 2)
}

fn counted7() -> mut Tally uses (tally: mut Tally) {
    yield mut tally
    log(tally.trace, 7)
}

struct PtrHolder {
    p: *Frame,
    trace: *u256,
}

// Grants a raw pointer, and logs 8 when its slide runs.
fn proj_ptr(_ h: mut PtrHolder) -> ref *Frame {
    yield ref h.p
    log(h.trace, 8)
}

fn note(_ t: *u256) -> u256 {
    log(t, 2)
    0
}

struct Holder {
    v: u256,
    trace: *u256,
}

impl Holder {
    fn project(mut self) -> mut u256 uses (frame: mut Frame) {
        yield mut self.v
        log(self.trace, 7)
    }
}

// Its slide panics with code 0x22, so a test that reverts with another code
// ran no slide.
fn strict() -> mut Frame uses (frame: mut Frame) {
    yield mut frame
    core::panic_code(0x22)
}

fn fresh(_ t: *u256) -> Frame {
    Frame { indent: 0, trace: t }
}

fn unused(_ t: *u256) uses (frame: mut Frame) {
    with (Frame = indented(1, 8)) {
        log(t, 1)
    }
    log(t, 2)
}

fn after_last_use(_ t: *u256) uses (frame: mut Frame) {
    with (Frame = indented(1, 8)) {
        mark()
        let _g = Guard { trace: t, event: 3 }
        log(t, 2)
    }
}

fn nested(_ t: *u256) uses (frame: mut Frame) {
    with (Frame = indented(1, 8)) {
        with (Frame = indented(1, 7)) {
            mark()
            log(t, 1)
        }
        mark()
    }
}

fn early_return(_ t: *u256, _ c: bool) -> u256 uses (frame: mut Frame) {
    with (Frame = indented(1, 8)) {
        mark()
        let _g = Guard { trace: t, event: 3 }
        if c {
            return 1
        }
        mark()
    }
    2
}

fn loops(_ t: *u256) uses (frame: mut Frame) {
    var i: u256 = 0
    while true {
        i += 1
        with (Frame = indented(i, 8)) {
            mark()
            let _g = Guard { trace: t, event: 3 }
            if i == 1 {
                continue
            }
            if i == 2 {
                break
            }
        }
    }
}

fn tried(_ t: *u256, _ x: Option<u256>) -> Option<u256> uses (frame: mut Frame) {
    with (Frame = indented(1, 8)) {
        mark()
        let _g = Guard { trace: t, event: 3 }
        let v = x?
        mark()
        Option::Some(v)
    }
}

fn let_else(_ t: *u256, _ x: Option<u256>) -> u256 uses (frame: mut Frame) {
    with (Frame = indented(1, 8)) {
        mark()
        let Option::Some(v) = x else {
            let _g = Guard { trace: t, event: 3 }
            return 0
        }
        mark()
        v
    }
}

fn two_providers(_ t: *u256) uses (frame: mut Frame, tally: mut Tally) {
    with (Frame = indented(1, 8), Tally = counted()) {
        mark()
        log(t, 1)
    }
}

// An exit from a later provider's expression holds the earlier one.
fn exit_in_provider(_ t: *u256, _ c: bool) uses (frame: mut Frame, tally: mut Tally) {
    with (Frame = indented(1, 8), Tally = {
        if c {
            let _g = Guard { trace: t, event: 3 }
            return
        }
        counted()
    }) {
        mark()
        tick()
    }
}

// The bindings of an access block among the providers end with the `with`
// block, after the providers that follow it and before those it follows.
fn later_block(_ t: *u256) uses (frame: mut Frame, tally: mut Tally) {
    with (Frame = indented(1, 8), Tally = {
        let _g = Guard { trace: t, event: 3 }
        counted7()
    }) {
        mark()
    }
    log(t, 9)
}

fn later_block_break(_ t: *u256) uses (frame: mut Frame, tally: mut Tally) {
    loop {
        with (Frame = indented(1, 8), Tally = {
            let _g = Guard { trace: t, event: 3 }
            if true {
                break
            }
            counted7()
        }) {
            mark()
        }
    }
    log(t, 9)
}

fn later_block_return(_ t: *u256, _ c: bool) uses (frame: mut Frame, tally: mut Tally) {
    with (Frame = indented(1, 8), Tally = {
        let _g = Guard { trace: t, event: 3 }
        if c {
            return
        }
        counted7()
    }) {
        mark()
    }
}

fn first_block(_ t: *u256) uses (frame: mut Frame) {
    with (Frame = {
        let _g = Guard { trace: t, event: 3 }
        indented(1, 8)
    }) {
        mark()
    }
    log(t, 9)
}

// A value provider's temporary ends with the `with` block, after the
// projection that follows it.
fn value_then_projection(_ t: *u256) -> u256 uses (frame: mut Frame) {
    with (Guard = Guard { trace: t, event: 1 }, Frame = indented(1, 8)) {
        mark()
        0
    } + note(t)
}

fn grant_field(_ t: *u256) uses (frame: mut Frame) {
    with (u256 = indented(1, 8).indent) {
        log(t, 2)
    }
}

fn unwrapped(_ t: *u256) uses (frame: mut Frame) {
    with (Frame = maybe(true).unwrap()) {
        mark()
        log(t, 2)
    }
}

fn block_field(_ t: *u256) uses (frame: mut Frame) {
    with (u256 = ({ indented(1, 8) }).indent) {
        log(t, 2)
    }
}

fn marked_field(_ t: *u256) uses (frame: mut Frame) {
    with (u256 = (mut indented(1, 8)).indent) {
        log(t, 2)
    }
}

// A place through a raw pointer a grant holds is not in the grant.
fn pointer_field(_ t: *u256, _ h: mut PtrHolder) {
    unsafe {
        with (u256 = proj_ptr(mut h).indent) {
            log(t, 2)
        }
    }
}

fn pointer_deref(_ t: *u256, _ h: mut PtrHolder) {
    unsafe {
        with (Frame = *proj_ptr(mut h)) {
            log(t, 2)
        }
    }
}

fn maybe_mut_ref(_ t: *u256) uses (frame: mut Frame) {
    frame.indent = 4
    with (Frame = viewed(8)) {
        look()
        log(t, 1)
    }
    frame.indent = 0
}

fn maybe_mut_mut(_ t: *u256) uses (frame: mut Frame) {
    with (Frame = mut viewed(8)) {
        mark()
        log(t, 1)
    }
}

fn optional(_ t: *u256, _ ok: bool) -> Option<u256> uses (frame: mut Frame) {
    with (Frame = maybe(ok)?) {
        mark()
        log(t, 2)
    }
    Option::Some(0)
}

fn in_closure(_ t: *u256) uses (frame: mut Frame) {
    let f = |trace: *u256| {
        with (Frame = indented(1, 8)) {
            mark()
            log(trace, 2)
        }
    }
    f(t)
}

// A block borrowing a place provides the place, and holds nothing after the
// last call that takes it.
fn block_provider(_ other: mut Frame) {
    with (Frame = { mut other }) {
        mark()
        other.indent += 1
    }
}

// A `with` block that is a projection's yield site: the inner grant is
// taken through the block's provider, and the session ends both where it
// resumes, after the caller's use, the block's binding between them.
fn deeper(_ t: *u256) -> mut Frame uses (frame: mut Frame) {
    with (Frame = indented(1, 8)) {
        let _g = Guard { trace: t, event: 3 }
        indented(1, 7)
    }
}

// A `yield` statement's operand ends where the session resumes: its
// provider slides after the caller's use, after the operand's bindings and
// before the slide after the `yield`.
fn yield_binding(_ t: *u256) -> mut u256 uses (frame: mut Frame) {
    yield with (Frame = indented(1, 8)) {
        var h = Holder { v: 0, trace: t }
        let _g = Guard { trace: t, event: 3 }
        h.project()
    }
    log(t, 9)
}

fn yield_place(_ t: *u256, _ other: mut u256) -> mut u256 uses (frame: mut Frame) {
    yield with (Frame = indented(1, 8)) {
        let _g = Guard { trace: t, event: 3 }
        mut other
    }
    log(t, 9)
}

// The same inside a compound yield.
fn yield_compound(_ t: *u256) -> Option<ref u256> uses (frame: mut Frame) {
    yield Option::Some(with (Frame = indented(1, 8)) {
        let g = 4
        let _g = Guard { trace: t, event: 3 }
        ref g
    })
    log(t, 9)
}

fn yield_two(_ t: *u256, _ other: mut u256) -> Option<mut u256> uses (frame: mut Frame, tally: mut Tally) {
    yield Option::Some(with (Frame = indented(1, 8), Tally = counted7()) {
        let _g = Guard { trace: t, event: 3 }
        mut other
    })
    log(t, 9)
}

// A `with` element of a yielded tuple or variant yields on each path of
// the elements before it, and of its own body, with its scope open: each
// path's provider slides where that path's session resumes, after the
// bindings of the `with` and before those of the elements before it.
fn after_branch(
    _ t: *u256,
    _ c: bool,
    _ a: mut u256,
    _ other: mut u256,
    _ f: mut Frame,
) -> (mut u256, mut u256) {
    yield (if c {
        let _g1 = Guard { trace: t, event: 1 }
        mut a
    } else {
        mut a
    }, with (Frame = f.clip(1, 8)) {
        let _g = Guard { trace: t, event: 3 }
        mut other
    })
    log(t, 9)
}

fn branches_inside(_ t: *u256, _ c: bool, _ x: mut u256, _ y: mut u256, _ f: mut Frame) -> Option<mut u256> {
    yield Option::Some(with (Frame = f.clip(1, 8)) {
        if c {
            let _a = Guard { trace: t, event: 1 }
            mut x
        } else {
            mut y
        }
    })
    log(t, 9)
}

fn returns_inside(_ t: *u256, _ c: bool, _ x: mut u256, _ f: mut Frame) -> Option<mut u256> {
    yield Option::Some(with (Frame = f.clip(1, 8)) {
        if c {
            return Option::None
        }
        mut x
    })
    log(t, 9)
}

// An owned element of a yielded tuple is a value: its `with` block ends
// where it ends, so the provider slides before the next element, which may
// name the outer frame.
fn owned_element(_ t: *u256, _ q: mut u256) -> (u256, mut u256) uses (frame: mut Frame) {
    yield (with (Frame = indented(1, 8)) {
        mark()
        1
    }, {
        mark()
        mut q
    })
    log(t, 9)
}

// An element the granted access comes out of holds its provider until the
// session resumes.
fn access_element(_ t: *u256, _ q: mut u256) -> (mut u256, u256) uses (frame: mut Frame) {
    yield (with (Frame = indented(1, 8)) {
        let _g = Guard { trace: t, event: 3 }
        mut q
    }, 2)
    log(t, 9)
}

// An owned `with` element after a branching one is evaluated on each path,
// its provider sliding before that path's yield.
fn owned_after_branch(_ t: *u256, _ c: bool, _ x: mut u256, _ y: mut u256, _ f: mut Frame) -> (mut u256, u256) {
    yield (if c { mut x } else { mut y }, with (Frame = f.clip(1, 8)) {
        let _g = Guard { trace: t, event: 3 }
        4
    })
    log(t, 9)
}

// A `return` in an owned `with` element yields on its own: the provider
// slides where that path resumes. The other path leaves the block first.
fn owned_return(_ t: *u256, _ c: bool, _ q: mut u256, _ f: mut Frame) -> (u256, mut u256) {
    yield (with (Frame = f.clip(1, 8)) {
        if c {
            return (0, mut q)
        }
        1
    }, mut q)
    log(t, 9)
}

fn peek_guard() -> ref Guard uses (guard: Guard) {
    ref guard
}

// A yield site `with` keeps its value provider until the session resumes.
fn value_yield(_ t: *u256) -> ref Guard {
    with (Guard = Guard { trace: t, event: 1 }) { peek_guard() }
}

// A `var` declared before the block belongs to its own block, though the
// `with` block assigns it.
fn outer_var(_ t: *u256) uses (frame: mut Frame) {
    var g: Guard
    with (Frame = indented(1, 8)) {
        mark()
        g = Guard { trace: t, event: 3 }
    }
    log(t, 9)
}

struct KQ {
    k: u256,
    a: u256,
}

// A `with` in an or-pattern arm yields on each alternative's path.
fn or_arm(_ t: *u256, _ kq: mut KQ, _ f: mut Frame) -> mut u256 {
    match kq {
        KQ { k: 0 | 1, mut a } => with (Frame = f.clip(1, 8)) {
            mark()
            let _g = Guard { trace: t, event: 3 }
            mut a
        }
        KQ { mut a, .. } => mut a
    }
}

// A loop whose only exit is `return` holds the provider through the loop.
// Coverage only: the `return`'s own hold keeps the provider live in the
// loop, so this passes without the hold at the loop's header, which the
// uitests of endless loops pin.
fn loop_return(_ t: *u256, _ c: bool) uses (frame: mut Frame) {
    with (Frame = indented(1, 8)) {
        loop {
            let _g = Guard { trace: t, event: 3 }
            if c {
                return
            }
        }
    }
}

// The code after a `yield` in the block still runs under its provider.
fn shifted(_ t: *u256) -> mut Frame uses (frame: mut Frame) {
    with (Frame = indented(1, 8)) {
        yield indented(1, 7)
        mark()
        log(t, 2)
    }
}

fn panics(_ c: bool) uses (frame: mut Frame) {
    with (Frame = strict()) {
        mark()
        if c {
            core::panic_code(0x11)
        }
        mark()
    }
}

fn fails_assert(_ c: bool) uses (frame: mut Frame) {
    with (Frame = strict()) {
        mark()
        assert!(c)
        mark()
    }
}

fn loops_until_panic() uses (frame: mut Frame) {
    with (Frame = strict()) {
        var i: u256 = 0
        loop {
            i += 1
            if i == 3 {
                core::panic_code(0x11)
            }
        }
    }
}

#[test(should_revert, panic = 0x11)]
fn panic_runs_no_slide() {
    var frame = fresh(new_trace())
    with (frame) { panics(true) }
}

#[test(should_revert, panic = 0x01)]
fn failing_assert_runs_no_slide() {
    var frame = fresh(new_trace())
    with (frame) { fails_assert(false) }
}

#[test(should_revert, panic = 0x11)]
fn endless_loop_runs_no_slide() {
    var frame = fresh(new_trace())
    with (frame) { loops_until_panic() }
}

#[test]
fn unused_provider_slides_at_block_end() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) { unused(t) }
    assert(read(t) == 182)
}

#[test]
fn provider_slides_after_last_use() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) { after_last_use(t) }
    assert(read(t) == 1238)
}

#[test]
fn nested_blocks_slide_innermost_first() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) { nested(t) }
    assert(read(t) == 21718)
}

#[test]
fn return_destroys_then_slides() {
    let t = new_trace()
    var frame = fresh(t)
    assert(with (frame) { early_return(t, true) } == 1)
    assert(read(t) == 138)
    let u = new_trace()
    var other = fresh(u)
    assert(with (other) { early_return(u, false) } == 2)
    assert(read(u) == 1138)
}

#[test]
fn break_and_continue_destroy_then_slide() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) { loops(t) }
    assert(read(t) == 138238)
}

#[test]
fn failing_try_destroys_then_slides() {
    let t = new_trace()
    var frame = fresh(t)
    assert(with (frame) { tried(t, Option::None) }.is_none())
    assert(read(t) == 138)
    let u = new_trace()
    var other = fresh(u)
    assert(with (other) { tried(u, Option::Some(5)) }.unwrap() == 5)
    assert(read(u) == 1138)
}

#[test]
fn let_else_destroys_then_slides() {
    let t = new_trace()
    var frame = fresh(t)
    assert(with (frame) { let_else(t, Option::None) } == 0)
    assert(read(t) == 138)
}

#[test]
fn two_providers_slide_newest_first() {
    let t = new_trace()
    var frame = fresh(t)
    var tally = Tally { trace: t }
    with (frame, tally) { two_providers(t) }
    assert(read(t) == 1168)
}

#[test]
fn exit_in_later_provider_holds_earlier() {
    let t = new_trace()
    var frame = fresh(t)
    var tally = Tally { trace: t }
    with (frame, tally) { exit_in_provider(t, true) }
    assert(read(t) == 38)
}

#[test]
fn later_provider_block_ends_with_the_block() {
    let t = new_trace()
    var frame = fresh(t)
    var tally = Tally { trace: t }
    with (frame, tally) { later_block(t) }
    assert(read(t) == 17389)
    let u = new_trace()
    var other = fresh(u)
    var count = Tally { trace: u }
    with (other, count) { later_block_break(u) }
    assert(read(u) == 389)
    let v = new_trace()
    var third = fresh(v)
    var last = Tally { trace: v }
    with (third, last) { later_block_return(v, true) }
    assert(read(v) == 38)
}

#[test]
fn first_provider_block_ends_with_the_block() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) { first_block(t) }
    assert(read(t) == 1839)
}

#[test]
fn value_provider_ends_with_the_block() {
    let t = new_trace()
    var frame = fresh(t)
    assert(with (frame) { value_then_projection(t) } == 0)
    assert(read(t) == 1812)
}

#[test]
fn grant_place_providers_slide_at_block_end() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) {
        grant_field(t)
        unwrapped(t)
        block_field(t)
        marked_field(t)
    }
    assert(read(t) == 281282828)
}

#[test]
fn pointer_providers_end_at_once() {
    let t = new_trace()
    var h = PtrHolder { p: ptr::alloc<Frame>(), trace: t }
    unsafe { *h.p = fresh(t) }
    pointer_field(t, mut h)
    pointer_deref(t, mut h)
    assert(read(t) == 8282)
}

#[test]
fn compound_yield_with_two_providers() {
    let t = new_trace()
    var frame = fresh(t)
    var tally = Tally { trace: t }
    var v: u256 = 0
    with (frame, tally) {
        if let Option::Some(mut x) = yield_two(t, mut v) {
            log(t, 5)
            x += 1
        }
    }
    assert(read(t) == 53789 && v == 1)
}

#[test]
fn maybe_mut_providers_slide_at_block_end() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) { maybe_mut_ref(t) }
    assert(read(t) == 418)
    let u = new_trace()
    var other = fresh(u)
    with (other) { maybe_mut_mut(u) }
    assert(read(u) == 18)
}

#[test]
fn optional_provider_slides_at_block_end() {
    let t = new_trace()
    var frame = fresh(t)
    assert(with (frame) { optional(t, true) }.is_some())
    assert(read(t) == 128)
    assert(with (frame) { optional(t, false) }.is_none())
    assert(read(t) == 128)
}

#[test]
fn closure_block_slides_at_its_end() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) { in_closure(t) }
    assert(read(t) == 128)
}

#[test]
fn block_provider_holds_nothing() {
    let t = new_trace()
    var other = fresh(t)
    block_provider(mut other)
    assert(read(t) == 0 && other.indent == 1)
}

#[test]
fn yield_site_block_ends_at_resume() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) {
        with (Frame = deeper(t)) {
            mark()
            log(t, 5)
        }
    }
    assert(read(t) == 25738)
}

#[test]
fn yield_operand_ends_at_resume() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) {
        let x = mut yield_binding(t)
        log(t, 5)
        x += 1
    }
    assert(read(t) == 57389)
    let u = new_trace()
    var other = fresh(u)
    var v: u256 = 0
    with (other) {
        let x = mut yield_place(u, mut v)
        log(u, 5)
        x += 1
    }
    assert(read(u) == 5389)
}

#[test]
fn compound_yield_operand_ends_at_resume() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) {
        if let Option::Some(ref x) = yield_compound(t) {
            log(t, 5)
            assert(x == 4)
        }
    }
    assert(read(t) == 5389)
}

#[test]
fn with_element_slides_on_each_path() {
    let t = new_trace()
    var frame = fresh(t)
    var a: u256 = 0
    var v: u256 = 0
    {
        let (_, mut x) = after_branch(t, true, mut a, mut v, mut frame)
        log(t, 5)
        x += 1
    }
    assert(read(t) == 53819)
    let u = new_trace()
    var other = fresh(u)
    {
        let (_, mut x) = after_branch(u, false, mut a, mut v, mut other)
        log(u, 5)
        x += 1
    }
    assert(read(u) == 5389 && v == 2)
}

#[test]
fn with_element_branches_slide_on_each_path() {
    let t = new_trace()
    var frame = fresh(t)
    var x: u256 = 0
    var y: u256 = 0
    if let Option::Some(mut g) = branches_inside(t, true, mut x, mut y, mut frame) {
        log(t, 5)
        g += 1
    }
    assert(read(t) == 5189)
    let u = new_trace()
    var other = fresh(u)
    if let Option::Some(mut g) = branches_inside(u, false, mut x, mut y, mut other) {
        log(u, 5)
        g += 1
    }
    assert(read(u) == 589 && x == 1 && y == 1)
    let w = new_trace()
    var third = fresh(w)
    assert(returns_inside(w, true, mut x, mut third).is_none())
    assert(read(w) == 8)
}

#[test]
fn owned_element_slides_before_the_next() {
    let t = new_trace()
    var frame = fresh(t)
    var q: u256 = 0
    with (frame) {
        let (_, mut x) = owned_element(t, mut q)
        log(t, 5)
        x += 1
    }
    assert(read(t) == 18059)
}

#[test]
fn access_element_holds_until_resume() {
    let t = new_trace()
    var frame = fresh(t)
    var q: u256 = 0
    with (frame) {
        let (mut x, _) = access_element(t, mut q)
        log(t, 5)
        x += 1
    }
    assert(read(t) == 5389)
}

#[test]
fn owned_element_after_branch_slides_on_each_path() {
    let t = new_trace()
    var frame = fresh(t)
    var x: u256 = 0
    var y: u256 = 0
    {
        let (mut g, _) = owned_after_branch(t, true, mut x, mut y, mut frame)
        log(t, 5)
        g += 1
    }
    assert(read(t) == 3859)
    let u = new_trace()
    var other = fresh(u)
    {
        let (mut g, _) = owned_after_branch(u, false, mut x, mut y, mut other)
        log(u, 5)
        g += 1
    }
    assert(read(u) == 3859 && x == 1 && y == 1)
}

#[test]
fn owned_element_return_slides_at_resume() {
