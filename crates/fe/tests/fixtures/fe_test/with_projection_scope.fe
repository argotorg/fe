#[test]
fn yield_site_value_provider_ends_at_resume() {
    let t = new_trace()
    {
        let g = ref value_yield(t)
        log(t, 5)
        assert(g.event == 1)
    }
    assert(read(t) == 51)
}

#[test]
fn outer_var_outlives_the_block() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) { outer_var(t) }
    assert(read(t) == 1893)
}

#[test]
fn or_pattern_arm_slides_on_each_alternative() {
    let t = new_trace()
    var frame = fresh(t)
    var kq = KQ { k: 0, a: 0 }
    {
        let x = mut or_arm(t, mut kq, mut frame)
        log(t, 5)
        x += 1
    }
    assert(read(t) == 1538)
    let u = new_trace()
    var other = fresh(u)
    kq.k = 1
    {
        let x = mut or_arm(u, mut kq, mut other)
        log(u, 5)
        x += 1
    }
    assert(read(u) == 1538 && kq.a == 2)
}

#[test]
fn loop_with_only_a_return_holds_the_provider() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) { loop_return(t, true) }
    assert(read(t) == 38)
}

#[test]
fn slide_after_yield_keeps_provider() {
    let t = new_trace()
    var frame = fresh(t)
    with (frame) {
        with (Frame = shifted(t)) {
            mark()
            log(t, 5)
        }
    }
    assert(read(t) == 257128)
}
