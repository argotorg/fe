// The public decode entry points take the input's length from their caller.
// A length larger than the memory input must not let a decode copy bytes from
// past the input: each of these fails instead of reading another allocation.
use core::abi::{Bytes, Decode, DynString, decode_field_from_prechecked_head, decode_frame_from, decode_msg_field_from}
use std::abi::DynArray
use core::ptr::{MemArray, MemBuffer, MemSpan}
use std::abi::Sol
use std::evm::{Call, Create, Evm}

/// A 32-byte input whose bytes tail claims to reach `secret`, and `secret`.
#[inline(never)]
fn tail_input() -> (MemBuffer, MemArray<u256>) {
    var input = MemBuffer::alloc(32)
    var secret = MemArray<u256>::new_zeroed(1)
    secret[0] = 0x5ec2e7
    let rel = (secret.ptr() as usize as u256) - (input.ptr() as usize as u256) - 32
    input.write_word(offset: 0, value: rel + 32)
    (input, secret)
}

/// A 64-byte input whose head points at a bytes tail that claims to reach
/// `secret`, and `secret`.
#[inline(never)]
fn head_input() -> (MemBuffer, MemArray<u256>) {
    var input = MemBuffer::alloc(64)
    var secret = MemArray<u256>::new_zeroed(1)
    secret[0] = 0x5ec2e7
    let rel = (secret.ptr() as usize as u256) - (input.ptr() as usize as u256) - 64
    input.write_word(offset: 0, value: 32)
    input.write_word(offset: 32, value: rel + 32)
    (input, secret)
}

msg Probe {
    #[selector = 1]
    PrecheckedHeadBytes {} -> u256,
    #[selector = 2]
    PrecheckedHeadString {} -> u256,
    #[selector = 3]
    FrameBytes {} -> u256,
    #[selector = 4]
    FieldFromPrecheckedHead {} -> u256,
    #[selector = 5]
    MsgField {} -> u256,
    #[selector = 6]
    BoundedDynArray {} -> u256,
    #[selector = 7]
    Honest {} -> u256,
}

pub contract Decoder {
    recv Probe {
        PrecheckedHeadBytes {} -> u256 {
            let (input, _) = tail_input()
            let b: Bytes = <Bytes as Decode<Sol>>::decode_from_prechecked_head(input.span(), 0, 0x100000)
            b.len() as u256
        }
        PrecheckedHeadString {} -> u256 {
            let (input, _) = tail_input()
            let s: DynString = <DynString as Decode<Sol>>::decode_from_prechecked_head(input.span(), 0, 0x100000)
            s.len() as u256
        }
        FrameBytes {} -> u256 {
            let (input, _) = tail_input()
            let b: Bytes = decode_frame_from<Sol, Bytes, MemSpan>(input.span(), 0, 0x100000)
            b.len() as u256
        }
        FieldFromPrecheckedHead {} -> u256 {
            let (input, _) = head_input()
            let b: Bytes = decode_field_from_prechecked_head<Sol, Bytes, MemSpan>(input.span(), base: 0, head_pos: 0, input_len: 0x100000)
            b.len() as u256
        }
        MsgField {} -> u256 {
            let (input, _) = head_input()
            let b: Bytes = decode_msg_field_from<Sol, Bytes, MemSpan>(input.span(), base: 0, head_pos: 0, input_len: 0x100000)
            b.len() as u256
        }
        BoundedDynArray {} -> u256 {
            var input = MemBuffer::alloc(32)
            var secret = MemArray<u256>::new_zeroed(1)
            secret[0] = 0x5ec2e7
            let rel = (secret.ptr() as usize as u256) - (input.ptr() as usize as u256) - 32
            input.write_word(offset: 0, value: rel / 32 + 1)
            let a: DynArray<u256> = <DynArray<u256> as Decode<Sol>>::decode_from_bounded(input.span(), 0, 0x100000)
            a.len() as u256
        }
        // An honest length still decodes a memory input.
        Honest {} -> u256 {
            var input = MemBuffer::alloc(96)
            input.write_word(offset: 0, value: 32)
            input.write_word(offset: 32, value: 3)
            input.write_word(offset: 64, value: 0x616263 << 232)
            let span = input.span()
            let b: Bytes = decode_field_from_prechecked_head<Sol, Bytes, MemSpan>(span, base: 0, head_pos: 0, input_len: span.len() as u256)
            assert(b.byte_at(0) == 0x61 && b.byte_at(2) == 0x63)
            b.len() as u256
        }
    }
}

#[test]
fn inflated_input_lengths_fail() uses (evm: mut Evm) {
    let target = evm.create2<Decoder>(value: Wei::zero(), args: (), salt: 0)
    assert(!evm.try_call(addr: target, gas: 300000, value: Wei::zero(), message: Probe::PrecheckedHeadBytes {}).success())
    assert(!evm.try_call(addr: target, gas: 300000, value: Wei::zero(), message: Probe::PrecheckedHeadString {}).success())
    assert(!evm.try_call(addr: target, gas: 300000, value: Wei::zero(), message: Probe::FrameBytes {}).success())
    assert(!evm.try_call(addr: target, gas: 300000, value: Wei::zero(), message: Probe::FieldFromPrecheckedHead {}).success())
    assert(!evm.try_call(addr: target, gas: 300000, value: Wei::zero(), message: Probe::MsgField {}).success())
    assert(!evm.try_call(addr: target, gas: 300000, value: Wei::zero(), message: Probe::BoundedDynArray {}).success())
    assert(evm.call(addr: target, gas: 300000, value: Wei::zero(), message: Probe::Honest {}) == 3)
}
