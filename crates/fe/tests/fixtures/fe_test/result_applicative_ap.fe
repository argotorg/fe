use core::functional::{Applicative, Fn, FnOnce, Functor}
use core::result::Result::{self, Ok}

enum AddError {
    LeftUnavailable,
    RightUnavailable,
}

struct MakeAdder {}

struct AddRight {
    left: u256,
}

impl FnOnce<(u256,), AddRight> for MakeAdder {
    fn call_once(self: own Self, _ args: own (u256,)) -> AddRight {
        self.call(args.0)
    }
}

impl Fn<(u256,), AddRight> for MakeAdder {
    fn call(self, _ args: own (u256,)) -> AddRight {
        AddRight { left: args.0 }
    }
}

impl FnOnce<(u256,), u256> for AddRight {
    fn call_once(self: own Self, _ args: own (u256,)) -> u256 {
        self.call(args.0)
    }
}

impl Fn<(u256,), u256> for AddRight {
    fn call(self, _ args: own (u256,)) -> u256 {
        self.left + args.0
    }
}

#[test]
fn test_result_ap_codegen() {
    let a: Result<AddError, u256> = Ok(20)
    let f: Result<AddError, AddRight> = a.map(MakeAdder {})
    let out: Result<AddError, u256> = f.ap(Ok(22))
    match out {
        Result::Ok(value) => assert!(value == 42)
        Result::Err(_) => assert!(false)
    }
}

#[test]
fn test_result_ap_with_closure_codegen() {
    let a: Result<AddError, u256> = Ok(20)
    let f = a.map(|left: own u256| {
        |right: own u256| -> u256 { left + right }
    })
    let out: Result<AddError, u256> = f.ap(Ok(22))
    match out {
        Result::Ok(value) => assert!(value == 42)
        Result::Err(_) => assert!(false)
    }
}
