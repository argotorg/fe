trait Marker {}
trait Foo {
    type Out
    fn make() -> Self::Out
}
impl<T: Marker> Foo for T {
    type Out = u256
    fn make() -> u256 { 1 }
}
struct S {}
impl Foo for S {
    type Out = u8
    fn make() -> u8 { 2 }
}
impl Marker for S as FakeMarker {}

fn gen<T: Marker>() -> <T as Foo>::Out { <T as Foo>::make() }
fn boom() -> u8 { with (FakeMarker) { gen<S>() } }
#[test]
fn t() { assert(boom() == 2) }
