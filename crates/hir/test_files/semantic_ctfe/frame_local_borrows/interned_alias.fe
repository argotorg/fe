struct Pair {
    a: u8,
    b: [u8; 2],
}

enum Entry {
    Empty,
    Full(Pair),
}

const fn word() -> [u8; 2] {
    [0, 26]
}

const PAIRS: [Pair; 2] = [Pair { a: 1, b: [2, 3] }, Pair { a: 4, b: [5, 6] }]
const ENTRIES: [Entry; 2] = [Entry::Empty, Entry::Full(Pair { a: 7, b: [8, 9] })]
const WORDS: [[u8; 2]; 1] = [word()]

// Locals copied from constants stay interned, so each borrow and read below
// projects into an interned value.
const fn answer() -> u8 {
    let pairs = PAIRS
    let entries = ENTRIES
    let words = WORDS
    let pair = ref pairs[1]
    let b = ref pairs[0].b[1]
    let byte = ref words[0][1]
    let mut total = pair.a + b + byte
    match entries[1] {
        Entry::Full(inner) => {
            total += inner.b[1]
        }
        Entry::Empty => {}
    }
    total
}
