trait Pick {
    const fn pick(_ value: mut u8) -> mut u8
}

struct Alias {}
impl Pick for Alias {
    const fn pick(_ value: mut u8) -> mut u8 { mut value }
}

// A generic projection yields through the selected implementation.
const fn via<T: Pick>(_ value: mut u8) -> mut u8 {
    T::pick(mut value)
}

const fn answer() -> u8 {
    var x: u8 = 0
    let a = mut via<Alias>(mut x)
    a = 42
    x
}
