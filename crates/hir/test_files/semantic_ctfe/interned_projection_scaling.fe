const VALUES: [u256; 20000] = [1; 20000]

// `values` stays interned, so each borrow and read projects one element of a
// 20000-element constant.
const fn answer() -> u256 {
    let values = VALUES
    var total: u256 = 0
    var i: usize = 0
    while i < 20000 {
        let value = ref values[i]
        total += values[i]
        i += 1
    }
    total
}
