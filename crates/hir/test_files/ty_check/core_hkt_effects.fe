use core::option::Option::{self, Some, None}
use core::result::Result::{self, Ok, Err}
use core::functional::{Fn, FnOnce, Functor, Applicative, Monad}

struct AddOne {}
impl FnOnce<(i32,), i32> for AddOne {
    fn call_once(self: own Self, _ args: own (i32,)) -> i32 {
        self.call(args.0)
    }
}

impl Fn<(i32,), i32> for AddOne {
    fn call(self, _ args: own (i32,)) -> i32 {
        args.0 + 1
    }
}

struct ToPositive {}
impl FnOnce<(i32,), Option<i32>> for ToPositive {
    fn call_once(self: own Self, _ args: own (i32,)) -> Option<i32> {
        self.call(args.0)
    }
}

impl Fn<(i32,), Option<i32>> for ToPositive {
    fn call(self, _ args: own (i32,)) -> Option<i32> {
        let value = args.0
        if value > 0 {
            Some(value)
        } else {
            None
        }
    }
}

struct ToEvenResult {}
impl FnOnce<(i32,), Result<(), i32>> for ToEvenResult {
    fn call_once(self: own Self, _ args: own (i32,)) -> Result<(), i32> {
        self.call(args.0)
    }
}

impl Fn<(i32,), Result<(), i32>> for ToEvenResult {
    fn call(self, _ args: own (i32,)) -> Result<(), i32> {
        let value = args.0
        if value % 2 == 0 {
            Ok(value)
        } else {
            Err(())
        }
    }
}

fn option_monad_chain(start: own Option<i32>) -> Option<i32> {
    let mapped = start.map(AddOne{})
    mapped.and_then(ToPositive{})
}

fn result_monad_chain(start: own Result<(), i32>) -> Result<(), i32> {
    let functor_mapped = start.map(AddOne{})

    let func: Result<(), AddOne> = Ok(AddOne{})
    let value: Result<(), i32> = functor_mapped
    let applied = func.ap(value)

    applied.bind(ToEvenResult{})
}

trait Logger {
    fn log(mut self)
}

struct ConsoleLogger {}
impl Logger for ConsoleLogger {
    fn log(mut self) {}
}

pub fn log_and_chain(x: i32) -> Result<(), Option<i32>>
  uses (logger: mut Logger)
{
    logger.log()

    let opt = Some(x)
    let opt_chain = option_monad_chain(start: opt)

    let base = Ok(x)
    let res_chain = result_monad_chain(start: base)

    match res_chain {
        Ok(_) => Ok(opt_chain)
        Err(e) => Err(e)
    }
}

pub fn with_logger<R, L: Logger, F: Fn<(), R>>(logger: own L, _ func: F) -> R {
    with (Logger = logger) {
        func.call()
    }
}

pub fn log_once()
  uses (logger: mut Logger)
{
    logger.log()
}

struct RunWithLogger {}
impl FnOnce<(), Result<(), Option<i32>>> for RunWithLogger {
    fn call_once(self: own Self, _ unit: own ()) -> Result<(), Option<i32>> {
        self.call()
    }
}

impl Fn<(), Result<(), Option<i32>>> for RunWithLogger {
    fn call(self, _ unit: own ()) -> Result<(), Option<i32>> {
        with (Logger = ConsoleLogger {}) {
            log_once()
            log_and_chain(x: 10)
        }
    }
}

pub fn use_with_logger() {
    let logger = ConsoleLogger {}
    let result: Result<(), Option<i32>> = with_logger(logger, RunWithLogger{})
    let _ = result
}
