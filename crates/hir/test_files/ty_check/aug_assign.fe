struct Foo {
    x: i32,
}

pub fn foo(var foo: own Foo, var b: own bool) -> i32 {
    foo.x *= 2
    b |= false

    var x = 1
    x += 1
    x *= 1
    x <<= 1
    x **= 2
    x

    var usize_acc: usize = 0
    usize_acc += 1
    usize_acc
    
    var arr = [x, 1, 2]
    arr[0] -= arr[1] + 1
    arr[0]
}
