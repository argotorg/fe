struct Pair {
    a: u256,
    b: u256,
}

fn bump(_ x: mut u256) {
    x += 1
}

fn bump_pair(_ p: mut Pair) {
    bump(mut p.a)
    bump(mut p.b)
}

fn take_u256(_ x: own u256) -> u256 {
    x
}

fn full() {
    var x: u256 = 0
    let r = ref x
    r
    bump(mut x)

    let a: u256 = 1
    let a2 = take_u256(a)
    a2

    var s = Pair {a: 1, b: 2}
    bump_pair(mut s)
    if true {
        let ma = mut s.a
        let mb = mut s.b
        ma += 1
        mb += 1
    }
    let moved_a = s.a
    s.a = moved_a

    var arr: [u256; 2] = [10, 20]
    if true {
        let p0 = mut arr[0]
        let p1 = mut arr[1]
        p0 += 1
        p1 += 1
    }

    var z: u256 = 5
    let w = z
    z = w
}
