struct Data {
    value: u256,
    other: u256,
}

struct Holder {
    data: *Data,
}

fn pointer_casts_and_offsets(data: *Data, bytes: *u8) -> u256 {
    let bytes_from_typed: *u8 = core::ptr::byte_ptr(data)
    let typed_again: *Data = core::ptr::cast<u8, Data>(bytes_from_typed)
    let next: *Data = core::ptr::offset_bytes(typed_again, 32)
    let input_data: *Data = core::ptr::cast<u8, Data>(bytes)

    unsafe { typed_again.value + next.other + input_data.value }
}

fn pointer_field_access(data: *Data) -> u256 {
    unsafe { data.value = 10 }
    unsafe { data.other = data.value + 3 }
    unsafe { data.value + data.other }
}

fn pointer_tuple_field_access(pair: *(u256, u256)) -> u256 {
    unsafe { pair.0 = 4 }
    unsafe { pair.1 = pair.0 + 5 }
    unsafe { pair.0 + pair.1 }
}

fn nested_pointer_field_access(holder: Holder) -> u256 {
    unsafe { holder.data.value = 17 }
    unsafe { holder.data.other = holder.data.value + 2 }
    unsafe { holder.data.value + holder.data.other }
}

fn mem_array_allocation() -> u256 {
    var array = unsafe { core::ptr::alloc_array<u256>(2) }
    array[0] = 3
    array[1] = 5

    let zeroed = core::ptr::MemArray<u256>::new_zeroed(1)
    zeroed[0] + array[0] + array[1]
}
