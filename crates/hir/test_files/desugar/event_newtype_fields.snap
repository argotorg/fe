use core::prelude::*
use std::prelude::*
use std::abi::sol::Uint160
use std::abi::sol::Int24

struct Swap {
    sender: Uint160,
    tick: Int24,
    amount: u256,
}

impl std::evm::Event for Swap {
    const TOPIC0: u256 = core::keccak(("Swap", "(", <Uint160 as std::abi::SolCompat>::SOL_TYPE, ",", <Int24 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ")"))

    #[inline(always)]
    fn emit<L: Log>(own self, _ log: mut L) {
        var size = DataSize { head: 0, payload: 0 }
        {
            ()
            size.add(self.tick)
            size.add(self.amount)
            ()
        }
        let head = size.head
        let total = head + size.payload
        let buffer = MemBuffer::new(allocation_len(total))
        let out = unsafe {
            AbiFrame::from_raw_parts(ptr: buffer.ptr(), len: total)
        }
        var writer = RecordWriter<Sol>::new(out, head_size: head, fields: 2 as usize)
        {
            ()
            writer.push(self.tick)
            writer.push(self.amount)
            ()
        }
        let data = buffer.span()
        log.log2(data: data, topic0: Self::TOPIC0, topic1: self.sender.as_topic())
    }
}
