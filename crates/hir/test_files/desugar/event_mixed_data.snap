use core::prelude::*
use std::prelude::*
use std::evm::Address

struct Mixed {
    from: Address,
    flag: bool,
    value: i128,
}

impl std::evm::Event for Mixed {
    const TOPIC0: u256 = core::keccak(("Mixed", "(", <Address as std::abi::SolCompat>::SOL_TYPE, ",", <bool as std::abi::SolCompat>::SOL_TYPE, ",", <i128 as std::abi::SolCompat>::SOL_TYPE, ")"))

    #[inline(always)]
    fn emit<L: Log>(own self, _ log: mut L) {
        let head = 0 as u256 + abi_field_head_size<bool>() + abi_field_head_size<i128>()
        let total = head + 0 as u256 + dynamic_payload_size<bool>(self.flag) + dynamic_payload_size<i128>(self.value)
        let buffer = MemBuffer::new(allocation_len(total))
        let out = unsafe {
            AbiFrame::from_raw_parts(ptr: buffer.ptr(), len: total)
        }
        var writer = RecordWriter<Sol>::new(out, head_size: head, fields: 2 as usize)
        {
            {
                ()
                push_record_field(mut writer, self.flag)
            }
            push_record_field(mut writer, self.value)
        }
        let data = buffer.span()
        log.log2(data: data, topic0: Self::TOPIC0, topic1: self.from.as_topic())
    }
}
