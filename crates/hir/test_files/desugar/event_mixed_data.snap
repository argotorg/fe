use core::prelude::*
use std::prelude::*
use std::evm::Address

struct Mixed {
    from: Address,
    flag: bool,
    value: i128,
}

impl std::evm::Event for Mixed {
    const TOPIC0: u256 = core::keccak(("Mixed", "(", <Address as std::abi::SolCompat>::SOL_TYPE, ",", <bool as std::abi::SolCompat>::SOL_TYPE, ",", <i128 as std::abi::SolCompat>::SOL_TYPE, ")"))

    #[inline(always)]
    #[arithmetic(unchecked)]
    fn emit<L: std::evm::Log>(own self, _ log: mut L) {
        let __field_0 = self.flag
        let __field_1 = self.value
        let __data = core::ptr::MemBuffer::alloc(<Self as core::abi::AbiRecord<2> >::LAYOUT.head_size + core::abi::dynamic_payload_size(__field_0) + core::abi::dynamic_payload_size(__field_1))
        let __ptr = __data.ptr()
        let mut __tail = <Self as core::abi::AbiRecord<2> >::LAYOUT.head_size
        __tail = core::abi::encode_field_at<std::abi::Sol, bool>(__field_0, __ptr, head_pos: <Self as core::abi::AbiRecord<2> >::LAYOUT.offsets[0], tail: __tail)
        core::abi::encode_field_at<std::abi::Sol, i128>(__field_1, __ptr, head_pos: <Self as core::abi::AbiRecord<2> >::LAYOUT.offsets[1], tail: __tail)
        log.log2(data: __data.span(), topic0: Self::TOPIC0, topic1: self.from.as_topic())
    }
}

impl core::abi::AbiRecord<2> for Mixed {
    const LAYOUT: core::abi::AbiRecordLayout<2> = core::abi::abi_record_layout<2>([core::abi::abi_field_head_size<bool>(), core::abi::abi_field_head_size<i128>()])
}
