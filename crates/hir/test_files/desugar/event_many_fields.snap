use core::prelude::*
use std::prelude::*
use std::evm::Address

pub struct ManyFields {
    pub who: Address,
    pub f0: u256,
    pub f1: u256,
    pub f2: u256,
    pub f3: u256,
    pub f4: u256,
    pub f5: u256,
    pub f6: u256,
    pub f7: u256,
    pub f8: u256,
    pub f9: u256,
    pub f10: u256,
    pub f11: u256,
}

impl std::evm::Event for ManyFields {
    const TOPIC0: u256 = core::keccak((("ManyFields", "(", <Address as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ","), (<u256 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ")")))

    #[inline(always)]
    fn emit<L: Log>(own self, _ log: mut L) {
        var size = DataSize { head: 0, payload: 0 }
        {
            ()
            size.add(self.f0)
            size.add(self.f1)
            size.add(self.f2)
            size.add(self.f3)
            size.add(self.f4)
            size.add(self.f5)
            size.add(self.f6)
            size.add(self.f7)
            size.add(self.f8)
            size.add(self.f9)
            size.add(self.f10)
            size.add(self.f11)
            ()
        }
        let head = size.head
        let total = head + size.payload
        let buffer = MemBuffer::new(allocation_len(total))
        let out = unsafe {
            AbiFrame::from_raw_parts(ptr: buffer.ptr(), len: total)
        }
        var writer = RecordWriter<Sol>::new(out, head_size: head, fields: 12 as usize)
        {
            ()
            writer.push(self.f0)
            writer.push(self.f1)
            writer.push(self.f2)
            writer.push(self.f3)
            writer.push(self.f4)
            writer.push(self.f5)
            writer.push(self.f6)
            writer.push(self.f7)
            writer.push(self.f8)
            writer.push(self.f9)
            writer.push(self.f10)
            writer.push(self.f11)
            ()
        }
        let data = buffer.span()
        log.log2(data: data, topic0: Self::TOPIC0, topic1: self.who.as_topic())
    }
}
