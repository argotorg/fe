use core::prelude::*
use std::prelude::*
use std::evm::Address

pub struct Transfer {
    pub from: Address,
    pub to: Address,
    pub amount: u256,
}

impl std::evm::Event for Transfer {
    const TOPIC0: u256 = core::keccak(("Transfer", "(", <Address as std::abi::SolCompat>::SOL_TYPE, ",", <Address as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ")"))

    #[inline(always)]
    fn emit<L: Log>(own self, _ log: mut L) {
        let head = 0 as u256 + abi_field_head_size<u256>()
        let total = head + 0 as u256 + dynamic_payload_size<u256>(self.amount)
        let buffer = MemBuffer::new(allocation_len(total))
        let out = unsafe {
            AbiFrame::from_raw_parts(ptr: buffer.ptr(), len: total)
        }
        var head_pos: u256 = 0
        var tails = out.tail(head)
        {
            ()
            tails = encode_field<Sol, u256>(self.amount, out, head_pos: head_pos, tails: tails)
            head_pos = head_pos + abi_field_head_size<u256>()
        }
        let data = buffer.span()
        log.log3(data: data, topic0: Self::TOPIC0, topic1: self.from.as_topic(), topic2: self.to.as_topic())
    }
}
