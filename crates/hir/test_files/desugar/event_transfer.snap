    pub from: Address,
    pub to: Address,
    pub amount: u256,
}

impl std::evm::Event for Transfer {
    const TOPIC0: u256 = core::keccak(("Transfer", "(", <Address as std::abi::SolCompat>::SOL_TYPE, ",", <Address as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ")"))

    #[inline(always)]
    #[arithmetic(unchecked)]
    fn emit<L: std::evm::Log>(own self, _ log: mut L) {
        let __field_0 = self.amount
        let __data = core::ptr::MemBuffer::alloc(<Self as core::abi::AbiRecord<1> >::LAYOUT.head_size + core::abi::dynamic_payload_size(__field_0))
        let __ptr = __data.ptr()
        let mut __tail = <Self as core::abi::AbiRecord<1> >::LAYOUT.head_size
        core::abi::encode_field_at<std::abi::Sol, u256>(__field_0, __ptr, head_pos: <Self as core::abi::AbiRecord<1> >::LAYOUT.offsets[0], tail: __tail)
        log.log3(data: __data.span(), topic0: Self::TOPIC0, topic1: self.from.as_topic(), topic2: self.to.as_topic())
    }
}

impl core::abi::AbiRecord<1> for Transfer {
    const LAYOUT: core::abi::AbiRecordLayout<1> = core::abi::abi_record_layout<1>([core::abi::abi_field_head_size<u256>()])
