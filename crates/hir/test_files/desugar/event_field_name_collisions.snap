    #[inline(always)]
    #[arithmetic(unchecked)]
    fn emit<L: std::evm::Log>(own self, _ log: mut L) {
        let __field_0 = self.data_len
        let __field_1 = self.data_ptr
        let __data = core::ptr::MemBuffer::alloc(<Self as core::abi::AbiRecord<2> >::LAYOUT.head_size + core::abi::dynamic_payload_size(__field_0) + core::abi::dynamic_payload_size(__field_1))
        let __ptr = __data.ptr()
        let mut __tail = <Self as core::abi::AbiRecord<2> >::LAYOUT.head_size
        __tail = core::abi::encode_field_at<std::abi::Sol, u256>(__field_0, __ptr, head_pos: <Self as core::abi::AbiRecord<2> >::LAYOUT.offsets[0], tail: __tail)
        core::abi::encode_field_at<std::abi::Sol, u256>(__field_1, __ptr, head_pos: <Self as core::abi::AbiRecord<2> >::LAYOUT.offsets[1], tail: __tail)
        log.log3(data: __data.span(), topic0: Self::TOPIC0, topic1: self.log.as_topic(), topic2: self.enc.as_topic())
    }
}

impl core::abi::AbiRecord<2> for Collision {
    const LAYOUT: core::abi::AbiRecordLayout<2> = core::abi::abi_record_layout<2>([core::abi::abi_field_head_size<u256>(), core::abi::abi_field_head_size<u256>()])
