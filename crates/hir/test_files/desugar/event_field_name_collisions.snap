use core::prelude::*
use std::prelude::*

struct Collision {
    log: u256,
    enc: u256,
    data_len: u256,
    data_ptr: u256,
}

impl std::evm::Event for Collision {
    const TOPIC0: u256 = core::keccak(("Collision", "(", <u256 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ")"))

    #[inline(always)]
    fn emit<L: Log>(own self, _ log: mut L) {
        let head = 0 as u256 + abi_field_head_size<u256>() + abi_field_head_size<u256>()
        let total = head + 0 as u256 + dynamic_payload_size<u256>(self.data_len) + dynamic_payload_size<u256>(self.data_ptr)
        let buffer = MemBuffer::new(allocation_len(total))
        let out = unsafe {
            AbiFrame::from_raw_parts(ptr: buffer.ptr(), len: total)
        }
        var writer = RecordWriter<Sol>::new(out, head_size: head, fields: 2 as usize)
        {
            {
                ()
                push_record_field(mut writer, self.data_len)
            }
            push_record_field(mut writer, self.data_ptr)
        }
        let data = buffer.span()
        log.log3(data: data, topic0: Self::TOPIC0, topic1: self.log.as_topic(), topic2: self.enc.as_topic())
    }
}
