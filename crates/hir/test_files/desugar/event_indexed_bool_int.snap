use core::prelude::*
use std::prelude::*

struct Flags {
    ok: bool,
    delta: i8,
    value: u256,
}

impl std::evm::Event for Flags {
    const TOPIC0: u256 = core::keccak(("Flags", "(", <bool as std::abi::SolCompat>::SOL_TYPE, ",", <i8 as std::abi::SolCompat>::SOL_TYPE, ",", <u256 as std::abi::SolCompat>::SOL_TYPE, ")"))

    #[inline(always)]
    fn emit<L: Log>(own self, _ log: mut L) {
        var size = DataSize { head: 0, payload: 0 }
        {
            ()
            ()
            size.add(self.value)
            ()
        }
        let head = size.head
        let total = head + size.payload
        let buffer = MemBuffer::new(allocation_len(total))
        let out = unsafe {
            AbiFrame::from_raw_parts(ptr: buffer.ptr(), len: total)
        }
        var writer = RecordWriter<Sol>::new(out, head_size: head, fields: 1 as usize)
        {
            ()
            ()
            writer.push(self.value)
            ()
        }
        let data = buffer.span()
        log.log3(data: data, topic0: Self::TOPIC0, topic1: self.ok.as_topic(), topic2: self.delta.as_topic())
    }
}
