use core::prelude::*
use std::prelude::*
use std::abi::Bytes

mod InnerMsg {
    use core::prelude::*
    use std::prelude::*
    use super::*

    pub struct Inner {
        pub marker: u256,
        pub data: Bytes,
    }

    impl core::message::MsgVariant<std::abi::Sol> for Inner {
        type Return = ()
        const SELECTOR: u32 = 1
    }

    impl std::abi::AbiFields for Inner {
    }

    impl core::abi::AbiSize for Inner {
        const HEAD_SIZE: u256 = <((u256), (Bytes)) as HeadsBefore>::SIZE
        const IS_DYNAMIC: bool = <((u256), (Bytes)) as HasDynamicFields>::IS_DYNAMIC

        #[inline(always)]
        fn payload_size(self) -> u256 {
            var size = PayloadSize { bytes: <Self as AbiSize>::HEAD_SIZE }
            {
                size.add(self.marker)
                size.add(self.data)
                ()
            }
            size.bytes
        }
    }

    impl core::abi::Encode<std::abi::Sol> for Inner {

        #[inline(always)]
        fn encode(self, _ out: AbiFrame) {
            var writer: RecordWriter<Sol> = RecordWriter { out: out.tail(0), tails: out.tail(<Self as AbiSize>::HEAD_SIZE), head: 0, remaining: 2 as usize }
            {
                writer.push(self.marker)
                writer.push(self.data)
                ()
            }
        }
    }

    impl core::abi::Decode<std::abi::Sol> for Inner {
        const CHECKS_HEAD_FRAME: bool = true

        #[inline(always)]
        fn decode_payload<D: AbiDecoder<Sol>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
            Inner { marker: d.read_record_field(input), data: d.read_record_field(input) }
        }

        #[inline(always)]
        fn decode_from_prechecked_head<I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> Self {
            var reader: PrecheckedRecordDecoder<Sol> = PrecheckedRecordDecoder { base: pos, head: pos, input_len }
            <Self as Decode<Sol> >::decode_payload(mut reader, input)
        }
    }
}

mod OuterMsg {
