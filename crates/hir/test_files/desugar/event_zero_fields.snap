use core::prelude::*
use std::prelude::*

struct Paused {}

impl std::evm::Event for Paused {
    const TOPIC0: u256 = core::keccak(("Paused", "(", ")"))

    #[inline(always)]
    fn emit<L: std::evm::Log>(own self, _ log: mut L) {
        log.log1(data: core::ptr::MemBuffer::empty().span(), topic0: Self::TOPIC0)
    }
}
