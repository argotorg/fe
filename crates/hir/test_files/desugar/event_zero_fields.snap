use core::prelude::*
use std::prelude::*

struct Paused {}

impl std::evm::Event for Paused {
    const TOPIC0: u256 = core::keccak(("Paused", "(", ")"))

    #[inline(always)]
    fn emit<L: Log>(own self, _ log: mut L) {
        let buffer = MemBuffer::empty()
        let data = buffer.span()
        log.log1(data: data, topic0: Self::TOPIC0)
    }
}
