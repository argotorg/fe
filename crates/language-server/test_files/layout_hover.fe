use std::evm::{StorageMap, TSlot}

struct CounterStore {
  global: u256,
  counts: StorageMap<u256, u256>,
}

pub contract <|contract|>Counter {
  mut <|store|>store: CounterStore,
  mut foo: u256,
  mut <|explicit|>baz: StorageMap<u256, u256>,
}

pub contract <|spaces|>Spaces {
  mut stored: u256,
  mut temporary: TSlot<u256>,
  <|immutable|>immutable: u256,
}

pub contract Arrays {
  mut <|array|>values: [u256; 3],
}

struct Empty {}
pub contract ZeroSized {
  mut <|empty|>empty: Empty,
}

pub contract Broken {
  mut <|blocked|>good: u256,
  <|invalid|>bad: [u256; 576460752303423488],
}

struct Flags {
  active: bool,
  level: u8,
  owner_id: u64,
  balance: u256,
}

pub contract Packed {
  mut <|packed|>flags: Flags,
}
