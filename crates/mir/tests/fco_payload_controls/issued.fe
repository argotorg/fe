use core::obligations::{Constraint, Evidence, prove}
trait Produce { type Output }
struct Subject {}
impl Produce for Subject { type Output = u64 }
const fn forward<G: Constraint>(_ witness: Evidence<G>) -> Evidence<G> { witness }
const fn first() -> Evidence<Produce<Subject, Output = u64>> {
    prove<Produce<Subject, Output = u64>>()
}
const fn second() -> Evidence<Produce<Subject, Output = u64>> {
    prove<Produce<Subject, Output = u64>>()
}
const fn forwarded() -> Evidence<Produce<Subject, Output = u64>> {
    forward<Produce<Subject, Output = u64>>(first())
}
