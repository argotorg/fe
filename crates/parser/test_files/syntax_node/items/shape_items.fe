trait Driver {
    type Base
    shape Step

    fn at(self, _ base: Self::Base) -> Self::Step<ref>
}

impl<B> Driver for Identity<B> {
    type Base = B
    shape Step = mut? B::Item
}

impl<D: Driver> Driver for Enumerate<D> {
    type Base = D::Base
    shape Step = (own usize, D::Step)
}

fn first<D: Driver, P: Fn(D::Step<ref>) -> bool>(_ d: D, _ p: P) {}

fn sum<D: Driver<Base = [u256; 3], Step<ref> = ref u256, Step<mut> = mut u256>>(_ d: D) {}
