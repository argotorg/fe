trait Read {
    unsafe fn read(self) -> u256
    unsafe const fn zero() -> u256
    fn len(self) -> u256
    unsafe fn bounded<T>(t: T) where T: Copy
    unsafe fn with_default(self) {}
}

impl Read for Ptr {
    unsafe fn read(self) -> u256 {
        unsafe { *self.p }
    }
}

extern {
    fn bound<T>(t: T) where T: Copy
    unsafe fn ext()
}
