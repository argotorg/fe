const fn set(value: mut usize) { value = 42 }

// A ground predicate block is evaluated at its declaration. It passes a
// local by mutable borrow to a const fn.
const fn ground() -> u256 where {
    var x: usize = 0
    set(value: mut x)
    x == 42
} { 1 }

// A generic one is evaluated at each concrete use, here through a mutable
// alias of a local.
const fn bounded<const N: usize>() -> u256 where {
    var x: usize = N
    let a = mut x
    a = a + 1
    x > 1
} { 2 }

const fn answer() -> u256 { ground() + bounded<1>() }
