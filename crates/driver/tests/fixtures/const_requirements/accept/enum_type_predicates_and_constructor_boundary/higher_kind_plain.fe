trait Flag { const ALLOWED: bool }
struct Yes {}
struct No {}
impl Flag for Yes { const ALLOWED: bool = true }
impl Flag for No { const ALLOWED: bool = false }
enum Choice<T: Flag>  { Empty }
const fn hidden<F: * -> *>() -> u256 { let unused: F<No>
 42 }
const fn answer() -> u256 { hidden<Choice>() }
