struct Window<const N: usize> { value: u256 }
impl<const N: usize> Window<N> { const fn make() -> Self where N > 0 { Self { value: 42 } }
const fn read(self) -> u256 where N > 0 { self.value }
const fn take<const M: usize>(self) -> u256 where N > 0, M > N { self.value } }
const fn forward<const A: usize, const B: usize>() -> u256 where A > 0, B > A { Window<A> { value: 42 }.take<B>() }
const fn answer() -> u256 { forward<1, 2>() }
