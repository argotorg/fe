const fn length<const K: usize>() -> usize where K > 0 { 0 }
struct Window<const N: usize> {}
impl<const N: usize> Window<N> { const fn read<const M: usize>(self, _ a: [u8; { length<N>() }], _ b: [u8; { length<M>() }]) -> u256 where N > 0, M > 0 { 42 } }
const fn answer() -> u256 { Window<1> {}.read<2>([], []) }
