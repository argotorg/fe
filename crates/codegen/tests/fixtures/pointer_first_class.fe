struct Data {
    a: u256,
    b: u256,
}

struct Holder {
    data: *Data,
}

pub fn sum_first_class_pointers() -> u256 {
    let data = core::ptr::alloc<Data>()
    unsafe { data.a = 5 }
    unsafe { data.b = 8 }

    let words = core::ptr::cast<Data, u256>(data)
    let second = core::ptr::offset(words, 1)
    unsafe { *second = *second + 3 }
    let field_sum = unsafe { data.a + data.b }

    let holder = Holder { data: data }
    unsafe { holder.data.b = holder.data.a + holder.data.b }
    let nested_sum = unsafe { holder.data.a + holder.data.b }

    let byte_ptr = core::ptr::byte_ptr(data)
    let roundtrip = core::ptr::cast<u8, Data>(byte_ptr)
    let first = unsafe { *roundtrip }

    var raw_array = unsafe { core::ptr::alloc_array<u256>(1) }
    raw_array[0] = 3

    let byte_alloc = core::ptr::alloc_bytes(1)
    let byte_distance = 0

    var array = unsafe { core::ptr::alloc_array<u256>(2) }
    array[0] = first.a
    array[1] = first.b
    let array_sum = array[0] + array[1]

    let bytes = array.into_bytes()
    let ptr_distance = 32
    var zeroed = core::ptr::MemArray<u256>::new_zeroed(1)
    zeroed[0] = 7
    zeroed.zero()
    let pair = core::ptr::alloc<[u256; 2]>()
    unsafe { (*pair)[0] = 13 }
    unsafe { (*pair)[1] = 21 }
    let pair_words = core::ptr::cast<u8, u256>(core::ptr::byte_ptr(pair))
    array_sum
        + raw_array[0]
        + zeroed[0]
        + bytes.len() as u256
        + ptr_distance
        + byte_distance
        + field_sum
        + nested_sum
        + unsafe { (*pair)[0] }
        + unsafe { (*pair)[1] }
        + unsafe { *pair_words }
}
