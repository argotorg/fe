struct Data {
    x: u256,
    y: u256,
}

fn live_view(_ d: Data) -> (ref u256, ref u256) {
    (ref d.x, ref d.y)
}

#[test]
fn test_ref_is_not_a_copy() {
    let d = Data { x: 10, y: 20 }
    let (ref live_x, ref live_y) = live_view(d)
    assert!(live_x == d.x)
    assert!(live_y == d.y)
}

pub fn main() {
    test_ref_is_not_a_copy()
}
