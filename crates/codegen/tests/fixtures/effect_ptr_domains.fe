use core::ptr
use std::evm::{RawStorage, StorPtr}

struct Foo {
    a: u256,
    b: u256,
}

fn bump() uses (foo: mut Foo) {
    foo.a = foo.a + 1
    foo.b = foo.b + 2
}

pub fn main() uses (st: mut RawStorage) {
    let mp = ptr::alloc<Foo>()
    unsafe {
        with (mut *mp) {
            bump()
        }
    }

    let sp = 0 as u256 as StorPtr<Foo>
    unsafe {
        with (mut *sp) {
            bump()
        }
    }

    var foo = Foo { a: 10, b: 20 }
    with (foo) {
        bump()
    }
}
