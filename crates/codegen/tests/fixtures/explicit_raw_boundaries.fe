use core::ptr
use core::abi::store_word
use std::evm::RawStorage

struct Data {
    value: u256,
}

fn bump() uses (value: mut u256) {
    value += 1
}

fn raw_store() uses (data: *Data, storage: mut RawStorage) {
    unsafe {
        store_word(ptr: ptr::byte_ptr(data), value: 8)
        storage.sstore(slot: 0, value: 8)
    }
}

pub fn main() uses (storage: mut RawStorage) {
    let value_ptr = ptr::alloc<u256>()
    unsafe {
        with (mut *value_ptr) {
            bump()
        }
    }

    let data = ptr::alloc<Data>()
    unsafe {
        with (data, storage) {
            raw_store()
        }
    }
}
