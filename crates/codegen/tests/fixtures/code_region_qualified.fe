use core::ptr
use std::evm::Evm

#[contract_init(Foo)]
fn init() uses (evm: mut Evm) {
    let len = evm.code_region_len(self::runtime)
    let offset = evm.code_region_offset(self::runtime)
    var dest = ptr::MemBuffer::alloc(len as usize)
    evm.codecopy(
        dest: mut dest,
        dest_offset: 0,
        src_offset: offset,
        len,
    )
    evm.return_data(data: dest.span())
}

#[contract_runtime(Foo)]
fn runtime() uses (evm: mut Evm) {
    evm.return_data(data: ptr::MemSpan::empty())
}
