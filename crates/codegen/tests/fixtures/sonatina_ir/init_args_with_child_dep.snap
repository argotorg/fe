func private %set_pos(v0.objref<@layout_0>, v1.i256) {
    block0:
        jump block1;

    block1:
        v5.objref<i256> = obj.proj v0 1.i256;
        obj.store v5 v1;
        return;
}

func private %store_word(v0.i256, v1.i256) {
    block0:
        jump block1;

    block1:
        mstore v0 v1 i256;
        return;
}

func private %word_at(v0.objref<@layout_0>, v1.i256) -> i256 {
    block0:
        jump block1;

    block1:
        v4.objref<i256> = obj.proj v0 0.i256;
        v5.i256 = obj.load v4;
        v7.i256 = add v5 v1;
        v8.i256 = mload v7 i256;
        return v8;
}


object @Child {
    section init {
        entry %contract_init_root_Child;
        embed .runtime as &Child_runtime;
    }
    section runtime {
        entry %contract_runtime_root_Child;
    }
}

object @Parent {
    section init {
        entry %contract_init_root_Parent;
        embed @Child.init as &Child_init;
        embed .runtime as &Parent_runtime;
    }
    section runtime {
        entry %contract_runtime_root_Parent;
    }
}
