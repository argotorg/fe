        v28.i1 = eq v27 20.i256;
        br v28 block5 block6;

    block5:
        jump block7;

    block6:
        v29.*i8 = evm_malloc 64.i256;
        v30.i256 = ptr_to_int v29 i256;
        mstore v30 35408467139433450592217433187231851964531694900788300625387963629091585785856.i256 i256;
        (v32.i256, v33.i1) = uaddo v30 32.i256;
        br v33 block8 block10;

    block7:
