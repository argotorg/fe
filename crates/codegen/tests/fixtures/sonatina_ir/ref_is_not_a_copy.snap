func private %test_ref_is_not_a_copy() {
    block0:
        v0.objref<@layout_1> = obj.alloc @layout_1;
        jump block1;

    block1:
        v3.constref<@layout_0> = const.ref $const_region_0;
        v4.constref<@layout_0> = const.ref $const_region_0;
        jump block9;

    block2:
        jump block4;

    block3:
        jump block11;

    block4:
        v6.i256 = const.load v15;
        v7.i1 = eq v6 20.i256;
        jump block13;

    block5:
        jump block7;

    block6:
        mstore 0.i256 35408467139433450592217433187231851964531694900788300625387963629091585785856.i256 i256;
        mstore 4.i256 1.i256 i256;
        evm_revert 0.i256 36.i256;

    block7:
        return;

    block8:
        obj.store v0 v23;
        v14.constref<i256> = extract_value v23 0.i256;
        v15.constref<i256> = extract_value v23 1.i256;
        v16.i256 = const.load v14;
        v17.i1 = eq v16 10.i256;
        br v17 block2 block3;

    block9:
        v19.constref<i256> = const.proj v4 0.i256;
        v20.constref<i256> = const.proj v4 1.i256;
        v22.@layout_1 = insert_value undef.@layout_1 0.i256 v19;
        v23.@layout_1 = insert_value v22 1.i256 v20;
        jump block8;

    block10:
        mstore 0.i256 35408467139433450592217433187231851964531694900788300625387963629091585785856.i256 i256;
        mstore 4.i256 1.i256 i256;
        evm_revert 0.i256 36.i256;

    block11:
        jump block10;

    block12:
        br v7 block5 block6;

    block13:
        jump block12;
}


