type @layout_0 = {i256, i256};
type @layout_1 = {constref<i256>, constref<i256>};

global private const @layout_0 $const_region_0 = {10, 20};

func private %main() {
    block0:
        jump block1;

    block1:
        call %test_ref_is_not_a_copy;
        return;
}

func private %main_root() {
    block0:
        jump block1;

