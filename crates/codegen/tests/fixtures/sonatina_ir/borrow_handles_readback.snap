---
source: crates/codegen/tests/sonatina_ir.rs
expression: output
input_file: crates/codegen/tests/fixtures/borrow_handles_readback.fe
---
target = "evm-ethereum-osaka"

func private %borrow_handles_readback() -> i256 {
    block0:
        v0.objref<i256> = obj.alloc i256;
        jump block1;

    block1:
        obj.store v0 0.i256;
        obj.store v0 5.i256;
        v3.i256 = obj.load v0;
        return v3;
}

func private %main_root() {
    block0:
        jump block1;

    block1:
        v0.i256 = call %borrow_handles_readback;
        evm_stop;
}


object @main {
    section main {
        entry %main_root;
    }
}
