        v10.i256 = sub v0 v1;
        v11.i256 = call %from_word v10;
        v13.i256 = call %from_word v2;
        obj.store v3 v13;
        v14.i1 = slt v11 v13;
        br v14 block5 block6;

    block3:
        jump block4;

    block4:
        return;

    block5:
        evm_revert 0.i256 0.i256;

    block6:
        jump block7;

    block7:
        jump block4;
}


object @C {
    section init {
        entry %contract_init_root_C;
        embed .runtime as &C_runtime;
    }
    section runtime {
        entry %contract_runtime_root_C;
        data $const_region_0;
    }
}
