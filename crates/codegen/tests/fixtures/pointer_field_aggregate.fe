use core::ptr

struct Holder {
    ptr: *u256,
    value: u256,
}

fn bump() uses (value: mut u256) {
    value += 1
}

pub fn main() {
    var holder = Holder { ptr: ptr::alloc<u256>(), value: 1 }
    let first = holder.ptr
    unsafe {
        with (mut *first) {
            bump()
        }
    }

    holder.ptr = ptr::alloc<u256>()
    let second = holder.ptr
    unsafe {
        with (mut *second) {
            bump()
        }
    }
}
