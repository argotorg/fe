use std::evm::{Address, Evm, Log}

#[event]
struct Transfer {
    #[indexed]
    from: Address,
    #[indexed]
    to: Address,
    amount: u256,
}

fn emit_transfer(evm: mut Evm, from: Address, to: Address, amount: u256) {
    evm.emit(Transfer { from, to, amount })
}

pub fn main() uses (evm: mut Evm) {
    emit_transfer(
        evm: mut evm,
        from: Address { inner: 1 },
        to: Address { inner: 2 },
        amount: 100,
    )
}
