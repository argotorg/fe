use core::ptr
use core::abi::{load_word, store_word}
use std::evm::{RawOps, RawStorage}

pub fn load_word(ptr: *u8) -> u256 {
    unsafe { load_word(ptr) }
}

pub fn store_word(ptr: *u8, value: u256) {
    unsafe { store_word(ptr: ptr, value: value) }
}

pub fn store_byte(ptr: *u8, value: u8) {
    unsafe { *ptr = value }
}

pub fn load_slot(slot: u256) -> u256 uses (sto: RawStorage) {
    unsafe { sto.sload(slot) }
}

pub fn store_slot(slot: u256, value: u256) uses (sto: mut RawStorage) {
    unsafe { sto.sstore(slot: slot, value: value) }
}

pub fn load_calldata(offset: u256) -> u256 uses (ops: RawOps) {
    ops.calldataload(offset)
}

pub fn finish(data: *u8, len: u256) uses (ops: RawOps) {
    unsafe { ops.return_data(data: ptr::MemSpan::from_raw_parts(ptr: data, len: len.downcast_unchecked())) }
}

pub fn main() -> u256
    uses (sto: mut RawStorage, ops: RawOps)
{
    let data = ptr::alloc_bytes(32)
    store_word(ptr: data, value: 1)
    store_byte(ptr: ptr::offset_bytes(data, 1), value: 2)
    store_slot(slot: 3, value: 4)
    load_word(ptr: data) + load_slot(slot: 3) + load_calldata(offset: 0)
}
