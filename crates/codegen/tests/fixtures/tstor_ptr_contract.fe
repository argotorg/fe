use std::evm::TSlot

msg GuardMsg {
    #[selector = 1]
    Flip -> bool
}

pub contract GuardContract {
    mut call_count: u256,
    mut block_reentrance: TSlot<bool>,

    init() uses (mut block_reentrance) {
        block_reentrance.value = false
    }

    recv GuardMsg {
        Flip -> bool uses (mut block_reentrance, mut call_count) {
            call_count += 1
            let old = block_reentrance.value
            block_reentrance.value = !old
            old
        }
    }
}
