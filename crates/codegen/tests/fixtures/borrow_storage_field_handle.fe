use std::evm::{RawStorage, StorPtr}

struct CoinStore {
    alice: u256,
}

fn borrow_storage_field_handle() -> u256
    uses (store: mut CoinStore)
{
    let p = mut store.alice
    p += 1
    store.alice
}

pub fn main() -> u256
    uses (sto: mut RawStorage)
{
    let store = 0 as u256 as StorPtr<CoinStore>
    unsafe {
        with (mut *store) {
            borrow_storage_field_handle()
        }
    }
}
