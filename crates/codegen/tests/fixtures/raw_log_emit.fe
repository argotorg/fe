use core::ptr
use std::evm::{Evm, Log}

struct Data {
    a: u256,
}

fn raw_emit(evm: mut Evm) {
    let data = ptr::alloc<Data>()
    unsafe {
        evm.log0(data: ptr::MemSpan::from_raw_parts(
            ptr: ptr::byte_ptr(data),
            len: core::size_of<Data>() as usize,
        ))
    }
}

pub fn main() uses (evm: mut Evm) {
    raw_emit(mut evm)
}
