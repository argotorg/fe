//! Sorting and searching for any collection indexed by position, after
//! Solady's `LibSort`.
//!
//! Solady has one copy of each routine per element type (`uint256[]`,
//! `address[]`, `int256[]` through casts and sign-bit flips). Here every
//! function is generic over both the container and the element: the same
//! `sort` orders a fixed array, a `MemSlice`, a `MemArray` or a `MemVec`
//! of integers, signed integers, addresses or any type that
//! implements `Ord`. A container takes part through `Index<usize>` (and
//! `mut Index<usize>` to reorder) and `Len`.
//!
//! ```fe
//! use core::sort::{dedup_sorted, sort}
//!
//! var ids: [u256; 5] = [7, 3, 7, 1, 3]
//! sort(mut ids)                     // [1, 3, 3, 7, 7]
//! let unique = dedup_sorted(mut ids) // 3; ids starts with [1, 3, 7]
//! ```
//!
//! `sort` uses insertion sort for up to 16 elements and heapsort above, so
//! its cost is `O(n log n)` for every input, including inputs an attacker
//! arranges to slow down a quicksort. It is not stable.
//!
//! The functions copy elements, so they need `Copy`. A `MemSlice`,
//! `MemArray` or `MemVec` of any `Ord` type, such as text or buffers, sorts
//! by swapping its elements in place, with the same algorithm:
//!
//! ```fe
//! var words: MemVec<DynString> = MemVec::new()
//! words.push("pear")
//! words.push("apple")
//! words.sort()                      // ["apple", "pear"]
//! ```
use super::marker::Copy
use super::ops::{Eq, Index, Len, Ord}
use super::option::Option
use super::ptr::{MemArray, MemSlice, MemVec}

const INSERTION_SORT_MAX_LEN: usize = 16

/// Sorts `seq` in ascending order.
pub fn sort<S: mut Index<usize> + Len>(_ seq: mut S) uses S::E
    where S::Output: Ord + Copy
{
    if seq.len() <= INSERTION_SORT_MAX_LEN {
        insertion_sort(mut seq)
    } else {
        heap_sort(mut seq)
    }
}

/// Sorts `seq` in ascending order by insertion: `O(n^2)` comparisons but
/// cheap for short or nearly sorted sequences. Stable.
pub fn insertion_sort<S: mut Index<usize> + Len>(_ seq: mut S) uses S::E
    where S::Output: Ord + Copy
{
    let n = seq.len()
    var i: usize = 1
    while i < n {
        let key = seq[i]
        var j = i
        while j > 0 && key.lt(seq[j - 1]) {
            seq[j] = seq[j - 1]
            j -= 1
        }
        seq[j] = key
        i += 1
    }
}

/// Sorts `seq` in ascending order with heapsort: `O(n log n)` for every
/// input and no extra memory. Not stable.
pub fn heap_sort<S: mut Index<usize> + Len>(_ seq: mut S) uses S::E
    where S::Output: Ord + Copy
{
    let n = seq.len()
    if n < 2 { return }
    // Build a max-heap.
    var start = n / 2
    while start > 0 {
        start -= 1
        sift_down(mut seq, start, end: n)
    }
    // Move the maximum to the end and restore the heap on the rest.
    var end = n - 1
    while end > 0 {
        swap(mut seq, 0, end)
        sift_down(mut seq, 0, end)
        end -= 1
    }
}

// Moves the element at `root` down until the max-heap property holds for
// the first `end` elements.
fn sift_down<S: mut Index<usize>>(_ seq: mut S, _ root: usize, end: usize) uses S::E
    where S::Output: Ord + Copy
{
    var parent = root
    let value = seq[parent]
    while true {
        var child = 2 * parent + 1
        if child >= end { break }
        if child + 1 < end && seq[child].lt(seq[child + 1]) {
            child += 1
        }
        let child_value = seq[child]
        if !value.lt(child_value) {
            break
        }
        seq[parent] = child_value
        parent = child
    }
    seq[parent] = value
}

/// Swaps the elements at `i` and `j`.
pub fn swap<S: mut Index<usize>>(_ seq: mut S, _ i: usize, _ j: usize) uses S::E
    where S::Output: Copy
{
    let a = seq[i]
    seq[i] = seq[j]
    seq[j] = a
}

/// Reverses the order of the elements.
pub fn reverse<S: mut Index<usize> + Len>(_ seq: mut S) uses S::E
    where S::Output: Copy
{
    let n = seq.len()
    var i: usize = 0
    while i < n / 2 {
        swap(mut seq, i, n - 1 - i)
        i += 1
    }
}

/// Whether every element is less than or equal to the next.
pub fn is_sorted<S: Index<usize> + Len>(_ seq: S) -> bool uses S::E
    where S::Output: Ord + Copy
{
    let n = seq.len()
    var i: usize = 1
    while i < n {
        if seq[i].lt(seq[i - 1]) {
            return false
        }
        i += 1
    }
    true
}

/// Whether every element is strictly less than the next, i.e. the sequence
/// is sorted and has no duplicates, like Solady's `isSortedAndUniquified`.
/// The usual check for signer lists.
pub fn is_sorted_unique<S: Index<usize> + Len>(_ seq: S) -> bool uses S::E
    where S::Output: Ord + Copy
{
    let n = seq.len()
    var i: usize = 1
    while i < n {
        if !seq[i - 1].lt(seq[i]) {
            return false
        }
        i += 1
    }
    true
}

/// The index of the first element of the sorted `seq` that is not less
/// than `needle`, or `seq.len()` if there is none.
pub fn lower_bound<S: Index<usize> + Len>(_ seq: S, _ needle: S::Output) -> usize uses S::E
    where S::Output: Ord + Copy
{
    var low: usize = 0
    var high = seq.len()
    while low < high {
        let mid = low + (high - low) / 2
        if seq[mid].lt(needle) {
            low = mid + 1
        } else {
            high = mid
        }
    }
    low
}

/// The index of an element equal to `needle` in the sorted `seq`, like
/// Solady's `searchSorted`. With duplicates it is the first one.
pub fn binary_search<S: Index<usize> + Len>(_ seq: S, _ needle: S::Output) -> Option<usize> uses S::E
    where S::Output: Ord + Eq + Copy
{
    let index = lower_bound(seq, needle)
    if index < seq.len() && seq[index] == needle {
        Option::Some(index)
    } else {
        Option::None
    }
}

/// Removes consecutive duplicates from the sorted `seq` by moving the
/// unique elements to the front, like Solady's `uniquifySorted`. Returns
/// how many there are; the elements after them are unspecified. A slice's
/// unique prefix is `slice.head(n)`.
pub fn dedup_sorted<S: mut Index<usize> + Len>(_ seq: mut S) -> usize uses S::E
    where S::Output: Eq + Copy
{
    let n = seq.len()
    if n == 0 { return 0 }
    var unique: usize = 1
    var i: usize = 1
    while i < n {
        let value = seq[i]
        if value != seq[unique - 1] {
            seq[unique] = value
            unique += 1
        }
        i += 1
    }
    unique
}

impl<T: Ord> MemSlice<T> {
    /// Sorts the elements in ascending order by swapping them, as `sort`
    /// does with copies. Not stable.
    pub fn sort(mut self) {
        let n = self.len()
        if n <= INSERTION_SORT_MAX_LEN {
            var i: usize = 1
            while i < n {
                var j = i
                while j > 0 && self[j].lt(self[j - 1]) {
                    self.swap(j, j - 1)
                    j -= 1
                }
                i += 1
            }
            return
        }
        var start = n / 2
        while start > 0 {
            start -= 1
            self.sift_down(start, end: n)
        }
        var end = n - 1
        while end > 0 {
            self.swap(0, end)
            self.sift_down(0, end)
            end -= 1
        }
    }

    // Swaps the element at `root` down until the max-heap property holds
    // for the first `end` elements.
    fn sift_down(mut self, _ root: usize, end: usize) {
        var parent = root
        while true {
            var child = 2 * parent + 1
            if child >= end {
                break
            }
            if child + 1 < end && self[child].lt(self[child + 1]) {
                child += 1
            }
            if !self[parent].lt(self[child]) {
                break
            }
            self.swap(parent, child)
            parent = child
        }
    }
}

impl<T: Ord> MemArray<T> {
    /// Sorts the elements in ascending order; see `MemSlice::sort`.
    pub fn sort(mut self) {
        self.as_slice().sort()
    }
}

impl<T: Ord> MemVec<T> {
    /// Sorts the elements in ascending order; see `MemSlice::sort`.
    pub fn sort(mut self) {
        self.as_slice().sort()
    }
}
