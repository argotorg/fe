impl<A: Abi, const N: usize> Decode<A> for String<N> {
    fn decode_payload<D: AbiDecoder<A>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
        let payload_at = d.pos()
        let payload = checked_dynamic_payload_with_input_len<A, I>(input, payload_at, input.len())
        decode_string_payload_after_head<A, I, N>(input, payload_at, payload.0)
    }

    #[inline(always)]
    fn decode_from<I: ByteInput>(_ input: I, _ pos: u256) -> Self {
        let input_len = input.len()
        Self::decode_from_bounded(input, pos, input_len)
    }

    #[inline(always)]
    fn decode_from_prechecked_head<I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> Self {
        let payload = checked_dynamic_payload_after_head<A, I>(input, pos, input_len)
        decode_string_payload_after_head<A, I, N>(input, pos, payload.0)
    }

    #[inline(always)]
    fn decode_from_bounded<I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> Self {
        let payload = checked_dynamic_payload_with_input_len<A, I>(input, pos, input_len)
        decode_string_payload_after_head<A, I, N>(input, pos, payload.0)
    }
}

impl<A: Abi, const N: usize> Encode<A> for String<N> {
    #[arithmetic(unchecked)]
    #[inline(always)]
    fn encode(own self, _ out: AbiFrame) {
        let word = self.to_word()
        let len = packed_string_len(word)
        out.store_word(at: 0, value: len)
        if len != 0 {
            out.store_word(at: 32, value: word << ((32 - len) * 8))
        }
    }
}

impl<A: Abi> Decode<A> for DynString {
    fn decode_payload<D: AbiDecoder<A>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
        let payload_at = d.pos()
        let payload: (u256, u256) = checked_dynamic_payload_with_input_len<A, I>(input, payload_at, input.len())
        // A checked payload fits `MAX_PAYLOAD_LEN`.
        let data_ptr = unsafe { ptr::alloc_bytes_unchecked(word_to_usize(payload.1)) }

        unsafe { copy_dynamic_bytes(input, payload_at, data_ptr, payload.0, payload.1) }

        // The payload was checked and copied into this tail above.
        unsafe {
            DynString::from_validated_abi_tail(
                data: data_ptr,
                len: word_to_usize(payload.0),
                size: payload.1,
            )
        }
    }

    #[inline(always)]
    fn decode_from<I: ByteInput>(_ input: I, _ pos: u256) -> Self {
        let payload: (*u8, u256, u256) = copy_dynamic_payload_from<A, I>(input, pos)

        // The checked copy returns a complete tail.
        unsafe {
            DynString::from_validated_abi_tail(
                data: payload.0,
                len: word_to_usize(payload.1),
                size: payload.2,
            )
        }
    }

    #[inline(always)]
    fn decode_from_prechecked_head<I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> Self {
        let payload: (u256, u256) = checked_dynamic_payload_after_head<A, I>(input, pos, input_len)
        // A checked payload fits `MAX_PAYLOAD_LEN`.
        let data_ptr = unsafe { ptr::alloc_bytes_unchecked(word_to_usize(payload.1)) }

        unsafe { copy_dynamic_bytes(input, pos, data_ptr, payload.0, payload.1) }

        // The payload was checked and copied into this tail above.
        unsafe {
            DynString::from_validated_abi_tail(
                data: data_ptr,
                len: word_to_usize(payload.0),
                size: payload.1,
            )
        }
    }

    #[inline(always)]
    fn decode_from_bounded<I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> Self {
        let payload: (*u8, u256, u256) = copy_dynamic_payload_from_with_input_len<A, I>(input, pos, input_len)

        // The checked copy returns a complete tail.
        unsafe {
            DynString::from_validated_abi_tail(
                data: payload.0,
                len: word_to_usize(payload.1),
                size: payload.2,
            )
        }
    }
}

