impl<A: Abi, T0, T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11> AbiSpan<A>
    for (T0, T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11)
    where T0: AbiSpan<A> + AbiSize,
          T1: AbiSpan<A> + AbiSize,
          T2: AbiSpan<A> + AbiSize,
          T3: AbiSpan<A> + AbiSize,
          T4: AbiSpan<A> + AbiSize,
          T5: AbiSpan<A> + AbiSize,
          T6: AbiSpan<A> + AbiSize,
          T7: AbiSpan<A> + AbiSize,
          T8: AbiSpan<A> + AbiSize,
          T9: AbiSpan<A> + AbiSize,
          T10: AbiSpan<A> + AbiSize,
          T11: AbiSpan<A> + AbiSize
{
    fn payload_end<I: ByteInput>(_ input: I, base: u256, pos: u256) -> u256 {
        let field1 = pos + abi_field_head_size<T0>()
        let field2 = field1 + abi_field_head_size<T1>()
        let field3 = field2 + abi_field_head_size<T2>()
        let field4 = field3 + abi_field_head_size<T3>()
        let field5 = field4 + abi_field_head_size<T4>()
        let field6 = field5 + abi_field_head_size<T5>()
        let field7 = field6 + abi_field_head_size<T6>()
        let field8 = field7 + abi_field_head_size<T7>()
        let field9 = field8 + abi_field_head_size<T8>()
        let field10 = field9 + abi_field_head_size<T9>()
        let field11 = field10 + abi_field_head_size<T10>()
        var end = field11 + abi_field_head_size<T11>()
        end = max_u256(a: end, b: abi_field_end<A, T0, I>(input, base: pos, pos: pos))
        end = max_u256(a: end, b: abi_field_end<A, T1, I>(input, base: pos, pos: field1))
        end = max_u256(a: end, b: abi_field_end<A, T2, I>(input, base: pos, pos: field2))
        end = max_u256(a: end, b: abi_field_end<A, T3, I>(input, base: pos, pos: field3))
        end = max_u256(a: end, b: abi_field_end<A, T4, I>(input, base: pos, pos: field4))
        end = max_u256(a: end, b: abi_field_end<A, T5, I>(input, base: pos, pos: field5))
        end = max_u256(a: end, b: abi_field_end<A, T6, I>(input, base: pos, pos: field6))
        end = max_u256(a: end, b: abi_field_end<A, T7, I>(input, base: pos, pos: field7))
        end = max_u256(a: end, b: abi_field_end<A, T8, I>(input, base: pos, pos: field8))
        end = max_u256(a: end, b: abi_field_end<A, T9, I>(input, base: pos, pos: field9))
        end = max_u256(a: end, b: abi_field_end<A, T10, I>(input, base: pos, pos: field10))
        end = max_u256(a: end, b: abi_field_end<A, T11, I>(input, base: pos, pos: field11))
        end
    }

    fn payload_end_with_input_len<I: ByteInput>(_ input: I, base: u256, pos: u256, input_len: u256) -> u256 {
        let _ = base
        checked_frame_end<A>(pos, Self::HEAD_SIZE, input_len)
        let field1 = pos + abi_field_head_size<T0>()
        let field2 = field1 + abi_field_head_size<T1>()
        let field3 = field2 + abi_field_head_size<T2>()
        let field4 = field3 + abi_field_head_size<T3>()
        let field5 = field4 + abi_field_head_size<T4>()
        let field6 = field5 + abi_field_head_size<T5>()
        let field7 = field6 + abi_field_head_size<T6>()
        let field8 = field7 + abi_field_head_size<T7>()
        let field9 = field8 + abi_field_head_size<T8>()
        let field10 = field9 + abi_field_head_size<T9>()
        let field11 = field10 + abi_field_head_size<T10>()
        var end = field11 + abi_field_head_size<T11>()
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T0, I>(input, base: pos, pos: pos, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T1, I>(input, base: pos, pos: field1, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T2, I>(input, base: pos, pos: field2, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T3, I>(input, base: pos, pos: field3, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T4, I>(input, base: pos, pos: field4, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T5, I>(input, base: pos, pos: field5, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T6, I>(input, base: pos, pos: field6, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T7, I>(input, base: pos, pos: field7, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T8, I>(input, base: pos, pos: field8, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T9, I>(input, base: pos, pos: field9, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T10, I>(input, base: pos, pos: field10, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T11, I>(input, base: pos, pos: field11, input_len: input_len))
        end
    }
}

impl<A: Abi, T0, T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11, T12> Decode<A>
    for (T0, T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11, T12)
    where T0: Decode<A> + AbiSize, T1: Decode<A> + AbiSize, T2: Decode<A> + AbiSize, T3: Decode<A> + AbiSize, T4: Decode<A> + AbiSize, T5: Decode<A> + AbiSize, T6: Decode<A> + AbiSize, T7: Decode<A> + AbiSize, T8: Decode<A> + AbiSize, T9: Decode<A> + AbiSize, T10: Decode<A> + AbiSize, T11: Decode<A> + AbiSize, T12: Decode<A> + AbiSize
{
    fn decode_payload<D: AbiDecoder<A>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
        let v0: T0 = decode_field<A, T0, D, I>(mut d, input)
