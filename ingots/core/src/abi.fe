/// A word too wide for the target's `usize` does not decode.
#[inline(always)]
fn decode_usize_word<A: Abi>(_ word: u256) -> usize {
    if word > usize::max() as u256 {
        A::decode_error()
    }
    word_to_usize(word)
}

