        let v6: T6 = decode_field<A, T6, D, I>(mut d, input)
        let v7: T7 = decode_field<A, T7, D, I>(mut d, input)
        let v8: T8 = decode_field<A, T8, D, I>(mut d, input)
        let v9: T9 = decode_field<A, T9, D, I>(mut d, input)
        let v10: T10 = decode_field<A, T10, D, I>(mut d, input)
        let v11: T11 = decode_field<A, T11, D, I>(mut d, input)
        let v12: T12 = decode_field<A, T12, D, I>(mut d, input)
        let v13: T13 = decode_field<A, T13, D, I>(mut d, input)
        let v14: T14 = decode_field<A, T14, D, I>(mut d, input)
        let v15: T15 = decode_field<A, T15, D, I>(mut d, input)
        (
            v0,
            v1,
            v2,
            v3,
            v4,
            v5,
            v6,
            v7,
            v8,
            v9,
            v10,
            v11,
            v12,
            v13,
            v14,
            v15,
        )
    }

    #[inline(always)]
    fn decode_from<I: ByteInput>(_ input: I, _ pos: u256) -> Self {
        var head_pos = pos
        let v0: T0 = decode_field_from<A, T0, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T0>()
        let v1: T1 = decode_field_from<A, T1, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T1>()
        let v2: T2 = decode_field_from<A, T2, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T2>()
        let v3: T3 = decode_field_from<A, T3, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T3>()
        let v4: T4 = decode_field_from<A, T4, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T4>()
        let v5: T5 = decode_field_from<A, T5, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T5>()
        let v6: T6 = decode_field_from<A, T6, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T6>()
        let v7: T7 = decode_field_from<A, T7, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T7>()
        let v8: T8 = decode_field_from<A, T8, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T8>()
        let v9: T9 = decode_field_from<A, T9, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T9>()
        let v10: T10 = decode_field_from<A, T10, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T10>()
        let v11: T11 = decode_field_from<A, T11, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T11>()
        let v12: T12 = decode_field_from<A, T12, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T12>()
        let v13: T13 = decode_field_from<A, T13, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T13>()
        let v14: T14 = decode_field_from<A, T14, I>(input, base: pos, head_pos: head_pos)
        head_pos += abi_field_head_size<T14>()
        let v15: T15 = decode_field_from<A, T15, I>(input, base: pos, head_pos: head_pos)
        (v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15)
    }

    #[inline(always)]
    fn decode_from_prechecked_head<I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> Self {
        var head_pos = pos
        let v0: T0 = decode_field_from_prechecked_head<A, T0, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T0>()
        let v1: T1 = decode_field_from_prechecked_head<A, T1, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T1>()
        let v2: T2 = decode_field_from_prechecked_head<A, T2, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T2>()
        let v3: T3 = decode_field_from_prechecked_head<A, T3, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T3>()
        let v4: T4 = decode_field_from_prechecked_head<A, T4, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T4>()
        let v5: T5 = decode_field_from_prechecked_head<A, T5, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T5>()
        let v6: T6 = decode_field_from_prechecked_head<A, T6, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T6>()
        let v7: T7 = decode_field_from_prechecked_head<A, T7, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T7>()
        let v8: T8 = decode_field_from_prechecked_head<A, T8, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T8>()
        let v9: T9 = decode_field_from_prechecked_head<A, T9, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T9>()
        let v10: T10 = decode_field_from_prechecked_head<A, T10, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T10>()
        let v11: T11 = decode_field_from_prechecked_head<A, T11, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T11>()
        let v12: T12 = decode_field_from_prechecked_head<A, T12, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T12>()
        let v13: T13 = decode_field_from_prechecked_head<A, T13, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T13>()
        let v14: T14 = decode_field_from_prechecked_head<A, T14, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        head_pos += abi_field_head_size<T14>()
        let v15: T15 = decode_field_from_prechecked_head<A, T15, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
        (v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15)
    }

    #[inline(always)]
    fn decode_from_bounded<I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> Self {
        checked_frame_end<A>(pos, Self::HEAD_SIZE, input_len)
        Self::decode_from_prechecked_head(input, pos, input_len)
    }
}

impl<A: Abi, T0, T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11, T12, T13, T14, T15> Encode<A>
    for (T0, T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11, T12, T13, T14, T15)
    where T0: Encode<A> + AbiSize,
          T1: Encode<A> + AbiSize,
          T2: Encode<A> + AbiSize,
          T3: Encode<A> + AbiSize,
          T4: Encode<A> + AbiSize,
          T5: Encode<A> + AbiSize,
          T6: Encode<A> + AbiSize,
          T7: Encode<A> + AbiSize,
          T8: Encode<A> + AbiSize,
          T9: Encode<A> + AbiSize,
          T10: Encode<A> + AbiSize,
          T11: Encode<A> + AbiSize,
          T12: Encode<A> + AbiSize,
          T13: Encode<A> + AbiSize,
          T14: Encode<A> + AbiSize,
          T15: Encode<A> + AbiSize
{
    #[arithmetic(unchecked)]
    #[inline(always)]
    fn encode(own self, _ out: AbiFrame) {
        let (v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15) = self
        var tails = out.tail(Self::HEAD_SIZE)
        let head1 = abi_field_head_size<T0>()
        let head2 = head1 + abi_field_head_size<T1>()
        let head3 = head2 + abi_field_head_size<T2>()
        let head4 = head3 + abi_field_head_size<T3>()
        let head5 = head4 + abi_field_head_size<T4>()
        let head6 = head5 + abi_field_head_size<T5>()
        let head7 = head6 + abi_field_head_size<T6>()
        let head8 = head7 + abi_field_head_size<T7>()
        let head9 = head8 + abi_field_head_size<T8>()
        let head10 = head9 + abi_field_head_size<T9>()
        let head11 = head10 + abi_field_head_size<T10>()
        let head12 = head11 + abi_field_head_size<T11>()
        let head13 = head12 + abi_field_head_size<T12>()
        let head14 = head13 + abi_field_head_size<T13>()
        let head15 = head14 + abi_field_head_size<T14>()
        tails = encode_field<A, T0>(v0, out, head_pos: 0, tails)
        tails = encode_field<A, T1>(v1, out, head_pos: head1, tails)
        tails = encode_field<A, T2>(v2, out, head_pos: head2, tails)
        tails = encode_field<A, T3>(v3, out, head_pos: head3, tails)
        tails = encode_field<A, T4>(v4, out, head_pos: head4, tails)
        tails = encode_field<A, T5>(v5, out, head_pos: head5, tails)
        tails = encode_field<A, T6>(v6, out, head_pos: head6, tails)
        tails = encode_field<A, T7>(v7, out, head_pos: head7, tails)
        tails = encode_field<A, T8>(v8, out, head_pos: head8, tails)
        tails = encode_field<A, T9>(v9, out, head_pos: head9, tails)
        tails = encode_field<A, T10>(v10, out, head_pos: head10, tails)
        tails = encode_field<A, T11>(v11, out, head_pos: head11, tails)
        tails = encode_field<A, T12>(v12, out, head_pos: head12, tails)
        tails = encode_field<A, T13>(v13, out, head_pos: head13, tails)
        tails = encode_field<A, T14>(v14, out, head_pos: head14, tails)
        encode_field<A, T15>(v15, out, head_pos: head15, tails)
    }
}

impl<A: Abi, T0, T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11, T12, T13, T14, T15> AbiSpan<A>
    for (T0, T1, T2, T3, T4, T5, T6, T7, T8, T9, T10, T11, T12, T13, T14, T15)
    where T0: AbiSpan<A> + AbiSize,
          T1: AbiSpan<A> + AbiSize,
          T2: AbiSpan<A> + AbiSize,
          T3: AbiSpan<A> + AbiSize,
          T4: AbiSpan<A> + AbiSize,
          T5: AbiSpan<A> + AbiSize,
          T6: AbiSpan<A> + AbiSize,
          T7: AbiSpan<A> + AbiSize,
          T8: AbiSpan<A> + AbiSize,
          T9: AbiSpan<A> + AbiSize,
          T10: AbiSpan<A> + AbiSize,
          T11: AbiSpan<A> + AbiSize,
          T12: AbiSpan<A> + AbiSize,
          T13: AbiSpan<A> + AbiSize,
          T14: AbiSpan<A> + AbiSize,
          T15: AbiSpan<A> + AbiSize
{
    fn payload_end<I: ByteInput>(_ input: I, base: u256, pos: u256) -> u256 {
        let field1 = pos + abi_field_head_size<T0>()
        let field2 = field1 + abi_field_head_size<T1>()
        let field3 = field2 + abi_field_head_size<T2>()
        let field4 = field3 + abi_field_head_size<T3>()
        let field5 = field4 + abi_field_head_size<T4>()
        let field6 = field5 + abi_field_head_size<T5>()
        let field7 = field6 + abi_field_head_size<T6>()
        let field8 = field7 + abi_field_head_size<T7>()
        let field9 = field8 + abi_field_head_size<T8>()
        let field10 = field9 + abi_field_head_size<T9>()
        let field11 = field10 + abi_field_head_size<T10>()
        let field12 = field11 + abi_field_head_size<T11>()
        let field13 = field12 + abi_field_head_size<T12>()
        let field14 = field13 + abi_field_head_size<T13>()
        let field15 = field14 + abi_field_head_size<T14>()
        var end = field15 + abi_field_head_size<T15>()
        end = max_u256(a: end, b: abi_field_end<A, T0, I>(input, base: pos, pos: pos))
        end = max_u256(a: end, b: abi_field_end<A, T1, I>(input, base: pos, pos: field1))
        end = max_u256(a: end, b: abi_field_end<A, T2, I>(input, base: pos, pos: field2))
        end = max_u256(a: end, b: abi_field_end<A, T3, I>(input, base: pos, pos: field3))
        end = max_u256(a: end, b: abi_field_end<A, T4, I>(input, base: pos, pos: field4))
        end = max_u256(a: end, b: abi_field_end<A, T5, I>(input, base: pos, pos: field5))
        end = max_u256(a: end, b: abi_field_end<A, T6, I>(input, base: pos, pos: field6))
        end = max_u256(a: end, b: abi_field_end<A, T7, I>(input, base: pos, pos: field7))
        end = max_u256(a: end, b: abi_field_end<A, T8, I>(input, base: pos, pos: field8))
        end = max_u256(a: end, b: abi_field_end<A, T9, I>(input, base: pos, pos: field9))
        end = max_u256(a: end, b: abi_field_end<A, T10, I>(input, base: pos, pos: field10))
        end = max_u256(a: end, b: abi_field_end<A, T11, I>(input, base: pos, pos: field11))
        end = max_u256(a: end, b: abi_field_end<A, T12, I>(input, base: pos, pos: field12))
        end = max_u256(a: end, b: abi_field_end<A, T13, I>(input, base: pos, pos: field13))
        end = max_u256(a: end, b: abi_field_end<A, T14, I>(input, base: pos, pos: field14))
        end = max_u256(a: end, b: abi_field_end<A, T15, I>(input, base: pos, pos: field15))
        end
    }

    fn payload_end_with_input_len<I: ByteInput>(_ input: I, base: u256, pos: u256, input_len: u256) -> u256 {
        let _ = base
        checked_frame_end<A>(pos, Self::HEAD_SIZE, input_len)
        let field1 = pos + abi_field_head_size<T0>()
        let field2 = field1 + abi_field_head_size<T1>()
        let field3 = field2 + abi_field_head_size<T2>()
        let field4 = field3 + abi_field_head_size<T3>()
        let field5 = field4 + abi_field_head_size<T4>()
        let field6 = field5 + abi_field_head_size<T5>()
        let field7 = field6 + abi_field_head_size<T6>()
        let field8 = field7 + abi_field_head_size<T7>()
        let field9 = field8 + abi_field_head_size<T8>()
        let field10 = field9 + abi_field_head_size<T9>()
        let field11 = field10 + abi_field_head_size<T10>()
        let field12 = field11 + abi_field_head_size<T11>()
        let field13 = field12 + abi_field_head_size<T12>()
        let field14 = field13 + abi_field_head_size<T13>()
        let field15 = field14 + abi_field_head_size<T14>()
        var end = field15 + abi_field_head_size<T15>()
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T0, I>(input, base: pos, pos: pos, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T1, I>(input, base: pos, pos: field1, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T2, I>(input, base: pos, pos: field2, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T3, I>(input, base: pos, pos: field3, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T4, I>(input, base: pos, pos: field4, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T5, I>(input, base: pos, pos: field5, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T6, I>(input, base: pos, pos: field6, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T7, I>(input, base: pos, pos: field7, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T8, I>(input, base: pos, pos: field8, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T9, I>(input, base: pos, pos: field9, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T10, I>(input, base: pos, pos: field10, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T11, I>(input, base: pos, pos: field11, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T12, I>(input, base: pos, pos: field12, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T13, I>(input, base: pos, pos: field13, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T14, I>(input, base: pos, pos: field14, input_len: input_len))
        end = max_u256(a: end, b: abi_field_end_with_input_len<A, T15, I>(input, base: pos, pos: field15, input_len: input_len))
        end
    }
}

impl<A: Abi, T, const N: usize> Decode<A> for [T; N]
    where T: Decode<A> + AbiSize + Copy
{
    fn decode_payload<D: AbiDecoder<A>, I: ByteInput>(_ d: mut D, _ input: I) -> Self {
        // Empty arrays contain no values to initialize or decode.
        if N == 0 {
            return unsafe { *ptr::alloc<[T; N]>() }
        }
        let first = decode_field<A, T, D, I>(mut d, input)
        var out: [T; N] = [first; N]
        var i: usize = 1
        while i < N {
            out[i] = decode_field<A, T, D, I>(mut d, input)
            i += 1
        }
        out
    }

    #[inline(always)]
    fn decode_from<I: ByteInput>(_ input: I, _ pos: u256) -> Self {
        // Empty arrays contain no values to initialize or decode.
        if N == 0 {
            return unsafe { *ptr::alloc<[T; N]>() }
        }
        let first = decode_field_from<A, T, I>(input, base: pos, head_pos: pos)
        var out: [T; N] = [first; N]
        var i: usize = 1
        var head_pos = pos + abi_field_head_size<T>()
        while i < N {
            out[i] = decode_field_from<A, T, I>(input, base: pos, head_pos: head_pos)
            head_pos += abi_field_head_size<T>()
            i += 1
        }
        out
    }

    #[inline(always)]
    fn decode_from_prechecked_head<I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> Self {
        // Empty arrays contain no values to initialize or decode.
        if N == 0 {
            return unsafe { *ptr::alloc<[T; N]>() }
        }
        let first = decode_field_from_prechecked_head<A, T, I>(input, base: pos, head_pos: pos, input_len: input_len)
        var out: [T; N] = [first; N]
        var i: usize = 1
        var head_pos = pos + abi_field_head_size<T>()
        while i < N {
            out[i] = decode_field_from_prechecked_head<A, T, I>(input, base: pos, head_pos: head_pos, input_len: input_len)
            head_pos += abi_field_head_size<T>()
            i += 1
        }
        out
    }

    #[inline(always)]
    fn decode_from_bounded<I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> Self {
        checked_frame_end<A>(pos, Self::HEAD_SIZE, input_len)
        Self::decode_from_prechecked_head(input, pos, input_len)
    }
}

impl<A: Abi, T, const N: usize> AbiSpan<A> for [T; N]
    where T: AbiSpan<A> + AbiSize + Copy
{
    fn payload_end<I: ByteInput>(_ input: I, base: u256, pos: u256) -> u256 {
        let _ = base
        var head_pos = pos
        var end = pos
        var i: usize = 0
        while i < N {
            end = max_u256(a: end, b: abi_field_end<A, T, I>(input, base: pos, pos: head_pos))
            head_pos += abi_field_head_size<T>()
            i += 1
        }
        max_u256(a: end, b: head_pos)
    }

    fn payload_end_with_input_len<I: ByteInput>(_ input: I, base: u256, pos: u256, input_len: u256) -> u256 {
        let _ = base
        checked_frame_end<A>(pos, Self::HEAD_SIZE, input_len)
        var head_pos = pos
        var end = pos
        var i: usize = 0
        while i < N {
            end = max_u256(a: end, b: abi_field_end_with_input_len<A, T, I>(input, base: pos, pos: head_pos, input_len: input_len))
            head_pos += abi_field_head_size<T>()
            i += 1
        }
        max_u256(a: end, b: head_pos)
    }
}

impl<A: Abi, T, const N: usize> Encode<A> for [T; N]
    where T: Encode<A> + AbiSize + Copy
{
    fn encode(own self, _ out: AbiFrame) {
        var head_pos: u256 = 0
        var tails = out.tail(Self::HEAD_SIZE)
        var i: usize = 0
        while i < N {
            tails = encode_field<A, T>(self[i], out, head_pos, tails)
            head_pos += abi_field_head_size<T>()
            i += 1
        }
    }
}
