    }

    #[inline(always)]
    fn decode_from<I: ByteInput>(_ input: I, _ pos: u256) -> Self {
        decode_isize_word<A>(input.word_at(pos))
    }
}

/// A word that is not the sign extension of a target `isize` does not
/// decode.
#[inline(always)]
fn decode_isize_word<A: Abi>(_ word: u256) -> isize {
    let signed: i256 = word.downcast_unchecked()
    if let Option::Some(value) = signed.downcast() {
        return value
    }
    A::decode_error()
}

