        tails = encode_field<A, T7>(v7, out, head_pos: head7, tails)
        tails = encode_field<A, T8>(v8, out, head_pos: head8, tails)
        encode_field<A, T9>(v9, out, head_pos: head9, tails)
    }
}

impl<A: Abi, T0, T1, T2, T3, T4, T5, T6, T7, T8, T9> AbiSpan<A>
    for (T0, T1, T2, T3, T4, T5, T6, T7, T8, T9)
