        let v9: T9 = decode_field<A, T9, D, I>(mut d, input)
        let v10: T10 = decode_field<A, T10, D, I>(mut d, input)
        let v11: T11 = decode_field<A, T11, D, I>(mut d, input)
        let v12: T12 = decode_field<A, T12, D, I>(mut d, input)
        (
            v0,
            v1,
            v2,
            v3,
            v4,
            v5,
            v6,
            v7,
            v8,
            v9,
            v10,
            v11,
            v12,
        )
