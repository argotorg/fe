use ingot::Copy
use ingot::Option
use ingot::num::{IntDowncast, WordValue, from_be, to_be, word_to_usize}
use ingot::ptr
use ingot::ops::Eq

/// Errors returned by ABI decoding/encoding helpers.
pub enum AbiError {
    InputTooShort,
    OutOfBounds,
    InvalidSelector,
    InvalidOffset,
    NonCanonical,
    InvalidBool,
    InvalidUtf8,
    LengthOverflow,
    AllocationFailed,
}

/// A read-only byte input for ABI decoding, such as calldata or a memory
/// span. Implement this trait for an input; code that reads one bounds it by
/// `ByteInput`, which every `ByteSource` is.
///
/// Implementations may return padded values (e.g. EVM calldata loads) so callers
/// must use `len()` to enforce bounds/canonicality. Inputs are passed by view;
/// only `Copy` inputs can be stored, as in `Cursor` and `BytesView`.
pub trait ByteSource {
    /// The input's length in bytes. Like any calldata, returndata or memory,
    /// an input is shorter than `2**64` bytes, so the offset and length words
    /// that fit it are below `2**64`, as Solidity requires of them.
    fn size(self) -> u64
    fn word_at(self, _ byte_offset: u256) -> u256
    fn byte_at(self, _ byte_offset: u256) -> u8
    /// Copy `len` bytes starting at `src_offset` into linear memory at `dest`.
    ///
    /// The checked operation accepts arbitrary byte lengths and checks the
    /// source range. The caller must ensure that `dest` has room for `len`
    /// bytes in a live allocation.
    unsafe fn copy_to_memory(self, dest: *u8, src_offset: u256, len: u256)

    /// Copy a byte range the caller has validated into linear memory.
    ///
    /// The caller must ensure that `dest` has room for `len` bytes in a live
    /// allocation. The range is validated only against a length the caller
    /// was given, which may exceed the input, so the copy must stay safe for
    /// any source range: an implementation may skip the check only where
    /// reading past the end is itself safe, as calldata reads zeros there.
    /// Arbitrary byte lengths are supported.
    unsafe fn copy_to_memory_unchecked(self, dest: *u8, src_offset: u256, len: u256) {
        self.copy_to_memory(dest: dest, src_offset: src_offset, len: len)
    }
}

/// A `ByteSource` with its length as a word for bounds arithmetic. Only the
/// impl below provides it, so the length is always the input's `size`.
pub trait ByteInput: ByteSource {
    fn len(self) -> u256
}

impl<I: ByteSource> ByteInput for I {
    #[inline(always)]
    fn len(self) -> u256 {
        self.size() as u256
    }
}

/// First-word prefix used for fast dispatch.
pub struct Prefix {
    pub len: u256,
    pub word0: u256,
}

pub fn prefix<I: ByteInput>(input: I) -> Prefix {
    let len = input.len()
    var word0: u256 = 0
    if len != 0 {
        word0 = input.word_at(0)
        if len < 32 {
            let shift = (32 - len) * 8
            word0 = word0 >> shift << shift
        }
    }
    Prefix {
        len,
        word0,
    }
}

/// Generic cursor over a `ByteInput`.
pub struct Cursor<I> {
    pub input: I,
    pub pos: u256,
}

impl<I> Cursor<I>
    where I: ByteInput + Copy
{
    #[inline(always)]
    pub fn new(input: own I) -> Self {
        Cursor {
            input,
            pos: 0,
        }
    }

    #[inline(always)]
    pub fn fork(self, _ pos: u256) -> Self {
        Cursor {
            input: self.input,
            pos,
        }
    }

    #[arithmetic(unchecked)]
    pub fn read_u8(mut self) -> u8 {
        let b = self.input.byte_at(self.pos)
        self.pos = self.pos + 1
        b
    }

    #[arithmetic(unchecked)]
    pub fn read_word(mut self) -> u256 {
        let w = self.input.word_at(self.pos)
        self.pos = self.pos + 32
        w
    }

    pub fn peek_word(self, _ at: u256) -> u256 {
        self.input.word_at(at)
    }
}

/// ABI definition (selector width/format).
pub trait Abi {
    type Selector
    /// Decoder state: a position in an input that each read is passed.
    type Decoder: AbiDecoder<Self>

    /// Size of the selector in bytes.
    const SELECTOR_SIZE: u256

    fn selector_from_prefix(_: u256) -> Self::Selector

    fn decode_bool_word(_: u256) -> bool
    fn decode_u8_word(_: u256) -> u8
    fn decode_u16_word(_: u256) -> u16
    fn decode_u32_word(_: u256) -> u32
    fn decode_u64_word(_: u256) -> u64
    fn decode_u128_word(_: u256) -> u128
    fn decode_i8_word(_: u256) -> i8
    fn decode_i16_word(_: u256) -> i16
    fn decode_i32_word(_: u256) -> i32
    fn decode_i64_word(_: u256) -> i64
    fn decode_i128_word(_: u256) -> i128
    fn decode_error() -> !

    /// Validate the top-level runtime argument head before decoding it.
    ///
    /// This is ABI-specific because wrapper compilers can impose bounds beyond
    /// the structural `base + head_size <= input_len` requirement.
    fn validate_runtime_head(input_len: u256, base: u256, head_size: u256)

    fn decoder_new() -> Self::Decoder
    fn decoder_with_base(_ base: u256) -> Self::Decoder
}

/// ABI decoder with cursor state.
///
/// A decoder does not hold its input: each read is passed the input and
/// validates the position against it. Decoding allocates its payloads
/// itself, so no implementation chooses where decoded bytes are written.
pub trait AbiDecoder<A: Abi> {
    fn base(self) -> u256
    fn set_base(mut self, _ new_base: u256)
    fn pos(self) -> u256
    fn set_pos(mut self, _ new_pos: u256)

    fn read_u8<I: ByteInput>(mut self, _ input: I) -> u8
    fn read_word<I: ByteInput>(mut self, _ input: I) -> u256
    fn peek_word<I: ByteInput>(self, _ input: I, _ at: u256) -> u256
}

/// ABI payload layout metadata and exact runtime payload size.
pub trait AbiSize {
    const HEAD_SIZE: u256
    const IS_DYNAMIC: bool
    /// Whether a top-level return value of this type is encoded as a
    /// parameter list: the value's own head/tail layout without a leading
    /// offset word, like Solidity's multi-value `returns (A, B, ...)`.
    ///
    /// Tuples set this. Other dynamic types keep the single-root layout,
    /// which matches a Solidity single `returns (T)`.
    const IS_PARAM_LIST: bool = false

    fn payload_size(self) -> u256 {
        Self::HEAD_SIZE
    }
}

/// End of the required input bytes; byte and string tails exclude trailing padding.
/// Owned dynamic arrays round this extent up and initialize their final padding.
pub trait AbiSpan<A: Abi>: AbiSize {
    fn payload_end<I: ByteInput>(_: I, base: u256, pos: u256) -> u256

    fn payload_end_with_input_len<I: ByteInput>(_ input: I, base: u256, pos: u256, input_len: u256) -> u256 {
        let _ = input_len
        Self::payload_end(input, base: base, pos: pos)
    }
}

pub trait Decode<A: Abi>: AbiSize {
    fn decode_payload<D: AbiDecoder<A>, I: ByteInput>(_ d: mut D, _ input: I) -> Self

    /// Decode from a raw ABI payload position. Callers that use this path are
    /// responsible for any bounds checks needed by the input source.
    fn decode_from<I: ByteInput>(_ input: I, _ pos: u256) -> Self {
        var d = A::decoder_with_base(pos)
        Self::decode_payload(mut d, input)
    }

    /// Decode after the caller has already checked this value's head frame.
    ///
    /// Dynamic leaves can read their length word without repeating the
    /// `pos + HEAD_SIZE <= input_len` check.
    #[inline(always)]
    fn decode_from_prechecked_head<I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> Self {
        let _ = input_len
        Self::decode_from(input, pos)
    }

    /// Decode from a position with only `input_len` known.
    ///
    /// Composite implementations must validate their own head frame before
    /// entering the prechecked-head fast path.
    fn decode_from_bounded<I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> Self {
        checked_frame_end<A>(pos, Self::HEAD_SIZE, input_len)
        Self::decode_from(input, pos)
    }
}

pub trait Encode<A: Abi>: AbiSize {
    /// Writes the ABI payload of `self` into `out`, which holds
    /// `self.payload_size()` bytes.
    fn encode(own self, _ out: AbiFrame)
}

/// The bytes an ABI encoding writes: `len` bytes in linear memory.
///
/// `Encode` implementations write through a frame's methods, which check
/// every write against the frame. The sizes a frame is given come from
/// `AbiSize`, a safe trait, so they are not trusted with memory safety: an
/// encoding that disagrees with its `AbiSize` panics instead of writing past
/// its frame.
pub struct AbiFrame {
    unsafe ptr: *u8,
    unsafe len: u256,
}

impl AbiFrame {
    /// A frame over the `len` bytes at `ptr`.
    ///
    /// The caller must ensure that the bytes are initialized and lie in a
    /// live allocation that nothing else reads or writes while the frame is
    /// in use.
    #[inline(always)]
    pub unsafe fn from_raw_parts(ptr: *u8, len: u256) -> Self {
        AbiFrame { ptr, len }
    }

    #[inline(always)]
    pub fn len(self) -> u256 {
        self.len
    }

    /// The `len` bytes at `offset`, as a frame.
    #[arithmetic(unchecked)]
    #[inline(always)]
    pub fn slice(self, offset: u256, len: u256) -> Self {
        if offset > self.len || len > self.len - offset {
            ptr::index_out_of_bounds()
        }
        // The range lies within this frame.
        unsafe { AbiFrame { ptr: ptr_offset(self.ptr, offset), len } }
    }

    /// The bytes after the first `n`.
    #[arithmetic(unchecked)]
    #[inline(always)]
    pub fn tail(self, _ n: u256) -> Self {
        if n > self.len {
            ptr::index_out_of_bounds()
        }
        // The bytes lie within this frame.
        unsafe { AbiFrame { ptr: ptr_offset(self.ptr, n), len: self.len - n } }
    }

    /// Writes `value` as the word at byte `at`.
    #[inline(always)]
    pub fn store_word(self, at: u256, value: u256) {
        let word = self.slice(offset: at, len: 32)
        unsafe { store_word(ptr: word.ptr, value) }
    }

    /// Copies `source` to byte `at`.
    #[inline(always)]
    pub fn copy_from(self, at: u256, _ source: ptr::MemSpan) {
        let dest = self.slice(offset: at, len: source.len() as u256)
        unsafe { ptr::copy(dest: dest.ptr, source) }
    }
}

/// Writes `value` as a big-endian word at `ptr`, which must have room for 32
/// bytes in a live allocation.
pub unsafe fn store_word(ptr: *u8, value: u256) {
    unsafe { *ptr::cast<u8, u256>(ptr) = to_be(value) }
}

/// Reads the big-endian word at `ptr`, whose 32 bytes must lie in a live
/// allocation.
pub unsafe fn load_word(_ ptr: *u8) -> u256 {
    from_be(unsafe { *ptr::cast<u8, u256>(ptr) })
}

pub fn decode_or_revert<A: Abi, T, D, I>(d: mut D, _ input: I) -> T
    where T: Decode<A>, D: AbiDecoder<A>, I: ByteInput
{
    T::decode_payload(mut d, input)
}

pub const fn abi_field_head_size<T: AbiSize>() -> u256 {
    if T::IS_DYNAMIC {
        return 32
    }
    <T as AbiSize>::HEAD_SIZE
}

pub const fn abi_payload_head_size<T: AbiSize>() -> u256 {
    <T as AbiSize>::HEAD_SIZE
}

pub const fn abi_single_root_head_size<T: AbiSize>() -> u256 {
    abi_field_head_size<T>()
}

// Explicit bounds below make the final addition safe without panic checks.
#[arithmetic(unchecked)]
#[inline(always)]
pub fn checked_frame_end<A: Abi>(_ pos: u256, _ head_size: u256, _ input_len: u256) -> u256 {
    if pos > input_len || head_size > input_len - pos {
        A::decode_error()
    }
    pos + head_size
}

// Overflow is reported through the ABI decoder rather than arithmetic panic.
#[arithmetic(unchecked)]
#[inline(always)]
pub fn checked_tail<A: Abi>(_ base: u256, _ tail_rel: u256) -> u256 {
    if tail_rel > (!(0 as u256)) - base {
        A::decode_error()
    }
    base + tail_rel
}

#[inline(always)]
pub fn decode_frame_from<A: Abi, T, I>(_ input: I, _ pos: u256, _ input_len: u256) -> T
    where T: Decode<A> + AbiSize,
          I: ByteInput
{
    checked_frame_end<A>(pos, T::HEAD_SIZE, input_len)
    T::decode_from_prechecked_head(input, pos, input_len)
}

pub fn abi_payload_size<T: AbiSize>(_ value: T) -> u256 {
    value.payload_size()
}

pub fn abi_field_size<T: AbiSize>(_ value: T) -> u256 {
    let payload_size = value.payload_size()
    if T::IS_DYNAMIC {
        return 32 + payload_size
    }
    payload_size
}

pub fn abi_single_root_size<T: AbiSize>(_ value: T) -> u256 {
    abi_field_size(value)
}

pub fn dynamic_payload_size<T: AbiSize>(_ value: T) -> u256 {
    if T::IS_DYNAMIC {
        return value.payload_size()
    }
    0
}

pub fn decode_payload_root<A: Abi, T, D, I>(_ d: mut D, _ input: I) -> T
    where T: Decode<A>,
          D: AbiDecoder<A>,
          I: ByteInput
{
    T::decode_payload(mut d, input)
}

pub fn decode_single_root<A: Abi, T, D, I>(_ d: mut D, _ input: I) -> T
    where T: Decode<A> + AbiSize,
          D: AbiDecoder<A>,
          I: ByteInput
{
    decode_field<A, T, D, I>(mut d, input)
}

#[inline(always)]
pub fn decode_field<A: Abi, T, D, I>(_ d: mut D, _ input: I) -> T
    where T: Decode<A> + AbiSize,
          D: AbiDecoder<A>,
          I: ByteInput
{
    if T::IS_DYNAMIC {
        let tail_rel = d.read_word(input)
        let parent_base = d.base()
        let parent_pos = d.pos()
        d.set_base(checked_tail<A>(parent_base, tail_rel))
        d.set_pos(d.base())
        let value = T::decode_payload(mut d, input)
        d.set_base(parent_base)
        d.set_pos(parent_pos)
        return value
    }

    T::decode_payload(mut d, input)
}

#[inline(always)]
pub fn decode_field_from<A: Abi, T, I>(_ input: I, base: u256, head_pos: u256) -> T
    where T: Decode<A> + AbiSize,
          I: ByteInput
{
    if T::IS_DYNAMIC {
        let tail_rel = input.word_at(head_pos)
        return T::decode_from(input, checked_tail<A>(base, tail_rel))
    }

    T::decode_from(input, head_pos)
}

#[inline(always)]
pub fn decode_msg_field_from<A: Abi, T, I>(_ input: I, base: u256, head_pos: u256, input_len: u256) -> T
    where T: Decode<A> + AbiSize,
          I: ByteInput
{
    if T::IS_DYNAMIC {
        return decode_field_from_prechecked_head<A, T, I>(input, base: base, head_pos: head_pos, input_len: input_len)
    }

    let _ = input_len
    decode_field_from<A, T, I>(input, base: base, head_pos: head_pos)
}

/// Decode a field whose head word lies inside an already-checked parent frame.
///
/// Static fields can decode directly from the head position. Dynamic fields use
/// `input_len` to validate their tail before entering that tail's decode path.
#[inline(always)]
pub fn decode_field_from_prechecked_head<A: Abi, T, I>(_ input: I, base: u256, head_pos: u256, input_len: u256) -> T
    where T: Decode<A> + AbiSize,
          I: ByteInput
{
    if T::IS_DYNAMIC {
        let tail_rel = input.word_at(head_pos)
        let tail_at = checked_tail<A>(base, tail_rel)
        return T::decode_from_bounded(input, tail_at, input_len)
    }

    T::decode_from(input, head_pos)
}

/// Encodes `value` as the field whose head is at `head_pos` in `out`, and
/// returns the bytes of `tails` after its tail.
///
/// `tails` holds the bytes of `out` that no earlier field's tail took, and
/// ends where `out` does. A dynamic field's tail starts it, so each tail
/// costs one bounds check against what is left.
#[arithmetic(unchecked)]
#[inline(always)]
pub fn encode_field<A: Abi, T>(_ value: own T, _ out: AbiFrame, head_pos: u256, tails: own AbiFrame) -> AbiFrame
    where T: Encode<A> + AbiSize
{
    if T::IS_DYNAMIC {
        let size = value.payload_size()
        // `tails` ends where `out` does, so this is its offset in `out`.
        out.store_word(at: head_pos, value: out.len() - tails.len())
        value.encode(tails.slice(offset: 0, len: size))
        return tails.tail(size)
    }

    value.encode(out.slice(offset: head_pos, len: T::HEAD_SIZE))
    tails
}

#[inline(always)]
pub fn encode_alloc<A: Abi, T>(_ value: own T) -> ptr::MemBuffer
    where T: Encode<A> + AbiSize
{
    let total = abi_payload_size(value)
    let buffer = ptr::MemBuffer::alloc(ptr::allocation_len(total))
    // The fresh buffer is zeroed, and only the encoding writes it.
    value.encode(unsafe { AbiFrame::from_raw_parts(ptr: buffer.ptr(), len: total) })
    buffer
}

#[inline(always)]
pub fn encode_single_root_alloc<A: Abi, T>(_ value: own T) -> ptr::MemBuffer
    where T: Encode<A> + AbiSize
{
    let total = abi_single_root_size(value)
    let buffer = ptr::MemBuffer::alloc(ptr::allocation_len(total))
    // The fresh buffer is zeroed, and only the encoding writes it.
    let out = unsafe { AbiFrame::from_raw_parts(ptr: buffer.ptr(), len: total) }
    encode_field<A, T>(value, out, head_pos: 0, tails: out.tail(abi_single_root_head_size<T>()))
    buffer
}

/// Encode a top-level return/output value.
///
/// Parameter-list types (tuples) are encoded without an outer offset word;
/// everything else uses the single-root layout.
#[inline(always)]
pub fn encode_return_alloc<A: Abi, T>(_ value: own T) -> ptr::MemBuffer
    where T: Encode<A> + AbiSize
{
    if T::IS_PARAM_LIST {
        return encode_alloc<A, T>(value)
    }
    encode_single_root_alloc<A, T>(value)
}

fn max_u256(a: u256, b: u256) -> u256 {
    if a >= b {
        a
    } else {
        b
    }
}

/// `ptr` advanced by the word `offset`, which lies within `ptr`'s
/// allocation and so fits `usize`.
#[inline(always)]
pub fn ptr_offset(_ ptr: *u8, _ offset: u256) -> *u8 {
    ptr::offset_bytes(ptr, word_to_usize(offset))
}

pub fn abi_field_end<A: Abi, T, I>(_ input: I, base: u256, pos: u256) -> u256
    where T: AbiSpan<A> + AbiSize,
          I: ByteInput
{
    if T::IS_DYNAMIC {
        let tail_rel = input.word_at(pos)
        let tail_at = checked_tail<A>(base, tail_rel)
        return T::payload_end(input, base: tail_at, pos: tail_at)
    }

    T::payload_end(input, base: base, pos: pos)
}

/// Folds one field of a record at `frame` into the record's payload end.
#[inline(always)]
pub fn abi_record_field_end<A: Abi, T, I>(_ input: I, _ frame: u256, _ head_pos: u256, _ input_len: u256, _ end: u256) -> u256
    where T: AbiSpan<A> + AbiSize,
          I: ByteInput
{
    max_u256(a: end, b: abi_field_end_with_input_len<A, T, I>(input, base: frame, pos: head_pos, input_len: input_len))
}

pub fn abi_field_end_with_input_len<A: Abi, T, I>(_ input: I, base: u256, pos: u256, input_len: u256) -> u256
    where T: AbiSpan<A> + AbiSize,
          I: ByteInput
{
    let end = if T::IS_DYNAMIC {
        let tail_rel = input.word_at(pos)
        let tail_at = checked_tail<A>(base, tail_rel)
        checked_frame_end<A>(tail_at, T::HEAD_SIZE, input_len)
        T::payload_end_with_input_len(input, base: tail_at, pos: tail_at, input_len: input_len)
    } else {
        T::payload_end_with_input_len(input, base: base, pos: pos, input_len: input_len)
    }
    // `AbiSpan` and `AbiSize` are safe traits, so a payload end reported past
    // the input is a decode error, not a range to copy.
    if end > input_len {
        A::decode_error()
    }
    end
}

fn round_up_words(_ len: u256) -> u256 {
    if len == 0 {
        return 0
    }
    (((len - 1) / 32) + 1) * 32
}

/// The largest word-aligned allocation. Decoders reject a payload that does
/// not fit it, and allocate the rest without the allocator's bound.
const MAX_PAYLOAD_LEN: u256 = ptr::MAX_ALLOCATION as u256 - 31

#[inline(always)]
fn checked_dynamic_payload_after_head<A: Abi, I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> (u256, u256) {
    let data_len = input.word_at(pos)
    // The caller has already validated the length word. Require the actual
    // bytes, few enough that they and the length word, rounded up to a word,
    // fit `MAX_PAYLOAD_LEN`.
    if data_len > input_len - (pos + 32) || data_len > MAX_PAYLOAD_LEN - 32 {
        A::decode_error()
    }
    let payload_size = (data_len + 63) & 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0

    (data_len, payload_size)
}

#[inline(always)]
fn checked_dynamic_payload<A: Abi, I: ByteInput>(_ input: I, _ pos: u256) -> (u256, u256) {
    let input_len = input.len()
    checked_dynamic_payload_with_input_len<A, I>(input, pos, input_len)
}

#[inline(always)]
fn checked_dynamic_payload_with_input_len<A: Abi, I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> (u256, u256) {
    checked_frame_end<A>(pos, 32, input_len)
    checked_dynamic_payload_after_head<A, I>(input, pos, input_len)
}

#[inline(always)]
fn copy_dynamic_payload_from<A: Abi, I: ByteInput>(_ input: I, _ pos: u256) -> (*u8, u256, u256) {
    let input_len = input.len()
    copy_dynamic_payload_from_with_input_len<A, I>(input, pos, input_len)
}

// Copy only validated payload bytes and clear the final allocated padding word.
// In particular, a bounded memory input may have unrelated data after its end.
// `dest` must have room for `size` bytes.
unsafe fn copy_dynamic_bytes<I: ByteInput>(_ input: I, _ pos: u256, _ dest: *u8, _ data_len: u256, _ size: u256) {
    copy_padded_payload(input, pos, dest, 32 + data_len, size)
}

unsafe fn copy_padded_payload<I: ByteInput>(_ input: I, _ pos: u256, _ dest: *u8, _ actual_size: u256, _ size: u256) {
    // Every owned tail includes a length word, so size >= 32. The copy
    // restores actual bytes in this word, including the whole word if aligned.
    store_word(ptr: ptr_offset(dest, size - 32), value: 0)
    input.copy_to_memory_unchecked(dest: dest, src_offset: pos, len: actual_size)
}

// An array payload lies within its input, so with the input at most
// `MAX_PAYLOAD_LEN` bytes the payload fits it, rounded up to a word or not.
// Owned tails of dynamic elements must remain word-aligned when embedded
// before another field.
#[arithmetic(unchecked)]
#[inline(always)]
fn checked_payload_size<A: Abi>(_ actual_size: u256, _ input_len: u256, padded: bool) -> u256 {
    if input_len > MAX_PAYLOAD_LEN {
        A::decode_error()
    }
    if padded { (actual_size + 31) & 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffe0 } else { actual_size }
}

/// A fresh tail holding the `actual_size` payload bytes at `pos` of
/// `input`, and its size: `actual_size`, rounded up to whole words when
/// `padded`, as owned tails of dynamic elements are. Reverts unless
/// `input_len` fits `MAX_PAYLOAD_LEN`.
///
/// The caller must ensure that the payload lies within the first
/// `input_len` bytes of `input`.
#[inline(always)]
pub unsafe fn copy_payload<A: Abi, I: ByteInput>(_ input: I, _ pos: u256, actual_size: u256, input_len: u256, padded: bool) -> (*u8, u256) {
    let size = checked_payload_size<A>(actual_size, input_len, padded)
    // A checked payload fits `MAX_PAYLOAD_LEN`.
    let data = ptr::alloc_bytes_unchecked(word_to_usize(size))
    if padded {
        copy_padded_payload(input, pos, data, actual_size, size)
    } else {
        input.copy_to_memory_unchecked(dest: data, src_offset: pos, len: size)
    }
    (data, size)
}

fn copy_dynamic_payload_from_with_input_len<A: Abi, I: ByteInput>(_ input: I, _ pos: u256, _ input_len: u256) -> (*u8, u256, u256) {
    let payload: (u256, u256) = checked_dynamic_payload_with_input_len<A, I>(input, pos, input_len)
    let data_len = payload.0
    let payload_size = payload.1
    // A checked payload fits `MAX_PAYLOAD_LEN`.
    let data_ptr = unsafe { ptr::alloc_bytes_unchecked(word_to_usize(payload_size)) }

    unsafe { copy_dynamic_bytes(input, pos, data_ptr, data_len, payload_size) }

    (data_ptr, data_len, payload_size)
}

// Fe strings are currently represented as a single packed word. This limits the
// ABI path here to strings whose runtime payload fits in 32 bytes.
#[inline(always)]
fn packed_string_len(_ word: u256) -> u256 {
    // Locate the highest nonzero byte with five binary-search steps. Each
    // shift removes a known number of whole bytes; no loop or mutable state
    // is needed, and constant string values fold to their exact ABI length.
    let n16 = ((word >> 128 != 0) as u256) << 4
    let word16 = word >> (n16 << 3)
    let n8 = ((word16 >> 64 != 0) as u256) << 3
    let word8 = word16 >> (n8 << 3)
    let n4 = ((word8 >> 32 != 0) as u256) << 2
    let word4 = word8 >> (n4 << 3)
    let n2 = ((word4 >> 16 != 0) as u256) << 1
    let word2 = word4 >> (n2 << 3)
    let n1 = (word2 >> 8 != 0) as u256
    (n16 | n8 | n4 | n2 | n1) + (word != 0) as u256
}

fn decode_string_payload_after_head<A: Abi, I: ByteInput, const N: usize>(_ input: I, _ pos: u256, _ data_len: u256) -> String<N> {
    let data_start = pos + 32
    if data_len > 32 || data_len > (N as u256) {
        A::decode_error()
    }

    let packed = if data_len == 0 {
        0
    } else {
        if data_len == 32 {
            input.word_at(data_start)
        } else {
            // The input may end immediately after the last string byte.
            // Load from a full scratch word only after a bounded copy.
            let scratch = ptr::alloc_bytes(32)
            unsafe {
                store_word(ptr: scratch, value: 0)
                input.copy_to_memory(dest: scratch, src_offset: data_start, len: data_len)
                mem_word_at(base: scratch, offset: 0) >> ((32 - data_len) * 8)
            }
        }
    }

    packed as String<N>
}

pub struct BytesView<I> {
    input: I,
    start: u256,
    len: usize,
}

impl<I> Copy for BytesView<I>
    where I: Copy
{}

impl<I> BytesView<I>
    where I: ByteInput + Copy
{
    pub fn try_new(input: I, start: u256, len: usize) -> Option<Self> {
        let input_len = input.len()
        if start > input_len || len as u256 > input_len - start {
            return Option::None
        }
        Option::Some(Self { input, start, len })
    }

    pub fn new(input: I, start: u256, len: usize) -> Self {
        match Self::try_new(input, start, len) {
            Option::Some(view) => view
            Option::None => super::panic()
        }
    }

    pub fn input(self) -> I {
        self.input
    }

    pub fn start(self) -> u256 {
        self.start
    }

    pub fn len(self) -> usize {
        self.len
    }

    pub fn is_empty(self) -> bool {
        self.len == 0
    }

    pub fn try_slice(self, offset: usize, len: usize) -> Option<Self> {
        if offset > self.len || len > self.len - offset {
            return Option::None
        }
        Option::Some(Self {
            input: self.input,
            start: self.start + offset as u256,
            len,
        })
    }

    pub fn slice(self, offset: usize, len: usize) -> Self {
        match self.try_slice(offset, len) {
            Option::Some(view) => view
            Option::None => super::panic()
        }
    }

    pub fn split_at(self, offset: usize) -> (Self, Self) {
        if offset > self.len {
            super::panic()
        }
        (
            self.truncate(len: offset),
            self.slice(offset, len: self.len - offset),
        )
    }

    pub fn truncate(self, len: usize) -> Self {
        self.slice(offset: 0, len)
    }

    pub fn get_byte(self, _ offset: usize) -> Option<u8> {
        if offset >= self.len {
            return Option::None
        }
        Option::Some(self.input.byte_at(self.start + offset as u256))
    }

    /// Read one byte, panicking when `offset` is outside this view.
    pub fn byte_at(self, _ offset: usize) -> u8 {
        match self.get_byte(offset) {
            Option::Some(value) => value
            Option::None => super::panic()
        }
    }

    pub fn get_word(self, _ offset: usize) -> Option<u256> {
        if offset >= self.len {
            return Option::None
        }

        let word = self.input.word_at(self.start + offset as u256)
        let remaining = (self.len - offset) as u256
        if remaining < 32 {
            let shift = (32 - remaining) * 8
            return Option::Some(word >> shift << shift)
        }
        Option::Some(word)
    }

    /// Read a word beginning at `offset`, zeroing bytes beyond this view.
    ///
    /// Panics when the first byte is outside the view.
    #[inline(always)]
    pub fn word_at(self, _ offset: usize) -> u256 {
        match self.get_word(offset) {
            Option::Some(value) => value
            Option::None => super::panic()
        }
    }
}

impl<I> ByteSource for BytesView<I>
    where I: ByteInput + Copy
{
    // A view lies within its input (`try_new`), so it is shorter.
    fn size(self) -> u64 {
        self.len.downcast_truncate()
    }

    fn word_at(self, _ byte_offset: u256) -> u256 {
        self.word_at(byte_offset.downcast_saturate())
    }

    fn byte_at(self, _ byte_offset: u256) -> u8 {
        self.byte_at(byte_offset.downcast_saturate())
    }

    unsafe fn copy_to_memory(self, dest: *u8, src_offset: u256, len: u256) {
        let view_len = self.len as u256
        if src_offset > view_len || len > view_len - src_offset {
            super::panic()
        }
        self.input.copy_to_memory_unchecked(dest, src_offset: self.start + src_offset, len)
    }
}

pub struct StringView<I> {
    pub bytes: BytesView<I>,
}

impl<I> Copy for StringView<I>
    where I: Copy
{}

impl<I> StringView<I>
    where I: ByteInput + Copy
{
    pub fn len(self) -> usize {
        self.bytes.len()
    }

    pub fn is_empty(self) -> bool {
        self.bytes.is_empty()
    }

    pub fn byte_at(self, _ offset: usize) -> u8 {
        self.bytes.byte_at(offset)
    }

    pub fn word_at(self, _ offset: usize) -> u256 {
        self.bytes.word_at(offset)
    }
}

/// Owned handle to a Solidity ABI `string` payload stored in linear memory.
///
/// `data` points at the ABI tail payload: the length word followed by packed
/// UTF-8 bytes padded to a whole word count.
pub struct DynString {
    unsafe data: *u8,
    unsafe len: usize,
    unsafe size: u256,
}

impl DynString {
    pub fn empty() -> Self {
        let data = ptr::alloc_bytes(32)
        unsafe { store_word(ptr: data, value: 0) }
        // A 32-byte tail holding length zero.
        unsafe {
            Self::from_validated_abi_tail(data: data, len: 0, size: 32)
        }
    }

    /// `data` must point to a validated ABI tail of `size` initialized
    /// bytes in a live allocation, holding `len` elements.
    unsafe fn from_validated_abi_tail(data: *u8, len: usize, size: u256) -> Self {
        DynString { data, len, size }
    }

    /// Wraps a complete ABI tail. `data` must point to `size` valid,
    /// initialized bytes in an allocation that outlives the value, which
    /// never frees it.
    pub unsafe fn from_abi_tail(data: *u8, len: usize, size: u256) -> Self {
        let expected_size = 32 + round_up_words(len as u256)
        if size != expected_size || mem_word_at(base: data, offset: 0) != len as u256 {
            super::panic()
        }
        Self::from_validated_abi_tail(data, len, size)
    }

    /// Allocates a string of `len` zero bytes, to be filled through `payload_span`.
    pub fn zeroed(_ len: usize) -> Self {
        let size = 32 + round_up_words(len as u256)
        let data = ptr::alloc_bytes(ptr::allocation_len(size))
        unsafe {
            ptr::zero_bytes(data, word_to_usize(size))
            store_word(ptr: data, value: len as u256)
        }
        // The tail was allocated and written above.
        unsafe {
            Self::from_validated_abi_tail(data: data, len: len, size: size)
        }
    }

    /// Returns the string made of the first `len` bytes of `word` (at most 32),
    /// e.g. a `bytes32` label.
    pub fn from_word_prefix(word: u256, len: usize) -> Self {
        let bytes = Bytes::from_word_prefix(word, len)
        // `bytes` holds a valid tail of the same layout.
        unsafe {
            Self::from_validated_abi_tail(data: bytes.data, len: bytes.len, size: bytes.size)
        }
    }

    /// Returns a copy of the `len` bytes starting at `start`.
    ///
    /// Fails with an index-out-of-bounds panic if the range exceeds the string.
    pub fn slice(self, start: usize, len: usize) -> Self {
        Self::from_payload(source: self.payload_span().slice(offset: start, len))
    }

    pub fn from_payload(source: ptr::MemSpan) -> Self {
        let len = source.len()
        let size = 32 + round_up_words(len as u256)
        let data = ptr::alloc_bytes(ptr::allocation_len(size))
        unsafe {
            ptr::zero_bytes(data, word_to_usize(size))
            store_word(ptr: data, value: len as u256)
            ptr::copy(dest: ptr::offset_bytes(data, 32), source)
        }
        // The tail was allocated and written above.
        unsafe {
            Self::from_validated_abi_tail(data: data, len: len, size: size)
        }
    }

    pub fn len(self) -> usize {
        self.len
    }

    pub fn is_empty(self) -> bool {
        self.len == 0
    }

    pub fn encoded_size(self) -> u256 {
        self.size
    }

    pub fn payload_span(self) -> ref ptr::MemSpan {
        unsafe {
            ptr::MemSpan::from_raw_parts(
                ptr: ptr::offset_bytes(self.data, 32),
                len: self.len,
            )
        }
    }

    pub fn encoded_span(self) -> ref ptr::MemSpan {
        unsafe { ptr::MemSpan::from_raw_parts(ptr: self.data, len: word_to_usize(self.size)) }
    }

    pub fn as_bytes(self) -> Bytes {
        // A string's tail is a valid bytes tail.
        unsafe {
            Bytes::from_validated_abi_tail(
                data: self.data,
                len: self.len,
                size: self.size,
            )
        }
    }

    pub fn byte_at(self, _ index: usize) -> u8 {
        self.payload_span().byte_at(index)
    }
}

/// Owned handle to a Solidity ABI `bytes` payload stored in linear memory.
///
/// `data` points at the ABI tail payload: the length word followed by packed
/// bytes data padded to a whole word count.
pub struct Bytes {
    unsafe data: *u8,
    unsafe len: usize,
    unsafe size: u256,
}

impl Bytes {
    pub fn empty() -> Self {
        let data = ptr::alloc_bytes(32)
        unsafe { store_word(ptr: data, value: 0) }
        // A 32-byte tail holding length zero.
        unsafe {
            Self::from_validated_abi_tail(data: data, len: 0, size: 32)
        }
    }

    /// `data` must point to a validated ABI tail of `size` initialized
    /// bytes in a live allocation, holding `len` elements.
    unsafe fn from_validated_abi_tail(data: *u8, len: usize, size: u256) -> Self {
        Bytes { data, len, size }
    }

    /// Wraps a complete ABI tail. `data` must point to `size` valid,
    /// initialized bytes in an allocation that outlives the value, which
    /// never frees it.
    pub unsafe fn from_abi_tail(data: *u8, len: usize, size: u256) -> Self {
        let expected_size = 32 + round_up_words(len as u256)
        if size != expected_size || mem_word_at(base: data, offset: 0) != len as u256 {
            super::panic()
        }
        Self::from_validated_abi_tail(data, len, size)
    }

    pub fn from_payload(source: ptr::MemSpan) -> Self {
        let len = source.len()
        let size = 32 + round_up_words(len as u256)
        let data = ptr::alloc_bytes(ptr::allocation_len(size))
        unsafe {
            ptr::zero_bytes(data, word_to_usize(size))
            store_word(ptr: data, value: len as u256)
            ptr::copy(dest: ptr::offset_bytes(data, 32), source)
        }
        // The tail was allocated and written above.
        unsafe {
            Self::from_validated_abi_tail(data: data, len: len, size: size)
        }
    }

    /// Build up to 32 bytes from the most-significant bytes of one word.
    #[inline(always)]
    pub fn from_word_prefix(word: u256, len: usize) -> Self {
        if len > 32 {
            super::panic()
        }
        if len == 0 {
            return Self::empty()
        }

        let data = ptr::alloc_bytes(64)
        let shift = (32 - len as u256) * 8
        unsafe {
            store_word(ptr: data, value: len as u256)
            store_word(
                ptr: ptr::offset_bytes(data, 32),
                value: word >> shift << shift,
            )
        }
        // The tail was allocated and written above.
        unsafe {
            Self::from_validated_abi_tail(data: data, len: len, size: 64)
        }
    }

    pub fn len(self) -> usize {
        self.len
    }

    pub fn is_empty(self) -> bool {
        self.len == 0
    }

    pub fn encoded_size(self) -> u256 {
        self.size
    }

    #[inline(always)]
    fn payload_ptr(self) -> *u8 {
        ptr::offset_bytes(self.data, 32)
    }

    #[inline(always)]
    pub fn payload_span(self) -> ref ptr::MemSpan {
        unsafe { ptr::MemSpan::from_raw_parts(ptr: self.payload_ptr(), len: self.len) }
    }

    #[inline(always)]
    pub fn encoded_span(self) -> ref ptr::MemSpan {
        unsafe { ptr::MemSpan::from_raw_parts(ptr: self.data, len: word_to_usize(self.size)) }
    }

    /// Read a word beginning at `offset`, zeroing bytes beyond the payload.
    ///
    /// Panics when the first byte is outside the payload.
    #[inline(always)]
    pub fn word_at(self, _ offset: usize) -> u256 {
        if offset >= self.len {
            super::panic()
        }
        // The word starts in the payload; see `mem_word_at` for the bytes
        // past the padded payload that an unaligned word reaches.
        let word = unsafe { mem_word_at(base: self.payload_ptr(), offset: offset as u256) }
        let remaining = (self.len - offset) as u256
        if remaining < 32 {
            let shift = (32 - remaining) * 8
            return word >> shift << shift
        }
        word
    }

    pub fn byte_at(self, _ index: usize) -> u8 {
        self.payload_span().byte_at(index)
    }
}

// Compares byte payloads a word at a time. Payloads of `Bytes` and `DynString`
// are padded to whole words, so the final word read stays inside the value.
fn payload_eq(_ a: ptr::MemSpan, _ b: ptr::MemSpan) -> bool {
    let len = a.len() as u256
    if len != b.len() as u256 {
        return false
    }
    unsafe {
        var offset: u256 = 0
        while offset + 32 <= len {
            if mem_word_at(base: a.ptr(), offset) != mem_word_at(base: b.ptr(), offset) {
                return false
            }
            offset += 32
        }
        let tail = len - offset
        if tail == 0 {
            return true
        }
        let shift = (32 - tail) * 8
        (mem_word_at(base: a.ptr(), offset) >> shift) == (mem_word_at(base: b.ptr(), offset) >> shift)
    }
}

impl Eq for Bytes {
    fn eq(self, _ other: Bytes) -> bool {
        payload_eq(self.payload_span(), other.payload_span())
    }
}

impl Eq for DynString {
    fn eq(self, _ other: DynString) -> bool {
        payload_eq(self.payload_span(), other.payload_span())
    }
}

// The word's first byte, at `offset` from `base`, must lie in a live
// allocation. Callers that read the last word of a span or payload let its
// other bytes run up to 31 bytes past the allocation and mask them off: EVM
// memory reads there are defined, while native targets need that much read
// slack after every allocation, which their allocator does not yet leave.
#[inline(always)]
unsafe fn mem_word_at(base: *u8, offset: u256) -> u256 {
    from_be(*ptr::cast<u8, u256>(ptr::offset_bytes(base, word_to_usize(offset))))
}

/// A span's bytes read past its end as zeros, like calldata's.
impl ByteSource for ptr::MemSpan {
    fn size(self) -> u64 {
        self.len().downcast_truncate()
    }

    #[arithmetic(unchecked)]
    #[inline(always)]
    fn word_at(self, _ byte_offset: u256) -> u256 {
        let len = self.len() as u256
        if byte_offset >= len {
            return 0
        }
        let word = unsafe { mem_word_at(base: self.ptr(), offset: byte_offset) }
        let available = len - byte_offset
        if available >= 32 {
            word
        } else {
            word & !(u256::max() >> (available * 8))
        }
    }

    #[arithmetic(unchecked)]
    fn byte_at(self, _ byte_offset: u256) -> u8 {
        if byte_offset >= self.len() as u256 {
            return 0
        }
        let word_offset = byte_offset - (byte_offset % 32)
        let word = unsafe { mem_word_at(base: self.ptr(), offset: word_offset) }
        let idx = byte_offset - word_offset
        let shift = (31 - idx) * 8
        (word >> shift).downcast_truncate()
    }

    unsafe fn copy_to_memory(self, dest: *u8, src_offset: u256, len: u256) {
        let span_len = self.len() as u256
        if src_offset > span_len || len > span_len - src_offset {
            super::panic()
        }

        ptr::copy_raw(
            dest,
            source: ptr::offset_bytes(self.ptr(), word_to_usize(src_offset)),
            len: word_to_usize(len),
        )
    }
}

impl AbiSize for u256 {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl<const N: usize> AbiSize for String<N> {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = true

    fn payload_size(self) -> u256 {
        // A packed string occupies at most one ABI data word.
        if self.to_word() == 0 { 32 } else { 64 }
    }
}

impl<T, const N: usize> AbiSize for [T; N]
    where T: AbiSize + Copy
{
    const HEAD_SIZE: u256 = (N as u256) * abi_field_head_size<T>()
    const IS_DYNAMIC: bool = T::IS_DYNAMIC

    fn payload_size(self) -> u256 {
        if !T::IS_DYNAMIC {
            return Self::HEAD_SIZE
        }

        var total = Self::HEAD_SIZE
        var i: usize = 0
        while i < N {
            total += self[i].payload_size()
            i += 1
        }
        total
    }
}

impl AbiSize for bool {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for u8 {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for u16 {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for u32 {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for u64 {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for u128 {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for i8 {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for i16 {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for i32 {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for i64 {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for i128 {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for i256 {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for usize {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for isize {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false
}

impl AbiSize for () {
    const HEAD_SIZE: u256 = 0
    const IS_DYNAMIC: bool = false
}

impl<T0> AbiSize for (T0,)
    where T0: AbiSize
{
    const HEAD_SIZE: u256 = abi_field_head_size<T0>()
    const IS_DYNAMIC: bool = T0::IS_DYNAMIC
    const IS_PARAM_LIST: bool = true

    #[arithmetic(unchecked)]
    #[inline(always)]
    fn payload_size(self) -> u256 {
        Self::HEAD_SIZE + dynamic_payload_size(self.0)
    }
}

impl<T0, T1> AbiSize for (T0, T1)
    where T0: AbiSize, T1: AbiSize
{
    const HEAD_SIZE: u256 = abi_field_head_size<T0>() + abi_field_head_size<T1>()
    const IS_DYNAMIC: bool = T0::IS_DYNAMIC || T1::IS_DYNAMIC
    const IS_PARAM_LIST: bool = true

    #[arithmetic(unchecked)]
    #[inline(always)]
    fn payload_size(self) -> u256 {
        Self::HEAD_SIZE + dynamic_payload_size(self.0) + dynamic_payload_size(self.1)
    }
}

impl<T0, T1, T2> AbiSize for (T0, T1, T2)
    where T0: AbiSize, T1: AbiSize, T2: AbiSize
{
    const HEAD_SIZE: u256 = abi_field_head_size<T0>() + abi_field_head_size<T1>() + abi_field_head_size<T2>()
    const IS_DYNAMIC: bool = T0::IS_DYNAMIC || T1::IS_DYNAMIC || T2::IS_DYNAMIC
    const IS_PARAM_LIST: bool = true

    #[arithmetic(unchecked)]
    #[inline(always)]
    fn payload_size(self) -> u256 {
        Self::HEAD_SIZE
            + dynamic_payload_size(self.0)
            + dynamic_payload_size(self.1)
            + dynamic_payload_size(self.2)
    }
}

impl<T0, T1, T2, T3> AbiSize for (T0, T1, T2, T3)
    where T0: AbiSize, T1: AbiSize, T2: AbiSize, T3: AbiSize
{
    const HEAD_SIZE: u256 =
        abi_field_head_size<T0>() + abi_field_head_size<T1>() + abi_field_head_size<T2>() + abi_field_head_size<T3>()
    const IS_DYNAMIC: bool = T0::IS_DYNAMIC || T1::IS_DYNAMIC || T2::IS_DYNAMIC || T3::IS_DYNAMIC
    const IS_PARAM_LIST: bool = true

    #[arithmetic(unchecked)]
    #[inline(always)]
    fn payload_size(self) -> u256 {
        Self::HEAD_SIZE
            + dynamic_payload_size(self.0)
            + dynamic_payload_size(self.1)
            + dynamic_payload_size(self.2)
            + dynamic_payload_size(self.3)
    }
