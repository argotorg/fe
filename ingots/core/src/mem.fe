//! Ending values early and moving them out of places that stay in use.
//!
//! `drop` destroys a value before its owner's scope ends, and `forget`
//! consumes one without destroying it.
//!
//! A value moved out of a `mut` place leaves a hole that must be filled
//! before the access ends. `replace` and `take` move the old value out and
//! the new one in at once:
//!
//! ```fe
//! use core::mem::{replace, take}
//!
//! let old = replace(mut pending.buffer, MemBuffer::empty())
//! let queued = take(mut pending.next) // `pending.next` is now `None`
//! ```
//!
//! Storage and transient places never hold a hole, so a non-`Copy` value
//! cannot be moved out of one.

use ingot::Default

/// Moves `value` into `dest` and returns the value `dest` held.
pub fn replace<T>(_ dest: mut T, _ value: own T) -> T {
    let old = dest
    dest = value
    old
}

/// Moves the value out of `dest`, leaving `T::default()` in its place.
pub fn take<T: Default>(_ dest: mut T) -> T {
    replace(mut dest, T::default())
}

/// Destroys `value` here, ending its lifetime before its owner's scope does.
pub fn drop<T>(_ value: own T) {}

extern {
    /// Consumes `value` without destroying it, so whatever it owns stays
    /// allocated. Leaking is memory-safe, so this is safe.
    pub fn forget<T>(_ value: own T)

    /// Whether destroying a `T` does anything on the target being compiled.
    /// Code that destroys values in bulk, such as a collection's elements,
    /// skips the work when it does not.
    pub fn needs_drop<T>() -> bool
}
