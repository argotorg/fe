use ingot::marker::{Clearable, Copy, Pinned}

pub trait Add<T = Self> {
    type Output = Self

    fn add(own self, _ other: own T) -> Self::Output
}

// Arithmetic binary operators
pub trait Sub<T = Self> {
    type Output = Self

    fn sub(own self, _ other: own T) -> Self::Output
}

pub trait Mul<T = Self> {
    type Output = Self
    fn mul(own self, _ other: own T) -> Self::Output
}

pub trait Div<T = Self> {
    type Output = Self

    fn div(own self, _ other: own T) -> Self::Output
}

pub trait Rem<T = Self> {
    type Output = Self

    fn rem(own self, _ other: own T) -> Self::Output
}

pub trait Pow<T = Self> {
    type Output = Self

    fn pow(own self, _ other: own T) -> Self::Output
}

// Wrapping arithmetic. In unchecked code, `a + b`, `a - b`, `a * b`, `a ** b`
// and `-a` on a non-primitive operand whose type implements these traits
// call them, and `a += b` is `a = a.wrapping_add(b)`. On other types they
// call the checked traits.
pub trait WrappingAdd<T = Self> {
    type Output = Self
    fn wrapping_add(self, _ other: T) -> Self::Output
}

pub trait WrappingSub<T = Self> {
    type Output = Self
    fn wrapping_sub(self, _ other: T) -> Self::Output
}

pub trait WrappingMul<T = Self> {
    type Output = Self
    fn wrapping_mul(self, _ other: T) -> Self::Output
}

pub trait WrappingPow<T = Self> {
    type Output = Self
    fn wrapping_pow(self, _ other: T) -> Self::Output
}

pub trait WrappingNeg {
    type Output = Self
    fn wrapping_neg(self) -> Self::Output
}

pub trait SaturatingAdd<T = Self> {
    type Output = Self
    fn saturating_add(self, _ other: T) -> Self::Output
}

pub trait SaturatingSub<T = Self> {
    type Output = Self
    fn saturating_sub(self, _ other: T) -> Self::Output
}

pub trait SaturatingMul<T = Self> {
    type Output = Self
    fn saturating_mul(self, _ other: T) -> Self::Output
}

// Bitwise binary operators
pub trait BitAnd<T = Self> {
    type Output = Self

    fn bitand(own self, _ other: own T) -> Self::Output
}

pub trait BitOr<T = Self> {
    type Output = Self

    fn bitor(own self, _ other: own T) -> Self::Output
}

pub trait BitXor<T = Self> {
    type Output = Self

    fn bitxor(own self, _ other: own T) -> Self::Output
}

// Shift operators
pub trait Shl<T = Self> {
    type Output = Self

    fn shl(own self, _ other: own T) -> Self::Output
}

pub trait Shr<T = Self> {
    type Output = Self

    fn shr(own self, _ other: own T) -> Self::Output
}

pub trait Neg {
    type Output = Self

    fn neg(own self) -> Self::Output
}

pub trait Not {
    type Output = Self

    fn not(own self) -> Self::Output
}

pub trait BitNot {
    type Output = Self

    fn bit_not(own self) -> Self::Output
}

// Comparison operators
pub trait Eq<T = Self> {
    fn eq(self, _ other: T) -> bool
    fn ne(self, _ other: T) -> bool {
        !self.eq(other)
    }
}

// Aggregate comparisons use element Eq implementations and short-circuit.
impl<T: Eq, const N: usize> Eq for [T; N] {
    fn eq(self, _ other: [T; N]) -> bool {
        var i: usize = 0
        while i < N {
            if !(self[i] == other[i]) {
                return false
            }
            i += 1
        }
        true
    }
}

impl Eq for () {
    fn eq(self, _ other: ()) -> bool {
        true
    }
}

impl<T0> Eq for (T0,) where T0: Eq {
    fn eq(self, _ other: (T0,)) -> bool {
        self.0 == other.0
    }
}

impl<T0, T1> Eq for (T0, T1) where T0: Eq, T1: Eq {
    fn eq(self, _ other: (T0, T1)) -> bool {
        self.0 == other.0 && self.1 == other.1
    }
}

impl<T0, T1, T2> Eq for (T0, T1, T2) where T0: Eq, T1: Eq, T2: Eq {
    fn eq(self, _ other: (T0, T1, T2)) -> bool {
        self.0 == other.0 && self.1 == other.1 && self.2 == other.2
    }
}

impl<T0, T1, T2, T3> Eq for (T0, T1, T2, T3) where T0: Eq, T1: Eq, T2: Eq, T3: Eq {
    fn eq(self, _ other: (T0, T1, T2, T3)) -> bool {
        self.0 == other.0 && self.1 == other.1 && self.2 == other.2 && self.3 == other.3
    }
}

impl<T0, T1, T2, T3, T4> Eq for (T0, T1, T2, T3, T4) where T0: Eq, T1: Eq, T2: Eq, T3: Eq, T4: Eq {
    fn eq(self, _ other: (T0, T1, T2, T3, T4)) -> bool {
        self.0 == other.0
            && self.1 == other.1
            && self.2 == other.2
            && self.3 == other.3
            && self.4 == other.4
    }
}

impl<T0, T1, T2, T3, T4, T5> Eq for (T0, T1, T2, T3, T4, T5)
where T0: Eq, T1: Eq, T2: Eq, T3: Eq, T4: Eq, T5: Eq {
    fn eq(self, _ other: (T0, T1, T2, T3, T4, T5)) -> bool {
        self.0 == other.0
            && self.1 == other.1
            && self.2 == other.2
            && self.3 == other.3
            && self.4 == other.4
            && self.5 == other.5
    }
}

pub trait Ord<T = Self> {
    fn lt(self, _ other: T) -> bool
    fn le(self, _ other: T) -> bool
    fn gt(self, _ other: T) -> bool
    fn ge(self, _ other: T) -> bool
}

/// Where an element of a `StateIndex` collection lies: its slot in the
/// collection's state space, and its bit offset within that slot's word.
pub struct Location {
    pub slot: u256,
    pub offset: u256,
}

/// A collection whose elements are places in a state space, as an array's
/// are places: `c[k]` names the element at `k` with no call, a path that the
/// access checker sees as `c` indexed by a dynamic key, and `c[k].f = v`
/// writes one field. A collection implements it by saying where an element
/// lives; the compiler calls `locate` once when it opens an access to the
/// element.
///
/// The collection is pinned to its space (`Pinned`): it lives at one number
/// there, and its region is its own fields at that number together with
/// every location `locate` returns. The trait is unsafe to implement: the
/// access checker relies on `locate` returning locations within that region,
/// and separated lanes for distinct keys, without checking it, so each
/// implementation is an `unsafe impl` that asserts both. A memory
/// collection, whose elements live in an allocation it owns, implements
/// `Index` instead.
pub unsafe trait StateIndex: Pinned {
    /// The index operand, evaluated once and retained by the access.
    type Key: Copy
    /// The element's type.
    type Entry
    /// The codec of elements packed into lanes: an element is a lane of
    /// `Lanes::BITS` bits when `Lanes: LaneCodec<Entry>` with `BITS` at most
    /// 128, and otherwise keeps its type's storage layout. `()` packs none.
    type Lanes = ()

    /// The location of the element at `key` of the collection rooted at
    /// `root`. It declares no effects: it may read the collection's own
    /// region, such as a length to check `key` against, and nothing else.
    fn locate(self, _ root: u256, _ key: Self::Key) -> Location
}

/// Zeroes the element at `key` of a collection: its slots, or only its bits
/// of a slot it shares. The element must be `Clearable`: zero is a value of
/// it, and one holding a storage collection is not cleared by zeroing its own
/// slots.
pub fn clear_storage<C: StateIndex>(_ collection: mut C, _ key: C::Key)
    where C::Entry: Clearable
{
    unsafe { ingot::intrinsic::clear(mut collection[key]) }
}

/// How a place-indexed collection encodes an element it packs into a lane:
/// `BITS` bits of a storage word, `offset` bits above its low end, shared
/// with the neighbouring elements. Reading the element loads the word and
/// decodes it with `get`; writing it stores the word `set` returns, so only
/// the element's bits change. A `BITS` above 128 packs nothing: the element
/// keeps its type's storage layout, `core::intrinsic::storage_slots<T>()`
/// slots, which a collection's `locate` steps by from one element to the
/// next.
pub trait LaneCodec<T> {
    const BITS: u256
    /// The element in `word`'s lane at bit `offset`.
    fn get(_ word: u256, offset: u256) -> T
    /// `word` with its lane at bit `offset` holding `value`.
    fn set(_ word: u256, offset: u256, value: own T) -> u256
}

/// `t[i]`: at `mut` where the context needs a `mut` place (an assignment
/// target, `mut t[i]`, or a `mut self` method's receiver), which takes
/// `T: mut Index<I>`.
pub trait Index<I> {
    /// The effects of reaching an element.
    uses E
    type Output

    fn index(mut? self, _ index: I) -> mut? Self::Output uses E
}

/// The number of elements of a collection indexed by position: its
/// `Index<usize>` reaches `0..len()`.
pub trait Len {
    fn len(self) -> usize
}

// An array index is built-in place syntax; this impl lets generic code
// index an array through `Index`.
impl<T, const N: usize> Index<usize> for [T; N] {
    type Output = T

    #[inline(always)]
    fn index(mut? self, _ index: usize) -> mut? T {
        mut? self[index]
    }
}

impl<T, const N: usize> Len for [T; N] {
    fn len(self) -> usize {
        N
    }
}

// Augmented assignment operators (return unit)
pub trait AddAssign<T = Self> {
    fn add_assign(mut self, _ other: own T)
}

pub trait SubAssign<T = Self> {
    fn sub_assign(mut self, _ other: own T)
}

pub trait MulAssign<T = Self> {
    fn mul_assign(mut self, _ other: own T)
}

pub trait DivAssign<T = Self> {
    fn div_assign(mut self, _ other: own T)
}

pub trait RemAssign<T = Self> {
    fn rem_assign(mut self, _ other: own T)
}

pub trait PowAssign<T = Self> {
    fn pow_assign(mut self, _ other: own T)
}

pub trait ShlAssign<T = Self> {
    fn shl_assign(mut self, _ other: own T)
}

pub trait ShrAssign<T = Self> {
    fn shr_assign(mut self, _ other: own T)
}

pub trait BitAndAssign<T = Self> {
    fn bitand_assign(mut self, _ other: own T)
}

pub trait BitOrAssign<T = Self> {
    fn bitor_assign(mut self, _ other: own T)
}

pub trait BitXorAssign<T = Self> {
    fn bitxor_assign(mut self, _ other: own T)
}

/// Destroys a value when its owner gives it up: at the end of the owner's
/// scope, when the value is overwritten, or for the fields a partial move
/// leaves behind. `drop` runs once, then the fields it did not move out are
/// destroyed in declaration order.
///
/// A drop runs where no call is written, so `drop` declares no effects, and
/// nothing calls it directly: `core::mem::drop` ends a value early. An
/// implementation covers the whole type, as `impl<T> Drop for Buf<T>` does,
/// and a type with one is never `Copy`.
pub trait Drop {
    fn drop(own self)
}
