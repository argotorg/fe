use ingot::option::Option
use ingot::marker::Copy
use ingot::ops::{WrappingAdd, WrappingSub}
use ingot::ptr::{MemArray, MemSlice}
use ingot::{assert, panic_code}
use ingot::panics::PANIC_ASSERT
use ingot::functional::FnMut_v

/// A collection a loop traverses by cursor, projecting each element in turn.
///
/// The loop holds the collection while it runs; the cursor is a plain value
/// that names a position and holds no reference to the collection. A
/// position may name no element, as the one after the last does; the loop
/// tests each with `has` before it steps from it or projects its element.
pub trait Collection {
    /// The effects of reaching an element, retained while an element is open.
    uses E
    /// The address space of the projected elements.
    space S
    type Cursor: Copy
    type Item

    /// The first position; one that names no element if there are none.
    fn start(self) -> Self::Cursor uses E

    /// Whether `c` names an element.
    fn has(self, _ c: Self::Cursor) -> bool uses E

    /// The position after `c`; `has(c)` must hold.
    fn next(self, _ c: Self::Cursor) -> Self::Cursor uses E

    /// The element at `c`; `has(c)` must hold.
    fn at(self, _ c: Self::Cursor) -> ref Self::Item @S uses E

    /// Each element with its index: `for (i, x) in xs.enumerate()`.
    fn enumerate(self) -> Enumerate<Identity> {
        enumerate()
    }

    /// The first `n` elements.
    fn take(self, _ n: usize) -> Take<Identity> {
        take(n)
    }

    /// The elements after the first `n`.
    fn skip(self, _ n: usize) -> Skip<Identity> {
        skip(n)
    }

    /// Every `k`th element.
    fn step_by(self, _ k: usize) -> StepBy<Identity> {
        step_by(k)
    }

    /// The elements `p` holds for.
    fn filter<P: Fn(Self::Item) -> bool>(self, _ p: own P) -> Filter<Identity, P> {
        filter(p)
    }

    /// The values `f` makes of the elements, owned.
    fn map<F: FnMut_v<Self::Item>>(self, _ f: own F) -> Map<Identity, F> {
        map(f)
    }

    /// `f` applied to each element in turn, threading an accumulator from
    /// `init`: the accumulator is owned and each element viewed, so neither
    /// needs to be `Copy`.
    fn fold<A, F: FnMut(own A, Self::Item) -> A>(self, _ init: own A, _ f: mut F) -> A
        uses (E, F::E)
    {
        var acc = init
        for ref x in self {
            acc = f(acc, x)
        }
        acc
    }

    /// Whether `p` holds for some element.
    fn any<P: Fn(Self::Item) -> bool>(self, _ p: P) -> bool uses (E, P::E) {
        for ref x in self {
            if p(x) {
                return true
            }
        }
        false
    }

    /// How many elements `p` holds for.
    fn count<P: Fn(Self::Item) -> bool>(self, _ p: P) -> usize uses (E, P::E) {
        var n = 0
        for ref x in self {
            if p(x) {
                n += 1
            }
        }
        n
    }

    /// The position of the first element `p` holds for.
    fn find<P: Fn(Self::Item) -> bool>(self, _ p: P) -> Option<Self::Cursor> uses (E, P::E) {
        var c = self.start()
        while self.has(c) {
            if p(Collection::at(self, c)) {
                return Option::Some(c)
            }
            c = self.next(c)
        }
        Option::None
    }
}

/// A collection whose elements a loop can mutate in place.
pub trait CollectionMut: Collection {
    /// The element at `c`, to mutate.
    fn at_mut(mut self, _ c: Self::Cursor) -> mut Self::Item @S uses E
}

/// A collection that can also be traversed from its end.
pub trait Bidirectional: Collection {
    /// The last position; one that names no element if there are none.
    fn last(self) -> Self::Cursor uses E

    /// The position before `c`; `has(c)` must hold. The position before the
    /// first element names none, as the one after the last does.
    fn prev(self, _ c: Self::Cursor) -> Self::Cursor uses E

    /// Each element from the last to the first.
    fn reversed(self) -> Reversed {
        reversed()
    }
}

// Index cursors wrap: the position before index 0 and the last position of
// an empty collection are both the largest index, so `c < len` tests a
// position in either direction. A position `has` holds for is below the
// length, so stepping from it cannot overflow.

impl<T, const N: usize> [T; N] {
    pub fn len(self) -> usize {
        N
    }
}

// An array's elements are its own parts, wherever it lies, unless they are
// pinned elsewhere.
impl<T, const N: usize> Collection for [T; N] {
    space S = self[_]
    type Cursor = usize
    type Item = T

    #[inline(always)]
    fn start(self) -> usize {
        0
    }

    #[inline(always)]
    fn has(self, _ c: usize) -> bool {
        c < N
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> usize {
        c.wrapping_add(1)
    }

    #[inline(always)]
    fn at(self, _ c: usize) -> ref T {
        ref self[c]
    }
}

impl<T, const N: usize> CollectionMut for [T; N] {
    #[inline(always)]
    fn at_mut(mut self, _ c: usize) -> mut T {
        mut self[c]
    }
}

impl<T, const N: usize> Bidirectional for [T; N] {
    #[inline(always)]
    fn last(self) -> usize {
        N.wrapping_sub(1)
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> usize {
        c.wrapping_sub(1)
    }
}

impl<T> Collection for MemArray<T> {
    space S = memory
    type Cursor = usize
    type Item = T

    #[inline(always)]
    fn start(self) -> usize {
        0
    }

    #[inline(always)]
    fn has(self, _ c: usize) -> bool {
        (c as u256) < self.len()
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> usize {
        c.wrapping_add(1)
    }

    #[inline(always)]
    fn at(self, _ c: usize) -> ref T {
        ref self[c]
    }
}

impl<T> CollectionMut for MemArray<T> {
    #[inline(always)]
    fn at_mut(mut self, _ c: usize) -> mut T {
        mut self[c]
    }
}

impl<T> Bidirectional for MemArray<T> {
    #[inline(always)]
    fn last(self) -> usize {
        (self.len() as usize).wrapping_sub(1)
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> usize {
        c.wrapping_sub(1)
    }
}

impl<T> Collection for MemSlice<T> {
    space S = memory
    type Cursor = usize
    type Item = T

    #[inline(always)]
    fn start(self) -> usize {
        0
    }

    #[inline(always)]
    fn has(self, _ c: usize) -> bool {
        (c as u256) < self.len()
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> usize {
        c.wrapping_add(1)
    }

    #[inline(always)]
    fn at(self, _ c: usize) -> ref T {
        ref self[c]
    }
}

impl<T> CollectionMut for MemSlice<T> {
    #[inline(always)]
    fn at_mut(mut self, _ c: usize) -> mut T {
        mut self[c]
    }
}

impl<T> Bidirectional for MemSlice<T> {
    #[inline(always)]
    fn last(self) -> usize {
        (self.len() as usize).wrapping_sub(1)
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> usize {
        c.wrapping_sub(1)
    }
}

/// A traversal of a base collection `B` that a loop holds and passes to each
/// call. A driver stores its state and parameters, never the base, so it is
/// an ordinary value: built, stored, returned and reused.
pub trait Driver<B: Collection> {
    /// The driver's own effects; each method declares the base's.
    uses E
    type State: Copy
    type Item
    /// What the driver yields beside each element, such as its index.
    type Extra = ()

    /// The first state; one that names no element if there are none.
    fn start(self, _ base: B) -> Self::State uses (B::E, E)

    /// Whether `s` names an element.
    fn has(self, _ base: B, _ s: Self::State) -> bool uses (B::E, E)

    /// The state after `s`; `has(s)` must hold.
    fn next(self, _ base: B, _ s: Self::State) -> Self::State uses (B::E, E)

    /// The element at `s`; `has(s)` must hold.
    fn at(self, _ base: B, _ s: Self::State) -> (Self::Extra, ref Self::Item) @B::S uses (B::E, E)
}

/// A driver whose elements a loop can mutate in place.
pub trait DriverMut<B: CollectionMut>: Driver<B> {
    fn at_mut(self, _ base: mut B, _ s: Self::State) -> (Self::Extra, mut Self::Item) @B::S uses (B::E, E)
}

/// A traversal that produces an owned value at each position, so non-`Copy`
/// results can be collected.
pub trait Producer<B: Collection> {
    uses E
    type State: Copy
    type Out

    /// The first state; one that names no element if there are none.
    fn start(self, _ base: B) -> Self::State uses (B::E, E)

    /// Whether `s` names an element.
    fn has(self, _ base: B, _ s: Self::State) -> bool uses (B::E, E)

    /// The state after `s`; `has(s)` must hold.
    fn next(self, _ base: B, _ s: Self::State) -> Self::State uses (B::E, E)

    /// The value made at `s`; `has(s)` must hold.
    fn produce(mut self, _ base: B, _ s: Self::State) -> Self::Out uses (B::E, E)
}

/// The traversal `for x in xs` runs: each element in order.
pub struct Identity {}

impl Copy for Identity {}

impl<B: Collection> Driver<B> for Identity {
    type State = B::Cursor
    type Item = B::Item

    #[inline(always)]
    fn start(self, _ base: B) -> B::Cursor uses B::E {
        base.start()
    }

    #[inline(always)]
    fn has(self, _ base: B, _ s: B::Cursor) -> bool uses B::E {
        base.has(s)
    }

    #[inline(always)]
    fn next(self, _ base: B, _ s: B::Cursor) -> B::Cursor uses B::E {
        base.next(s)
    }

    #[inline(always)]
    fn at(self, _ base: B, _ s: B::Cursor) -> ((), ref B::Item) uses B::E {
        ((), Collection::at(base, s))
    }
}

impl<B: CollectionMut> DriverMut<B> for Identity {
    #[inline(always)]
    fn at_mut(self, _ base: mut B, _ s: B::Cursor) -> ((), mut B::Item) uses B::E {
        ((), CollectionMut::at_mut(mut base, s))
    }
}

/// Each element from the last to the first.
pub struct Reversed {}

impl Copy for Reversed {}

impl<B: Bidirectional> Driver<B> for Reversed {
    type State = B::Cursor
    type Item = B::Item

    #[inline(always)]
    fn start(self, _ base: B) -> B::Cursor uses B::E {
        base.last()
    }

    #[inline(always)]
    fn has(self, _ base: B, _ s: B::Cursor) -> bool uses B::E {
        base.has(s)
    }

    #[inline(always)]
    fn next(self, _ base: B, _ s: B::Cursor) -> B::Cursor uses B::E {
        base.prev(s)
    }

    #[inline(always)]
    fn at(self, _ base: B, _ s: B::Cursor) -> ((), ref B::Item) uses B::E {
        ((), Collection::at(base, s))
    }
}

impl<B: Bidirectional + CollectionMut> DriverMut<B> for Reversed {
    #[inline(always)]
    fn at_mut(self, _ base: mut B, _ s: B::Cursor) -> ((), mut B::Item) uses B::E {
        ((), CollectionMut::at_mut(mut base, s))
    }
}

/// Each element of the inner traversal with its index.
pub struct Enumerate<D> {
    inner: D,
}

impl<D: Copy> Copy for Enumerate<D> {}

impl<B: Collection, D: Driver<B>> Driver<B> for Enumerate<D> {
    uses E = D::E
    type State = (usize, D::State)
    type Item = D::Item
    type Extra = usize

    #[inline(always)]
    fn start(self, _ base: B) -> (usize, D::State) uses (B::E, E) {
        (0, self.inner.start(base))
    }

    #[inline(always)]
    fn has(self, _ base: B, _ s: (usize, D::State)) -> bool uses (B::E, E) {
        self.inner.has(base, s.1)
    }

    #[inline(always)]
    fn next(self, _ base: B, _ s: (usize, D::State)) -> (usize, D::State) uses (B::E, E) {
        (s.0 + 1, self.inner.next(base, s.1))
    }

    #[inline(always)]
    fn at(self, _ base: B, _ s: (usize, D::State)) -> (usize, ref D::Item) uses (B::E, E) {
        let (_, ref item) = Driver<B>::at(self.inner, base, s.1)
        (s.0, item)
    }
}

impl<B: CollectionMut, D: DriverMut<B>> DriverMut<B> for Enumerate<D> {
    #[inline(always)]
    fn at_mut(self, _ base: mut B, _ s: (usize, D::State)) -> (usize, mut D::Item) uses (B::E, E) {
        let (_, mut item) = DriverMut<B>::at_mut(self.inner, mut base, s.1)
        (s.0, item)
    }
}

/// The first `n` elements of the inner traversal.
pub struct Take<D> {
    n: usize,
    inner: D,
}

impl<D: Copy> Copy for Take<D> {}

impl<B: Collection, D: Driver<B>> Driver<B> for Take<D> {
    uses E = D::E
    type State = (usize, D::State)
    type Item = D::Item
    type Extra = D::Extra

    // The state counts the elements before its own, and stops advancing the
    // inner traversal at the limit, where a filter would scan on.
    #[inline(always)]
    fn start(self, _ base: B) -> (usize, D::State) uses (B::E, E) {
        (0, self.inner.start(base))
    }

    #[inline(always)]
    fn has(self, _ base: B, _ s: (usize, D::State)) -> bool uses (B::E, E) {
        s.0 < self.n && self.inner.has(base, s.1)
    }

    #[inline(always)]
    fn next(self, _ base: B, _ s: (usize, D::State)) -> (usize, D::State) uses (B::E, E) {
        if s.0 + 1 < self.n { (s.0 + 1, self.inner.next(base, s.1)) } else { (self.n, s.1) }
    }

    #[inline(always)]
    fn at(self, _ base: B, _ s: (usize, D::State)) -> (D::Extra, ref D::Item) uses (B::E, E) {
        Driver<B>::at(self.inner, base, s.1)
    }
}

impl<B: CollectionMut, D: DriverMut<B>> DriverMut<B> for Take<D> {
    #[inline(always)]
    fn at_mut(self, _ base: mut B, _ s: (usize, D::State)) -> (D::Extra, mut D::Item) uses (B::E, E) {
        DriverMut<B>::at_mut(self.inner, mut base, s.1)
    }
}

/// The inner traversal after its first `n` elements.
pub struct Skip<D> {
    n: usize,
    inner: D,
}

impl<D: Copy> Copy for Skip<D> {}

impl<B: Collection, D: Driver<B>> Driver<B> for Skip<D> {
    uses E = D::E
    type State = D::State
    type Item = D::Item
    type Extra = D::Extra

    #[inline(always)]
    fn start(self, _ base: B) -> D::State uses (B::E, E) {
        var s = self.inner.start(base)
        var skipped = 0
        while skipped < self.n && self.inner.has(base, s) {
            s = self.inner.next(base, s)
            skipped += 1
        }
        s
    }

    #[inline(always)]
    fn has(self, _ base: B, _ s: D::State) -> bool uses (B::E, E) {
        self.inner.has(base, s)
    }

    #[inline(always)]
    fn next(self, _ base: B, _ s: D::State) -> D::State uses (B::E, E) {
        self.inner.next(base, s)
    }

    #[inline(always)]
    fn at(self, _ base: B, _ s: D::State) -> (D::Extra, ref D::Item) uses (B::E, E) {
        Driver<B>::at(self.inner, base, s)
    }
}

impl<B: CollectionMut, D: DriverMut<B>> DriverMut<B> for Skip<D> {
    #[inline(always)]
    fn at_mut(self, _ base: mut B, _ s: D::State) -> (D::Extra, mut D::Item) uses (B::E, E) {
        DriverMut<B>::at_mut(self.inner, mut base, s)
    }
}

/// Every `k`th element of the inner traversal, from its first.
pub struct StepBy<D> {
    k: usize,
    inner: D,
}

impl<D: Copy> Copy for StepBy<D> {}

impl<B: Collection, D: Driver<B>> Driver<B> for StepBy<D> {
    uses E = D::E
    type State = D::State
    type Item = D::Item
    type Extra = D::Extra

    #[inline(always)]
    fn start(self, _ base: B) -> D::State uses (B::E, E) {
        self.inner.start(base)
    }

    #[inline(always)]
    fn has(self, _ base: B, _ s: D::State) -> bool uses (B::E, E) {
        self.inner.has(base, s)
    }

    // Stops at the end of the inner traversal rather than stepping past it.
    #[inline(always)]
    fn next(self, _ base: B, _ s: D::State) -> D::State uses (B::E, E) {
        var s = self.inner.next(base, s)
        var stepped = 1
        while stepped < self.k && self.inner.has(base, s) {
            s = self.inner.next(base, s)
            stepped += 1
        }
        s
    }

    #[inline(always)]
    fn at(self, _ base: B, _ s: D::State) -> (D::Extra, ref D::Item) uses (B::E, E) {
        Driver<B>::at(self.inner, base, s)
    }
}

impl<B: CollectionMut, D: DriverMut<B>> DriverMut<B> for StepBy<D> {
    #[inline(always)]
    fn at_mut(self, _ base: mut B, _ s: D::State) -> (D::Extra, mut D::Item) uses (B::E, E) {
        DriverMut<B>::at_mut(self.inner, mut base, s)
    }
}

/// Owned copies of the `Copy` items of a driver, with what it yields beside
/// them.
pub struct Copied<D> {
    inner: D,
}

impl<D: Copy> Copy for Copied<D> {}

impl<B: Collection, D: Driver<B>> Producer<B> for Copied<D>
    where D::Item: Copy, D::Extra: Copy
{
    uses E = D::E
    type State = D::State
    type Out = (D::Extra, D::Item)

    #[inline(always)]
    fn start(self, _ base: B) -> D::State uses (B::E, E) {
        self.inner.start(base)
    }

    #[inline(always)]
    fn has(self, _ base: B, _ s: D::State) -> bool uses (B::E, E) {
        self.inner.has(base, s)
    }

    #[inline(always)]
    fn next(self, _ base: B, _ s: D::State) -> D::State uses (B::E, E) {
        self.inner.next(base, s)
    }

    #[inline(always)]
    fn produce(mut self, _ base: B, _ s: D::State) -> (D::Extra, D::Item) uses (B::E, E) {
        let (extra, item) = Driver<B>::at(self.inner, base, s)
        (extra, item)
    }
}

/// The elements of the inner traversal that `p` holds for.
pub struct Filter<D, P> {
    inner: D,
    p: P,
}

impl<D: Copy, P: Copy> Copy for Filter<D, P> {}

/// The first state from `s` on whose element `d`'s predicate holds, or the
/// inner traversal's end.
fn filtered<B: Collection, D: Driver<B>, P: Fn(D::Item) -> bool>(
    _ d: Filter<D, P>,
    _ base: B,
    _ s: D::State,
) -> D::State uses (B::E, D::E, P::E) {
    var s = s
    while d.inner.has(base, s) {
        let (_, ref item) = Driver<B>::at(d.inner, base, s)
        if (d.p)(item) {
            return s
        }
        s = d.inner.next(base, s)
    }
    s
}

impl<B: Collection, D: Driver<B>, P: Fn(D::Item) -> bool> Driver<B> for Filter<D, P> {
    uses E = (D::E, P::E)
    type State = D::State
    type Item = D::Item
    type Extra = D::Extra

    fn start(self, _ base: B) -> D::State uses (B::E, E) {
        filtered(self, base, self.inner.start(base))
    }

    fn has(self, _ base: B, _ s: D::State) -> bool uses (B::E, E) {
        self.inner.has(base, s)
    }

    fn next(self, _ base: B, _ s: D::State) -> D::State uses (B::E, E) {
        filtered(self, base, self.inner.next(base, s))
    }

    fn at(self, _ base: B, _ s: D::State) -> (D::Extra, ref D::Item) uses (B::E, E) {
        Driver<B>::at(self.inner, base, s)
    }
}

impl<B: CollectionMut, D: DriverMut<B>, P: Fn(D::Item) -> bool> DriverMut<B> for Filter<D, P> {
    fn at_mut(self, _ base: mut B, _ s: D::State) -> (D::Extra, mut D::Item) uses (B::E, E) {
        DriverMut<B>::at_mut(self.inner, mut base, s)
    }
}

/// The values `f` makes of the inner traversal's elements, owned.
pub struct Map<D, F> {
    inner: D,
    f: F,
}

impl<B: Collection, D: Driver<B>, F: FnMut_v<D::Item>> Producer<B> for Map<D, F> {
    uses E = (D::E, F::E)
    type State = D::State
    type Out = F::Out

    fn start(self, _ base: B) -> D::State uses (B::E, E) {
        self.inner.start(base)
    }

    fn has(self, _ base: B, _ s: D::State) -> bool uses (B::E, E) {
        self.inner.has(base, s)
    }

    fn next(self, _ base: B, _ s: D::State) -> D::State uses (B::E, E) {
        self.inner.next(base, s)
    }

    fn produce(mut self, _ base: B, _ s: D::State) -> F::Out uses (B::E, E) {
        let (_, ref item) = Driver<B>::at(self.inner, base, s)
        (self.f)(item)
    }
}

/// The combinators every driver has.
pub trait Adapt {
    fn enumerate(own self) -> Enumerate<Self> {
        Enumerate { inner: self }
    }

    fn take(own self, _ n: usize) -> Take<Self> {
        Take { n, inner: self }
    }

    fn skip(own self, _ n: usize) -> Skip<Self> {
        Skip { n, inner: self }
    }

    fn step_by(own self, _ k: usize) -> StepBy<Self> {
        assert(k > 0)
        StepBy { k, inner: self }
    }

    fn copied(own self) -> Copied<Self> {
        Copied { inner: self }
    }

    fn filter<P>(own self, _ p: own P) -> Filter<Self, P> {
        Filter { inner: self, p }
    }

    fn map<F>(own self, _ f: own F) -> Map<Self, F> {
        Map { inner: self, f }
    }
}

impl Adapt for Identity {}
impl Adapt for Reversed {}
impl<D> Adapt for Enumerate<D> {}
impl<D> Adapt for Take<D> {}
impl<D> Adapt for Skip<D> {}
impl<D> Adapt for StepBy<D> {}
impl<D, P> Adapt for Filter<D, P> {}

pub fn reversed() -> Reversed {
    Reversed {}
}

pub fn enumerate() -> Enumerate<Identity> {
    Identity {}.enumerate()
}

pub fn take(_ n: usize) -> Take<Identity> {
    Identity {}.take(n)
}

pub fn skip(_ n: usize) -> Skip<Identity> {
    Identity {}.skip(n)
}

pub fn step_by(_ k: usize) -> StepBy<Identity> {
    Identity {}.step_by(k)
}

pub fn filter<P>(_ p: own P) -> Filter<Identity, P> {
    Identity {}.filter(p)
}

pub fn map<F>(_ f: own F) -> Map<Identity, F> {
    Identity {}.map(f)
}

/// A container a producer's owned values are collected into, of the same
/// shape whatever their type.
pub trait FromProducer
    where Self: * -> *
{
    fn collect<B: Collection, P: Producer<B, Out = T>, T>(_ base: B, _ p: own P) -> Self<T>
        uses (B::E, P::E)
}

impl FromProducer for MemArray {
    fn collect<B: Collection, P: Producer<B, Out = T>, T>(_ base: B, _ p: own P) -> MemArray<T>
        uses (B::E, P::E)
    {
        var p = p
        var len: u256 = 0
        var s = p.start(base)
        while p.has(base, s) {
            len += 1
            s = p.next(base, s)
        }
        // Each element is initialized below before anything reads it: a
        // second pass that yields more elements reverts at the bounds check,
        // and one that yields fewer, its producer having changed its own
        // traversal, reverts before the uninitialized rest can be read.
        var out = unsafe { MemArray<T>::new_uninit(len) }
        var i: usize = 0
        s = p.start(base)
        while p.has(base, s) {
            out[i] = p.produce(base, s)
            i += 1
            s = p.next(base, s)
        }
        if i as u256 != len {
            panic_code(PANIC_ASSERT)
        }
        out
    }
}
