use ingot::option::Option
use ingot::marker::Copy
use ingot::ops::{WrappingAdd, WrappingSub}
use ingot::ptr::{MemArray, MemSlice, MemVec}
use ingot::{assert, panic_code}
use ingot::panics::PANIC_ASSERT
use ingot::functional::FnMut_v

/// A collection a loop traverses by cursor, projecting each element in turn.
///
/// The loop holds the collection while it runs; the cursor is a plain value
/// that names a position and holds no reference to the collection.
pub trait Collection {
    /// The effects of reaching an element, retained while an element is open.
    uses E
    /// The address space of the projected elements.
    space S
    type Cursor: Copy
    type Item

    /// The first position, if any.
    fn start(self) -> Option<Self::Cursor> uses E

    /// The position after `c`, if any.
    fn next(self, _ c: Self::Cursor) -> Option<Self::Cursor> uses E

    /// The element at `c`.
    fn at(self, _ c: Self::Cursor) -> ref Self::Item @S uses E

    /// Each element with its index: `for (i, x) in xs.enumerate()`.
    fn enumerate(self) -> Enumerate<Identity> {
        enumerate()
    }

    /// The first `n` elements.
    fn take(self, _ n: usize) -> Take<Identity> {
        take(n)
    }

    /// The elements after the first `n`.
    fn skip(self, _ n: usize) -> Skip<Identity> {
        skip(n)
    }

    /// Every `k`th element.
    fn step_by(self, _ k: usize) -> StepBy<Identity> {
        step_by(k)
    }

    /// The elements `p` holds for.
    fn filter<P: Fn(Self::Item) -> bool>(self, _ p: own P) -> Filter<Identity, P> {
        filter(p)
    }

    /// The values `f` makes of the elements, owned.
    fn map<F: FnMut_v<Self::Item>>(self, _ f: own F) -> Map<Identity, F> {
        map(f)
    }

    /// `f` applied to each element in turn, threading an accumulator from
    /// `init`: the accumulator is owned and each element viewed, so neither
    /// needs to be `Copy`.
    fn fold<A, F: FnMut(own A, Self::Item) -> A>(self, _ init: own A, _ f: mut F) -> A
        uses (E, F::E)
    {
        var acc = init
        for ref x in self {
            acc = f(acc, x)
        }
        acc
    }

    /// Whether `p` holds for some element.
    fn any<P: Fn(Self::Item) -> bool>(self, _ p: P) -> bool uses (E, P::E) {
        for ref x in self {
            if p(x) {
                return true
            }
        }
        false
    }

    /// How many elements `p` holds for.
    fn count<P: Fn(Self::Item) -> bool>(self, _ p: P) -> usize uses (E, P::E) {
        var n = 0
        for ref x in self {
            if p(x) {
                n += 1
            }
        }
        n
    }

    /// The position of the first element `p` holds for.
    fn find<P: Fn(Self::Item) -> bool>(self, _ p: P) -> Option<Self::Cursor> uses (E, P::E) {
        var cursor = self.start()
        while let Option::Some(c) = cursor {
            if p(Collection::at(self, c)) {
                return Option::Some(c)
            }
            cursor = self.next(c)
        }
        Option::None
    }
}

/// A collection whose elements a loop can mutate in place.
pub trait CollectionMut: Collection {
    /// The element at `c`, to mutate.
    fn at_mut(mut self, _ c: Self::Cursor) -> mut Self::Item @S uses E
}

/// A collection that can also be traversed from its end.
pub trait Bidirectional: Collection {
    /// The last position, if any.
    fn last(self) -> Option<Self::Cursor> uses E

    /// The position before `c`, if any.
    fn prev(self, _ c: Self::Cursor) -> Option<Self::Cursor> uses E

    /// Each element from the last to the first.
    fn reversed(self) -> Reversed {
        reversed()
    }
}

// A valid cursor is below the collection's length, so stepping from it
// cannot overflow.

/// The first index of a collection of `len` elements.
#[inline(always)]
pub fn first_index(_ len: usize) -> Option<usize> {
    if len == 0 { Option::None } else { Option::Some(0) }
}

/// The index after `i` in a collection of `len` elements.
#[inline(always)]
pub fn next_index(_ i: usize, _ len: usize) -> Option<usize> {
    let next = i.wrapping_add(1)
    if next < len { Option::Some(next) } else { Option::None }
}

/// The last index of a collection of `len` elements.
#[inline(always)]
pub fn last_index(_ len: usize) -> Option<usize> {
    if len == 0 { Option::None } else { Option::Some(len.wrapping_sub(1)) }
}

/// The index before `i`.
#[inline(always)]
pub fn prev_index(_ i: usize) -> Option<usize> {
    if i == 0 { Option::None } else { Option::Some(i.wrapping_sub(1)) }
}

impl<T, const N: usize> [T; N] {
    pub fn len(self) -> usize {
        N
    }
}

// An array's elements are its own parts, wherever it lies, unless they are
// pinned elsewhere.
impl<T, const N: usize> Collection for [T; N] {
    space S = self[_]
    type Cursor = usize
    type Item = T

    #[inline(always)]
    fn start(self) -> Option<usize> {
        first_index(N)
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> Option<usize> {
        next_index(c, N)
    }

    #[inline(always)]
    fn at(self, _ c: usize) -> ref T {
        ref self[c]
    }
}

impl<T, const N: usize> CollectionMut for [T; N] {
    #[inline(always)]
    fn at_mut(mut self, _ c: usize) -> mut T {
        mut self[c]
    }
}

impl<T, const N: usize> Bidirectional for [T; N] {
    #[inline(always)]
    fn last(self) -> Option<usize> {
        last_index(N)
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> Option<usize> {
        prev_index(c)
    }
}

impl<T> Collection for MemArray<T> {
    space S = memory
    type Cursor = usize
    type Item = T

    #[inline(always)]
    fn start(self) -> Option<usize> {
        first_index(self.len())
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> Option<usize> {
        next_index(c, self.len())
    }

    #[inline(always)]
    fn at(self, _ c: usize) -> ref T {
        ref self[c]
    }
}

impl<T> CollectionMut for MemArray<T> {
    #[inline(always)]
    fn at_mut(mut self, _ c: usize) -> mut T {
        mut self[c]
    }
}

impl<T> Bidirectional for MemArray<T> {
    #[inline(always)]
    fn last(self) -> Option<usize> {
        last_index(self.len())
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> Option<usize> {
        prev_index(c)
    }
}

impl<T> Collection for MemVec<T> {
    space S = memory
    type Cursor = usize
    type Item = T

    #[inline(always)]
    fn start(self) -> Option<usize> {
        first_index(self.len())
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> Option<usize> {
        next_index(c, self.len())
    }

    #[inline(always)]
    fn at(self, _ c: usize) -> ref T {
        ref self[c]
    }
}

impl<T> CollectionMut for MemVec<T> {
    #[inline(always)]
    fn at_mut(mut self, _ c: usize) -> mut T {
        mut self[c]
    }
}

impl<T> Bidirectional for MemVec<T> {
    #[inline(always)]
    fn last(self) -> Option<usize> {
        last_index(self.len())
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> Option<usize> {
        prev_index(c)
    }
}

impl<T> Collection for MemSlice<T> {
    space S = memory
    type Cursor = usize
    type Item = T

    #[inline(always)]
    fn start(self) -> Option<usize> {
        first_index(self.len())
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> Option<usize> {
        next_index(c, self.len())
    }

    #[inline(always)]
    fn at(self, _ c: usize) -> ref T {
        ref self[c]
    }
}

impl<T> CollectionMut for MemSlice<T> {
    #[inline(always)]
    fn at_mut(mut self, _ c: usize) -> mut T {
        mut self[c]
    }
}

impl<T> Bidirectional for MemSlice<T> {
    #[inline(always)]
    fn last(self) -> Option<usize> {
        last_index(self.len())
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> Option<usize> {
        prev_index(c)
