use ingot::option::Option
use ingot::marker::Copy
use ingot::ops::{WrappingAdd, WrappingSub}
use ingot::ptr::{MemArray, MemSlice, MemVec}
use ingot::{assert, panic_code}
use ingot::panics::PANIC_ASSERT

/// A collection a loop traverses by cursor, projecting each element in turn.
///
/// The loop holds the collection while it runs; the cursor is a plain value
/// that names a position and holds no reference to the collection. A
/// position may name no element, as the one after the last does; the loop
/// tests each with `has` before it projects its element or steps from it.
/// A body that copies its items may change the collection before the step,
/// so by then the position may name no element.
pub trait Collection {
    /// The effects of reaching an element, retained while an element is open.
    uses E
    type Cursor: Copy
    type Item

    /// The first position; one that names no element if there are none.
    fn start(self) -> Self::Cursor uses E

    /// Whether `c` names an element.
    fn has(self, _ c: Self::Cursor) -> bool uses E

    /// The position after `c`, which `has` accepted but which may name no
    /// element by now; the loop tests the result with `has`.
    fn next(self, _ c: Self::Cursor) -> Self::Cursor uses E

    /// The element at `c`; `has(c)` must hold. A loop that mutates its
    /// elements takes it at `mut`, from a `mut Collection`.
    fn at(mut? self, _ c: Self::Cursor) -> mut? Self::Item uses E

    /// Each element with its index: `for (i, x) in xs.enumerate()`.
    fn enumerate(self) -> Enumerate<Identity<Self>> {
        Identity<Self> {}.enumerate()
    }

    /// The first `n` elements.
    fn take(self, _ n: usize) -> Take<Identity<Self>> {
        Identity<Self> {}.take(n)
    }

    /// The elements after the first `n`.
    fn skip(self, _ n: usize) -> Skip<Identity<Self>> {
        Identity<Self> {}.skip(n)
    }

    /// Every `k`th element.
    fn step_by(self, _ k: usize) -> StepBy<Identity<Self>> {
        Identity<Self> {}.step_by(k)
    }

    /// The elements `p` holds for.
    fn filter<P: Fn(Self::Item) -> bool>(self, _ p: own P) -> Filter<Identity<Self>, P> {
        Identity<Self> {}.filter(p)
    }

    /// The values `f` makes of the elements, owned.
    fn map<F: FnMut(Self::Item) -> _>(self, _ f: own F) -> Map<Identity<Self>, F> {
        Identity<Self> {}.map(f)
    }

    /// The traversal `d`, a driver or producer whose base is this
    /// collection's type, runs over it: `for x in xs.by(d)`. `d` moves into
    /// the loop, so one that is not `Copy` runs a single loop.
    fn by<D>(self, _ d: own D) -> D {
        d
    }

    /// `f` applied to each element in turn, threading an accumulator from
    /// `init`: the accumulator is owned and each element viewed, so neither
    /// needs to be `Copy`.
    fn fold<A, F: FnMut(own A, Self::Item) -> A>(self, _ init: own A, _ f: mut F) -> A
        uses (E, F::E)
    {
        var acc = init
        for ref x in self {
            acc = f(acc, x)
        }
        acc
    }

    /// Whether `p` holds for some element.
    fn any<P: Fn(Self::Item) -> bool>(self, _ p: P) -> bool uses (E, P::E) {
        for ref x in self {
            if p(x) {
                return true
            }
        }
        false
    }

    /// How many elements `p` holds for.
    fn count<P: Fn(Self::Item) -> bool>(self, _ p: P) -> usize uses (E, P::E) {
        var n = 0
        for ref x in self {
            if p(x) {
                n += 1
            }
        }
        n
    }

    /// The position of the first element `p` holds for.
    fn find<P: Fn(Self::Item) -> bool>(self, _ p: P) -> Option<Self::Cursor> uses (E, P::E) {
        var c = self.start()
        while self.has(c) {
            if p(Collection::at(self, c)) {
                return Option::Some(c)
            }
            c = self.next(c)
        }
        Option::None
    }
}

/// A collection that can also be traversed from its end.
pub trait Bidirectional: Collection {
    /// The last position; one that names no element if there are none.
    fn last(self) -> Self::Cursor uses E

    /// The position before `c`, which `has` accepted, as for `next`.
    /// The position before the first element names none, as the one after
    /// the last does.
    fn prev(self, _ c: Self::Cursor) -> Self::Cursor uses E

    /// Each element from the last to the first.
    fn reversed(self) -> Reversed<Self> {
        Reversed<Self> {}
    }
}

// Index cursors wrap: the position before index 0 and the last position of
// an empty collection are both the largest index, so `c < len` tests a
// position in either direction. A position `has` accepted was below the
// length, so stepping from it cannot overflow, even once the collection has
// shrunk.

impl<T, const N: usize> [T; N] {
    pub fn len(self) -> usize {
        N
    }
}

// An array's elements are its own parts, wherever it lies, unless they are
// pinned elsewhere.
impl<T, const N: usize> Collection for [T; N] {
    type Cursor = usize
    type Item = T

    #[inline(always)]
    fn start(self) -> usize {
        0
    }

    #[inline(always)]
    fn has(self, _ c: usize) -> bool {
        c < N
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> usize {
        c.wrapping_add(1)
    }

    #[inline(always)]
    fn at(mut? self, _ c: usize) -> mut? T {
        mut? self[c]
    }
}

impl<T, const N: usize> Bidirectional for [T; N] {
    #[inline(always)]
    fn last(self) -> usize {
        N.wrapping_sub(1)
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> usize {
        c.wrapping_sub(1)
    }
}

impl<T> Collection for MemArray<T> {
    type Cursor = usize
    type Item = T

    #[inline(always)]
    fn start(self) -> usize {
        0
    }

    #[inline(always)]
    fn has(self, _ c: usize) -> bool {
        c < self.len()
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> usize {
        c.wrapping_add(1)
    }

    #[inline(always)]
    fn at(mut? self, _ c: usize) -> mut? T {
        mut? self[c]
    }
}

impl<T> Bidirectional for MemArray<T> {
    #[inline(always)]
    fn last(self) -> usize {
        self.len().wrapping_sub(1)
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> usize {
        c.wrapping_sub(1)
    }
}

impl<T> Collection for MemVec<T> {
    type Cursor = usize
    type Item = T

    #[inline(always)]
    fn start(self) -> usize {
        0
    }

    #[inline(always)]
    fn has(self, _ c: usize) -> bool {
        c < self.len()
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> usize {
        c.wrapping_add(1)
    }

    #[inline(always)]
    fn at(mut? self, _ c: usize) -> mut? T {
        mut? self[c]
    }
}

impl<T> Bidirectional for MemVec<T> {
    #[inline(always)]
    fn last(self) -> usize {
        self.len().wrapping_sub(1)
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> usize {
        c.wrapping_sub(1)
    }
}

impl<T> Collection for MemSlice<T> {
    type Cursor = usize
    type Item = T

    #[inline(always)]
    fn start(self) -> usize {
        0
    }

    #[inline(always)]
    fn has(self, _ c: usize) -> bool {
        c < self.len()
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> usize {
        c.wrapping_add(1)
    }

    #[inline(always)]
    fn at(mut? self, _ c: usize) -> mut? T {
        mut? self[c]
    }
}

impl<T> Bidirectional for MemSlice<T> {
    #[inline(always)]
    fn last(self) -> usize {
        self.len().wrapping_sub(1)
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> usize {
        c.wrapping_sub(1)
    }
}

/// A traversal of a base collection, `Base`, that a loop holds and passes to
/// each call. A driver stores its state and parameters, never the base, so
/// it is an ordinary value: built, stored and returned, and run over a base
/// by `xs.by(d)`.
///
/// Each position yields a `Step`: the element accesses it projects, with
/// what the driver adds beside them, such as an index. A loop's pattern
/// destructures it as a `let` does, and a closure the driver calls takes it
/// whole.
///
/// Nothing promises one call per element: `filter` projects each element to
/// test it and again to yield it, and `take(0)` still starts its inner
/// traversal.
pub trait Driver {
    /// The driver's own effects; each method declares its base's too.
    uses E
    type Base: Collection
    type State: Copy
    shape Step

    /// The first state; one that names no element if there are none.
    fn start(self, _ base: Self::Base) -> Self::State uses (Self::Base::E, E)

    /// Whether `s` names an element.
    fn has(self, _ base: Self::Base, _ s: Self::State) -> bool uses (Self::Base::E, E)

    /// The state after `s`, which `has` accepted but which may name no
    /// element by now, as for `Collection::next`.
    fn next(self, _ base: Self::Base, _ s: Self::State) -> Self::State uses (Self::Base::E, E)

    /// The step at `s`; `has(s)` must hold. A loop that mutates its
    /// elements takes it at `mut`, from a `mut Driver`.
    fn at(self, _ base: mut? Self::Base, _ s: Self::State) -> Self::Step uses (Self::Base::E, E)

    /// Each step with its index.
    fn enumerate(own self) -> Enumerate<Self> {
        Enumerate { inner: self }
    }

    /// The first `n` steps.
    fn take(own self, _ n: usize) -> Take<Self> {
        Take { n, inner: self }
    }

    /// The steps after the first `n`.
    fn skip(own self, _ n: usize) -> Skip<Self> {
        Skip { n, inner: self }
    }

    /// Every `k`th step.
    fn step_by(own self, _ k: usize) -> StepBy<Self> {
        assert(k > 0)
        StepBy { k, inner: self }
    }

    /// The steps `p` holds for.
    fn filter<P: Fn(Self::Step<ref>) -> bool>(own self, _ p: own P) -> Filter<Self, P> {
        Filter { inner: self, p }
    }

    /// The values `f` makes of the steps, owned.
    fn map<F: FnMut(Self::Step<ref>) -> _>(own self, _ f: own F) -> Map<Self, F> {
        Map { inner: self, f }
    }
}

/// A traversal that produces an owned value at each position, so non-`Copy`
/// results can be collected.
pub trait Producer {
    uses E
    type Base: Collection
    type State: Copy
    type Out

    /// The first state; one that names no element if there are none.
    fn start(self, _ base: Self::Base) -> Self::State uses (Self::Base::E, E)

    /// Whether `s` names an element.
    fn has(self, _ base: Self::Base, _ s: Self::State) -> bool uses (Self::Base::E, E)

    /// The state after `s`, which `has` accepted but which may name no
    /// element by now: the base may have changed, or `produce` the producer.
    fn next(self, _ base: Self::Base, _ s: Self::State) -> Self::State uses (Self::Base::E, E)

    /// The value made at `s`; `has(s)` must hold.
    fn produce(mut self, _ base: Self::Base, _ s: Self::State) -> Self::Out uses (Self::Base::E, E)
}

/// The traversal `for x in xs` runs over a `B`: each element in order.
pub struct Identity<B> {}

impl<B> Copy for Identity<B> {}

impl<B: mut? Collection> Driver for Identity<B> {
    type Base = B
    type State = B::Cursor
    shape Step = mut? B::Item

    #[inline(always)]
    fn start(self, _ base: B) -> B::Cursor uses B::E {
        base.start()
    }

    #[inline(always)]
    fn has(self, _ base: B, _ s: B::Cursor) -> bool uses B::E {
        base.has(s)
    }

    #[inline(always)]
    fn next(self, _ base: B, _ s: B::Cursor) -> B::Cursor uses B::E {
        base.next(s)
    }

    #[inline(always)]
    fn at(self, _ base: mut? B, _ s: B::Cursor) -> mut? B::Item uses B::E {
        Collection::at(mut? base, s)
    }
}

/// Each element of a `B` from the last to the first.
pub struct Reversed<B> {}

impl<B> Copy for Reversed<B> {}

impl<B: Bidirectional + mut? Collection> Driver for Reversed<B> {
    type Base = B
    type State = B::Cursor
    shape Step = mut? B::Item

    #[inline(always)]
    fn start(self, _ base: B) -> B::Cursor uses B::E {
        base.last()
    }

    #[inline(always)]
    fn has(self, _ base: B, _ s: B::Cursor) -> bool uses B::E {
        base.has(s)
    }

    #[inline(always)]
    fn next(self, _ base: B, _ s: B::Cursor) -> B::Cursor uses B::E {
        base.prev(s)
    }

    #[inline(always)]
    fn at(self, _ base: mut? B, _ s: B::Cursor) -> mut? B::Item uses B::E {
        Collection::at(mut? base, s)
    }
}

/// Each step of the inner traversal with its index.
pub struct Enumerate<D> {
    inner: D,
}

impl<D: Copy> Copy for Enumerate<D> {}

impl<D: mut? Driver> Driver for Enumerate<D> {
    uses E = D::E
    type Base = D::Base
    type State = (usize, D::State)
    shape Step = (own usize, D::Step)

    #[inline(always)]
    fn start(self, _ base: D::Base) -> (usize, D::State) uses (D::Base::E, E) {
        (0, self.inner.start(base))
    }

    #[inline(always)]
    fn has(self, _ base: D::Base, _ s: (usize, D::State)) -> bool uses (D::Base::E, E) {
        self.inner.has(base, s.1)
    }

    #[inline(always)]
    fn next(self, _ base: D::Base, _ s: (usize, D::State)) -> (usize, D::State) uses (D::Base::E, E) {
        (s.0 + 1, self.inner.next(base, s.1))
    }

    #[inline(always)]
    fn at(self, _ base: mut? D::Base, _ s: (usize, D::State)) -> (own usize, D::Step) uses (D::Base::E, E) {
        (s.0, self.inner.at(mut? base, s.1))
    }
}

/// The first `n` steps of the inner traversal.
pub struct Take<D> {
    n: usize,
    inner: D,
}

impl<D: Copy> Copy for Take<D> {}

impl<D: mut? Driver> Driver for Take<D> {
    uses E = D::E
    type Base = D::Base
    type State = (usize, D::State)
    shape Step = D::Step

    // The state counts the steps before its own, and stops advancing the
    // inner traversal at the limit, where a filter would scan on. It holds
    // an inner state from the start, so even `take(0)` starts the inner
    // traversal: an empty state would put an `Option` in every take loop.
    #[inline(always)]
    fn start(self, _ base: D::Base) -> (usize, D::State) uses (D::Base::E, E) {
        (0, self.inner.start(base))
    }

    #[inline(always)]
    fn has(self, _ base: D::Base, _ s: (usize, D::State)) -> bool uses (D::Base::E, E) {
        s.0 < self.n && self.inner.has(base, s.1)
    }

    #[inline(always)]
    fn next(self, _ base: D::Base, _ s: (usize, D::State)) -> (usize, D::State) uses (D::Base::E, E) {
        if s.0 + 1 < self.n { (s.0 + 1, self.inner.next(base, s.1)) } else { (self.n, s.1) }
    }

    #[inline(always)]
    fn at(self, _ base: mut? D::Base, _ s: (usize, D::State)) -> D::Step uses (D::Base::E, E) {
        self.inner.at(mut? base, s.1)
    }
}

/// The inner traversal after its first `n` steps.
pub struct Skip<D> {
    n: usize,
    inner: D,
}

impl<D: Copy> Copy for Skip<D> {}

impl<D: mut? Driver> Driver for Skip<D> {
    uses E = D::E
    type Base = D::Base
    type State = D::State
    shape Step = D::Step

    #[inline(always)]
    fn start(self, _ base: D::Base) -> D::State uses (D::Base::E, E) {
        var s = self.inner.start(base)
        var skipped = 0
        while skipped < self.n && self.inner.has(base, s) {
            s = self.inner.next(base, s)
            skipped += 1
        }
        s
    }

    #[inline(always)]
    fn has(self, _ base: D::Base, _ s: D::State) -> bool uses (D::Base::E, E) {
        self.inner.has(base, s)
    }

    #[inline(always)]
    fn next(self, _ base: D::Base, _ s: D::State) -> D::State uses (D::Base::E, E) {
        self.inner.next(base, s)
    }

    #[inline(always)]
    fn at(self, _ base: mut? D::Base, _ s: D::State) -> D::Step uses (D::Base::E, E) {
        self.inner.at(mut? base, s)
    }
}

/// Every `k`th step of the inner traversal, from its first.
pub struct StepBy<D> {
    k: usize,
    inner: D,
}

impl<D: Copy> Copy for StepBy<D> {}

impl<D: mut? Driver> Driver for StepBy<D> {
    uses E = D::E
    type Base = D::Base
    type State = D::State
    shape Step = D::Step

    #[inline(always)]
    fn start(self, _ base: D::Base) -> D::State uses (D::Base::E, E) {
        self.inner.start(base)
    }

    #[inline(always)]
    fn has(self, _ base: D::Base, _ s: D::State) -> bool uses (D::Base::E, E) {
        self.inner.has(base, s)
    }

    // Stops at the end of the inner traversal rather than stepping past it.
    #[inline(always)]
    fn next(self, _ base: D::Base, _ s: D::State) -> D::State uses (D::Base::E, E) {
        var s = self.inner.next(base, s)
        var stepped = 1
        while stepped < self.k && self.inner.has(base, s) {
            s = self.inner.next(base, s)
            stepped += 1
        }
        s
    }

    #[inline(always)]
    fn at(self, _ base: mut? D::Base, _ s: D::State) -> D::Step uses (D::Base::E, E) {
        self.inner.at(mut? base, s)
    }
}

/// The steps of the inner traversal that `p` holds for.
pub struct Filter<D, P> {
    inner: D,
    p: P,
}

impl<D: Copy, P: Copy> Copy for Filter<D, P> {}

/// The first state from `s` on whose step `d`'s predicate holds, or the
/// inner traversal's end.
fn filtered<D: Driver, P: Fn(D::Step<ref>) -> bool>(
    _ d: Filter<D, P>,
    _ base: D::Base,
    _ s: D::State,
) -> D::State uses (D::Base::E, D::E, P::E) {
    var s = s
    while d.inner.has(base, s) {
        if (d.p)(d.inner.at(base, s)) {
            return s
        }
        s = d.inner.next(base, s)
    }
    s
}

impl<D: mut? Driver, P: Fn(D::Step<ref>) -> bool> Driver for Filter<D, P> {
    uses E = (D::E, P::E)
    type Base = D::Base
    type State = D::State
    shape Step = D::Step

    fn start(self, _ base: D::Base) -> D::State uses (D::Base::E, E) {
        filtered(self, base, self.inner.start(base))
    }

    fn has(self, _ base: D::Base, _ s: D::State) -> bool uses (D::Base::E, E) {
        self.inner.has(base, s)
    }

    fn next(self, _ base: D::Base, _ s: D::State) -> D::State uses (D::Base::E, E) {
        filtered(self, base, self.inner.next(base, s))
    }

    fn at(self, _ base: mut? D::Base, _ s: D::State) -> D::Step uses (D::Base::E, E) {
        self.inner.at(mut? base, s)
    }
}

/// The values `f` makes of the inner traversal's steps, owned.
pub struct Map<D, F> {
    inner: D,
    f: F,
}

impl<D: Driver, F: FnMut(D::Step<ref>) -> _> Producer for Map<D, F> {
    uses E = (D::E, F::E)
    type Base = D::Base
    type State = D::State
    type Out = F::Out

    fn start(self, _ base: D::Base) -> D::State uses (D::Base::E, E) {
        self.inner.start(base)
    }

    fn has(self, _ base: D::Base, _ s: D::State) -> bool uses (D::Base::E, E) {
        self.inner.has(base, s)
    }

    fn next(self, _ base: D::Base, _ s: D::State) -> D::State uses (D::Base::E, E) {
        self.inner.next(base, s)
    }

    fn produce(mut self, _ base: D::Base, _ s: D::State) -> F::Out uses (D::Base::E, E) {
        (self.f)(self.inner.at(base, s))
    }
}

/// A container a producer's owned values are collected into, of the same
/// shape whatever their type.
pub trait FromProducer
    where Self: * -> *
{
    fn collect<P: Producer<Out = T>, T>(_ base: P::Base, _ p: own P) -> Self<T>
        uses (P::Base::E, P::E)
}

impl FromProducer for MemArray {
    fn collect<P: Producer<Out = T>, T>(_ base: P::Base, _ p: own P) -> MemArray<T>
        uses (P::Base::E, P::E)
    {
        var p = p
        var len: usize = 0
        var s = p.start(base)
        while p.has(base, s) {
            len += 1
            s = p.next(base, s)
        }
        // Each element is initialized below before anything reads it: a
        // second pass that yields more elements reverts at the bounds check,
        // and one that yields fewer, its producer having changed its own
        // traversal, reverts before the uninitialized rest can be read. The
        // raw writes initialize the elements, destroying nothing.
        let out = unsafe { MemArray<T>::new_uninit(len) }
        var i: usize = 0
        s = p.start(base)
        while p.has(base, s) {
            unsafe { *out.ptr_at(i) = p.produce(base, s) }
            i += 1
            s = p.next(base, s)
        }
        if i != len {
            panic_code(PANIC_ASSERT)
        }
        out
    }
}

impl FromProducer for MemVec {
    fn collect<P: Producer<Out = T>, T>(_ base: P::Base, _ p: own P) -> MemVec<T>
        uses (P::Base::E, P::E)
    {
        var p = p
        var out = MemVec<T>::new()
        var s = p.start(base)
        while p.has(base, s) {
            out.push(p.produce(base, s))
            s = p.next(base, s)
        }
        out
    }
}
