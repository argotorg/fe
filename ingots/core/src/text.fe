//! Formatting helpers that build `DynString` values, their parsers, and
//! searching and splitting of byte spans.
//!
//! String literals can be used directly as `DynString`:
//! `let s: DynString = "<svg>"`.
//!
//! Text is bytes here: searches compare bytes, which is exact for UTF-8, and
//! offsets count bytes.
use super::abi::{ByteSource, Bytes, DynString}
use super::fixed::{Fixed, UFixed}
use super::iter::Driver
use super::marker::Copy
use super::num::{Bounded, IntDowncast}
use super::option::Option
use super::panic_code
use super::panics::PANIC_ASSERT
use super::ptr::{self, MemArray, MemBuffer, MemSlice, MemSpan}

/// Text the parsers read in place, and a span's searches look for: a
/// literal, a `String<N>`, a `DynString`, a `MemSpan` or a `MemBuffer`.
pub trait Text {
    fn text_len(self) -> usize
    /// The byte at `index`, which is below `text_len()`.
    fn text_byte(self, _ index: usize) -> u8

    /// Whether the text is the bytes of `span` from `offset` on, of which
    /// there must be `text_len()`.
    fn text_matches_at(self, _ span: MemSpan, offset: usize) -> bool {
        let len = self.text_len()
        var i: usize = 0
        while i < len {
            if span.byte_at(offset + i) != self.text_byte(i) {
                return false
            }
            i += 1
        }
        true
    }

    /// The first match in `span` at or after `from`.
    fn text_find(self, _ span: MemSpan, from: usize) -> Option<usize> {
        let len = self.text_len()
        var offset = from
        while offset + len <= span.len() {
            if self.text_matches_at(span, offset) {
                return Option::Some(offset)
            }
            offset += 1
        }
        Option::None
    }
}

impl<const N: usize> Text for String<N> {
    fn text_len(self) -> usize { self.len() }
    fn text_byte(self, _ index: usize) -> u8 { self.byte_at(index) }

    // `byte_at` finds the string's `len()` for each byte, so these compare words.
    fn text_matches_at(self, _ span: MemSpan, offset: usize) -> bool {
        span.slice(offset, len: self.len()) == self
    }

    fn text_find(self, _ span: MemSpan, from: usize) -> Option<usize> {
        let len = self.len()
        find_word(span, word: self.text_word(len), len, from)
    }
}

impl Text for DynString {
    fn text_len(self) -> usize { self.len() }
    fn text_byte(self, _ index: usize) -> u8 { self.byte_at(index) }
}

impl Text for MemSpan {
    fn text_len(self) -> usize { self.len() }
    fn text_byte(self, _ index: usize) -> u8 { self.byte_at(index) }
}

impl Text for MemBuffer {
    fn text_len(self) -> usize { self.len() }
    fn text_byte(self, _ index: usize) -> u8 { self[index] }
}

/// Returns the concatenation of `parts` (Solidity `string.concat`).
pub fn concat<const N: usize>(_ parts: [DynString; N]) -> DynString {
    var len: usize = 0
    var i: usize = 0
    while i < N {
        len += parts[i].len()
        i += 1
    }
    let out = DynString::zeroed(len)
    let data = out.span().ptr()
    var offset: usize = 0
    i = 0
    while i < N {
        let part = parts[i].span()
        unsafe { ptr::copy(dest: ptr::offset_bytes(data, offset), source: part) }
        offset += part.len()
        i += 1
    }
    out
}

/// Returns the decimal representation of `value` (Solidity `Strings.toString`).
pub fn decimal(_ value: u256) -> DynString {
    var digits: usize = 1
    var rest = value / 10
    while rest != 0 {
        digits += 1
        rest /= 10
    }
    let out = DynString::zeroed(digits)
    let data = out.span().ptr()
    var remaining = value
    var i = digits
    while i > 0 {
        i -= 1
        unsafe { *ptr::offset_bytes(data, i) = ((remaining % 10) + 48).downcast_truncate() }
        remaining /= 10
    }
    out
}

/// Returns the lowest `bytes` bytes of `value` as `2 * bytes` lowercase hex
/// digits, without a `0x` prefix. Higher bytes of `value` are ignored.
pub fn hex(_ value: u256, _ bytes: usize) -> DynString {
    let digits = bytes * 2
    let out = DynString::zeroed(digits)
    let data = out.span().ptr()
    var remaining = value
    var i = digits
    while i > 0 {
        i -= 1
        let nibble: u8 = (remaining & 15).downcast_truncate()
        unsafe { *ptr::offset_bytes(data, i) = if nibble < 10 { nibble + b'0' } else { nibble - 10 + b'a' } }
        remaining >>= 4
    }
    out
}

/// Like `hex`, with uppercase digits.
pub fn hex_upper(_ value: u256, _ bytes: usize) -> DynString {
    let digits = bytes * 2
    let out = DynString::zeroed(digits)
    let data = out.span().ptr()
    var remaining = value
    var i = digits
    while i > 0 {
        i -= 1
        let nibble: u8 = (remaining & 15).downcast_truncate()
        unsafe { *ptr::offset_bytes(data, i) = if nibble < 10 { nibble + b'0' } else { nibble - 10 + b'A' } }
        remaining >>= 4
    }
    out
}

/// Parses decimal digits as a `u256` (Solidity `Strings.tryParseUint`).
/// `None` for an empty string (OpenZeppelin returns 0), any byte other
/// than `0` to `9` (signs and whitespace included) or a value above
/// `u256::max()` (OpenZeppelin reverts).
pub fn parse_uint<T: Text>(_ text: T) -> Option<u256> {
    parse_digits(text, from: 0, to: text.text_len(), radix: 10)
}

/// Parses decimal digits with an optional `+` or `-` sign as an `i256`
/// (Solidity `Strings.tryParseInt`). `None` for invalid digits, a missing
/// digit or a value outside the `i256` range.
pub fn parse_int<T: Text>(_ text: T) -> Option<i256> {
    parse_signed(text, decimals: 0)
}

/// Parses hex digits of either case, with or without a `0x` prefix, as a
/// `u256` (Solidity `Strings.tryParseHexUint`). `None` for an invalid
/// digit, no digits or a value above `u256::max()`.
pub fn parse_hex_uint<T: Text>(_ text: T) -> Option<u256> {
    let prefixed = text.text_len() >= 2 && text.text_byte(0) == 48 && text.text_byte(1) == 120
    parse_digits(text, from: if prefixed { 2 } else { 0 }, to: text.text_len(), radix: 16)
}

impl<const D: u256> UFixed<D> {
    /// Parses decimal digits, optionally followed by a `.` and at most `D`
    /// fraction digits: `12`, `0.25` or `007.50`. `None` for any other byte
    /// (signs and whitespace included), no digits on either side of the
    /// `.`, more than `D` fraction digits or a value out of range.
    pub fn parse<T: Text>(_ text: T) -> Option<Self> {
        match parse_scaled(text, from: 0, decimals: D) {
            Option::Some(raw) => Option::Some(UFixed::from_raw(raw)),
            Option::None => Option::None,
        }
    }
}

impl<const D: u256> Fixed<D> {
    /// Like `UFixed::parse`, after an optional `+` or `-` sign.
    pub fn parse<T: Text>(_ text: T) -> Option<Self> {
        match parse_signed(text, decimals: D) {
            Option::Some(raw) => Option::Some(Fixed::from_raw(raw)),
            Option::None => Option::None,
        }
    }
}

// An optional `+` or `-` sign, then `parse_scaled`'s digits, in the `i256`
// range.
fn parse_signed<T: Text>(_ text: T, decimals: u256) -> Option<i256> {
    let negative = text.text_len() != 0 && text.text_byte(0) == 45
    let signed = negative || (text.text_len() != 0 && text.text_byte(0) == 43)
    let magnitude = match parse_scaled(text, from: signed as usize, decimals) {
        Option::Some(value) => value
        Option::None => return Option::None
    }
    let min_magnitude: u256 = 1 << 255
    if magnitude < min_magnitude {
        let value: i256 = magnitude.downcast_unchecked()
        Option::Some(if negative { -value } else { value })
    } else if negative && magnitude == min_magnitude {
        Option::Some(i256::min())
    } else {
        Option::None
    }
}

// The decimal digits from byte `from` on, with at most `decimals` fraction
// digits after a `.`, times `10^decimals`.
fn parse_scaled<T: Text>(_ text: T, from: usize, decimals: u256) -> Option<u256> {
    let len = text.text_len()
    if decimals == 0 {
        return parse_digits(text, from, to: len, radix: 10)
    }
    var point = from
    while point < len && text.text_byte(point) != b'.' {
        point += 1
    }
    let whole = match parse_digits(text, from, to: point, radix: 10) {
        Option::Some(value) => value
        Option::None => return Option::None
    }
    let scale = 10 ** decimals
    var fraction: u256 = 0
    if point < len {
        let digits = len - point - 1
        if digits as u256 > decimals {
            return Option::None
        }
        fraction = match parse_digits(text, from: point + 1, to: len, radix: 10) {
            Option::Some(value) => value * 10 ** (decimals - digits as u256)
            Option::None => return Option::None
        }
    }
    if whole > (u256::max() - fraction) / scale {
        return Option::None
    }
    Option::Some(whole * scale + fraction)
}

// The value of the digits from byte `from` to byte `to`.
fn parse_digits<T: Text>(_ text: T, from: usize, to: usize, radix: u256) -> Option<u256> {
    if from >= to {
        return Option::None
    }
    let limit = u256::max() / radix
    let last = u256::max() % radix
    var value: u256 = 0
    var i = from
    while i < to {
        let digit = digit_value(text.text_byte(i))
        if digit >= radix || value > limit || (value == limit && digit > last) {
            return Option::None
        }
        value = value * radix + digit
        i += 1
    }
    Option::Some(value)
}

// Value of a decimal or hex digit of either case, 16 for any other byte.
fn digit_value(_ byte: u8) -> u256 {
    let c = byte as u256
    if c >= 48 && c <= 57 {
        c - 48
    } else if c >= 97 && c <= 102 {
        c - 87
    } else if c >= 65 && c <= 70 {
        c - 55
    } else {
        16
    }
}

/// Returns the standard base64 encoding of `data`, with `=` padding
/// (Solidity `Base64.encode`).
pub fn base64(_ data: MemSpan) -> DynString {
    var out = DynString::zeroed(4 * ((data.len() + 2) / 3))
    // The alphabet from byte 31 on: the word read at a digit's index ends
    // with the digit, which `mstore8` stores as it is.
    let table: DynString = "                               ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let digits = table.span()
    // Four digits for each group of three bytes, and for the one or two
    // bytes after the last group.
    let (groups, rest) = data.as_chunks<3>()
    let (mut encoded, _) = out.span().as_chunks<4>()
    let (mut body, mut last) = encoded.split_at(groups.len())
    for k in 0..groups.len() {
        let bits = groups.word_at(k)
        let o = mut body[k]
        o[0] = base64_digit(digits, bits, 0)
        o[1] = base64_digit(digits, bits, 1)
        o[2] = base64_digit(digits, bits, 2)
        o[3] = base64_digit(digits, bits, 3)
    }
    if !rest.is_empty() {
        let bits = rest.word_at(0)
        let o = mut last[0]
        o[0] = base64_digit(digits, bits, 0)
        o[1] = base64_digit(digits, bits, 1)
        o[2] = if rest.len() > 1 { base64_digit(digits, bits, 2) } else { b'=' }
        o[3] = b'='
    }
    out
}

// Digit `n` of the bytes at the start of `bits`, from their six bits from
// bit `6 * n` on, counted from the top.
#[inline(always)]
fn base64_digit(_ digits: MemSpan, _ bits: u256, _ n: u256) -> u8 {
    let index: usize = ((bits >> (250 - 6 * n)) & 63).downcast_truncate()
    digits.read_word(index).downcast_truncate()
}

/// Decodes standard base64 with `=` padding, the inverse of `base64`.
/// `None` unless the length is a multiple of 4, every byte is in the
/// standard alphabet, padding appears only as the last one or two bytes and
/// the bits it leaves unused are zero, so each byte string has exactly one
/// accepted encoding (RFC 4648).
pub fn decode_base64<T: Text>(_ input: T) -> Option<Bytes> {
    let len = input.text_len()
    if len % 4 != 0 {
        return Option::None
    }
    var padding: usize = 0
    if len > 0 && input.text_byte(len - 1) == 61 {
        padding = if input.text_byte(len - 2) == 61 { 2 } else { 1 }
    }
    let out_len = len / 4 * 3 - padding
    let decoded = Bytes::zeroed(out_len)
    let out = decoded.span().ptr()
    var i: usize = 0
    var j: usize = 0
    while i < len {
        let a = base64_value(input.text_byte(i))
        let b = base64_value(input.text_byte(i + 1))
        let c = if i + 2 < len - padding { base64_value(input.text_byte(i + 2)) } else { 0 }
        let d = if i + 3 < len - padding { base64_value(input.text_byte(i + 3)) } else { 0 }
        if a > 63 || b > 63 || c > 63 || d > 63 {
            return Option::None
        }
        let group = (a << 18) | (b << 12) | (c << 6) | d
        unsafe { *ptr::offset_bytes(out, j) = (group >> 16).downcast_truncate() }
        if j + 1 < out_len {
            unsafe { *ptr::offset_bytes(out, j + 1) = (group >> 8).downcast_truncate() }
        }
        if j + 2 < out_len {
            unsafe { *ptr::offset_bytes(out, j + 2) = group.downcast_truncate() }
        } else if (group & 0xff) != 0 || (padding == 2 && (group & 0xffff) != 0) {
            return Option::None
        }
        i += 4
        j += 3
    }
    Option::Some(decoded)
}

/// Decodes hex digits of either case, with or without a `0x` prefix, two
/// to a byte: `decode_hex("0x00ff")` is the bytes `0x00` and `0xff`. `None`
/// for an odd number of digits or a byte that is not a hex digit. No digits
/// decode to no bytes.
pub fn decode_hex<T: Text>(_ input: T) -> Option<Bytes> {
    let len = input.text_len()
    let from: usize = if len >= 2 && input.text_byte(0) == b'0' && input.text_byte(1) == b'x' { 2 } else { 0 }
    if (len - from) % 2 != 0 {
        return Option::None
    }
    let decoded = Bytes::zeroed((len - from) / 2)
    let out = decoded.span().ptr()
    var i = from
    var j: usize = 0
    while i < len {
        let high = digit_value(input.text_byte(i))
        let low = digit_value(input.text_byte(i + 1))
        if high > 15 || low > 15 {
            return Option::None
        }
        unsafe { *ptr::offset_bytes(out, j) = ((high << 4) | low).downcast_truncate() }
        i += 2
        j += 1
    }
    Option::Some(decoded)
}

// The index of `byte` in the base64 alphabet, 64 for a byte outside it.
fn base64_value(_ byte: u8) -> u256 {
    let c = byte as u256
    if c >= 65 && c <= 90 {
        c - 65
    } else if c >= 97 && c <= 122 {
        c - 71
    } else if c >= 48 && c <= 57 {
        c + 4
    } else if c == 43 {
        62
    } else if c == 47 {
        63
    } else {
        64
    }
}

// Limb bases for base58 conversion: 10 base58 digits (58^10) or 24 bytes.
const BASE58_LIMB: u256 = 430804206899405824
const BYTES_LIMB: u256 = 1 << 192

/// Returns the Bitcoin base58 encoding of `data` (OpenZeppelin
/// `Base58.encode`), where each leading zero byte becomes a `1`. The cost
/// grows quadratically with the length of `data`.
pub fn base58(_ data: MemSpan) -> DynString {
    let len = data.len()
    var zeros: usize = 0
    while zeros < len && data.byte_at(zeros) == 0 {
        zeros += 1
    }
    // A 24-byte chunk at a time, into limbs of 10 digits. One limb holds
    // more than 7.32 bytes, so 0.137 limbs per byte suffice.
    let limbs = MemArray<u256>::new_zeroed((len - zeros) * 137 / 1000 + 1)
    var used: usize = 0
    var i = zeros
    while i < len {
        let end = if len - i > 24 { i + 24 } else { len }
        var chunk: u256 = 0
        var j = i
        while j < end {
            chunk = (chunk << 8) | (data.byte_at(j) as u256)
            j += 1
        }
        used = mul_add(limbs, used, base: BASE58_LIMB, factor: 1 << ((end - i) as u256 * 8), addend: chunk)
        i = end
    }
    // Every limb but the most significant one has all 10 digits.
    var digits: usize = 0
    if used > 0 {
        var top = limbs[used - 1]
        while top != 0 {
            digits += 1
            top /= 58
        }
        digits += (used - 1) * 10
    }
    let out = DynString::zeroed(zeros + digits)
    let dest = out.span().ptr()
    i = 0
    while i < zeros {
        unsafe { *ptr::offset_bytes(dest, i) = 49 }
        i += 1
    }
    var pos = zeros + digits
    var k: usize = 0
    while pos > zeros {
        var limb = limbs[k]
        var n: u256 = 0
        while n < 10 && pos > zeros {
            pos -= 1
            unsafe { *ptr::offset_bytes(dest, pos) = base58_digit((limb % 58).downcast_truncate()) }
            limb /= 58
            n += 1
        }
        k += 1
    }
    out
}

/// Decodes Bitcoin base58, the inverse of `base58` (OpenZeppelin
/// `Base58.decode`): each leading `1` becomes a zero byte. `None` if any
/// byte is outside the alphabet.
pub fn decode_base58<T: Text>(_ input: T) -> Option<Bytes> {
    let len = input.text_len()
    var zeros: usize = 0
    while zeros < len && input.text_byte(zeros) == 49 {
        zeros += 1
    }
    // Ten digits at a time, into limbs of 24 bytes. One limb holds more
    // than 32.7 digits, so 0.031 limbs per digit suffice.
    let limbs = MemArray<u256>::new_zeroed((len - zeros) * 31 / 1000 + 1)
    var used: usize = 0
    var i = zeros
    while i < len {
        let end = if len - i > 10 { i + 10 } else { len }
        var chunk: u256 = 0
        var factor: u256 = 1
        var j = i
        while j < end {
            let value = base58_value(input.text_byte(j))
            if value > 57 {
                return Option::None
            }
            chunk = chunk * 58 + (value as u256)
            factor *= 58
            j += 1
        }
        used = mul_add(limbs, used, base: BYTES_LIMB, factor, addend: chunk)
        i = end
    }
    // Every limb but the most significant one has all 24 bytes.
    var bytes: usize = 0
    if used > 0 {
        var top = limbs[used - 1]
        while top != 0 {
            bytes += 1
            top >>= 8
        }
        bytes += (used - 1) * 24
    }
    // The leading `zeros` bytes stay zero.
    let decoded = Bytes::zeroed(zeros + bytes)
    let out = decoded.span().ptr()
    var pos = zeros + bytes
    var k: usize = 0
    while pos > zeros {
        var limb = limbs[k]
        var n: u256 = 0
        while n < 24 && pos > zeros {
            pos -= 1
            unsafe { *ptr::offset_bytes(out, pos) = limb.downcast_truncate() }
            limb >>= 8
            n += 1
        }
        k += 1
    }
    Option::Some(decoded)
}

// Sets the number in `limbs` (base `base`, least significant limb first,
// `used` limbs significant) to `number * factor + addend` and returns the
// new count of significant limbs. `limbs` must be long enough to hold it.
fn mul_add(_ limbs: MemArray<u256>, used: usize, base: u256, factor: u256, addend: u256) -> usize {
    var carry = addend
    var k: usize = 0
    while carry != 0 || k < used {
        carry += limbs[k] * factor
        unsafe { *limbs.ptr_at(k) = carry % base }
        carry /= base
        k += 1
    }
    k
}

fn base58_digit(_ value: u8) -> u8 {
    if value < 9 {
        value + 49
    } else if value < 17 {
        value + 56
    } else if value < 22 {
        value + 57
    } else if value < 33 {
        value + 58
    } else if value < 44 {
        value + 64
    } else {
        value + 65
    }
}

// Inverse of `base58_digit`, 58 for a byte outside the alphabet (`0`, `I`,
// `O`, `l` and anything not alphanumeric).
fn base58_value(_ byte: u8) -> u8 {
    if byte >= 49 && byte <= 57 {
        byte - 49
    } else if byte >= 65 && byte <= 72 {
        byte - 56
    } else if byte >= 74 && byte <= 78 {
        byte - 57
    } else if byte >= 80 && byte <= 90 {
        byte - 58
    } else if byte >= 97 && byte <= 107 {
        byte - 64
    } else if byte >= 109 && byte <= 122 {
        byte - 65
    } else {
        58
    }
}

/// Concatenate a runtime-length slice of strings with one output allocation.
/// Payloads are copied as bytes; no UTF-8 validation or normalization is done.
pub fn concat_slice(_ parts: ptr::MemSlice<DynString>) -> DynString {
    var len: usize = 0
    var i: usize = 0
    while i < parts.len() {
        len += unsafe { (*parts.ptr_at(i)).len() }
        i += 1
    }
    let out = DynString::zeroed(len)
    var offset: usize = 0
    i = 0
    while i < parts.len() {
        let part = unsafe { (*parts.ptr_at(i)).span() }
        unsafe {
            ptr::copy(
                dest: ptr::offset_bytes(out.span().ptr(), offset),
                source: part,
            )
        }
        offset += part.len()
        i += 1
    }
    out
}

/// Incremental byte-preserving text construction. Capacity grows geometrically
/// through `MemBuffer`; finishing copies the result into an ABI string once.
/// No reference into the growable backing allocation is exposed.
/// Append operations consume and return the builder: `builder = builder.push(part)`.
#[must_use]
pub struct TextBuilder { buffer: ptr::MemBuffer }

impl TextBuilder {
    pub fn new() -> Self {
        Self { buffer: ptr::MemBuffer::empty() }
    }
    pub fn with_capacity(_ capacity: usize) -> Self {
        Self { buffer: ptr::MemBuffer::with_capacity(capacity) }
    }
    pub fn len(self) -> usize {
        self.buffer.len()
    }
    pub fn is_empty(self) -> bool {
        self.buffer.is_empty()
    }

    /// Append a string without copying the already accumulated prefix unless
    /// the buffer must grow.
    pub fn push(own self, _ value: DynString) -> Self {
        self.push_bytes(value.span())
    }

    /// Append arbitrary bytes, including zero bytes and non-UTF-8 sequences.
    pub fn push_bytes(own self, _ value: MemSpan) -> Self {
        var buffer = self.buffer
        buffer.extend_from(value)
        Self { buffer }
    }
    pub fn finish(own self) -> DynString {
        DynString::from_payload(source: self.buffer.span())
    }
}

impl MemSlice<u8> {
    /// Whether the span begins with `prefix`.
    pub fn starts_with<P: Pattern>(self, _ prefix: P) -> bool {
        prefix.pattern_len() <= self.len() && prefix.pattern_matches_at(self, offset: 0)
    }

    /// Whether the span ends with `suffix`.
    pub fn ends_with<P: Pattern>(self, _ suffix: P) -> bool {
        let len = suffix.pattern_len()
        len <= self.len() && suffix.pattern_matches_at(self, offset: self.len() - len)
    }

    /// The offset of the first match of `pattern`.
    pub fn index_of<P: Pattern>(self, _ pattern: P) -> Option<usize> {
        pattern.pattern_find(self, from: 0)
    }

    /// The span without its leading and trailing ASCII whitespace.
    pub fn trim(self) -> ref MemSpan {
        var start: usize = 0
        var end = self.len()
        while start < end && is_ascii_whitespace(self.byte_at(start)) {
            start += 1
        }
        while end > start && is_ascii_whitespace(self.byte_at(end - 1)) {
            end -= 1
        }
        self.slice(offset: start, len: end - start)
    }

    /// The parts between matches of `separator`, which must not be empty:
    /// `for field in row.split(b',')`. Separators next to each other or at
    /// either end have empty parts between them, and a span with no match is
    /// its own one part.
    pub fn split<P: Pattern>(self, _ separator: own P) -> Split<P> {
        if separator.pattern_len() == 0 {
            panic_code(PANIC_ASSERT)
        }
        Split { separator }
    }

    /// The lines, each without its `\n` or `\r\n`. The last line needs no
    /// terminator, and one at the end of the span starts no empty line.
    pub fn lines(self) -> Lines {
        Lines {}
    }
}

/// What a span's searches and `split` look for: a byte (`b','`) or any
/// `Text`, such as a literal.
pub trait Pattern {
    /// The number of bytes a match covers.
    fn pattern_len(self) -> usize

    /// Whether the pattern is the bytes of `span` from `offset` on, of which
    /// there must be `pattern_len()`.
    fn pattern_matches_at(self, _ span: MemSpan, offset: usize) -> bool

    /// The first match in `span` at or after `from`.
    fn pattern_find(self, _ span: MemSpan, from: usize) -> Option<usize>
}

impl Pattern for u8 {
    fn pattern_len(self) -> usize {
        1
    }

    fn pattern_matches_at(self, _ span: MemSpan, offset: usize) -> bool {
        span.byte_at(offset) == self
    }

    fn pattern_find(self, _ span: MemSpan, from: usize) -> Option<usize> {
        find_byte(span, self, from)
    }
}

impl<T: Text> Pattern for T {
    fn pattern_len(self) -> usize {
        self.text_len()
    }

    fn pattern_matches_at(self, _ span: MemSpan, offset: usize) -> bool {
        self.text_matches_at(span, offset)
    }

    fn pattern_find(self, _ span: MemSpan, from: usize) -> Option<usize> {
        self.text_find(span, from)
    }
}

/// The traversal `MemSpan::split` runs over a span. Its state is a part's
/// start and end.
pub struct Split<P> {
    separator: P,
}

impl<P: Copy> Copy for Split<P> {}

impl<P: Pattern> Driver for Split<P> {
    type Base = MemSpan
    type State = (usize, usize)
    shape Step = ref MemSpan

    fn start(self, _ base: MemSpan) -> (usize, usize) {
        part_from(base, self.separator, start: 0)
    }

    fn has(self, _ base: MemSpan, _ s: (usize, usize)) -> bool {
        s.0 <= base.len()
    }

    fn next(self, _ base: MemSpan, _ s: (usize, usize)) -> (usize, usize) {
        part_from(base, self.separator, start: s.1 + self.separator.pattern_len())
    }

    fn at(self, _ base: MemSpan, _ s: (usize, usize)) -> ref MemSpan {
        base.slice(offset: s.0, len: s.1 - s.0)
    }
}

/// The traversal `MemSpan::lines` runs over a span. Its state is a line's
/// start and the offset of its `\n`, or the span's end.
pub struct Lines {}

impl Copy for Lines {}

impl Driver for Lines {
    type Base = MemSpan
    type State = (usize, usize)
    shape Step = ref MemSpan

    fn start(self, _ base: MemSpan) -> (usize, usize) {
        part_from(base, b'\n', start: 0)
    }

    fn has(self, _ base: MemSpan, _ s: (usize, usize)) -> bool {
        s.0 < base.len()
    }

    fn next(self, _ base: MemSpan, _ s: (usize, usize)) -> (usize, usize) {
        part_from(base, b'\n', start: s.1 + 1)
    }

    fn at(self, _ base: MemSpan, _ s: (usize, usize)) -> ref MemSpan {
        // A `\r` belongs to the terminator only before a `\n`.
        let crlf = s.1 > s.0 && base.byte_at(s.1 - 1) == b'\r' && s.1 < base.len()
        let end = if crlf { s.1 - 1 } else { s.1 }
        base.slice(offset: s.0, len: end - s.0)
    }
}

// The part beginning at `start`, which ends at the next separator or at the
// span's end. A `start` past the end names no part.
fn part_from<P: Pattern>(_ text: MemSpan, _ separator: P, start: usize) -> (usize, usize) {
    match separator.pattern_find(text, from: start) {
        Option::Some(end) => (start, end)
        Option::None => (start, text.len())
    }
}

// The first offset at or after `from` where `len` bytes of `text` are `word`'s
// first `len` bytes, the rest of `word` being zero. Testing the first byte
// avoids most of the word reads.
fn find_word(_ text: MemSpan, word: u256, len: usize, from: usize) -> Option<usize> {
    let end = text.len()
    if len == 0 && from <= end {
        return Option::Some(from)
    }
    let base = text.ptr()
    let first: u8 = (word >> 248).downcast_truncate()
    var offset = from
    while offset + len <= end {
        let at = ptr::offset_bytes(base, offset)
        if unsafe { *at } == first && unsafe { ptr::read_padded_word(at, len) } == word {
            return Option::Some(offset)
        }
        offset += 1
    }
    Option::None
}

fn find_byte(_ text: MemSpan, _ byte: u8, from: usize) -> Option<usize> {
    let end = text.len()
    let base = text.ptr()
    var offset = from
    while offset < end {
        if unsafe { *ptr::offset_bytes(base, offset) } == byte {
            return Option::Some(offset)
        }
        offset += 1
    }
    Option::None
}

fn is_ascii_whitespace(_ byte: u8) -> bool {
    byte == b' ' || (byte >= 9 && byte <= 13)
}
