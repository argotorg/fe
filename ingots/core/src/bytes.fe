        let a: [u8; T0::N] = self.0.as_bytes()
        let b: [u8; T1::N] = self.1.as_bytes()
        let c: [u8; T2::N] = self.2.as_bytes()
        let d: [u8; T3::N] = self.3.as_bytes()
