use ingot::Default
use ingot::Fn
use ingot::Functor
use ingot::Applicative
use ingot::Monad
use ingot::Option
use ingot::panic
use ingot::panic_with_value

#[must_use]
pub enum Result<E, T> {
    Ok(T),
    Err(E),
}

impl<E, T> ingot::marker::Copy for Result<E, T>
    where E: ingot::marker::Copy, T: ingot::marker::Copy
{}

impl<E, T> Result<E, T> {
    pub fn is_ok(self) -> bool {
        match self {
            Self::Ok(_) => true
            Self::Err(_) => false
        }
    }

    pub fn is_err(self) -> bool {
        !self.is_ok()
    }

    pub fn ok(own self) -> Option<T> {
        match self {
            Self::Ok(value) => Option::Some(value)
            Self::Err(_) => Option::None
        }
    }

    pub fn err(own self) -> Option<E> {
        match self {
            Self::Err(error) => Option::Some(error)
            Self::Ok(_) => Option::None
        }
    }

    pub fn unwrap(own self) -> T {
        match self {
            Self::Ok(value) => value
            Self::Err(e) => panic_with_value(e)
        }
    }

    pub fn unwrap_err(own self) -> E {
        match self {
            Self::Err(error) => error
            Self::Ok(_) => panic()
        }
    }

    pub fn unwrap_or(own self, default: own T) -> T {
        match self {
            Self::Ok(value) => value
            Self::Err(_) => default
        }
    }

    pub fn map<U, F: Fn(own T) -> U>(own self, _ func: F) -> Result<E, U> uses F::E {
        match self {
            Self::Ok(value) => Result::Ok(func(value))
            Self::Err(error) => Result::Err(error)
        }
    }

    pub fn map_err<FError, F: Fn(own E) -> FError>(own self, _ func: F) -> Result<FError, T> uses F::E {
        match self {
            Self::Ok(value) => Result::Ok(value)
            Self::Err(error) => Result::Err(func(error))
        }
    }

    pub fn and_then<U, F: Fn(own T) -> Result<E, U>>(own self, _ func: F) -> Result<E, U> uses F::E {
        match self {
            Self::Ok(value) => func(value)
            Self::Err(error) => Result::Err(error)
        }
    }

    pub fn or_else<E2, F: Fn(own E) -> Result<E2, T>>(own self, _ func: F) -> Result<E2, T> uses F::E {
        match self {
            Self::Ok(value) => Result::Ok(value)
            Self::Err(error) => func(error)
        }
    }
}

impl<E, T> Result<E, T> where T: Default {
    pub fn unwrap_or_default(own self) -> T {
        match self {
            Self::Ok(value) => value
            Self::Err(_) => T::default()
        }
    }
}

impl<E, T> Default for Result<E, T> where T: Default {
    fn default() -> Self {
        Result::Ok(T::default())
    }
}

impl<E> Functor for Result<E> {
    fn map<T, U, F: Fn(own T) -> U>(self: own Self<T>, _ func: F) -> Self<U> uses F::E {
        match self {
            Result::Ok(value) => Result::Ok(func(value))
            Result::Err(error) => Result::Err(error)
        }
    }
}

impl<E> Applicative for Result<E> {
    fn pure<T>(_ value: own T) -> Self<T> {
        Result::Ok(value)
    }

    fn ap<T, U, F: Fn(own T) -> U>(self: own Self<F>, _ value: own Self<T>) -> Self<U> uses F::E {
        match (self, value) {
            (Result::Ok(func), Result::Ok(arg)) => Result::Ok(func(arg))
            (Result::Err(error), _) => Result::Err(error)
            (_, Result::Err(error)) => Result::Err(error)
        }
    }
}

impl<E> Monad for Result<E> {
    fn bind<T, U, F: Fn(own T) -> Self<U>>(self: own Self<T>, _ func: F) -> Self<U> uses F::E {
        match self {
            Result::Ok(value) => func(value)
            Result::Err(error) => Result::Err(error)
        }
    }
}
