use ingot::meta::{Record, Code, Item}

/// Authored structural input, checked output through the ordinary establish gate.
pub trait Derive<P: * -> Constraint> {
    const fn derive(_ record: Record) -> Code<Item>
}

/// Members for an inherent implementation header `impl Type with (Provider)`.
pub trait DeriveInherent {
    const fn derive(_ record: Record) -> Code<Item>
}
