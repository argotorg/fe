//! ERC20: a token implementation ([`Erc20`], see `token`) and safe helpers
//! for calling other tokens (OpenZeppelin `SafeERC20` equivalent).
//!
//! Widely used tokens (USDT, BNB, OMG, ...) execute `transfer`/`approve` but
//! return no data, so strictly decoding a `bool` result reverts on success.
//! These helpers tolerate empty returndata via `call_with_default`, and in
//! addition:
//!
//! - revert if the call succeeded with empty returndata but there is no code
//!   at the token address (a call to a codeless account succeeds with empty
//!   returndata at the EVM level, which would otherwise be a silent no-op)
//! - revert if the token returned `false`
//!
//! Reverts from the token itself are bubbled through untouched.
//!
//! `safe_approve` has no "must set the allowance to zero first" restriction;
//! callers dealing with tokens that require it (e.g. USDT) should approve 0
//! first themselves.
//!
//! `try_transfer`, `try_transfer_from` and `try_approve` perform the same
//! calls without reverting and return a `TokenCall` outcome instead, so the
//! caller can raise its own error. Their success rule (Solady `SafeTransferLib`,
//! OpenZeppelin 5 `SafeERC20`, Seaport) is slightly different from the
//! `safe_*` helpers: the first returned word must be exactly 1, and any
//! returndata beyond the first word is ignored and never copied.

pub use token::{
    Approval,
    Erc20,
    IErc20,
    IErc20Permit,
    InsufficientAllowance,
    InsufficientBalance,
    InvalidPermit,
    PERMIT_TYPEHASH,
    PermitExpired,
    TotalSupplyOverflow,
    Transfer,
    VERSION_HASH,
    VerifiedPermit,
}

use core::ptr::MemBuffer
use super::effects::{Address, Call, Ctx, RawCallOutcome, revert}
use super::token::TokenCall
use ingot::abi::sol::sol
use ingot::evm::ops

msg Erc20Msg {
    #[selector = sol("transfer(address,uint256)")]
    Transfer { receiver: Address, amount: u256 } -> bool,
    #[selector = sol("transferFrom(address,address,uint256)")]
    TransferFrom { owner: Address, receiver: Address, amount: u256 } -> bool,
    #[selector = sol("approve(address,uint256)")]
    Approve { spender: Address, amount: u256 } -> bool,
}

/// Call `transfer(receiver, amount)` on `token`, reverting unless the
/// transfer succeeded under SafeERC20 rules.
pub fn safe_transfer(token: Address, receiver: Address, amount: u256)
uses (ctx: Ctx, call: mut Call)
{
    let ok = call.call_with_default(
        addr: token,
        gas: ops::gas(),
        value: 0,
        message: Erc20Msg::Transfer { receiver, amount },
        default: true,
    )
    if !ok || empty_return_without_code(token) {
        revert("erc20: transfer failed")
    }
}

/// Call `transferFrom(owner, receiver, amount)` on `token`, reverting unless
/// the transfer succeeded under SafeERC20 rules.
pub fn safe_transfer_from(token: Address, owner: Address, receiver: Address, amount: u256)
uses (ctx: Ctx, call: mut Call)
{
    let ok = call.call_with_default(
        addr: token,
        gas: ops::gas(),
        value: 0,
        message: Erc20Msg::TransferFrom { owner, receiver, amount },
        default: true,
    )
    if !ok || empty_return_without_code(token) {
        revert("erc20: transferFrom failed")
    }
}

/// Call `approve(spender, amount)` on `token`, reverting unless the approval
/// succeeded under SafeERC20 rules.
pub fn safe_approve(token: Address, spender: Address, amount: u256)
uses (ctx: Ctx, call: mut Call)
{
    let ok = call.call_with_default(
        addr: token,
        gas: ops::gas(),
        value: 0,
        message: Erc20Msg::Approve { spender, amount },
        default: true,
    )
    if !ok || empty_return_without_code(token) {
        revert("erc20: approve failed")
    }
}

/// True if the token call just performed succeeded with empty returndata and
/// `token` has no code, i.e. the "success" was a no-op call to a codeless
/// account. Checked only on the empty-returndata path (mirroring
/// OpenZeppelin) so compliant tokens pay no extra codesize gas.
///
/// Must run before any further call, while returndata still belongs to the
/// token call.
fn empty_return_without_code(_ token: Address) -> bool
uses (ctx: Ctx)
{
    ops::returndatasize() == 0 && ctx.extcodesize(token) == 0
}

/// Call `transfer(receiver, amount)` on `token` without reverting; see
/// `try_transfer_from` for the classification.
pub fn try_transfer(token: Address, receiver: Address, amount: u256) -> TokenCall
uses (ctx: Ctx, call: mut Call)
{
    let mut ret = MemBuffer::with_capacity(32)
    let outcome = call.try_call_into(
        addr: token,
        gas: ops::gas(),
        value: 0,
        message: Erc20Msg::Transfer { receiver, amount },
        ret: mut ret,
    )
    classify_bool_return(token, outcome, ret)
}

/// Call `transferFrom(owner, receiver, amount)` on `token` without reverting.
///
/// Forwards all available gas and copies at most 32 bytes of returndata, so
/// an oversized return costs the caller no copy or memory expansion. The
/// outcome is:
///
/// - `Reverted` if the call failed; the revert payload is left in the
///   returndata buffer
/// - `Ok` if the call returned at least 32 bytes whose first word is exactly
///   1 (not merely nonzero), ignoring any further bytes
/// - `Ok` if the call returned no data and `token` has code (tokens such as
///   USDT that return nothing)
/// - `NoCode` if the call returned no data and `token` has no code. The code
///   size is checked only on this path, after the call, so compliant tokens
///   pay nothing extra.
/// - `BadReturn` otherwise: `false`, any other word such as 2, or 1 to 31
///   bytes of returndata
pub fn try_transfer_from(
    token: Address,
    owner: Address,
    receiver: Address,
    amount: u256,
) -> TokenCall
uses (ctx: Ctx, call: mut Call)
{
    let mut ret = MemBuffer::with_capacity(32)
    let outcome = call.try_call_into(
        addr: token,
        gas: ops::gas(),
        value: 0,
        message: Erc20Msg::TransferFrom { owner, receiver, amount },
        ret: mut ret,
    )
    classify_bool_return(token, outcome, ret)
}

/// Call `approve(spender, amount)` on `token` without reverting; see
/// `try_transfer_from` for the classification.
pub fn try_approve(token: Address, spender: Address, amount: u256) -> TokenCall
uses (ctx: Ctx, call: mut Call)
{
    let mut ret = MemBuffer::with_capacity(32)
    let outcome = call.try_call_into(
        addr: token,
        gas: ops::gas(),
        value: 0,
        message: Erc20Msg::Approve { spender, amount },
        ret: mut ret,
    )
    classify_bool_return(token, outcome, ret)
}

fn classify_bool_return(_ token: Address, _ outcome: RawCallOutcome, _ ret: MemBuffer) -> TokenCall
uses (ctx: Ctx)
{
    if !outcome.success() {
        return TokenCall::Reverted
    }
    let len = outcome.returndata_len()
    if len == 0 {
        if ctx.extcodesize(token) == 0 {
            return TokenCall::NoCode
        }
        return TokenCall::Ok
    }
    if len >= 32 && ret.span().word_at(0) == 1 {
        return TokenCall::Ok
    }
    TokenCall::BadReturn
}
