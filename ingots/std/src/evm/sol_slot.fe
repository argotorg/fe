//! Solidity-packed state variables in a storage slot.
//!
//! Solidity packs consecutive small state variables into one slot, each at a
//! byte offset counted from the low end of the word. `SolSlot`, the owner of
//! one slot, reads and writes one such field without disturbing its
//! neighbours:
//!
//! ```fe
//! // `address owner; bool paused;` share slot 0: owner at byte 0, paused at 20.
//! let slot = unsafe { mut SolSlot::at(0) }
//! let owner: Address = slot.read(offset: 0)
//! slot.write(offset: 20, value: true)
//! ```
//!
//! `read`/`write` cost one `sload` (and one `sstore`) per field. To read or
//! update several fields of one slot with a single `sload`/`sstore`, `load`
//! the slot into a `SolWord` and `store` it back:
//!
//! ```fe
//! let slot = unsafe { mut SolSlot::at(0) }
//! var word = slot.load()
//! let owner: Address = word.get(offset: 0)
//! word.set(offset: 20, value: false)
//! slot.store(word)
//! ```
//!
//! A `SolWord` is only a value, so it also packs or unpacks a word obtained
//! some other way: `SolWord { word: raw }.get(offset: 2)`.
//!
//! `read_bytes`/`write_bytes` (and the `string` variants) use Solidity's
//! layout for a `bytes` or `string` state variable in the slot.
use core::abi::{ByteInput, Bytes, DynString, store_word}
use core::num::IntDowncast
use core::marker::{Pinned, Storage}
use core::ops::{Location, StateIndex, WrappingAdd}
use core::ptr::{self, MemSpan}
use super::effects::{Address, RawStorage, revert_error, storage_at}
use super::layout::array_data_slot
use super::ops::{revert_empty, signextend}
use super::panic::{PANIC_STORAGE_ENCODING, Panic}

/// A value with a fixed-width Solidity storage representation.
///
/// `to_packed` returns the low `BITS` bits of the stored field and
/// `from_packed` rebuilds the value from them (sign-extending signed types).
pub trait SolPacked {
    const BITS: u256
    fn to_packed(own self) -> u256
    fn from_packed(_ bits: u256) -> Self
}

pub struct SolSlot {
    payload: Payload,
}

/// The words of a slot's long `bytes` or `string` payload, from
/// `keccak256(slot)` on; the slot itself holds the head.
struct Payload {
    head: u256,
}

impl Pinned for Payload {
    type Space = Storage
}

unsafe impl StateIndex for Payload {
    type Key = u256
    type Entry = u256

    fn locate(self, _ root: u256, _ word: u256) -> Location {
        Location { slot: array_data_slot(root).wrapping_add(word), offset: 0 }
    }
}

impl SolSlot {
    /// The storage slot `slot`.
    ///
    /// The caller must ensure that nothing the compiler allocates, such as a
    /// contract field, uses `slot` or the slots its payload derives.
    #[raw_place]
    pub unsafe fn at(_ slot: u256) -> mut? Self uses (storage: mut? RawStorage) {
        unsafe { storage_at(slot) }
    }

    /// Reads the `T` stored `offset` bytes above the low end of the slot.
    /// Reverts if the field does not fit in the slot.
    pub fn read<T: SolPacked>(self, offset: u256) -> T {
        SolWord { word: self.payload.head }.get(offset)
    }

    /// Writes `value` `offset` bytes above the low end of the slot, keeping
    /// the other bytes of the slot. Reverts if the field does not fit in the
    /// slot.
    pub fn write<T: SolPacked>(mut self, offset: u256, value: own T) {
        if T::BITS == 256 {
            // The field is the whole slot: nothing to preserve.
            let _ = field_shift(offset, bits: T::BITS)
            self.payload.head = value.to_packed()
        } else {
            var word = SolWord { word: self.payload.head }
            word.set(offset, value)
            self.payload.head = word.word
        }
    }

    /// Loads the whole slot with one `sload`, for reading or updating
    /// several packed fields; see `SolWord`.
    pub fn load(self) -> SolWord {
        SolWord { word: self.payload.head }
    }

    /// Writes `word` to the slot with one `sstore`, replacing all of it,
    /// including changes made to the slot since `word` was loaded.
    pub fn store(mut self, _ word: SolWord) {
        self.payload.head = word.word
    }
}

/// A 32-byte word of Solidity-packed fields, such as the value of a storage
/// slot loaded by `SolSlot::load`.
///
/// `get` and `set` address a field by its byte offset from the low end of the
/// word, with the same encoding and bounds checks as `SolSlot::read`/`write`,
/// but only compute on the value: storage changes only when the word is
/// written with `SolSlot::store`. `SolWord { word }` packs or unpacks a word
/// obtained any other way, e.g. read through `RawOps` or returned by a call.
pub struct SolWord {
    pub word: u256,
}

impl Copy for SolWord {}
impl Snapshot for SolWord {}

impl SolWord {
    /// The `T` stored `offset` bytes above the low end of the word. Reverts
    /// if the field does not fit in the word.
    pub fn get<T: SolPacked>(self, offset: u256) -> T {
        let shift = field_shift(offset, bits: T::BITS)
        T::from_packed((self.word >> shift) & field_mask(T::BITS))
    }

    /// Replaces the `T` stored `offset` bytes above the low end of the word,
    /// keeping the other bytes. Reverts if the field does not fit in the
    /// word.
    pub fn set<T: SolPacked>(mut self, offset: u256, value: own T) {
        let shift = field_shift(offset, bits: T::BITS)
        let mask = field_mask(T::BITS) << shift
        self.word = (self.word & !mask) | ((value.to_packed() << shift) & mask)
    }
}

// Solidity `bytes`/`string` storage: a short value (< 32 bytes) lives in the
// slot's high bytes with `2 * len` in the low byte; a long one stores
// `2 * len + 1` in the slot and its words from `keccak256(slot)` on.
impl SolSlot {
    /// Reads the Solidity `bytes` stored in this slot.
    pub fn read_bytes(self) -> Bytes {
        let (data, len, size) = self.load_payload()
        unsafe { Bytes::from_abi_tail(data, len: len.downcast_unchecked(), size) }
    }

    /// Reads the Solidity `string` stored in this slot.
    pub fn read_string(self) -> DynString {
        let (data, len, size) = self.load_payload()
        unsafe { DynString::from_abi_tail(data, len: len.downcast_unchecked(), size) }
    }

    /// Assigns Solidity `bytes` to this slot, clearing words a previous,
    /// longer value left behind.
    pub fn write_bytes(mut self, _ value: Bytes) {
        self.store_payload(value.payload_span())
    }

    /// Assigns a Solidity `string` to this slot; see `write_bytes`.
    pub fn write_string(mut self, _ value: DynString) {
        self.store_payload(value.payload_span())
    }

    fn load_payload(self) -> (*u8, u256, u256) {
        let head = self.payload.head
        let len = stored_len(head)
        let size = 32 + word_count(len) * 32
        let data = ptr::alloc_bytes(size.downcast_saturate())
        unsafe {
            store_word(ptr: data, value: len)
            // Only the `len` data bytes are kept, so the ABI padding is zero.
            if head & 1 == 0 {
                if len != 0 {
                    store_word(ptr: ptr::offset_bytes(data, 32), value: leading_bytes(head, count: len))
                }
            } else {
                var i: u256 = 0
                while i < word_count(len) {
                    let word = leading_bytes(self.payload[i], count: len - i * 32)
                    store_word(ptr: ptr::offset_bytes(data, (32 + i * 32).downcast_unchecked()), value: word)
                    i += 1
                }
            }
        }
        (data, len, size)
    }

    fn store_payload(mut self, _ payload: MemSpan) {
        let old = self.payload.head
        let old_len = stored_len(old)
        let old_words = if old & 1 == 0 { 0 } else { word_count(old_len) }
        let len = payload.len() as u256
        var words: u256 = 0
        if len < 32 {
            self.payload.head = payload_word(payload, 0) | (len * 2)
        } else {
            self.payload.head = len * 2 + 1
            words = word_count(len)
            var i: u256 = 0
            while i < words {
                self.payload[i] = payload_word(payload, i * 32)
                i += 1
            }
        }
        var i = words
        while i < old_words {
            self.payload[i] = 0
            i += 1
        }
    }
}

// Panics like Solidity (0x22) on a head whose length contradicts its
// short/long discriminator.
fn stored_len(_ head: u256) -> u256 {
    let long = head & 1 == 1
    let len = if long { head / 2 } else { (head & 0xff) / 2 }
    if long == (len < 32) {
        revert_error(Panic::from(PANIC_STORAGE_ENCODING))
    }
    len
}

fn word_count(_ len: u256) -> u256 {
    (len + 31) / 32
}

// The payload word at `offset`, with bytes past the end of `payload` zeroed.
fn payload_word(_ payload: MemSpan, _ offset: u256) -> u256 {
    let len = payload.len() as u256
    if offset >= len {
        return 0
    }
    leading_bytes(payload.word_at(offset), count: len - offset)
}

// The first `count` bytes of `word`, with the rest zeroed.
fn leading_bytes(_ word: u256, count: u256) -> u256 {
    if count >= 32 { word } else { word & !(u256::max() >> (count * 8)) }
}

// The bit shift of a `bits`-wide field `offset` bytes above the low end of a
// slot; reverts unless the field lies within the slot.
fn field_shift(_ offset: u256, bits: u256) -> u256 {
    if offset >= 32 || bits > 256 - offset * 8 {
        revert_empty()
    }
    offset * 8
}

pub(ingot) fn field_mask(_ bits: u256) -> u256 {
    if bits >= 256 { u256::max() } else { ((1 as u256) << bits) - 1 }
}

fn sign_extended(_ bits: u256, width: u256) -> u256 {
    signextend(byte: width / 8 - 1, value: bits)
}

impl SolPacked for bool {
    const BITS: u256 = 8
    fn to_packed(own self) -> u256 { if self { 1 } else { 0 } }
    fn from_packed(_ bits: u256) -> Self { bits != 0 }
}

impl SolPacked for Address {
    const BITS: u256 = 160
    fn to_packed(own self) -> u256 { self.inner }
    fn from_packed(_ bits: u256) -> Self { Address::from_word_truncate(bits) }
}

impl SolPacked for u8 {
    const BITS: u256 = 8
    fn to_packed(own self) -> u256 { self as u256 }
    fn from_packed(_ bits: u256) -> Self { bits.downcast_truncate() }
}

impl SolPacked for u16 {
    const BITS: u256 = 16
    fn to_packed(own self) -> u256 { self as u256 }
    fn from_packed(_ bits: u256) -> Self { bits.downcast_truncate() }
}

impl SolPacked for u32 {
    const BITS: u256 = 32
    fn to_packed(own self) -> u256 { self as u256 }
    fn from_packed(_ bits: u256) -> Self { bits.downcast_truncate() }
}

impl SolPacked for u64 {
    const BITS: u256 = 64
    fn to_packed(own self) -> u256 { self as u256 }
    fn from_packed(_ bits: u256) -> Self { bits.downcast_truncate() }
}

impl SolPacked for u128 {
    const BITS: u256 = 128
    fn to_packed(own self) -> u256 { self as u256 }
    fn from_packed(_ bits: u256) -> Self { bits.downcast_truncate() }
}

impl SolPacked for u256 {
    const BITS: u256 = 256
    fn to_packed(own self) -> u256 { self }
    fn from_packed(_ bits: u256) -> Self { bits }
}

impl SolPacked for i8 {
    const BITS: u256 = 8
    fn to_packed(own self) -> u256 { self.downcast_unchecked() }
    fn from_packed(_ bits: u256) -> Self { sign_extended(bits, width: 8).downcast_truncate() }
}

impl SolPacked for i16 {
    const BITS: u256 = 16
    fn to_packed(own self) -> u256 { self.downcast_unchecked() }
    fn from_packed(_ bits: u256) -> Self { sign_extended(bits, width: 16).downcast_truncate() }
}

impl SolPacked for i32 {
    const BITS: u256 = 32
    fn to_packed(own self) -> u256 { self.downcast_unchecked() }
    fn from_packed(_ bits: u256) -> Self { sign_extended(bits, width: 32).downcast_truncate() }
}

impl SolPacked for i64 {
    const BITS: u256 = 64
    fn to_packed(own self) -> u256 { self.downcast_unchecked() }
    fn from_packed(_ bits: u256) -> Self { sign_extended(bits, width: 64).downcast_truncate() }
}

impl SolPacked for i128 {
    const BITS: u256 = 128
    fn to_packed(own self) -> u256 { self.downcast_unchecked() }
    fn from_packed(_ bits: u256) -> Self { sign_extended(bits, width: 128).downcast_truncate() }
}

impl SolPacked for i256 {
    const BITS: u256 = 256
    fn to_packed(own self) -> u256 { self.downcast_unchecked() }
    fn from_packed(_ bits: u256) -> Self { bits.downcast_truncate() }
}
