use core::abi::ByteInput
use core::ptr

use super::ops
use super::effects::{RawStorage, storage_at_mut}
use super::storage_map::{StorageKey, StorageMap}

fn offset(_ base: *u8, _ bytes: u256) -> *u8 {
    ptr::offset_bytes(base, bytes)
}

/// Round `len` up to the number of whole EVM words required to store it.
pub fn ceil_words(_ len: u256) -> u256 {
    if len == 0 {
        return 0
    }
    ((len - 1) / 32) + 1
}

/// Mask that preserves the first `rem` bytes of a 32-byte word.
pub fn mask_for_bytes(rem: u256) -> u256 {
    if rem == 0 {
        return 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    }

    let shift = (32 - rem) * 8
    0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff << shift
}

/// Zero the right-padding bytes after copying a dynamic byte slice into memory.
///
/// The caller must ensure that `ptr` has room for `len` rounded up to whole
/// words.
pub unsafe fn zero_pad_memory_bytes(ptr: *u8, len: u256) {
    let rem = len % 32
    if rem == 0 {
        return
    }

    let tail_ptr = offset(ptr, (len / 32) * 32)
    let word = ops::mload(tail_ptr)
    ops::mstore(addr: tail_ptr, value: word & mask_for_bytes(rem))
}

// The word at `offset` of `input`, with the bytes past `len` zeroed.
//
// The callers read `input.len()` once and pass it as `len`: a safe `len()`
// need not answer the same way twice.
fn masked_word_at<I: ByteInput>(_ input: I, _ offset: u256, len: u256) -> u256 {
    let remaining = len - offset
    if remaining < 32 {
        return input.word_at(offset) & mask_for_bytes(rem: remaining)
    }
    input.word_at(offset)
}

/// The caller must ensure that `dest` has room for `len` rounded up to whole
/// words.
unsafe fn copy_input_words_to_memory<I: ByteInput>(_ input: I, _ dest: *u8, len: u256) {
    let word_count = ceil_words(len)
    var i: u256 = 0
    while i < word_count {
        unsafe { ops::mstore(addr: offset(dest, i * 32), value: masked_word_at(input, i * 32, len)) }
        i += 1
    }
}

/// Return ABI-encoded `bytes` copied directly from calldata.
///
/// `data_ptr` is a raw calldata byte offset.
pub fn encode_bytes_return_from_calldata(data_ptr: u256, len: u256) -> ! {
    let total_len = 64 + ceil_words(len) * 32
    let ptr = ptr::alloc_bytes(total_len)
    unsafe {
        ops::mstore(addr: ptr, value: 32)
        ops::mstore(addr: offset(ptr, 32), value: len)
        ops::calldatacopy(dest: offset(ptr, 64), offset: data_ptr, len: len)
        zero_pad_memory_bytes(ptr: offset(ptr, 64), len: len)
        ops::return_data(offset: ptr, len: total_len)
    }
}

/// Return ABI-encoded `bytes` copied from an arbitrary byte input.
pub fn encode_bytes_return_view<I: ByteInput>(view: I) -> ! {
    let len = view.len()
    let total_len = 64 + ceil_words(len) * 32
    let ptr = ptr::alloc_bytes(total_len)
    unsafe {
        ops::mstore(addr: ptr, value: 32)
        ops::mstore(addr: offset(ptr, 32), value: len)
        copy_input_words_to_memory(view, offset(ptr, 64), len)
        ops::return_data(offset: ptr, len: total_len)
    }
}

/// Emit a Solidity-compatible event with a single dynamic `bytes` payload.
///
/// `data_ptr` is a raw calldata byte offset.
pub fn emit_bytes_event(topic0: u256, data_ptr: u256, data_len: u256) {
    let total_len = 64 + ceil_words(data_len) * 32
    let ptr = ptr::alloc_bytes(total_len)
    unsafe {
        ops::mstore(addr: ptr, value: 32)
        ops::mstore(addr: offset(ptr, 32), value: data_len)
        ops::calldatacopy(dest: offset(ptr, 64), offset: data_ptr, len: data_len)
        zero_pad_memory_bytes(ptr: offset(ptr, 64), len: data_len)
        ops::log1(offset: ptr, len: total_len, topic0: topic0)
    }
}

/// Emit a Solidity-compatible event with a single dynamic `bytes` payload.
pub fn emit_bytes_event_view<I: ByteInput>(topic0: u256, view: I) {
    let len = view.len()
    let total_len = 64 + ceil_words(len) * 32
    let ptr = ptr::alloc_bytes(total_len)
    unsafe {
        ops::mstore(addr: ptr, value: 32)
        ops::mstore(addr: offset(ptr, 32), value: len)
        copy_input_words_to_memory(view, offset(ptr, 64), len)
        ops::log1(offset: ptr, len: total_len, topic0: topic0)
    }
}

/// Storage-backed dynamic bytes keyed by `K`: the byte length of each value
/// and its 32-byte payload words, in two maps.
pub struct StorageBytes<K> {
    lengths: StorageMap<K, u256>,
    words: StorageMap<(K, u256), u256>,
}

impl<K: StorageKey + Copy> StorageBytes<K> {
    /// The bytes whose maps take slots `slot` and `slot + 1`.
    ///
    /// The caller must ensure that nothing the compiler allocates, such as a
    /// contract field, uses those slots or the entries' slots.
    #[raw_place]
    pub unsafe fn at(_ slot: u256) -> mut Self uses (storage: mut RawStorage) {
        unsafe { storage_at_mut(slot) }
    }

    pub fn len(self, key: K) -> u256 {
        self.lengths[key]
    }

    pub fn clear(mut self, key: K) {
        let word_count = ceil_words(self.lengths[key])
        var i: u256 = 0
        while i < word_count {
            self.words[(key, i)] = 0
            i += 1
        }
        self.lengths[key] = 0
    }

    /// Store bytes copied directly from calldata.
    ///
    /// `data_ptr` is a raw calldata byte offset.
    pub fn store_from_calldata(mut self, key: K, data_ptr: u256, len: u256) {
        self.clear(key)
        self.lengths[key] = len
        let word_count = ceil_words(len)
        var i: u256 = 0
        while i < word_count {
            var word = ops::calldataload(data_ptr + i * 32)
            if i + 1 == word_count {
                let rem = len % 32
                if rem != 0 {
                    word = word & mask_for_bytes(rem)
                }
            }
            self.words[(key, i)] = word
            i += 1
        }
    }

    /// Store bytes from an arbitrary byte input.
    pub fn store_view<I: ByteInput>(mut self, key: K, view: I) {
        self.clear(key)
        let len = view.len()
        self.lengths[key] = len
        let word_count = ceil_words(len)
        var i: u256 = 0
        while i < word_count {
            self.words[(key, i)] = masked_word_at(view, i * 32, len)
            i += 1
        }
    }

    /// Copy the stored bytes into freshly allocated memory.
    ///
    /// Returns a buffer containing the payload bytes. Unlike `encode_return`,
    /// this does not end the call, so the bytes can be post-processed (hashed,
    /// deployed via `create2_raw`, etc).
    /// The trailing partial word, if any, is zero-padded.
    pub fn to_memory(self, key: K) -> ptr::MemBuffer {
        let len = self.lengths[key]
        let word_count = ceil_words(len)
        var buffer = unsafe { ptr::MemBuffer::alloc_uninit((word_count * 32) as usize) }

        var i: u256 = 0
        while i < word_count {
            unsafe {
                ops::mstore(
                    addr: ptr::offset_bytes(buffer.ptr(), i * 32),
                    value: self.words[(key, i)],
                )
            }
            i += 1
        }

        unsafe { buffer.set_len(len as usize) }
        buffer
    }

    /// Load the 32-byte payload word at word `index` for `key`.
    ///
    /// The last word of a non-word-multiple length is zero-padded; indices
    /// past `ceil_words(len(key))` read as zero.
    pub fn word_at(self, key: K, index: u256) -> u256 {
        self.words[(key, index)]
    }

    /// Return ABI-encoded `bytes` from storage.
    pub fn encode_return(self, key: K) -> ! {
        let len = self.lengths[key]
        let word_count = ceil_words(len)
        let total_len = 64 + word_count * 32
        let ptr = ptr::alloc_bytes(total_len)
        unsafe {
            ops::mstore(addr: ptr, value: 32)
            ops::mstore(addr: offset(ptr, 32), value: len)
        }

        var i: u256 = 0
        while i < word_count {
            unsafe { ops::mstore(addr: offset(ptr, 64 + i * 32), value: self.words[(key, i)]) }
            i += 1
        }

        unsafe { ops::return_data(offset: ptr, len: total_len) }
    }
}
