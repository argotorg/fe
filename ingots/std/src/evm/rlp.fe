//! Recursive Length Prefix (RLP) encoding and decoding, the serialization
//! of Ethereum transactions, blocks and trie nodes (OpenZeppelin `RLP`).
//!
//! Encoders return the encoding as `Bytes`. A list takes its items already
//! encoded, so nested values are built from the inside out:
//!
//! ```ignore
//! let encoded = rlp::encode_list([
//!     rlp::encode_uint(nonce),
//!     rlp::encode_address(to),
//!     rlp::encode_bytes(data.payload_span()),
//! ])
//! ```
//!
//! Decoding only accepts the canonical encoding of a value: no single byte
//! below `0x80` in long form, no length prefix that a shorter form could
//! hold, no leading zero bytes in lengths or integers. `decode` checks the
//! outer item; list items are checked when `Item::items` reads them.
//! Decoded items are ranges of the input, nothing is copied; their accessors
//! take the input they were decoded from.
//!
//! Specification: https://ethereum.org/developers/docs/data-structures-and-encoding/rlp
use core::abi::Bytes
use core::num::IntDowncast
use core::option::Option
use core::ptr::{self, MemArray, MemSpan}
use super::effects::Address

/// Encodes a byte string.
pub fn encode_bytes(_ data: MemSpan) -> Bytes {
    let len = data.len()
    if len == 1 && data.byte_at(0) < 0x80 {
        return Bytes::from_payload(source: data)
    }
    let header = header_len(len)
    let out = ptr::alloc_bytes(header + len)
    write_header(out, offset: 0x80, len)
    unsafe {
        ptr::copy(dest: ptr::offset_bytes(out, header), source: data)
        Bytes::from_payload(source: MemSpan::from_raw_parts(ptr: out, len: header + len))
    }
}

/// Encodes an integer as its big-endian bytes without leading zeros, so
/// zero is the empty string `0x80`.
pub fn encode_uint(_ value: u256) -> Bytes {
    let len = byte_len(value)
    if len == 1 && value < 0x80 {
        return Bytes::from_word_prefix(word: value << 248, len: 1)
    }
    let out = ptr::alloc_bytes(1 + len)
    unsafe { *out = (0x80 + len as u256).downcast_truncate() }
    write_be(ptr::offset_bytes(out, 1), value, len)
    unsafe { Bytes::from_payload(source: MemSpan::from_raw_parts(ptr: out, len: 1 + len)) }
}

/// Encodes an address as a 20-byte string.
pub fn encode_address(_ address: Address) -> Bytes {
    Bytes::from_word_prefix(word: (0x94 << 248) | (address.inner << 88), len: 21)
}

/// Encodes `true` as the integer 1 (`0x01`) and `false` as 0 (`0x80`).
pub fn encode_bool(_ value: bool) -> Bytes {
    encode_uint(if value { 1 } else { 0 })
}

/// Encodes a list of already encoded items.
pub fn encode_list<const N: usize>(_ items: [Bytes; N]) -> Bytes {
    var len: usize = 0
    var i: usize = 0
    while i < N {
        len += items[i].len()
        i += 1
    }
    let header = header_len(len)
    let out = ptr::alloc_bytes(header + len)
    write_header(out, offset: 0xc0, len)
    var offset = header
    i = 0
    while i < N {
        let item = items[i].payload_span()
        unsafe { ptr::copy(dest: ptr::offset_bytes(out, offset), source: item) }
        offset += item.len()
        i += 1
    }
    unsafe { Bytes::from_payload(source: MemSpan::from_raw_parts(ptr: out, len: header + len)) }
}

fn header_len(_ len: usize) -> usize {
    if len < 56 { 1 } else { 1 + byte_len(len as u256) }
}

// Writes the prefix of a string (`offset` 0x80) or list (`offset` 0xc0)
// whose payload has `len` bytes.
fn write_header(_ dest: *u8, offset: u256, len: usize) {
    if len < 56 {
        unsafe { *dest = (offset + len as u256).downcast_truncate() }
        return
    }
    let len_len = byte_len(len as u256)
    unsafe { *dest = (offset + 55 + len_len as u256).downcast_truncate() }
    write_be(ptr::offset_bytes(dest, 1), value: len as u256, len_len)
}

fn byte_len(_ value: u256) -> usize {
    var len: usize = 0
    var rest = value
    while rest != 0 {
        len += 1
        rest >>= 8
    }
    len
}

// Writes the low `len` bytes of `value` big-endian.
fn write_be(_ dest: *u8, value: u256, _ len: usize) {
    var rest = value
    var i = len
    while i > 0 {
        i -= 1
        unsafe { *ptr::offset_bytes(dest, i) = rest.downcast_truncate() }
        rest >>= 8
    }
}

/// A decoded RLP item: a byte string or a list, as the range of its payload
/// in the input it was decoded from. Its accessors take that input.
pub struct Item {
    is_list: bool,
    start: usize,
    len: usize,
}

impl Copy for Item {}

impl Item {
    pub fn is_list(self) -> bool {
        self.is_list
    }

    /// The string bytes, or the concatenated encodings of the list items.
    pub fn payload(self, _ input: MemSpan) -> ref MemSpan {
        input.slice(offset: self.start, len: self.len)
    }

    /// The bytes of a string item, `None` for a list.
    pub fn as_bytes(self, _ input: MemSpan) -> Option<ref MemSpan> {
        if self.is_list {
            return Option::None
        }
        Option::Some(self.payload(input))
    }

    /// A string item of at most 32 bytes without leading zero bytes, read as
    /// a big-endian integer.
    pub fn as_uint(self, _ input: MemSpan) -> Option<u256> {
        let payload = self.payload(input)
        if self.is_list || self.len > 32 || (self.len > 0 && payload.byte_at(0) == 0) {
            return Option::None
        }
        Option::Some(read_be(payload))
    }

    /// A string item of exactly 20 bytes.
    pub fn as_address(self, _ input: MemSpan) -> Option<Address> {
        if self.is_list || self.len != 20 {
            return Option::None
        }
        Option::Some(Address { inner: read_be(self.payload(input)) })
    }

    /// The integer 0 or 1 as `false` or `true`.
    pub fn as_bool(self, _ input: MemSpan) -> Option<bool> {
        match self.as_uint(input) {
            Option::Some(0) => Option::Some(false)
            Option::Some(1) => Option::Some(true)
            _ => Option::None
        }
    }

    /// The items of a list item, `None` for a string or if any item is not
    /// canonically encoded. Like this item, they are ranges of `input`.
    pub fn items(self, _ input: MemSpan) -> Option<MemArray<Item>> {
        if !self.is_list {
            return Option::None
        }
        let payload = self.payload(input)
        var count: usize = 0
        var pos: usize = 0
        while pos < self.len {
            let (_, used) = split(payload.tail(pos))?
            pos += used
            count += 1
        }
        let items = unsafe { MemArray<Item>::new_uninit(count) }
        pos = 0
        var i: usize = 0
        while pos < self.len {
            let (item, used) = split(payload.tail(pos))?
            let start = self.start + pos + item.start
            unsafe { *items.ptr_at(i) = Item { is_list: item.is_list, start, len: item.len } }
            pos += used
            i += 1
        }
        Option::Some(items)
    }
}

/// Decodes `input` as exactly one item. `None` if it is not canonically
/// encoded or bytes follow it.
pub fn decode(_ input: MemSpan) -> Option<Item> {
    let (item, used) = split(input)?
    if used == input.len() { Option::Some(item) } else { Option::None }
}

// The first item of `input`, and the number of bytes it takes.
fn split(_ input: MemSpan) -> Option<(Item, usize)> {
    let len = input.len()
    if len == 0 {
        return Option::None
    }
    let prefix = input.byte_at(0) as u256
    if prefix < 0x80 {
        return Option::Some((Item { is_list: false, start: 0, len: 1 }, 1))
    }
    let is_list = prefix >= 0xc0
    let short: usize = (prefix - (if is_list { 0xc0 } else { 0x80 })).downcast_unchecked()
    var header: usize = 1
    var payload_len = short
    if short >= 56 {
        let len_len = short - 55
        header = 1 + len_len
        if len < header || input.byte_at(1) == 0 {
            return Option::None
        }
        payload_len = read_be(input.slice(offset: 1, len: len_len)).downcast_unchecked()
        if payload_len < 56 {
            return Option::None
        }
    }
    if header > len || payload_len > len - header {
        return Option::None
    }
    // A single byte below 0x80 is its own encoding.
    if !is_list && payload_len == 1 && input.byte_at(header) < 0x80 {
        return Option::None
    }
    Option::Some((Item { is_list, start: header, len: payload_len }, header + payload_len))
}

// Reads at most 32 bytes as a big-endian integer.
fn read_be(_ bytes: MemSpan) -> u256 {
    var value: u256 = 0
    var i: usize = 0
    while i < bytes.len() {
        value = (value << 8) | (bytes.byte_at(i) as u256)
        i += 1
    }
    value
}
