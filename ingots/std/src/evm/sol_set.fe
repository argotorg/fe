//! OpenZeppelin `EnumerableSet` storage.
//!
//! An `EnumerableSet.Set` at slot `s` is the struct
//! `{ bytes32[] _values; mapping(bytes32 => uint256) _positions; }`: the
//! values array at `s` and, at `s + 1`, a mapping from each value to its
//! index in the array plus one (0 means absent). `SolEnumerableSet` reads
//! and writes exactly that layout, so `SolEnumerableSet<Address>`,
//! `SolEnumerableSet<u256>` and `SolEnumerableSet<Bytes32>` are storage
//! compatible with OZ's `AddressSet`, `UintSet` and `Bytes32Set`.
//!
//! ```fe
//! // `EnumerableSet.AddressSet operators;` at slot 4, which no contract
//! // field uses
//! let operators = unsafe { SolEnumerableSet<Address>::at(4) }
//! if operators.add(operator) { /* newly added */ }
//! let n = operators.len()
//! ```
use core::abi::{AbiFrame, AbiSize, Encode, store_word}
use ingot::abi::DynArray
use core::iter::{Bidirectional, Collection}
use core::option::Option
use core::ptr
use ingot::abi::{Sol, StaticAbiElement}
use super::effects::{RawStorage, storage_at_mut}
use super::sol_array::{SolArray, first_index, last_index, next_index, prev_index}
use super::sol_slot::{SolPacked, field_mask}
use super::storage_map::StorageMap

// Each element is stored as its `SolPacked` bits in a full word, which is
// `bytes32(uint256(uint160(a)))` for an address, like OZ.
pub struct SolEnumerableSet<T> {
    values: SolArray<u256>,
    positions: StorageMap<u256, u256>,
}

// A loop visits the elements in the set's internal order, like `get`.
impl<T: SolPacked> Collection for SolEnumerableSet<T> {
    space S = memory
    type Cursor = u256
    type Item = T

    fn start(self) -> Option<u256> {
        first_index(self.len())
    }

    fn next(self, _ c: u256) -> Option<u256> {
        next_index(c, self.len())
    }

    fn at(self, _ c: u256) -> ref T {
        let value = self.get(c)
        ref value
    }
}

impl<T: SolPacked> Bidirectional for SolEnumerableSet<T> {
    fn last(self) -> Option<u256> {
        last_index(self.len())
    }

    fn prev(self, _ c: u256) -> Option<u256> {
        prev_index(c)
    }
}

impl<T: SolPacked> SolEnumerableSet<T> {
    /// The set stored at `slot` (and `slot + 1`).
    ///
    /// The caller must ensure that nothing the compiler allocates, such as a
    /// contract field, uses the slots the set occupies or derives.
    #[raw_place]
    pub unsafe fn at(_ slot: u256) -> mut Self uses (storage: mut RawStorage) {
        unsafe { storage_at_mut(slot) }
    }

    /// Number of elements.
    pub fn len(self) -> u256 {
        self.values.len()
    }

    /// Whether `value` is in the set.
    pub fn contains(self, _ value: own T) -> bool {
        self.positions[value.to_packed()] != 0
    }

    /// The element at `index` in the set's internal order, like OZ's `at`.
    /// The order changes when elements are removed. Reverts with
    /// `Panic(0x32)` if `index >= len()`.
    pub fn get(self, _ index: u256) -> T {
        T::from_packed(self.values[index] & field_mask(T::BITS))
    }

    /// All elements in the set's internal order (the order of `get`), like
    /// OZ's `values`.
    ///
    /// Costs one `sload` per element and allocates `32 * (len() + 1)`
    /// bytes, so the gas grows with the size of the set without bound. Meant
    /// for view calls, as OZ warns; a state-changing function calling it can
    /// be made to run out of gas by growing the set.
    pub fn values(self) -> DynArray<T>
        where T: StaticAbiElement + Encode<Sol> + AbiSize
    {
        let len = self.len()
        let size = 32 + len * 32
        let data = ptr::alloc_bytes(size)
        unsafe {
            ptr::zero_bytes(data, size)
            store_word(ptr: data, value: len)
        }
        var i: u256 = 0
        while i < len {
            let value = self.get(i)
            // The element's zeroed word, which only this encoding writes.
            value.encode(unsafe { AbiFrame::from_raw_parts(ptr: ptr::offset_bytes(data, 32 + i * 32), len: 32) })
            i += 1
        }
        unsafe { DynArray::from_abi_tail(data, len: len as usize, size) }
    }

    /// Adds `value`; returns false if it was already present.
    pub fn add(mut self, _ value: own T) -> bool {
        let word = value.to_packed()
        if self.positions[word] != 0 {
            return false
        }
        self.values.push(word)
        self.positions[word] = self.values.len()
        true
    }

    /// Removes `value` by moving the last element into its place and
    /// popping the array, like OZ; returns false if it was absent.
    pub fn remove(mut self, _ value: own T) -> bool {
        let word = value.to_packed()
        let position = self.positions[word]
        if position == 0 {
            return false
        }
        let index = position - 1
        let last = self.values.len() - 1
        if index != last {
            let last_word = self.values[last]
            self.values[index] = last_word
            self.positions[last_word] = position
        }
        self.values.pop()
        self.positions.remove(word)
        true
    }

    /// Removes every element.
    pub fn clear(mut self) {
        let len = self.values.len()
        var i: u256 = 0
        while i < len {
            let word = self.values[i]
            self.positions.remove(word)
            i += 1
        }
        self.values.clear()
    }
}
