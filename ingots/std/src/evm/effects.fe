impl RawOps for Evm {
    fn calldataload(self, _ offset: u256) -> u256 {
        ops::calldataload(offset)
    }
    fn calldatasize(self) -> u256 {
        ops::calldatasize()
    }
    fn calldatacopy(
        mut self,
        dest: mut MemBuffer,
        dest_offset: u256,
        src_offset: u256,
        len: u256,
    ) {
        let dest_ptr = prepare_copy_destination(
            dest: mut dest,
            dest_offset,
            len,
        )
        if len == 0 {
            return
        }
        ops::calldatacopy(
            dest: dest_ptr,
            offset: src_offset,
            len,
        )
        let end = dest_offset + len
        if end > dest.len() {
            dest.set_len(end)
        }
    }

    fn returndatasize(self) -> u256 {
        ops::returndatasize()
    }
    fn returndatacopy(
        mut self,
        dest: mut MemBuffer,
        dest_offset: u256,
        src_offset: u256,
        len: u256,
    ) {
        let dest_ptr = prepare_copy_destination(
            dest: mut dest,
            dest_offset,
            len,
        )
        if len == 0 {
            return
        }
        ops::returndatacopy(
            dest: dest_ptr,
            offset: src_offset,
            len,
        )
        let end = dest_offset + len
        if end > dest.len() {
            dest.set_len(end)
        }
    }

    fn codecopy(
        mut self,
        dest: mut MemBuffer,
        dest_offset: u256,
        src_offset: u256,
        len: u256,
    ) {
        let dest_ptr = prepare_copy_destination(
            dest: mut dest,
            dest_offset,
            len,
        )
        if len == 0 {
            return
        }
        ops::codecopy(
            dest: dest_ptr,
            offset: src_offset,
            len,
        )
        let end = dest_offset + len
        if end > dest.len() {
            dest.set_len(end)
        }
    }

    fn codesize(self) -> u256 {
        ops::codesize()
    }

    fn keccak256(self, data: MemSpan) -> u256 {
        ops::keccak256(offset: data.ptr(), len: data.len())
    }

    fn revert(self, data: MemSpan) -> ! {
        ops::revert(offset: data.ptr(), len: data.len())
    }

    fn return_data(self, data: MemSpan) -> ! {
        ops::return_data(offset: data.ptr(), len: data.len())
    }

    fn code_region_offset<F>(self, _ f: F) -> u256 {
        intrinsic_code_region_offset(f)
    }
    fn code_region_len<F>(self, _ f: F) -> u256 {
        intrinsic_code_region_len(f)
    }
}

