use core::marker::Pinned
use core::ops::{Location, StateIndex}
use core::option::Option

use super::effects::{RawStorage, storage_at, storage_at_mut}
use super::layout::array_data_slot

const U256_MASK: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

/// A storage-backed packed array of fixed-bit-width integer lanes, indexed
/// by any `u256`, with no length: a packed map of small integers.
///
/// Index `i` is lane `i % (256 / BITS)` of word `i / (256 / BITS)`, and word
/// `w` lies at `keccak256(slot) + w`, from the array's slot on like a Solidity
/// dynamic array's data. Consecutive indices share words, so dense integer
/// indices (token IDs, user IDs, order IDs, sequence positions) pack well;
/// addresses or hashes would take a word each and belong in a `StorageMap`.
/// Every index reads as zero until it is set.
///
/// The words have no bound: the indices reach `BITS / 256` of all storage
/// from `keccak256(slot)` on, which can include another field's slots or a
/// map's entries. Keep indices in a range the contract controls rather than
/// passing an untrusted `u256` through.
///
/// `BITS` must be a power of two that divides 256 — one of
/// 1, 2, 4, 8, 16, 32, 64, 128. The constraint is enforced at compile time
/// via `PackedBits<BITS>: ValidPackedBits`; invalid widths fail type-checking
/// with a "trait bound is not satisfied" error.
///
/// The array lives at its storage place, which takes one slot. A
/// `StoragePackedArray` in a contract field, a struct or a map value is its
/// own array.
///
/// # Example
///
/// ```fe
/// struct Store {
///     order_status: StoragePackedArray<8>,
///     order_tier:   StoragePackedArray<4>,
/// }
///
/// fn write_order_status() uses (store: mut Store) {
///     store.order_status.set(42, 1)
/// }
/// ```
pub struct StoragePackedArray<const BITS: u256> {
    words: PackedWords,
}

/// The words of a packed array: word `w` of the array whose place starts at
/// slot `s` is at `keccak256(s) + w`.
struct PackedWords {}

impl Pinned for PackedWords {
    space S = storage
}

unsafe impl StateIndex for PackedWords {
    type Key = u256
    type Entry = u256

    #[arithmetic(unchecked)]
    #[inline(always)]
    fn locate(self, _ root: u256, _ word: u256) -> Location {
        Location { slot: array_data_slot(root) + word, offset: 0 }
    }
}

/// Marker trait for `BITS` values that produce a well-formed packed layout
/// — power of two ≤ 128, so 256 divides evenly into `256 / BITS` lanes.
///
/// Implemented only via `PackedBits<N>` for valid `N`; not user-extensible.
pub trait ValidPackedBits {}

/// Type-level witness used to constrain `BITS` of `StoragePackedArray`.
///
/// Most users do not name this directly. Generic helpers over `BITS` may need
/// a `where PackedBits<BITS>: ValidPackedBits` bound to call the accessor methods
/// for an otherwise unknown lane width.
pub struct PackedBits<const N: u256> {}

impl ValidPackedBits for PackedBits<1> {}
impl ValidPackedBits for PackedBits<2> {}
impl ValidPackedBits for PackedBits<4> {}
impl ValidPackedBits for PackedBits<8> {}
impl ValidPackedBits for PackedBits<16> {}
impl ValidPackedBits for PackedBits<32> {}
impl ValidPackedBits for PackedBits<64> {}
impl ValidPackedBits for PackedBits<128> {}

impl<const BITS: u256> StoragePackedArray<BITS>
    where PackedBits<BITS>: ValidPackedBits
{
    /// Number of lanes packed into each 256-bit storage slot.
    const LANES_PER_SLOT: u256 = 256 / BITS

    /// Mask covering the low `BITS` bits of a lane.
    const LANE_MASK: u256 = (1 << BITS) - 1

    /// The array whose slot is `slot`, to read.
    ///
    /// The caller must ensure that nothing the compiler allocates, such as a
    /// contract field, uses `slot` or the words' slots.
    #[raw_place]
    pub unsafe fn at(_ slot: u256) -> ref Self uses (storage: RawStorage) {
        unsafe { storage_at(slot) }
    }

    /// The array whose slot is `slot`, to read and write.
    ///
    /// The caller must ensure what `at` requires.
    #[raw_place]
    pub unsafe fn at_mut(_ slot: u256) -> mut Self uses (storage: mut RawStorage) {
        unsafe { storage_at_mut(slot) }
    }

    /// Read the lane at index `i`. Returns the lane value zero-extended to `u256`.
    #[arithmetic(unchecked)]
    #[inline(always)]
    pub fn get(self, _ i: u256) -> u256 {
        let bit_pos: u256 = (i % Self::LANES_PER_SLOT) * BITS
        (self.words[i / Self::LANES_PER_SLOT] >> bit_pos) & Self::LANE_MASK
    }

    /// Overwrite the lane at index `i` with `value`. Bits above `BITS` in
    /// `value` are silently dropped.
    #[arithmetic(unchecked)]
    #[inline(always)]
    pub fn set(mut self, i: u256, value: u256) {
        let bit_pos: u256 = (i % Self::LANES_PER_SLOT) * BITS
        let lane_mask_shifted: u256 = Self::LANE_MASK << bit_pos
        let word = mut self.words[i / Self::LANES_PER_SLOT]
        word = (word & (U256_MASK ^ lane_mask_shifted)) | ((value & Self::LANE_MASK) << bit_pos)
    }

    /// Linear search in `[start, end)` for the first lane equal to `needle`.
    ///
    /// Reads one SLOAD per slot and then scans up to `Self::LANES_PER_SLOT`
    /// lanes from the in-register word, amortizing storage access across
    /// consecutive indices.
    #[arithmetic(unchecked)]
    pub fn search(self, needle: u256, start: u256, end: u256) -> Option<u256> {
        var i: u256 = start
        while i < end {
            let word: u256 = self.words[i / Self::LANES_PER_SLOT]
            var lane: u256 = i % Self::LANES_PER_SLOT
            while lane < Self::LANES_PER_SLOT && i < end {
                if ((word >> (lane * BITS)) & Self::LANE_MASK) == needle {
                    return Option::Some(i)
                }
                lane += 1
                i += 1
            }
        }
        Option::None
    }
}
