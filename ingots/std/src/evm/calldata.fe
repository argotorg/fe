use core::abi::{AbiSize, ByteInput, Decode}
use core::Copy
use core::num::IntDowncast
use ingot::abi::{ArrayView, Sol, decode_array_view_at}
use ingot::abi::sol::{decode_input}
use ingot::evm::ops::{calldataload, calldatacopy, calldatasize, revert_empty}

/// A view over the current EVM calldata.
///
/// `base` marks the first byte visible through this view. External function
/// selectors are not handled specially; callers choose whether to decode raw
/// calldata (`CallData::new()`) or a rebased payload view
/// (`CallData::with_base(4)`).
pub struct CallData { pub base: u256 }

impl Copy for CallData {}

impl CallData {
    #[inline(always)]
    pub fn new() -> Self {
        CallData { base: 0 }
    }

    #[inline(always)]
    pub fn with_base(_ base: u256) -> Self {
        CallData { base }
    }

    /// Decode Solidity ABI data from this calldata view.
    pub fn decode<T>(self) -> T where T: Decode<Sol> + AbiSize {
        decode_input(self)
    }

    /// Lazy view of the ABI `T[]` whose head word is at `head_pos` (relative
    /// to `base`); offsets are resolved relative to `base`.
    ///
    /// With `CallData::with_base(4)`, `head_pos: k * 32` is the `k`-th
    /// argument of an external call, which is how a `recv` arm with a raw
    /// selector reads a `T[] calldata` argument without decoding all of it.
    /// See `decode_array_view_at` for the validation performed.
    pub fn array_view<T>(self, _ head_pos: u256) -> ArrayView<CallData, T> where T: AbiSize {
        decode_array_view_at(self, base: 0, head_pos: head_pos)
    }
}

impl ByteInput for CallData {
    #[inline(always)]
    fn len(self) -> u256 {
        let total = calldatasize()
        if self.base > total {
            0
        } else {
            total - self.base
        }
    }

    #[arithmetic(unchecked)]
    #[inline(always)]
    fn word_at(self, _ byte_offset: u256) -> u256 {
        calldataload(self.base + byte_offset)
    }

    #[arithmetic(unchecked)]
    #[inline(always)]
    fn byte_at(self, _ byte_offset: u256) -> u8 {
        let word_offset = byte_offset - (byte_offset % 32)
        let word = calldataload(self.base + word_offset)
        let idx = byte_offset - word_offset
        let shift = (31 - idx) * 8
        (word >> shift).downcast_truncate()
    }

    fn copy_to_memory(self, dest: *u8, src_offset: u256, len: u256) {
        let input_len = self.len()
        if src_offset > input_len || len > input_len - src_offset {
            revert_empty()
        }

        calldatacopy(dest: dest, offset: self.base + src_offset, len: len)
    }

    #[arithmetic(unchecked)]
    #[inline(always)]
    fn copy_to_memory_unchecked(self, dest: *u8, src_offset: u256, len: u256) {
        calldatacopy(dest: dest, offset: self.base + src_offset, len: len)
    }
}
