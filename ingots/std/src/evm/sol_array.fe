//! Solidity dynamic storage arrays (`T[]`).
//!
//! A `T[]` state variable at slot `s` stores its length in `s` and its
//! elements from `keccak256(abi.encode(s))` on, like Solidity. An element of
//! 16 bytes or fewer with a Solidity encoding (`SolPacked`) shares a slot:
//! `32 / size` of them fit, element `i` sitting `(i % (32 / size)) * size`
//! bytes above the low end of slot `keccak256(abi.encode(s)) + i / (32 / size)`.
//! Any other element takes the slots its storage layout spans, one after
//! another.
//!
//! `arr[i]` is the element's place: `arr[i] = v` writes only its bytes, and
//! `arr[i].count += 1` one field. It reverts with `Panic(0x32)` if
//! `i >= arr.len()`.
//!
//! ```fe
//! // `address[] owners;` at slot 2, which no contract field uses
//! let owners = unsafe { mut SolArray<Address>::at(2) }
//! owners.push(owner)
//! let first = owners[0]
//! ```
use core::abi::{AbiFrame, AbiSize, Encode, store_word}
use ingot::abi::DynArray
use core::iter::{Bidirectional, Collection}
use core::marker::{Clearable, Pinned, Storage}
use core::ops::{LaneCodec, Location, StateIndex, WrappingAdd, WrappingSub, clear_storage}
use core::ptr
use ingot::abi::{Sol, StaticAbiElement}
use super::effects::{RawStorage, revert_error, storage_at}
use super::panic::{PANIC_INDEX_OUT_OF_BOUNDS, PANIC_OUT_OF_MEMORY, PANIC_POP_EMPTY, Panic}
use super::layout::{array_data_slot, element_location}
use super::sol_slot::{SolPacked, field_mask}

// Solidity refuses to `push` onto a storage array of 2**64 - 1 elements.
const MAX_LEN: u256 = 0xffffffffffffffff

pub struct SolArray<T> {
    len: u256,
}

/// How a `SolArray` packs its elements: Solidity's encoding (`SolPacked`), in
/// lanes when it is at most 128 bits. Any other element is stored at whole
/// slots, as its type's storage layout places it (`storage_slots<T>()`); for
/// an element without an encoding the compiler implements `LaneCodec<T>`,
/// with `BITS` 256 times those slots.
pub struct SolLanes {}

impl<T: SolPacked> LaneCodec<T> for SolLanes {
    const BITS: u256 = T::BITS

    fn get(_ word: u256, offset: u256) -> T {
        T::from_packed((word >> offset) & field_mask(T::BITS))
    }

    fn set(_ word: u256, offset: u256, value: own T) -> u256 {
        let mask = field_mask(T::BITS) << offset
        (word & !mask) | ((value.to_packed() << offset) & mask)
    }
}

impl<T> Pinned for SolArray<T> {
    type Space = Storage
}

unsafe impl<T> StateIndex for SolArray<T> {
    type Key = u256
    type Entry = T
    type Lanes = SolLanes

    fn locate(self, _ root: u256, _ index: u256) -> Location {
        if index >= self.len {
            revert_error(Panic::from(PANIC_INDEX_OUT_OF_BOUNDS))
        }
        element_location<T>(array_data_slot(root), index, bits: <Self::Lanes as LaneCodec<T>>::BITS)
    }
}

impl<T> SolArray<T> {
    /// The array whose length is stored at `slot`.
    ///
    /// The caller must ensure that nothing the compiler allocates, such as a
    /// contract field, uses `slot` or the elements' slots.
    #[raw_place]
    pub unsafe fn at(_ slot: u256) -> mut? Self uses (storage: mut? RawStorage) {
        unsafe { storage_at(slot) }
    }

    /// Number of elements.
    pub fn len(self) -> u256 {
        self.len
    }

    /// Element `index`. Reverts with `Panic(0x32)` if `index >= len()`.
    pub fn get(self, _ index: u256) -> T
        where T: Copy
    {
        self[index]
    }

    /// Replaces element `index`, keeping elements packed into the same slot.
    /// Reverts with `Panic(0x32)` if `index >= len()`.
    pub fn set(mut self, index: u256, value: own T) {
        self[index] = value
    }

    /// Appends `value`. Reverts with `Panic(0x41)` if the array already has
    /// 2**64 - 1 elements, like Solidity.
    pub fn push(mut self, _ value: own T) {
        let len = self.len
        if len >= MAX_LEN {
            revert_error(Panic::from(PANIC_OUT_OF_MEMORY))
        }
        self.len = len + 1
        self[len] = value
    }

    /// Removes the last element, zeroing its storage like Solidity's `pop()`.
    /// Reverts with `Panic(0x31)` if the array is empty.
    pub fn pop(mut self)
        where T: Clearable
    {
        let len = self.len
        if len == 0 {
            revert_error(Panic::from(PANIC_POP_EMPTY))
        }
        clear_storage(mut self, len - 1)
        self.len = len - 1
    }

    /// Zeroes the element at `i`, leaving the length: it reads as its type's
    /// zero value. Reverts with `Panic(0x32)` if `i` is out of bounds.
    pub fn clear_at(mut self, _ i: u256)
        where T: Clearable
    {
        clear_storage(mut self, i)
    }

    /// Removes every element, zeroing their storage, so that growing the
    /// array again exposes no old element. Costs a slot write per element,
    /// and a read too for elements packed into shared slots.
    pub fn clear(mut self)
        where T: Clearable
    {
        let len = self.len
        var i: u256 = 0
        while i < len {
            clear_storage(mut self, i)
            i += 1
        }
        self.len = 0
    }

    /// All elements in index order, as an ABI `T[]` in memory, like
    /// Solidity's `return arr;` for a storage array.
    ///
    /// Costs an `sload` per element and allocates `32 * (len() + 1)` bytes,
    /// so the gas grows with the length without bound. Meant for view calls;
    /// a state-changing function calling it can be made to run out of gas by
    /// growing the array.
    pub fn to_dyn_array(self) -> DynArray<T>
        where T: SolPacked + Copy + StaticAbiElement + Encode<Sol> + AbiSize
    {
        let len = self.len
        let size = 32 + len * 32
        let data = ptr::alloc_bytes(size.downcast_saturate())
        unsafe {
            ptr::zero_bytes(data, size.downcast_unchecked())
            store_word(ptr: data, value: len)
        }
        var i: u256 = 0
        while i < len {
            let value = self[i]
            // The element's zeroed word, which only this encoding writes.
            value.encode(unsafe { AbiFrame::from_raw_parts(ptr: ptr::offset_bytes(data, (32 + i * 32).downcast_unchecked()), len: 32) })
            i += 1
        }
        unsafe { DynArray::from_abi_tail(data, len: len.downcast_unchecked(), size) }
    }
}

impl<T> Collection for SolArray<T> {
    type Cursor = u256
    type Item = T

    // Index cursors wrap, as core's do: the position before index 0 and the
    // last position of an empty array are both `u256::MAX`, so `c < len`
    // tests a position in either direction.
    fn start(self) -> u256 {
        0
    }

    fn has(self, _ c: u256) -> bool {
        c < self.len
    }

    fn next(self, _ c: u256) -> u256 {
        c.wrapping_add(1)
    }

    fn at(mut? self, _ c: u256) -> mut? T {
        mut? self[c]
    }
}

impl<T> Bidirectional for SolArray<T> {
    fn last(self) -> u256 {
        self.len.wrapping_sub(1)
    }

    fn prev(self, _ c: u256) -> u256 {
        c.wrapping_sub(1)
    }
}
