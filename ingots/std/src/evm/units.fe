impl<A: Abi> AbiSpan<A> for Timestamp {
    fn payload_end<I: ByteInput>(_: I, base: u256, pos: u256) -> u256 { pos + 32 }
}

impl StaticAbiElementSeal for Timestamp {}
impl StaticAbiElement for Timestamp {}

impl SolCompat for Timestamp {
    type S = String<7>
    const SOL_TYPE: Self::S = "uint256"
}

impl TopicValue for Timestamp {
    fn as_topic(self) -> u256 { self.secs }
}

impl StorageKey for Timestamp {
    fn encoded_len(self) -> u256 { 32 }
    fn write_key(ptr: *u8, self) {
        store_word(ptr: ptr, value: self.secs)
    }
}

impl EncodePacked for Timestamp {
    #[inline(always)]
    fn packed_width(self) -> u256 { 32 }
    fn pack_into(own self, mut _ p: own Packed) -> Packed uses (mem: mut RawMem) {
        p.u256(self.secs)
        p
