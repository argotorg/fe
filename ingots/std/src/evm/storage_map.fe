use super::effects::{Address, RawStorage, StorPtr, StorReadPtr}
use super::crypto::keccak256
use ingot::evm::ops::mstore
use core::num::IntWord
use core::ptr

/// Keys that can be written into the mapping preimage for keccak hashing.
pub trait StorageKey {
    /// Returns the exact byte length of this key's mapping encoding.
    fn encoded_len(self) -> u256

    /// Writes exactly `self.encoded_len()` bytes into the reserved region at `ptr`.
    /// Encoding must remain stable between `encoded_len` and `write_key`.
    fn write_key(ptr: *u8, self)
}

impl StorageKey for u256 {
    fn encoded_len(self) -> u256 {
        32
    }

    #[inline(always)]
    fn write_key(ptr: *u8, self) {
        mstore(addr: ptr, value: self)
    }
}

impl StorageKey for Address {
    fn encoded_len(self) -> u256 {
        32
    }

    #[inline(always)]
    fn write_key(ptr: *u8, self) {
        u256::write_key(ptr: ptr, self.inner)
    }
}

// Unsigned integer keys — widening cast to u256 zero-extends, matching
// Solidity's `mapping(uintN => V)` slot derivation (`keccak256(key ++ slot)`
// with the key left-padded to 32 bytes).

impl StorageKey for u8 {
    fn encoded_len(self) -> u256 {
        32
    }

    fn write_key(ptr: *u8, self) {
        u256::write_key(ptr: ptr, IntWord::to_word(self))
    }
}

impl StorageKey for u16 {
    fn encoded_len(self) -> u256 {
        32
    }

    fn write_key(ptr: *u8, self) {
        u256::write_key(ptr: ptr, IntWord::to_word(self))
    }
}

impl StorageKey for u32 {
    fn encoded_len(self) -> u256 {
        32
    }

    fn write_key(ptr: *u8, self) {
        u256::write_key(ptr: ptr, IntWord::to_word(self))
    }
}

impl StorageKey for u64 {
    fn encoded_len(self) -> u256 {
        32
    }

    fn write_key(ptr: *u8, self) {
        u256::write_key(ptr: ptr, IntWord::to_word(self))
    }
}

impl StorageKey for u128 {
    fn encoded_len(self) -> u256 {
        32
    }

    fn write_key(ptr: *u8, self) {
        u256::write_key(ptr: ptr, IntWord::to_word(self))
    }
}

impl StorageKey for usize {
    fn encoded_len(self) -> u256 {
        32
    }

    fn write_key(ptr: *u8, self) {
        u256::write_key(ptr: ptr, IntWord::to_word(self))
    }
}

// Signed integer keys — `IntWord::to_word` sign-extends, matching Solidity's
// `mapping(intN => V)` convention.

impl StorageKey for i8 {
    fn encoded_len(self) -> u256 {
        32
    }

    fn write_key(ptr: *u8, self) {
        u256::write_key(ptr: ptr, IntWord::to_word(self))
    }
}

impl StorageKey for i16 {
    fn encoded_len(self) -> u256 {
        32
    }

    fn write_key(ptr: *u8, self) {
        u256::write_key(ptr: ptr, IntWord::to_word(self))
    }
}

impl StorageKey for i32 {
    fn encoded_len(self) -> u256 {
        32
    }

    fn write_key(ptr: *u8, self) {
