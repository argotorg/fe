    }

    unsafe fn write_key(ptr: *u8, self) {
        u256::write_key(ptr: ptr, IntWord::to_word(self))
    }
}

// `bool` — encoded as 1 (true) or 0 (false) in a 32-byte word.

impl StorageKey for bool {
    fn encoded_len(self) -> u256 {
        32
    }

    unsafe fn write_key(ptr: *u8, self) {
        u256::write_key(ptr: ptr, if self { 1 } else { 0 })
    }
}

/// A storage-backed mapping from keys `K` to values `V`, laid out like a
/// Solidity `mapping`.
///
/// A map is a storage collection: it lives at its place in storage, which
/// takes one slot of its container, never written, as a Solidity mapping's
/// does, and it is never copied or moved. The value at `key` occupies the
/// slots from `keccak256(key ++ slot)` onwards,
/// laid out like any value of type `V` in storage, including packed struct
/// fields, so a map in a map's value derives its slot from its entry's. The
/// entries are persistent, so a map cannot lie in transient storage.
/// `map[key]` names that entry's place: `map[key].f += 1` reads and writes
/// one field, and `let e = mut map[key]` binds the entry. Keys use the stable
/// encoding `StorageKey` defines.
pub struct StorageMap<K, V> {}

impl<K, V> Pinned for StorageMap<K, V> {
    type Space = Storage
}

unsafe impl<K: StorageKey + Copy, V> StateIndex for StorageMap<K, V> {
    type Key = K
    type Entry = V

    #[inline(always)]
    fn locate(self, _ root: u256, _ key: K) -> Location {
        Location { slot: mapping_slot(root, key), offset: 0 }
    }
}

impl<K: StorageKey + Copy, V> StorageMap<K, V> {
    /// The map whose slot is `slot`, such as a Solidity `mapping` at a known
    /// slot.
    ///
    /// The caller must ensure that nothing the compiler allocates, such as a
    /// contract field, uses `slot` or the entries' slots.
    #[raw_place]
    pub unsafe fn at(_ slot: u256) -> mut? Self uses (storage: mut? RawStorage) {
        unsafe { storage_at(slot) }
    }

    /// Copies the value at `key` out of storage, in full.
    #[inline(always)]
    pub fn get(self, _ key: K) -> V
        where V: Copy
    {
        self[key]
    }

    /// Replaces the value at `key`.
    #[inline(always)]
    pub fn set(mut self, key: K, value: own V) {
        self[key] = value
    }

    /// Zeroes the value at `key`: it reads as its type's zero value, as a
    /// key no one set does. A value holding a storage collection cannot be
    /// removed, since zeroing its slots would leave the collection's entries.
    #[inline(always)]
    pub fn remove(mut self, _ key: K)
        where V: Clearable
    {
        clear_storage(mut self, key)
    }
}

impl<A, B> StorageKey for (A, B)
where A: StorageKey,
      B: StorageKey {
    #[inline(always)]
    fn encoded_len(self) -> u256 {
        A::encoded_len(self.0) + B::encoded_len(self.1)
    }

    #[inline(always)]
    unsafe fn write_key(ptr: *u8, self) {
        let a_len = A::encoded_len(self.0)
        A::write_key(ptr: ptr, self.0)
        B::write_key(ptr: ptr::offset_bytes(ptr, a_len.downcast_unchecked()), self.1)
    }
}


impl<A, B, C> StorageKey for (A, B, C)
where A: StorageKey,
      B: StorageKey,
      C: StorageKey {
    #[inline(always)]
    fn encoded_len(self) -> u256 {
        A::encoded_len(self.0) + B::encoded_len(self.1) + C::encoded_len(self.2)
    }

    #[inline(always)]
    unsafe fn write_key(ptr: *u8, self) {
        let a_len = A::encoded_len(self.0)
        let b_len = B::encoded_len(self.1)
        A::write_key(ptr: ptr, self.0)
        B::write_key(ptr: ptr::offset_bytes(ptr, a_len.downcast_unchecked()), self.1)
        C::write_key(ptr: ptr::offset_bytes(ptr, (a_len + b_len).downcast_unchecked()), self.2)
    }
}


impl<A, B, C, D> StorageKey for (A, B, C, D)
where A: StorageKey,
      B: StorageKey,
      C: StorageKey,
      D: StorageKey {
    #[inline(always)]
    fn encoded_len(self) -> u256 {
        A::encoded_len(self.0) + B::encoded_len(self.1) + C::encoded_len(self.2) + D::encoded_len(self.3)
    }

    #[inline(always)]
    unsafe fn write_key(ptr: *u8, self) {
        let a_len = A::encoded_len(self.0)
        let b_len = B::encoded_len(self.1)
        let c_len = C::encoded_len(self.2)
        A::write_key(ptr: ptr, self.0)
        B::write_key(ptr: ptr::offset_bytes(ptr, a_len.downcast_unchecked()), self.1)
        C::write_key(ptr: ptr::offset_bytes(ptr, (a_len + b_len).downcast_unchecked()), self.2)
        D::write_key(ptr: ptr::offset_bytes(ptr, (a_len + b_len + c_len).downcast_unchecked()), self.3)
    }
}


impl<A, B, C, D, E> StorageKey for (A, B, C, D, E)
where A: StorageKey,
      B: StorageKey,
      C: StorageKey,
      D: StorageKey,
      E: StorageKey {
    #[inline(always)]
    fn encoded_len(self) -> u256 {
        A::encoded_len(self.0) + B::encoded_len(self.1) + C::encoded_len(self.2) + D::encoded_len(self.3) + E::encoded_len(self.4)
    }

    #[inline(always)]
    unsafe fn write_key(ptr: *u8, self) {
        let a_len = A::encoded_len(self.0)
        let b_len = B::encoded_len(self.1)
        let c_len = C::encoded_len(self.2)
        let d_len = D::encoded_len(self.3)
        A::write_key(ptr: ptr, self.0)
        B::write_key(ptr: ptr::offset_bytes(ptr, a_len.downcast_unchecked()), self.1)
        C::write_key(ptr: ptr::offset_bytes(ptr, (a_len + b_len).downcast_unchecked()), self.2)
        D::write_key(ptr: ptr::offset_bytes(ptr, (a_len + b_len + c_len).downcast_unchecked()), self.3)
        E::write_key(ptr: ptr::offset_bytes(ptr, (a_len + b_len + c_len + d_len).downcast_unchecked()), self.4)
    }
}


impl<A, B, C, D, E, F> StorageKey for (A, B, C, D, E, F)
where A: StorageKey,
      B: StorageKey,
      C: StorageKey,
      D: StorageKey,
      E: StorageKey,
      F: StorageKey {
    #[inline(always)]
    fn encoded_len(self) -> u256 {
        A::encoded_len(self.0) + B::encoded_len(self.1) + C::encoded_len(self.2) + D::encoded_len(self.3) + E::encoded_len(self.4) + F::encoded_len(self.5)
    }

    #[inline(always)]
    unsafe fn write_key(ptr: *u8, self) {
        let a_len = A::encoded_len(self.0)
        let b_len = B::encoded_len(self.1)
        let c_len = C::encoded_len(self.2)
        let d_len = D::encoded_len(self.3)
        let e_len = E::encoded_len(self.4)
        A::write_key(ptr: ptr, self.0)
        B::write_key(ptr: ptr::offset_bytes(ptr, a_len.downcast_unchecked()), self.1)
        C::write_key(ptr: ptr::offset_bytes(ptr, (a_len + b_len).downcast_unchecked()), self.2)
        D::write_key(ptr: ptr::offset_bytes(ptr, (a_len + b_len + c_len).downcast_unchecked()), self.3)
        E::write_key(ptr: ptr::offset_bytes(ptr, (a_len + b_len + c_len + d_len).downcast_unchecked()), self.4)
        F::write_key(ptr: ptr::offset_bytes(ptr, (a_len + b_len + c_len + d_len + e_len).downcast_unchecked()), self.5)
    }
}
