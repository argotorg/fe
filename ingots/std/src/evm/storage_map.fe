    }

    fn write_key(ptr: *u8, self) {
        u256::write_key(ptr: ptr, IntWord::to_word(self))
    }
}

// `bool` — encoded as 1 (true) or 0 (false) in a 32-byte word.

impl StorageKey for bool {
    fn encoded_len(self) -> u256 {
        32
    }

    fn write_key(ptr: *u8, self) {
        u256::write_key(ptr: ptr, if self { 1 } else { 0 })
    }
}

/// Seals construction of storage maps to the standard library.
struct StorageMapSeal {}

/// A storage-backed mapping from keys `K` to values `V`.
///
/// Values use their native storage layout, including packed struct fields.
/// `get`/`set` and `ptr`/`mut_ptr` access the same representation; keys use
/// the separate, stable encoding defined by `StorageKey`.
///
/// `SALT` is the mapping's slot seed (the `slot` component in
/// `keccak256(key ++ slot)`), chosen explicitly for each mapping instance to
/// prevent collisions.
pub struct StorageMap<K, V, const SALT: u256 = _> {
    seal: StorageMapSeal,
}

impl<K, V, const SALT: u256> Copy for StorageMap<K, V, SALT> {}

#[inline(always)]
fn storagemap_storage_slot_with_salt<K>(key: K, salt: u256) -> u256
    where K: StorageKey
{
    // keccak256(key ++ slot) - standard Solidity mapping layout
    // Reserve the entire preimage before encoding: key encoders may allocate.
    let key_len = K::encoded_len(key)
    let scratch = ptr::alloc_bytes(key_len + 32)
    K::write_key(ptr: scratch, key)
    mstore(addr: ptr::offset_bytes(scratch, key_len), value: salt)
    keccak256(ptr::MemSpan::from_raw_parts(ptr: scratch, len: key_len + 32))
}

// Trusted by the borrow checker: the returned handle addresses a value that
// starts at `slot`, which must be the result of
// `storagemap_storage_slot_with_salt`. Such a value never overlaps a
// compiler-allocated contract field.
#[inline(always)]
fn storagemap_entry_ptr<V>(_ slot: u256) -> StorPtr<V> {
    StorPtr::at_slot_unchecked(slot)
}

// The read-only counterpart of `storagemap_entry_ptr`, with the same trust.
#[inline(always)]
fn storagemap_entry_read_ptr<V>(_ slot: u256) -> StorReadPtr<V> {
    StorReadPtr::at_slot_unchecked(slot)
}

impl<K: StorageKey, V, const SALT: u256> StorageMap<K, V, SALT> {
    pub(ingot) fn new_unchecked() -> Self {
        Self { seal: StorageMapSeal {} }
    }

    pub fn new() -> Self
    uses (storage: mut RawStorage)
    {
        Self::new_unchecked()
    }

    /// A read-only storage place for the value at `key`.
    ///
    /// The value occupies the storage slots from `keccak256(key ++ SALT)`
    /// onwards, laid out like any value of type `V` in storage. Bind the
    /// pointer with `with (ptr) { ... }` to read individual fields without
    /// loading the whole value.
    #[inline(always)]
    pub fn ptr(self, _ key: K) -> StorReadPtr<V> {
        storagemap_entry_read_ptr(storagemap_storage_slot_with_salt(key, salt: SALT))
    }

    /// A writable storage place for the value at `key`.
    ///
    /// Like `ptr`, but the place can also be written, either as a whole or
    /// one field at a time. Requires a mutable map.
    #[inline(always)]
    pub fn mut_ptr(mut self, _ key: K) -> StorPtr<V> {
        storagemap_entry_ptr(storagemap_storage_slot_with_salt(key, salt: SALT))
    }

    #[inline(always)]
    pub(ingot) fn get_unchecked(self, _ key: K) -> V
        where V: Copy
    {
        self.ptr(key).read()
    }

    /// Copies the whole value from its native storage layout.
    #[inline(always)]
    pub fn get(self, _ key: K) -> V
        where V: Copy
    {
        self.get_unchecked(key)
    }

    #[inline(always)]
    pub(ingot) fn set_unchecked(mut self, key: K, value: own V) {
        self.mut_ptr(key).write(value)
    }

    /// Replaces the whole value using the same layout as `ptr` and `mut_ptr`.
    #[inline(always)]
    pub fn set(mut self, key: K, value: own V) {
        self.set_unchecked(key: key, value)
    }
}


impl<A, B> StorageKey for (A, B)
where A: StorageKey,
      B: StorageKey {
    #[inline(always)]
    fn encoded_len(self) -> u256 {
        A::encoded_len(self.0) + B::encoded_len(self.1)
    }

    #[inline(always)]
    fn write_key(ptr: *u8, self) {
        let a_len = A::encoded_len(self.0)
        A::write_key(ptr: ptr, self.0)
        B::write_key(ptr: ptr::offset_bytes(ptr, a_len), self.1)
    }
}


impl<A, B, C> StorageKey for (A, B, C)
where A: StorageKey,
      B: StorageKey,
      C: StorageKey {
    #[inline(always)]
    fn encoded_len(self) -> u256 {
        A::encoded_len(self.0) + B::encoded_len(self.1) + C::encoded_len(self.2)
    }

    #[inline(always)]
    fn write_key(ptr: *u8, self) {
        let a_len = A::encoded_len(self.0)
        let b_len = B::encoded_len(self.1)
        A::write_key(ptr: ptr, self.0)
        B::write_key(ptr: ptr::offset_bytes(ptr, a_len), self.1)
        C::write_key(ptr: ptr::offset_bytes(ptr, a_len + b_len), self.2)
    }
}


impl<A, B, C, D> StorageKey for (A, B, C, D)
where A: StorageKey,
      B: StorageKey,
      C: StorageKey,
      D: StorageKey {
    #[inline(always)]
    fn encoded_len(self) -> u256 {
        A::encoded_len(self.0) + B::encoded_len(self.1) + C::encoded_len(self.2) + D::encoded_len(self.3)
    }

    #[inline(always)]
    fn write_key(ptr: *u8, self) {
        let a_len = A::encoded_len(self.0)
        let b_len = B::encoded_len(self.1)
        let c_len = C::encoded_len(self.2)
        A::write_key(ptr: ptr, self.0)
        B::write_key(ptr: ptr::offset_bytes(ptr, a_len), self.1)
        C::write_key(ptr: ptr::offset_bytes(ptr, a_len + b_len), self.2)
        D::write_key(ptr: ptr::offset_bytes(ptr, a_len + b_len + c_len), self.3)
    }
}


impl<A, B, C, D, E> StorageKey for (A, B, C, D, E)
where A: StorageKey,
      B: StorageKey,
      C: StorageKey,
      D: StorageKey,
      E: StorageKey {
    #[inline(always)]
    fn encoded_len(self) -> u256 {
        A::encoded_len(self.0) + B::encoded_len(self.1) + C::encoded_len(self.2) + D::encoded_len(self.3) + E::encoded_len(self.4)
    }

    #[inline(always)]
    fn write_key(ptr: *u8, self) {
        let a_len = A::encoded_len(self.0)
        let b_len = B::encoded_len(self.1)
        let c_len = C::encoded_len(self.2)
        let d_len = D::encoded_len(self.3)
        A::write_key(ptr: ptr, self.0)
        B::write_key(ptr: ptr::offset_bytes(ptr, a_len), self.1)
        C::write_key(ptr: ptr::offset_bytes(ptr, a_len + b_len), self.2)
        D::write_key(ptr: ptr::offset_bytes(ptr, a_len + b_len + c_len), self.3)
        E::write_key(ptr: ptr::offset_bytes(ptr, a_len + b_len + c_len + d_len), self.4)
    }
}


impl<A, B, C, D, E, F> StorageKey for (A, B, C, D, E, F)
where A: StorageKey,
      B: StorageKey,
      C: StorageKey,
      D: StorageKey,
      E: StorageKey,
      F: StorageKey {
    #[inline(always)]
    fn encoded_len(self) -> u256 {
        A::encoded_len(self.0) + B::encoded_len(self.1) + C::encoded_len(self.2) + D::encoded_len(self.3) + E::encoded_len(self.4) + F::encoded_len(self.5)
    }

    #[inline(always)]
    fn write_key(ptr: *u8, self) {
        let a_len = A::encoded_len(self.0)
        let b_len = B::encoded_len(self.1)
        let c_len = C::encoded_len(self.2)
        let d_len = D::encoded_len(self.3)
        let e_len = E::encoded_len(self.4)
        A::write_key(ptr: ptr, self.0)
        B::write_key(ptr: ptr::offset_bytes(ptr, a_len), self.1)
        C::write_key(ptr: ptr::offset_bytes(ptr, a_len + b_len), self.2)
        D::write_key(ptr: ptr::offset_bytes(ptr, a_len + b_len + c_len), self.3)
        E::write_key(ptr: ptr::offset_bytes(ptr, a_len + b_len + c_len + d_len), self.4)
        F::write_key(ptr: ptr::offset_bytes(ptr, a_len + b_len + c_len + d_len + e_len), self.5)
    }
}
