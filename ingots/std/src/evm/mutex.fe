use super::effects::TSlot

/// A storage-backed value guarded by a transient reentrancy lock.
///
/// The lock bit lives in transient storage at the slot number its `lock`
/// field takes, which no other storage or transient state shares. [`Mutex::lock`] and [`Mutex::unlock`] bracket a window
/// across external calls; entry points that may be reentered take the lock
/// with [`Mutex::try_lock`] and back off when it is held. The value is
/// reached through short projections, which cannot be held across the
/// external call the lock guards.
pub struct Mutex<T> {
    value: T,
    lock: TSlot<bool>,
}

impl<T> Mutex<T> {
    /// Takes the lock, reverting if it is already held.
    pub fn lock(mut self) {
        if self.lock.read() {
            assert!(false)
        }
        self.lock.write(true)
    }

    /// Takes the lock if it is free, and returns whether it did.
    pub fn try_lock(mut self) -> bool {
        if self.lock.read() {
            return false
        }
        self.lock.write(true)
        true
    }

    pub fn unlock(mut self) {
        self.lock.write(false)
    }

    pub fn is_locked(self) -> bool {
        self.lock.read()
    }

    pub fn value(mut? self) -> mut? T {
        mut? self.value
    }

    /// Copies the protected value out without taking the lock, to keep
    /// across an external call: an access of it cannot be held there. This
    /// does not protect against observing intermediate state during
    /// reentrancy.
    pub fn peek(self) -> T
    where
        T: Copy,
    {
        self.value
    }
}
