#![cfg(target_os = "macos")]
/// AArch64 macOS's layouts and values, with 64-bit inodes.
use core::MemSpan

extern {
    fn __error() -> *i32
}

pub fn errno_location() -> *i32 {
    unsafe { __error() }
}

// `struct stat` and `struct dirent`.
pub fn stat_mode(_ stat: MemSpan) -> u32 {
    stat.read_le<u16>(4) as u32
}

pub fn stat_size(_ stat: MemSpan) -> u64 {
    stat.read_le<u64>(96)
}

pub const DIRENT_TYPE: usize = 20
pub const DIRENT_NAME: usize = 21

// `clock_gettime`'s clock that never goes back.
pub const CLOCK_MONOTONIC: i32 = 6
