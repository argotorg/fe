#![cfg(target_family = "unix")]
/// Files and directories of the native host.
///
/// `Fs` is a capability of the native root effect, `std::native::Host`: a
/// function that reads files declares `uses (fs: Fs)`, and one that changes
/// them `uses (fs: mut Fs)`. A path is the text of a `Display` value, such as
/// a string literal, an `Arg` or a `MemBuffer`. An operation that fails
/// returns the host's reason as a `std::io::Error`.
///
/// A `File` is an open file, which reads and writes as a `std::io::Read` and
/// `Write`. Owning it is the authority to use it: `Fs` opens it.
use core::{MemBuffer, MemSlice, MemSpan, MemVec, Option, Result, ptr}
use super::env::c_string_len
use super::io::{Display, Error, ErrorKind, Read, Write}
use super::native::{Host, HostCapabilitySeal}
use super::sys::{self, EINVAL, Fd, O_RDONLY, O_RDWR, O_WRONLY, c_string, last_error}

extern {
    // POSIX file system calls. `mode_t` is 16 bits on macOS, where the
    // caller extends it to 32 bits, so a 32-bit mode passes the same, and a
    // variadic argument is promoted to an `int` anyway.
    fn open(_ path: *u8, _ flags: i32, ...) -> i32
    fn mkdir(_ path: *u8, _ mode: u32) -> i32
    fn stat(_ path: *u8, _ buf: *u8) -> i32
    fn lstat(_ path: *u8, _ buf: *u8) -> i32
    fn opendir(_ path: *u8) -> *u8
    fn readdir(_ dir: *u8) -> *u8
    fn closedir(_ dir: *u8) -> i32
    fn realpath(_ path: *u8, _ resolved: *u8) -> *u8
}

// File types in a `stat` mode, and in a `dirent`.
const S_IFMT: u32 = 0o170000
const S_IFDIR: u32 = 0o040000
const S_IFREG: u32 = 0o100000
const S_IFLNK: u32 = 0o120000
const DT_UNKNOWN: u8 = 0
const DT_DIR: u8 = 4
const DT_REG: u8 = 8
const DT_LNK: u8 = 10

// The bytes of a `struct stat` on every supported host.
const STAT_SIZE: usize = 144

// `/` and `.`.
const SLASH: u8 = 47
const DOT: u8 = 46

/// The host's files and directories.
pub trait Fs: HostCapabilitySeal {
    /// The contents of the file at `path`.
    fn read<P: Display>(self, _ path: P) -> Result<Error, MemBuffer>
    /// Replaces the contents of the file at `path` with `bytes`, creating
    /// the file if it doesn't exist.
    fn write<P: Display>(mut self, _ path: P, _ bytes: MemSpan) -> Result<Error, ()>
    /// Appends `bytes` to the file at `path`, creating the file if it
    /// doesn't exist.
    fn append<P: Display>(mut self, _ path: P, _ bytes: MemSpan) -> Result<Error, ()>
    /// Opens the file at `path` for reading.
    fn open<P: Display>(self, _ path: P) -> Result<Error, File>
    /// Opens the file at `path` for writing, creating it if it doesn't exist
    /// and emptying it if it does.
    fn create<P: Display>(mut self, _ path: P) -> Result<Error, File>
    /// Opens the file at `path` as `options` say.
    fn open_with<P: Display>(mut self, _ path: P, _ options: OpenOptions) -> Result<Error, File>
    /// Creates the directory at `path` and any of its missing parents. An
    /// existing directory is no error.
    fn create_dir_all<P: Display>(mut self, _ path: P) -> Result<Error, ()>
    /// The type and size of the file at `path`, following symbolic links.
    fn metadata<P: Display>(self, _ path: P) -> Result<Error, Metadata>
    /// The entries of the directory at `path`, except `.` and `..`, in no
    /// particular order.
    fn read_dir<P: Display>(self, _ path: P) -> Result<Error, MemVec<DirEntry>>
    /// The absolute form of `path`, without symbolic links, `.` or `..`.
    fn canonicalize<P: Display>(self, _ path: P) -> Result<Error, MemBuffer>
}

/// An open file, which closes when destroyed. Each read or write starts
/// where the last one ended.
pub struct File { fd: Fd }

impl File {
    /// The file's descriptor, which the file still owns.
    pub fn as_raw_fd(self) -> i32 {
        self.fd.fd
    }

    /// The file of the open descriptor `fd`, which it takes over: nothing
    /// else may close `fd`.
    pub unsafe fn from_raw_fd(_ fd: i32) -> Self {
        File { fd: Fd { fd } }
    }
}

impl Read for File {
    fn read(mut self, _ buf: mut MemSpan) -> Result<Error, usize> {
        sys::read_fd(self.fd.fd, mut buf)
    }
}

impl Write for File {
    fn write(mut self, _ bytes: MemSpan) -> Result<Error, usize> {
        sys::write_fd(self.fd.fd, bytes)
    }
}

/// How `Fs::open_with` opens a file: what the file allows, and whether
/// opening creates or empties it. Each method returns the options with one
/// more setting: `OpenOptions::new().append(true).create(true)` appends to a
/// file, creating it if it doesn't exist.
pub struct OpenOptions {
    read: bool,
    write: bool,
    append: bool,
    truncate: bool,
    create: bool,
    create_new: bool,
}

impl Copy for OpenOptions {}

impl OpenOptions {
    /// Options that allow nothing, which `open_with` refuses until `read`,
    /// `write` or `append` is set.
    pub fn new() -> Self {
        OpenOptions { read: false, write: false, append: false, truncate: false, create: false, create_new: false }
    }

    /// Allows reads.
    pub fn read(var own self, _ read: bool) -> Self {
        self.read = read
        self
    }

    /// Allows writes, the first from the start of the file.
    pub fn write(var own self, _ write: bool) -> Self {
        self.write = write
        self
    }

    /// Allows writes, each to the end of the file.
    pub fn append(var own self, _ append: bool) -> Self {
        self.append = append
        self
    }

    /// Empties the file as it opens, which needs `write`.
    pub fn truncate(var own self, _ truncate: bool) -> Self {
        self.truncate = truncate
        self
    }

    /// Creates the file if it doesn't exist, which needs `write` or
    /// `append`.
    pub fn create(var own self, _ create: bool) -> Self {
        self.create = create
        self
    }

    /// Creates the file, with an `AlreadyExists` error if it exists. It
    /// needs `write` or `append`.
    pub fn create_new(var own self, _ create_new: bool) -> Self {
        self.create_new = create_new
        self
    }

    // The `open` flags, or an `InvalidInput` error for options that allow
    // nothing or conflict.
    fn flags(self) -> Result<Error, i32> {
        let writes = self.write || self.append
        let valid = (self.read || writes)
            && (writes || !(self.truncate || self.create || self.create_new))
            && !(self.append && self.truncate && !self.create_new)
        if !valid {
            return Result::Err(Error::from_code(EINVAL))
        }
        var flags = if !writes { O_RDONLY } else if self.read { O_RDWR } else { O_WRONLY }
        if self.append {
            flags = flags | sys::O_APPEND
        }
        if self.create_new {
            flags = flags | sys::O_CREAT | sys::O_EXCL
        } else {
            if self.create {
                flags = flags | sys::O_CREAT
            }
            if self.truncate {
                flags = flags | sys::O_TRUNC
            }
        }
        Result::Ok(flags)
    }
}

/// The type of a file.
pub enum FileType {
    File,
    Dir,
    Symlink,
    /// A device, pipe or socket.
    Other,
}

impl Copy for FileType {}

/// A file's type and size.
pub struct Metadata { file_type: FileType, len: u64 }

impl Copy for Metadata {}

impl Metadata {
    pub fn file_type(self) -> FileType {
        self.file_type
    }

    pub fn is_file(self) -> bool {
        match self.file_type {
            FileType::File => true,
            _ => false,
        }
    }

    pub fn is_dir(self) -> bool {
        match self.file_type {
            FileType::Dir => true,
            _ => false,
        }
    }

    /// The size of the file in bytes.
    pub fn len(self) -> u64 {
        self.len
    }
}

/// An entry of a directory: a file name, and the type of its file, which a
/// symbolic link doesn't lead to.
pub struct DirEntry { name: MemBuffer, file_type: FileType }

impl DirEntry {
    /// The file name, without the directory.
    pub fn name(self) -> ref MemSpan {
        self.name.span()
    }

    pub fn file_type(self) -> FileType {
        self.file_type
    }
}

impl Fs for Host {
    fn read<P: Display>(self, _ path: P) -> Result<Error, MemBuffer> {
        var file = self.open(path)?
        var contents = MemBuffer::empty()
        file.read_to_end(mut contents)?
        Result::Ok(contents)
    }

    fn write<P: Display>(mut self, _ path: P, _ bytes: MemSpan) -> Result<Error, ()> {
        var file = self.create(path)?
        file.write_all(bytes)
    }

    fn append<P: Display>(mut self, _ path: P, _ bytes: MemSpan) -> Result<Error, ()> {
        var file = self.open_with(path, OpenOptions::new().append(true).create(true))?
        file.write_all(bytes)
    }

    fn open<P: Display>(self, _ path: P) -> Result<Error, File> {
        open_file(c_string(path)?, flags: O_RDONLY)
    }

    fn create<P: Display>(mut self, _ path: P) -> Result<Error, File> {
        open_file(c_string(path)?, flags: O_WRONLY | sys::O_CREAT | sys::O_TRUNC)
    }

    fn open_with<P: Display>(mut self, _ path: P, _ options: OpenOptions) -> Result<Error, File> {
        open_file(c_string(path)?, flags: options.flags()?)
    }

    fn create_dir_all<P: Display>(mut self, _ path: P) -> Result<Error, ()> {
        var path = c_string(path)?
        let len = path.len() - 1
        make_dirs(mut path, len)
    }

    fn metadata<P: Display>(self, _ path: P) -> Result<Error, Metadata> {
        stat_path(c_string(path)?, follow: true)
    }

    fn read_dir<P: Display>(self, _ path: P) -> Result<Error, MemVec<DirEntry>> {
        let path = c_string(path)?
        let dir = unsafe { opendir(path.ptr()) }
        if ptr::is_null(dir) {
            return Result::Err(last_error())
        }
        var entries = MemVec::new()
        var failure: Option<Error> = Option::None
        while failure.is_none() {
            // `readdir` returns null at the end and on a failure, which
            // alone sets `errno`.
            unsafe { *sys::errno_location() = 0 }
            let entry = unsafe { readdir(dir) }
            if ptr::is_null(entry) {
                let code = sys::errno()
                if code != 0 {
                    failure = Option::Some(Error::from_code(code))
                }
                break
            }
            let name_ptr = ptr::offset_bytes(entry, sys::DIRENT_NAME)
            let name = unsafe { MemSlice::from_raw_parts(ptr: name_ptr, len: c_string_len(name_ptr)) }
            if is_dot_or_dot_dot(name) {
                continue
            }
            match dir_entry(path, name, unsafe { *ptr::offset_bytes(entry, sys::DIRENT_TYPE) }) {
                Result::Ok(entry) => entries.push(entry),
                Result::Err(error) => failure = Option::Some(error),
            }
        }
        unsafe { closedir(dir) }
        match failure {
            Option::Some(error) => Result::Err(error),
            Option::None => Result::Ok(entries),
        }
    }

    fn canonicalize<P: Display>(self, _ path: P) -> Result<Error, MemBuffer> {
        let path = c_string(path)?
        // At least `PATH_MAX`: 4096 on Linux, 1024 on macOS.
        var resolved = MemBuffer::new(4096)
        if ptr::is_null(unsafe { realpath(path.ptr(), resolved.ptr()) }) {
            return Result::Err(last_error())
        }
        resolved.truncate(c_string_len(resolved.ptr()))
        Result::Ok(resolved)
    }
}

// Opens the file at the C string `path` with the `open` flags `flags`,
// close-on-exec. A file it creates has mode `0o666`, less the umask.
fn open_file(_ path: MemBuffer, flags: i32) -> Result<Error, File> {
    let c_path = path.ptr()
    let fd = sys::retry(|| unsafe { open(c_path, flags | sys::O_CLOEXEC, 0o666 as u32) } as isize)?
    // `open` returned a new descriptor, which nothing else has.
    Result::Ok(unsafe { File::from_raw_fd(fd.downcast_unchecked()) })
}

// Creates the directory named by the first `len` bytes of `path`, which a
// NUL ends, and its missing parents.
fn make_dirs(_ path: mut MemBuffer, _ len: usize) -> Result<Error, ()> {
    let made = make_dir(path)
    let missing_parent = match made {
        Result::Err(error) => match error.kind() {
            ErrorKind::NotFound => true,
            _ => false,
        },
        Result::Ok(_) => false,
    }
    // The parent ends before the last name's `/`, past trailing slashes.
    var end = len
    while end > 0 && path[end - 1] == SLASH {
        end -= 1
    }
    while end > 0 && path[end - 1] != SLASH {
        end -= 1
    }
    if !missing_parent || end <= 1 {
        return made
    }
    path.span().set(end - 1, 0)
    let parent = make_dirs(mut path, end - 1)
    path.span().set(end - 1, SLASH)
    parent?
    make_dir(path)
}

// Creates the directory at the C string `path`, unless it is one already.
fn make_dir(_ path: MemBuffer) -> Result<Error, ()> {
    if unsafe { mkdir(path.ptr(), 0o777) } == 0 {
        return Result::Ok(())
    }
    let error = last_error()
    let exists = match error.kind() {
        ErrorKind::AlreadyExists => true,
        _ => false,
    }
    let is_dir = exists
        && match stat_path(path, follow: true) {
            Result::Ok(metadata) => metadata.is_dir(),
            Result::Err(_) => false,
        }
    if is_dir { Result::Ok(()) } else { Result::Err(error) }
}

// The entry `name` of the directory at the C string `dir`, whose `dirent`
// gives the type `d_type`.
fn dir_entry(_ dir: MemBuffer, _ name: MemSpan, _ d_type: u8) -> Result<Error, DirEntry> {
    let file_type = if d_type == DT_DIR {
        FileType::Dir
    } else if d_type == DT_REG {
        FileType::File
    } else if d_type == DT_LNK {
        FileType::Symlink
    } else if d_type != DT_UNKNOWN {
        FileType::Other
    } else {
        // Some file systems don't record types in directories.
        var path = MemBuffer::from_span(dir.span().head(dir.len() - 1))
        path.push(SLASH)
        path.extend_from(name)
        path.push(0)
        stat_path(path, follow: false)?.file_type
    }
    Result::Ok(DirEntry { name: MemBuffer::from_span(name), file_type })
}

// The metadata of the file at the C string `path`, or of the symbolic link
// itself unless `follow`.
fn stat_path(_ path: MemBuffer, follow: bool) -> Result<Error, Metadata> {
    let buf = MemBuffer::new(STAT_SIZE)
    let status = if follow {
        unsafe { stat(path.ptr(), buf.ptr()) }
    } else {
        unsafe { lstat(path.ptr(), buf.ptr()) }
    }
    if status != 0 {
        return Result::Err(last_error())
    }
    Result::Ok(Metadata { file_type: mode_type(sys::stat_mode(buf.span())), len: sys::stat_size(buf.span()) })
}

fn mode_type(_ mode: u32) -> FileType {
    let format = mode & S_IFMT
    if format == S_IFDIR {
        FileType::Dir
    } else if format == S_IFREG {
        FileType::File
    } else if format == S_IFLNK {
        FileType::Symlink
    } else {
        FileType::Other
    }
}

fn is_dot_or_dot_dot(_ name: MemSpan) -> bool {
    name.len() <= 2 && name[0] == DOT && (name.len() == 1 || name[1] == DOT)
}
