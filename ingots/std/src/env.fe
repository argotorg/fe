/// The process's command-line arguments and environment variables, which are
/// capabilities of the native root effect, `std::native::Host`:
/// `pub fn main() -> i32 uses (args: Args, env: Env)`.
use core::{MemBuffer, MemSlice, MemSpan, Option, ptr}
use super::io::Display
use super::native::{Host, HostCapabilitySeal}

extern {
    // The native entry's `argc` and `argv`, which the compiler keeps: zero
    // and null outside an executable.
    fn __fe_native_argc() -> i32
    fn __fe_native_argv() -> **u8
    // POSIX environment lookup.
    fn getenv(_ name: *u8) -> *u8
}

/// The process's command-line arguments. The first names the program.
pub trait Args: HostCapabilitySeal {
    /// The number of arguments.
    fn count(self) -> usize
    /// The argument at `index`, which must be less than `count()`.
    fn get(self, _ index: usize) -> Arg
}

/// The process's environment variables.
pub trait Env: HostCapabilitySeal {
    /// The value of the variable named by `name`'s text, such as a string
    /// literal's, or `None` if it is unset.
    fn lookup<T: Display>(self, _ name: T) -> Option<MemBuffer>
}

/// A process argument: bytes that may be empty and need not be UTF-8.
pub struct Arg { unsafe ptr: *u8, unsafe len: usize }

impl Arg {
    pub fn len(self) -> usize {
        self.len
    }

    pub fn is_empty(self) -> bool {
        self.len == 0
    }

    /// The argument's bytes.
    pub fn span(self) -> ref MemSpan {
        // An argument lives as long as the process.
        unsafe { MemSlice::from_raw_parts(ptr: self.ptr, len: self.len) }
    }
}

/// The argument's bytes.
impl Display for Arg {
    fn fmt(self, _ out: mut MemBuffer) {
        out.extend_from(self.span())
    }
}

impl Args for Host {
    fn count(self) -> usize {
        unsafe { __fe_native_argc() }.downcast_unchecked()
    }

    fn get(self, _ index: usize) -> Arg {
        assert!(index < self.count(), "argument index out of bounds")
        let bytes = unsafe { *ptr::offset(__fe_native_argv(), index) }
        // Each argument is a live, NUL-terminated string.
        unsafe { Arg { ptr: bytes, len: c_string_len(bytes) } }
    }
}

impl Env for Host {
    fn lookup<T: Display>(self, _ name: T) -> Option<MemBuffer> {
        var key = MemBuffer::empty()
        name.fmt(mut key)
        key.push(0)
        let value = unsafe { getenv(key.ptr()) }
        if value as usize == 0 {
            return Option::None
        }
        // `value` is a live, NUL-terminated string until the environment
        // changes; the copy keeps it.
        Option::Some(
            MemBuffer::from_span(unsafe { MemSlice::from_raw_parts(ptr: value, len: c_string_len(value)) }),
        )
    }
}

// The number of bytes before the NUL that ends the string at `bytes`.
pub(ingot) fn c_string_len(_ bytes: *u8) -> usize {
    var len: usize = 0
    while unsafe { *ptr::offset(bytes, len) } != 0 {
        len += 1
    }
    len
}
