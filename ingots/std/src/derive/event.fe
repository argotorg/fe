use core::abi::{AbiFrame, AbiSize, abi_field_head_size, dynamic_payload_size}
use core::derive::Derive
use core::meta::{Code, Expr, Field, FieldInit, Item, Record, field, field_count, field_is_indexed, for_each_field}
use core::ptr::{MemBuffer, allocation_len}
use ingot::abi::Sol
use ingot::evm::{Event, Log, TopicValue}
use super::abi::{RecordWriter, WriteField}

/// The head size and the payload size of the data fields of an event: what
/// `emit` allocates before it writes them.
struct DataSize {
    head: u256,
    payload: u256,
}

impl DataSize {
    #[inline(always)]
    fn add<F: AbiSize>(mut self, _ field: F) {
        self.head = self.head + abi_field_head_size<F>()
        self.payload = self.payload + dynamic_payload_size(field)
    }
}

/// Adds each data field of an event to the `size` of the splice site. An
/// indexed field is a topic, not data.
struct AddDataSize {}
impl FieldInit for AddDataSize {
    const fn init(_ field: Field, _ index: usize) -> Code<Expr> {
        if field_is_indexed(field) {
            quote { () }
        } else {
            quote(size) { size.add(self.${field}) }
        }
    }
}

/// Provides the log encoding of an authored event.
pub struct StructEvent {}
impl Derive<trait Event> for StructEvent {
    const fn derive(_ record: Record) -> Code<Item> {
        let n = field_count(record)
        var data_fields: usize = 0
        var topic_a: Code<Expr> = quote { 0 as u256 }
        var topic_b: Code<Expr> = quote { 0 as u256 }
        var topic_c: Code<Expr> = quote { 0 as u256 }
        var topics: usize = 0
        var i: usize = 0
        while i < n {
            let f = field(record, i)
            if field_is_indexed(f) {
                let topic = quote { self.${f}.as_topic() }
                if topics == 0 {
                    topic_a = topic
                } else if topics == 1 {
                    topic_b = topic
                } else {
                    topic_c = topic
                }
                topics += 1
            } else {
                data_fields += 1
            }
            i += 1
        }

        // `emit` has room for three topics after the event signature.
        assert!(topics <= 3)

        let emit = if topics == 0 {
            quote(log, data) { log.log1(data: data, topic0: Self::TOPIC0) }
        } else if topics == 1 {
            quote(log, data) { log.log2(data: data, topic0: Self::TOPIC0, topic1: ${topic_a}) }
        } else if topics == 2 {
            quote(log, data) {
                log.log3(data: data, topic0: Self::TOPIC0, topic1: ${topic_a}, topic2: ${topic_b})
            }
        } else {
            quote(log, data) {
                log.log4(data: data, topic0: Self::TOPIC0, topic1: ${topic_a}, topic2: ${topic_b}, topic3: ${topic_c})
            }
        }
        if data_fields == 0 {
            return quote(log, data) {
                #[inline(always)]
                fn emit<L: Log>(own self, _ log: mut L) {
                    let buffer = MemBuffer::empty()
                    let data = buffer.span()
                    ${emit}
                }
            }
        }
        let sizes = for_each_field<AddDataSize>(record)
        let steps = for_each_field<WriteField>(record)
        quote(log, data, writer, size) {
            #[inline(always)]
            fn emit<L: Log>(own self, _ log: mut L) {
                var size = DataSize { head: 0, payload: 0 }
                ${sizes}
                let head = size.head
                let total = head + size.payload
                let buffer = MemBuffer::new(allocation_len(total))
                let out = unsafe { AbiFrame::from_raw_parts(ptr: buffer.ptr(), len: total) }
                var writer = RecordWriter<Sol>::new(out, head_size: head, fields: ${data_fields})
                ${steps}
                let data = buffer.span()
                ${emit}
            }
        }
    }
}
