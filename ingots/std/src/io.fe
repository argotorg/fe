/// Standard input, output and error of a native program or a WebAssembly
/// module.
///
/// Each stream is a capability of the target's root effect: `std::native::Host`,
/// which reads and writes the process's descriptors, and `std::wasm::Host`,
/// which calls imports of the host (`std::wasm::streams`). `main`, tests and
/// WebAssembly exports receive the streams they declare, as in
/// `pub fn main() -> i32 uses (out: mut Stdout)`, and a function that prints
/// declares the stream it writes. `Stdio` provides all three:
/// `uses (io: mut Stdio)`.
///
/// `print!(a, b, ..)`, `println!`, `eprint!` and `eprintln!` write the text
/// of each `Display` argument in order, the `ln` forms then a newline.
/// Output is unbuffered: each print is one write to the stream, so a later
/// panic loses nothing. `format!(a, b, ..)` returns the text in a new
/// `MemBuffer`, and `write!(mut buf, a, b, ..)` and `writeln!` append it to
/// `buf`, a `MemBuffer` held by a local, a field or an effect
/// (`uses (text: mut MemBuffer)`). They work on any target.
///
/// `Read` and `Write` are sources and sinks of bytes, on any target: a
/// `MemReader` reads the bytes of a `MemBuffer`, and writing to a
/// `MemBuffer` appends. A `BufReader` reads a `Read` a byte or a line at a
/// time, as a `StdinReader` reads standard input.
///
/// A native host operation that fails, such as one of `std::fs` or
/// `std::process`, returns the host's reason as an `Error`.
use core::{MemBuffer, MemSlice, MemSpan, Option, PackedBytes, Result}
use core::abi::DynString
use core::fixed::{Fixed, UFixed}
use core::num::{IntWord, UnsignedAbs}
use super::env::c_string_len
use super::native::{Host, HostCapabilitySeal}
use super::sys

extern {
    // POSIX descriptor I/O.
    pub(ingot) fn read(_ fd: i32, _ buf: *u8, _ count: usize) -> isize
    pub(ingot) fn write(_ fd: i32, _ buf: *u8, _ count: usize) -> isize
    fn strerror(_ code: i32) -> *u8
    fn gai_strerror(_ code: i32) -> *u8
}

/// Why an operation failed: its kind, and the host's error number if the
/// host reported it, or the code `getaddrinfo` gave a failed lookup.
pub struct Error { kind: ErrorKind, code: Option<i32>, lookup: bool }

impl Copy for Error {}

impl Error {
    /// An error of `kind` that no host error number gives, such as one a
    /// `Read` implementation returns.
    pub fn new(_ kind: ErrorKind) -> Self {
        Error { kind, code: Option::None, lookup: false }
    }

    /// The host's error number, if the host reported the error. A failed
    /// lookup has none, but its text is the host's.
    pub fn code(self) -> Option<i32> {
        if self.lookup { Option::None } else { self.code }
    }

    /// What went wrong, in terms every host shares.
    pub fn kind(self) -> ErrorKind {
        self.kind
    }
}

// The error numbers differ between hosts, which `sys` knows.
#[cfg(target_family = "unix")]
impl Error {
    /// The error with the host's error number `code`.
    pub fn from_code(_ code: i32) -> Self {
        Error { kind: sys::errno_kind(code), code: Option::Some(code), lookup: false }
    }

    /// The error of a `getaddrinfo` that returned `code`: `errno`'s for
    /// `EAI_SYSTEM`.
    pub(ingot) fn from_lookup_code(_ code: i32) -> Self {
        if code == sys::EAI_SYSTEM {
            return sys::last_error()
        }
        let not_found = code == sys::EAI_NONAME || code == sys::EAI_NODATA
        let kind = if not_found { ErrorKind::HostNotFound } else { ErrorKind::Other }
        Error { kind, code: Option::Some(code), lookup: true }
    }
}

/// The host's description of an error it reported, such as `No such file or
/// directory`, or `gai_strerror`'s of a failed lookup, and otherwise the
/// kind's.
#[cfg(target = "native")]
impl Display for Error {
    fn fmt(self, _ out: mut MemBuffer) {
        match self.code {
            Option::Some(code) => {
                let text = if self.lookup { unsafe { gai_strerror(code) } } else { unsafe { strerror(code) } }
                out.extend_from(unsafe { MemSlice::from_raw_parts(ptr: text, len: c_string_len(text)) })
            }
            Option::None => self.kind.fmt(mut out),
        }
    }
}

/// The kind's description: no host reports errors on the EVM.
#[cfg(target = "evm")]
impl Display for Error {
    fn fmt(self, _ out: mut MemBuffer) {
        self.kind.fmt(mut out)
    }
}

/// The kind's description: a WebAssembly host reports no error numbers.
#[cfg(target = "wasm")]
impl Display for Error {
    fn fmt(self, _ out: mut MemBuffer) {
        self.kind.fmt(mut out)
    }
}

/// The kinds of `Error`. A signal that interrupts a host call is none:
/// `std` makes the call again.
pub enum ErrorKind {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    NotADirectory,
    IsADirectory,
    /// A path or other text holds a NUL byte, or an argument is invalid.
    InvalidInput,
    /// A non-blocking operation would have to wait.
    WouldBlock,
    TimedOut,
    ConnectionRefused,
    ConnectionReset,
    ConnectionAborted,
    NotConnected,
    AddrInUse,
    AddrNotAvailable,
    NetworkUnreachable,
    HostUnreachable,
    /// A write to a pipe or socket whose reading end is closed.
    BrokenPipe,
    /// The input ended before a read that needs more of it.
    UnexpectedEof,
    /// The input isn't what the reader takes, such as a line longer than
    /// its limit.
    InvalidData,
    /// A lookup found no address for the host name.
    HostNotFound,
    Other,
}

impl Copy for ErrorKind {}

/// A short description, such as `connection refused`.
impl Display for ErrorKind {
    fn fmt(self, _ out: mut MemBuffer) {
        let text: String<24> = match self {
            ErrorKind::NotFound => "not found",
            ErrorKind::PermissionDenied => "permission denied",
            ErrorKind::AlreadyExists => "already exists",
            ErrorKind::NotADirectory => "not a directory",
            ErrorKind::IsADirectory => "is a directory",
            ErrorKind::InvalidInput => "invalid input",
            ErrorKind::WouldBlock => "operation would block",
            ErrorKind::TimedOut => "timed out",
            ErrorKind::ConnectionRefused => "connection refused",
            ErrorKind::ConnectionReset => "connection reset",
            ErrorKind::ConnectionAborted => "connection aborted",
            ErrorKind::NotConnected => "not connected",
            ErrorKind::AddrInUse => "address in use",
            ErrorKind::AddrNotAvailable => "address not available",
            ErrorKind::NetworkUnreachable => "network unreachable",
            ErrorKind::HostUnreachable => "host unreachable",
            ErrorKind::BrokenPipe => "broken pipe",
            ErrorKind::UnexpectedEof => "unexpected end of input",
            ErrorKind::InvalidData => "invalid data",
            ErrorKind::HostNotFound => "host not found",
            ErrorKind::Other => "other error",
        }
        text.fmt(mut out)
    }
}

/// The standard output of the process, or of a WebAssembly module's host.
pub trait Stdout: HostCapabilitySeal {
    /// Writes all of `bytes`; false if the stream fails first.
    fn write_stdout(mut self, _ bytes: MemSpan) -> bool
}

/// The standard error of the process, or of a WebAssembly module's host.
pub trait Stderr: HostCapabilitySeal {
    /// Writes all of `bytes`; false if the stream fails first.
    fn write_stderr(mut self, _ bytes: MemSpan) -> bool
}

/// The standard input of the process, or of a WebAssembly module's host.
pub trait Stdin: HostCapabilitySeal {
    /// Reads at most `buf.len()` bytes into the start of `buf`: the number
    /// read, zero at the end of input, or `None` if the stream fails.
    fn read_stdin(mut self, _ buf: mut MemSpan) -> Option<usize>
}

/// Standard input, output and error together: an effect keyed by `Stdio`
/// provides `Stdout`, `Stderr` and `Stdin`.
pub trait Stdio: Stdout + Stderr + Stdin {}

impl Stdio for Host {}

impl Stdout for Host {
    fn write_stdout(mut self, _ bytes: MemSpan) -> bool {
        write_all(fd: 1, bytes)
    }
}

impl Stderr for Host {
    fn write_stderr(mut self, _ bytes: MemSpan) -> bool {
        write_all(fd: 2, bytes)
    }
}

impl Stdin for Host {
    fn read_stdin(mut self, _ buf: mut MemSpan) -> Option<usize> {
        let count = unsafe { read(0, buf.ptr(), buf.len()) }
        if count < 0 { Option::None } else { Option::Some(count.downcast_unchecked()) }
    }
}

fn write_all(fd: i32, _ bytes: MemSpan) -> bool {
    var written: usize = 0
    while written < bytes.len() {
        let count = unsafe { write(fd, core::ptr::offset_bytes(bytes.ptr(), written), bytes.len() - written) }
        if count <= 0 {
            return false
        }
        written += count.downcast_unchecked()
    }
    true
}

/// A value with a text form, which `format!`, `write!`, `print!` and their
/// relatives write.
pub trait Display {
    /// Appends the value's text to `out`.
    fn fmt(self, _ out: mut MemBuffer)
}

/// Writes `text` to standard output, as `print!` and `println!` do. Panics
/// if the stream fails.
pub fn print_buffer(_ text: MemBuffer) uses (out: mut Stdout) {
    assert!(out.write_stdout(text.span()), "failed writing to stdout")
}

/// Writes `text` to standard error, as `eprint!` and `eprintln!` do. Panics
/// if the stream fails.
pub fn eprint_buffer(_ text: MemBuffer) uses (err: mut Stderr) {
    assert!(err.write_stderr(text.span()), "failed writing to stderr")
}

/// A source of bytes, such as a `MemReader`.
pub trait Read {
    /// Reads at most `buf.len()` bytes into the start of `buf`: the number
    /// read, which is zero only at the end of the input or for an empty
    /// `buf`. What `buf` holds before the read is unspecified, so a read
    /// only writes it.
    fn read(mut self, _ buf: mut MemSpan) -> Result<Error, usize>

    /// Fills `buf`: an `UnexpectedEof` error if the input ends first.
    fn read_exact(mut self, _ buf: mut MemSpan) -> Result<Error, ()> {
        var filled: usize = 0
        while filled < buf.len() {
            let count = self.read(buf.tail(filled))?
            if count == 0 {
                return Result::Err(Error::new(ErrorKind::UnexpectedEof))
            }
            filled += count
        }
        Result::Ok(())
    }

    /// Appends the rest of the input to `buf`: the number of bytes appended.
    fn read_to_end(mut self, _ buf: mut MemBuffer) -> Result<Error, usize> {
        read_all(mut self, mut buf)
    }
}

/// A sink of bytes, such as a `MemBuffer`.
pub trait Write {
    /// Writes bytes from the start of `bytes`: the number written, which is
    /// zero only for empty `bytes`.
    fn write(mut self, _ bytes: MemSpan) -> Result<Error, usize>

    /// Writes all of `bytes`. A `write` of none of them is an `Other` error.
    fn write_all(mut self, _ bytes: MemSpan) -> Result<Error, ()> {
        var written: usize = 0
        while written < bytes.len() {
            let count = self.write(bytes.tail(written))?
            if count == 0 {
                return Result::Err(Error::new(ErrorKind::Other))
            }
            written += count
        }
        Result::Ok(())
    }
}

/// Appends the bytes.
impl Write for MemBuffer {
    fn write(mut self, _ bytes: MemSpan) -> Result<Error, usize> {
        self.extend_from(bytes)
        Result::Ok(bytes.len())
    }
}

/// Reads the bytes of a `MemBuffer` it owns, from the first.
pub struct MemReader { bytes: MemBuffer, position: usize }

impl MemReader {
    pub fn new(_ bytes: own MemBuffer) -> Self {
        MemReader { bytes, position: 0 }
    }
}

impl Read for MemReader {
    fn read(mut self, _ buf: mut MemSpan) -> Result<Error, usize> {
        let rest = self.bytes.len() - self.position
        let count = if buf.len() < rest { buf.len() } else { rest }
        buf.head(count).copy_from(self.bytes.slice(offset: self.position, len: count))
        self.position += count
        Result::Ok(count)
    }
}

// What the readers of this module read: a `Read`, or standard input, which
// the caller's `Stdin` effect provides.
trait Source {
    uses E

    fn fill(mut self, _ buf: mut MemSpan) -> Result<Error, usize> uses E
}

impl<R: Read> Source for R {
    uses E = ()

    fn fill(mut self, _ buf: mut MemSpan) -> Result<Error, usize> {
        self.read(mut buf)
    }
}

// Standard input. Its failures have no error number.
struct StdinSource {}

impl Source for StdinSource {
    uses E = (input: mut Stdin)

    fn fill(mut self, _ buf: mut MemSpan) -> Result<Error, usize> uses E {
        match input.read_stdin(mut buf) {
            Option::Some(count) => Result::Ok(count),
            Option::None => Result::Err(Error::new(ErrorKind::Other)),
        }
    }
}

// Appends what `source` reads to `buf`, up to its end: the number of bytes
// appended.
fn read_all<S: Source>(_ source: mut S, _ buf: mut MemBuffer) -> Result<Error, usize> uses S::E {
    let start = buf.len()
    while read_more(mut source, mut buf)? {}
    Result::Ok(buf.len() - start)
}

// Reads once from `source` into `buf`'s spare capacity, growing it first:
// false at the end of the input.
fn read_more<S: Source>(_ source: mut S, _ buf: mut MemBuffer) -> Result<Error, bool> uses S::E {
    buf.reserve(4096)
    let len = buf.len()
    // The bytes past the length are allocated; the read initializes the
    // ones it counts.
    let spare = core::ptr::offset_bytes(buf.ptr(), len)
    let count = source.fill(unsafe { MemSlice::from_raw_parts(ptr: spare, len: buf.capacity() - len) })?
    unsafe { buf.set_len(len + count) }
    Result::Ok(count > 0)
}

/// Appends the rest of standard input to `buf`. Panics if the stream fails.
pub fn read_to_end(_ buf: mut MemBuffer) uses (input: mut Stdin) {
    var source = StdinSource {}
    let _ = stdin_value(read_all(mut source, mut buf))
}

// What a read of standard input gave. Panics if the stream failed.
fn stdin_value<T>(_ result: own Result<Error, T>) -> T {
    assert!(result.is_ok(), "failed reading stdin")
    result.ok().unwrap()
}

/// Reads standard input through a buffer, a byte or a line at a time, as a
/// `BufReader` reads its reader.
pub struct StdinReader { buffer: ReadBuffer }

impl StdinReader {
    pub fn new() -> Self {
        StdinReader { buffer: ReadBuffer::new() }
    }

    /// The next byte of standard input, or `None` at its end. Panics if the
    /// stream fails.
    pub fn read_byte(mut self) -> Option<u8> uses (input: mut Stdin) {
        var source = StdinSource {}
        stdin_value(self.buffer.read_byte(mut source))
    }

    /// Appends the next line of standard input to `line`, without its
    /// newline: false at the end of input. The last line need not end in a
    /// newline. Panics if the stream fails.
    pub fn read_line(mut self, _ line: mut MemBuffer) -> bool uses (input: mut Stdin) {
        var source = StdinSource {}
        stdin_value(self.buffer.read_line(mut source, mut line, max: usize::max()))
    }
}

/// Reads a `Read` through a buffer, a byte or a line at a time. It owns the
/// reader, which `inner()` reaches, as to write to a socket it reads, and
/// `into_inner()` gives back.
pub struct BufReader<R> { inner: R, buffer: ReadBuffer }

impl<R: Read> BufReader<R> {
    pub fn new(_ inner: own R) -> Self {
        BufReader { inner, buffer: ReadBuffer::new() }
    }

    /// The next byte, or `None` at the end of the input.
    pub fn read_byte(mut self) -> Result<Error, Option<u8>> {
        self.buffer.read_byte(mut self.inner)
    }

    /// Appends the next line to `line`, without its newline: false at the
    /// end of the input. The last line need not end in a newline. An error,
    /// such as `WouldBlock`, leaves `line` as it was, and the next call
    /// reads the line from its start.
    pub fn read_line(mut self, _ line: mut MemBuffer) -> Result<Error, bool> {
        self.buffer.read_line(mut self.inner, mut line, max: usize::max())
    }

    /// Appends the next line to `line` as `read_line` does if it has at most
    /// `max` bytes, without its newline. A longer line is an `InvalidData`
    /// error, which the reader gives as soon as it has `max` bytes of the
    /// line and no newline, so it holds no more of the line than that and
    /// one read. The error leaves `line` as it was and the line's bytes
    /// unread, so each later call fails the same way: a server drops the
    /// peer's connection.
    pub fn read_line_max(mut self, _ line: mut MemBuffer, max: usize) -> Result<Error, bool> {
        self.buffer.read_line(mut self.inner, mut line, max)
    }

    /// The reader. A read of it skips the bytes in the buffer.
    pub fn inner(mut? self) -> mut? R {
        mut? self.inner
    }

    /// The reader, without the bytes in the buffer.
    pub fn into_inner(own self) -> R {
        self.inner
    }
}

/// Reads the bytes in the buffer, or reads the reader once into the buffer
/// if it holds none.
impl<R: Read> Read for BufReader<R> {
    fn read(mut self, _ buf: mut MemSpan) -> Result<Error, usize> {
        self.buffer.read(mut self.inner, mut buf)
    }
}

// The bytes a buffered reader has read from its source and not yet
// returned. Once the source has ended, the buffer reads it no more.
struct ReadBuffer {
    bytes: MemBuffer,
    // The first byte of `bytes` not yet returned.
    start: usize,
    done: bool,
}

impl ReadBuffer {
    fn new() -> Self {
        ReadBuffer { bytes: MemBuffer::empty(), start: 0, done: false }
    }

    // The next byte, or `None` at the end of `source`.
    fn read_byte<S: Source>(mut self, _ source: mut S) -> Result<Error, Option<u8>> uses S::E {
        if self.start == self.bytes.len() && !self.refill(mut source)? {
            return Result::Ok(Option::None)
        }
        let byte = self.bytes[self.start]
        self.start += 1
        Result::Ok(Option::Some(byte))
    }

    // Appends the next line to `line`, without its newline: false at the end
    // of `source`. A line of more than `max` bytes is an `InvalidData` error
    // as soon as the buffer holds more than `max` bytes of it.
    fn read_line<S: Source>(mut self, _ source: mut S, _ line: mut MemBuffer, max: usize) -> Result<Error, bool> uses S::E {
        var scanned = self.start
        while true {
            while scanned < self.bytes.len() {
                if self.bytes[scanned] == b'\n' {
                    return self.take_line(mut line, end: scanned, after: scanned + 1, max)
                }
                scanned += 1
            }
            if scanned - self.start > max {
                return Result::Err(Error::new(ErrorKind::InvalidData))
            }
            let returned = self.start
            if !self.refill(mut source)? {
                if self.start == self.bytes.len() {
                    return Result::Ok(false)
                }
                let end = self.bytes.len()
                return self.take_line(mut line, end, after: end, max)
            }
            scanned -= returned
        }
        Result::Ok(false)
    }

    // Appends the line from the first byte not yet returned to `end` to
    // `line`, and returns the bytes up to `after`: an `InvalidData` error,
    // which returns nothing, if the line has more than `max` bytes.
    fn take_line(mut self, _ line: mut MemBuffer, end: usize, after: usize, max: usize) -> Result<Error, bool> {
        if end - self.start > max {
            return Result::Err(Error::new(ErrorKind::InvalidData))
        }
        line.extend_from(self.bytes.slice(offset: self.start, len: end - self.start))
        self.start = after
        Result::Ok(true)
    }

    // Reads into `buf` the bytes in the buffer, refilling it first if it
    // holds none.
    fn read<S: Source>(mut self, _ source: mut S, _ buf: mut MemSpan) -> Result<Error, usize> uses S::E {
        if self.start == self.bytes.len() && !self.refill(mut source)? {
            return Result::Ok(0)
        }
        let rest = self.bytes.len() - self.start
        let count = if buf.len() < rest { buf.len() } else { rest }
        buf.head(count).copy_from(self.bytes.slice(offset: self.start, len: count))
        self.start += count
        Result::Ok(count)
    }

    // Moves the bytes not yet returned to the front and reads more after
    // them: false at the end of `source`.
    fn refill<S: Source>(mut self, _ source: mut S) -> Result<Error, bool> uses S::E {
        if self.done {
            return Result::Ok(false)
        }
        let rest = self.bytes.len() - self.start
        self.bytes.span().copy_within(source: self.start, dest: 0, len: rest)
        self.bytes.truncate(rest)
        self.start = 0
        self.done = !read_more(mut source, mut self.bytes)?
        Result::Ok(!self.done)
    }
}

// Appends the decimal digits of `value`.
fn push_decimal(_ out: mut MemBuffer, _ value: u256) {
    // Wide division is slow on native targets; most values fit in 64 bits.
    if value <= 0xffffffffffffffff {
        push_decimal_u64(mut out, value.downcast_unchecked())
        return
    }
    var digits: [u8; 78] = [0; 78]
    var count: usize = 0
    var rest = value
    while rest != 0 {
        digits[count] = ((rest % 10) + 48).downcast_unchecked()
        rest /= 10
        count += 1
    }
    while count > 0 {
        count -= 1
        out.push(digits[count])
    }
}

fn push_decimal_u64(_ out: mut MemBuffer, _ value: u64) {
    var digits: [u8; 20] = [0; 20]
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = ((rest % 10) + 48).downcast_unchecked()
        rest /= 10
        count += 1
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        out.push(digits[count])
    }
}

fn push_signed<T: IntWord>(_ out: mut MemBuffer, negative: bool, magnitude: T) {
    if negative {
        out.push(b'-')
    }
    push_decimal(mut out, IntWord::to_word(magnitude))
}

impl Display for u8 {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal(mut out, IntWord::to_word(self)) }
}
impl Display for u16 {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal(mut out, IntWord::to_word(self)) }
}
impl Display for u32 {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal(mut out, IntWord::to_word(self)) }
}
impl Display for u64 {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal_u64(mut out, self) }
}
impl Display for u128 {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal(mut out, IntWord::to_word(self)) }
}
impl Display for u256 {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal(mut out, self) }
}
impl Display for usize {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal(mut out, IntWord::to_word(self)) }
}
impl Display for i8 {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}
impl Display for i16 {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}
impl Display for i32 {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}
impl Display for i64 {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}
impl Display for i128 {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}
impl Display for i256 {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}
impl Display for isize {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}

/// The integer part, then any fraction after a `.` without trailing zeros:
/// `Wad::from_ratio(5, 2)` is `2.5` and `Wad::from_int(3)` is `3`.
impl<const D: u256> Display for UFixed<D> {
    fn fmt(self, _ out: mut MemBuffer) {
        let scale = UFixed<D>::SCALE
        push_decimal(mut out, self.raw() / scale)
        var fraction = self.raw() % scale
        if fraction == 0 {
            return
        }
        out.push(b'.')
        var place = scale / 10
        while fraction < place {
            out.push(b'0')
            place /= 10
        }
        while fraction % 10 == 0 {
            fraction /= 10
        }
        push_decimal(mut out, fraction)
    }
}

/// Like `UFixed`, after a `-` if negative.
impl<const D: u256> Display for Fixed<D> {
    fn fmt(self, _ out: mut MemBuffer) {
        if self.is_negative() {
            out.push(b'-')
        }
        self.abs().fmt(mut out)
    }
}

impl Display for bool {
    fn fmt(self, _ out: mut MemBuffer) {
        write!(mut out, if self { "true" } else { "false" })
    }
}

impl<const N: usize> Display for String<N> {
    fn fmt(self, _ out: mut MemBuffer) {
        // The text is the low `len` bytes of the string's word, big endian.
        out.extend_from_word(self as u256, len: self.len())
    }
}

impl Display for DynString {
    fn fmt(self, _ out: mut MemBuffer) { out.extend_from(self.span()) }
}

/// The bytes themselves.
impl Display for MemSlice<u8> {
    fn fmt(self, _ out: mut MemBuffer) { out.extend_from(self) }
}

/// All `N` bytes, padding included.
impl<const N: usize> Display for PackedBytes<N> {
    fn fmt(self, _ out: mut MemBuffer) {
        var i: usize = 0
        while i < N {
            out.push(self[i])
            i += 1
        }
    }
}

/// The bytes themselves.
impl Display for MemBuffer {
    fn fmt(self, _ out: mut MemBuffer) { out.extend_from(self.span()) }
}
