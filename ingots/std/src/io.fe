/// Standard input, output and error of a native program.
///
/// Each stream is a capability of the native root effect, `std::native::Host`.
/// `main` and tests receive the streams they declare, as in
/// `pub fn main() -> i32 uses (out: mut Stdout)`, and a function that prints
/// declares the stream it writes. `Stdio` provides all three:
/// `uses (io: mut Stdio)`. Output is unbuffered: each print is one write to
/// the stream, so a later panic loses nothing.
use core::{MemBuffer, MemSlice, MemSpan, Option, PackedBytes}
use core::abi::DynString
use core::num::{IntWord, UnsignedAbs}
use super::native::{Host, HostCapabilitySeal}

extern {
    // POSIX descriptor I/O.
    fn read(_ fd: i32, _ buf: *u8, _ count: usize) -> isize
    fn write(_ fd: i32, _ buf: *u8, _ count: usize) -> isize
}

/// The process's standard output.
pub trait Stdout: HostCapabilitySeal {
    /// Writes all of `bytes`; false if the stream fails first.
    fn write_stdout(mut self, _ bytes: MemSpan) -> bool
}

/// The process's standard error.
pub trait Stderr: HostCapabilitySeal {
    /// Writes all of `bytes`; false if the stream fails first.
    fn write_stderr(mut self, _ bytes: MemSpan) -> bool
}

/// The process's standard input.
pub trait Stdin: HostCapabilitySeal {
    /// Reads at most `buf.len()` bytes into the start of `buf`: the number
    /// read, zero at the end of input, or `None` if the stream fails.
    fn read_stdin(mut self, _ buf: mut MemSpan) -> Option<usize>
}

/// Standard input, output and error together: an effect keyed by `Stdio`
/// provides `Stdout`, `Stderr` and `Stdin`.
pub trait Stdio: Stdout + Stderr + Stdin {}

impl Stdio for Host {}

impl Stdout for Host {
    fn write_stdout(mut self, _ bytes: MemSpan) -> bool {
        write_all(fd: 1, bytes)
    }
}

impl Stderr for Host {
    fn write_stderr(mut self, _ bytes: MemSpan) -> bool {
        write_all(fd: 2, bytes)
    }
}

impl Stdin for Host {
    fn read_stdin(mut self, _ buf: mut MemSpan) -> Option<usize> {
        let count = unsafe { read(0, buf.ptr(), buf.len()) }
        if count < 0 { Option::None } else { Option::Some(count.downcast_unchecked()) }
    }
}

fn write_all(fd: i32, _ bytes: MemSpan) -> bool {
    var written: usize = 0
    while written < bytes.len() {
        let count = unsafe { write(fd, core::ptr::offset_bytes(bytes.ptr(), written), bytes.len() - written) }
        if count <= 0 {
            return false
        }
        written += count.downcast_unchecked()
    }
    true
}

/// A value with a text form, which `print` and its relatives write.
pub trait Display {
    /// Appends the value's text to `out`.
    fn fmt(self, _ out: mut MemBuffer)
}

/// Writes `value`'s text to standard output. Panics if the stream fails.
pub fn print<T: Display>(_ value: T) uses (out: mut Stdout) {
    var text = MemBuffer::empty()
    value.fmt(mut text)
    assert!(out.write_stdout(text.span()), "failed writing to stdout")
}

/// Writes `value`'s text and a newline to standard output. Panics if the
/// stream fails.
pub fn println<T: Display>(_ value: T) uses (out: mut Stdout) {
    var text = MemBuffer::empty()
    value.fmt(mut text)
    text.push(10)
    assert!(out.write_stdout(text.span()), "failed writing to stdout")
}

/// Writes `value`'s text to standard error. Panics if the stream fails.
pub fn eprint<T: Display>(_ value: T) uses (err: mut Stderr) {
    var text = MemBuffer::empty()
    value.fmt(mut text)
    assert!(err.write_stderr(text.span()), "failed writing to stderr")
}

/// Writes `value`'s text and a newline to standard error. Panics if the
/// stream fails.
pub fn eprintln<T: Display>(_ value: T) uses (err: mut Stderr) {
    var text = MemBuffer::empty()
    value.fmt(mut text)
    text.push(10)
    assert!(err.write_stderr(text.span()), "failed writing to stderr")
}

/// Appends the rest of standard input to `buf`. Panics if the stream fails.
pub fn read_to_end(_ buf: mut MemBuffer) uses (input: mut Stdin) {
    while fill(mut buf) {}
}

// Reads once into `buf`'s spare capacity, growing it first: false at the end
// of input.
fn fill(_ buf: mut MemBuffer) -> bool uses (input: mut Stdin) {
    buf.reserve(4096)
    let len = buf.len()
    // The bytes past the length are allocated; the read initializes the
    // ones it counts.
    let spare = core::ptr::offset_bytes(buf.ptr(), len)
    match input.read_stdin(unsafe { MemSlice::from_raw_parts(ptr: spare, len: buf.capacity() - len) }) {
        Option::Some(count) => {
            unsafe { buf.set_len(len + count) }
            count > 0
        }
        Option::None => {
            assert!(false, "failed reading stdin")
            false
        }
    }
}

/// Reads standard input through a buffer, a byte or a line at a time.
pub struct StdinReader {
    buffer: MemBuffer,
    // The first byte of `buffer` not yet returned.
    start: usize,
    done: bool,
}

impl StdinReader {
    pub fn new() -> Self {
        StdinReader { buffer: MemBuffer::empty(), start: 0, done: false }
    }

    /// The next byte of standard input, or `None` at its end. Panics if the
    /// stream fails.
    pub fn read_byte(mut self) -> Option<u8> uses (input: mut Stdin) {
        if self.start == self.buffer.len() && !self.refill() {
            return Option::None
        }
        let byte = self.buffer[self.start]
        self.start += 1
        Option::Some(byte)
    }

    /// Appends the next line of standard input to `line`, without its
    /// newline: false at the end of input. The last line need not end in a
    /// newline. Panics if the stream fails.
    pub fn read_line(mut self, _ line: mut MemBuffer) -> bool uses (input: mut Stdin) {
        var scanned = self.start
        while true {
            while scanned < self.buffer.len() {
                if self.buffer[scanned] == 10 {
                    line.extend_from(self.buffer.slice(offset: self.start, len: scanned - self.start))
                    self.start = scanned + 1
                    return true
                }
                scanned += 1
            }
            let returned = self.start
            if !self.refill() {
                if self.start == self.buffer.len() {
                    return false
                }
                line.extend_from(self.buffer.slice(offset: self.start, len: self.buffer.len() - self.start))
                self.start = self.buffer.len()
                return true
            }
            scanned -= returned
        }
        false
    }

    // Moves the unreturned bytes to the front of the buffer and reads more
    // after them: false at the end of input.
    fn refill(mut self) -> bool uses (input: mut Stdin) {
        if self.done {
            return false
        }
        let rest = self.buffer.len() - self.start
        self.buffer.span().copy_within(source: self.start, dest: 0, len: rest)
        self.buffer.truncate(rest)
        self.start = 0
        self.done = !fill(mut self.buffer)
        !self.done
    }
}

// Appends the decimal digits of `value`.
fn push_decimal(_ out: mut MemBuffer, _ value: u256) {
    // Wide division is slow on native targets; most values fit in 64 bits.
    if value <= 0xffffffffffffffff {
        push_decimal_u64(mut out, value.downcast_unchecked())
        return
    }
    var digits: [u8; 78] = [0; 78]
    var count: usize = 0
    var rest = value
    while rest != 0 {
        digits[count] = ((rest % 10) + 48).downcast_unchecked()
        rest /= 10
        count += 1
    }
    while count > 0 {
        count -= 1
        out.push(digits[count])
    }
}

fn push_decimal_u64(_ out: mut MemBuffer, _ value: u64) {
    var digits: [u8; 20] = [0; 20]
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = ((rest % 10) + 48).downcast_unchecked()
        rest /= 10
        count += 1
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        out.push(digits[count])
    }
}

fn push_signed<T: IntWord>(_ out: mut MemBuffer, negative: bool, magnitude: T) {
    if negative {
        out.push(45)
    }
    push_decimal(mut out, IntWord::to_word(magnitude))
}

impl Display for u8 {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal(mut out, IntWord::to_word(self)) }
}
impl Display for u16 {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal(mut out, IntWord::to_word(self)) }
}
impl Display for u32 {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal(mut out, IntWord::to_word(self)) }
}
impl Display for u64 {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal_u64(mut out, self) }
}
impl Display for u128 {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal(mut out, IntWord::to_word(self)) }
}
impl Display for u256 {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal(mut out, self) }
}
impl Display for usize {
    fn fmt(self, _ out: mut MemBuffer) { push_decimal(mut out, IntWord::to_word(self)) }
}
impl Display for i8 {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}
impl Display for i16 {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}
impl Display for i32 {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}
impl Display for i64 {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}
impl Display for i128 {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}
impl Display for i256 {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}
impl Display for isize {
    fn fmt(self, _ out: mut MemBuffer) { push_signed(mut out, negative: self < 0, magnitude: self.unsigned_abs()) }
}

impl Display for bool {
    fn fmt(self, _ out: mut MemBuffer) {
        if self { "true".fmt(mut out) } else { "false".fmt(mut out) }
    }
}

impl<const N: usize> Display for String<N> {
    fn fmt(self, _ out: mut MemBuffer) {
        // The text is the low `len` bytes of the string's word, big endian.
        let len = self.len()
        let word = self as u256
        var i: usize = len
        while i > 0 {
            i -= 1
            out.push(((word >> ((i * 8) as u256)) & 0xff).downcast_unchecked())
        }
    }
}

impl Display for DynString {
    fn fmt(self, _ out: mut MemBuffer) { out.extend_from(self.payload_span()) }
}

/// The bytes themselves.
impl Display for MemSlice<u8> {
    fn fmt(self, _ out: mut MemBuffer) { out.extend_from(self) }
}

/// All `N` bytes, padding included.
impl<const N: usize> Display for PackedBytes<N> {
    fn fmt(self, _ out: mut MemBuffer) {
        var i: usize = 0
        while i < N {
            out.push(self[i])
            i += 1
        }
    }
}

/// The bytes themselves.
impl Display for MemBuffer {
    fn fmt(self, _ out: mut MemBuffer) { out.extend_from(self.span()) }
}

impl<T0: Display> Display for (T0,) {
    fn fmt(self, _ out: mut MemBuffer) {
        self.0.fmt(mut out)
    }
}
impl<T0: Display, T1: Display> Display for (T0, T1) {
    fn fmt(self, _ out: mut MemBuffer) {
        self.0.fmt(mut out)
        self.1.fmt(mut out)
    }
}
impl<T0: Display, T1: Display, T2: Display> Display for (T0, T1, T2) {
    fn fmt(self, _ out: mut MemBuffer) {
        self.0.fmt(mut out)
        self.1.fmt(mut out)
        self.2.fmt(mut out)
    }
}
impl<T0: Display, T1: Display, T2: Display, T3: Display> Display for (T0, T1, T2, T3) {
    fn fmt(self, _ out: mut MemBuffer) {
        self.0.fmt(mut out)
        self.1.fmt(mut out)
        self.2.fmt(mut out)
        self.3.fmt(mut out)
    }
}
impl<T0: Display, T1: Display, T2: Display, T3: Display, T4: Display> Display for (T0, T1, T2, T3, T4) {
    fn fmt(self, _ out: mut MemBuffer) {
        self.0.fmt(mut out)
        self.1.fmt(mut out)
        self.2.fmt(mut out)
        self.3.fmt(mut out)
        self.4.fmt(mut out)
    }
}
impl<T0: Display, T1: Display, T2: Display, T3: Display, T4: Display, T5: Display> Display for (
    T0,
    T1,
    T2,
    T3,
    T4,
    T5,
) {
    fn fmt(self, _ out: mut MemBuffer) {
        self.0.fmt(mut out)
        self.1.fmt(mut out)
        self.2.fmt(mut out)
        self.3.fmt(mut out)
        self.4.fmt(mut out)
        self.5.fmt(mut out)
    }
}
impl<T0: Display, T1: Display, T2: Display, T3: Display, T4: Display, T5: Display, T6: Display> Display for (
    T0,
    T1,
    T2,
    T3,
    T4,
    T5,
    T6,
) {
    fn fmt(self, _ out: mut MemBuffer) {
        self.0.fmt(mut out)
        self.1.fmt(mut out)
        self.2.fmt(mut out)
        self.3.fmt(mut out)
        self.4.fmt(mut out)
        self.5.fmt(mut out)
        self.6.fmt(mut out)
    }
}
impl<
    T0: Display,
    T1: Display,
    T2: Display,
    T3: Display,
    T4: Display,
    T5: Display,
    T6: Display,
    T7: Display,
> Display for (T0, T1, T2, T3, T4, T5, T6, T7) {
    fn fmt(self, _ out: mut MemBuffer) {
        self.0.fmt(mut out)
        self.1.fmt(mut out)
        self.2.fmt(mut out)
        self.3.fmt(mut out)
        self.4.fmt(mut out)
        self.5.fmt(mut out)
        self.6.fmt(mut out)
        self.7.fmt(mut out)
    }
}
