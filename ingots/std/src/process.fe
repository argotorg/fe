/// Ending the process and starting other programs, capabilities of the
/// native root effect, `std::native::Host`: a function that ends the process
/// declares `uses (proc: Exit)`, and one that runs programs
/// `uses (proc: mut Spawn)`. An operation that fails returns the host's
/// reason as a `std::io::Error`.
use super::native::{Host, HostCapabilitySeal}

#[cfg(target_family = "unix")]
pub use spawn::*

extern {
    // The C library's `exit`.
    fn exit(_ status: i32) -> !
}

/// Ending the process.
pub trait Exit: HostCapabilitySeal {
    /// Ends the process with `status` at once; destructors do not run.
    fn exit(self, _ status: i32) -> !
}

impl Exit for Host {
    fn exit(self, _ status: i32) -> ! {
        unsafe { exit(status) }
    }
}
